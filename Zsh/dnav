  # Settings rows: about_body_lines + about_row_kind/key/idx for editing
  local -a about_body_lines about_row_kind about_row_key
  local -a about_row_idx
  local about_interactive_rows=0

  _dnav_settings_fill_body() {
    local tab="${settings_tabs[settings_sel+1]}"
    local onoff i k path
    about_body_lines=()
    about_row_kind=()
    about_row_key=()
    about_row_idx=()
    about_interactive_rows=0
    case $tab in
      General)
        (( DNAV_CFG_LS )) && onoff=on || onoff=off
        about_body_lines+=("ls_after          $onoff          Enter toggle")
        about_row_kind+=(toggle) about_row_key+=(ls_after) about_row_idx+=(-1)
        (( DNAV_CFG_SHOW_HIDDEN )) && onoff=on || onoff=off
        about_body_lines+=("show_hidden       $onoff          Enter toggle")
        about_row_kind+=(toggle) about_row_key+=(show_hidden) about_row_idx+=(-1)
        (( DNAV_CFG_SUCCESS_ANIM )) && onoff=on || onoff=off
        about_body_lines+=("success_anim      $onoff          Enter toggle")
        about_row_kind+=(toggle) about_row_key+=(success_anim) about_row_idx+=(-1)
        (( DNAV_CFG_FULL_REDRAW )) && onoff=on || onoff=off
        about_body_lines+=("full_redraw       $onoff          Enter toggle · full line vs partial")
        about_row_kind+=(toggle) about_row_key+=(full_redraw) about_row_idx+=(-1)
        about_body_lines+=("color_fg          ${DNAV_CFG_COLOR_FG}          Enter edit number/name")
        about_row_kind+=(value) about_row_key+=(color_fg) about_row_idx+=(-1)
        about_body_lines+=("color_bg          ${DNAV_CFG_COLOR_BG}          Enter edit number/name")
        about_row_kind+=(value) about_row_key+=(color_bg) about_row_idx+=(-1)
        about_body_lines+=("brand             ${DNAV_CFG_BRAND}          Enter edit text")
        about_row_kind+=(value) about_row_key+=(brand) about_row_idx+=(-1)
        about_interactive_rows=$#about_body_lines
        ;;
      Folders)
        if (( ${#DNAV_FOLDER_NAMES} )); then
          for (( i=1; i <= $#DNAV_FOLDER_NAMES; i++ )); do
            path="${DNAV_FOLDER_PATHS[i]}"
            about_body_lines+=("${(r:14:)DNAV_FOLDER_NAMES[i]}  $path")
            about_row_kind+=(folder)
            about_row_key+=("${DNAV_FOLDER_NAMES[i]}")
            about_row_idx+=($i)
          done
        fi
        about_body_lines+=("+ Add folder     Enter add · x delete selected")
        about_row_kind+=(folder_add) about_row_key+=("") about_row_idx+=(-1)
        about_interactive_rows=$#about_body_lines
        ;;
      Jumps)
        if (( $+functions[_djump_ensure] )) && _djump_ensure 2>/dev/null && (( $#_DJUMP_KEYS )); then
          for (( i=1; i <= $#_DJUMP_KEYS; i++ )); do
            k="${_DJUMP_KEYS[i]}"
            about_body_lines+=("d${(r:12:)k}  ${_DJUMP_MAP[$k]}")
            about_row_kind+=(jump)
            about_row_key+=("$k")
            about_row_idx+=($i)
          done
        fi
        about_body_lines+=("+ Add jump       Enter add · x delete selected")
        about_row_kind+=(jump_add) about_row_key+=("") about_row_idx+=(-1)
        about_interactive_rows=$#about_body_lines
        ;;
    esac
  }

  # Manual line editor (raw mode). Handles Backspace/Delete; Esc cancels.
  # Returns 0 and sets REPLY on Enter; returns 1 on Esc/cancel.
  _dnav_inline_edit() {
    local prompt="$1" buf="${2:-}"
    local k k2 k3 k4
    local edit_row=$(( help_extra > 0 ? help_extra : 0 ))

    printf "\e[%dB" $edit_row
    printf "\e[?25h"
    # Stay in -echo -icanon so we control every key (vared mishandles Delete)
    stty -echo -icanon isig 2>/dev/null

    while true; do
      printf "\r\e[2K%s%s" "$prompt" "$buf"
      read -k 1 k || { REPLY=""; printf "\e[?25l\r\e[2K"; (( edit_row > 0 )) && printf "\e[%dA" $edit_row; return 1; }
      case $k in
        $'\n'|$'\r')
          REPLY="$buf"
          printf "\e[?25l\r\e[2K"
          (( edit_row > 0 )) && printf "\e[%dA" $edit_row
          return 0
          ;;
        $'\e')
          if read -t 0.05 -k 1 k2 2>/dev/null; then
            if [[ $k2 == '[' ]]; then
              read -k 1 k3 2>/dev/null || k3=""
              case $k3 in
                3)  # Delete = ESC [ 3 ~
                  read -t 0.05 -k 1 k4 2>/dev/null || true
                  (( ${#buf} > 0 )) && buf="${buf[1,-2]}"
                  ;;
                *)
                  # swallow other CSI sequences (arrows, etc.)
                  [[ $k3 == [0-9] ]] && read -t 0.05 -k 1 k4 2>/dev/null || true
                  ;;
              esac
            fi
            # else: Alt+key — ignore
          else
            # bare Esc → cancel
            REPLY=""
            printf "\e[?25l\r\e[2K"
            (( edit_row > 0 )) && printf "\e[%dA" $edit_row
            return 1
          fi
          ;;
        $'\x7f'|$'\b')  # Backspace
          (( ${#buf} > 0 )) && buf="${buf[1,-2]}"
          ;;
        $'\x03')  # Ctrl+C while editing → cancel edit only
          REPLY=""
          printf "\e[?25l\r\e[2K"
          (( edit_row > 0 )) && printf "\e[%dA" $edit_row
          return 1
          ;;
        [[:print:]])
          buf+="$k"
          ;;
      esac
    done
  }

  # Word/hard wrap text to width; prints one physical row per line (no terminal wrap).
  _dnav_wrap_lines() {
    local width="$1"
    shift
    local text chunk cut rest w
    (( width < 8 )) && width=8
    for text in "$@"; do
      rest="$text"
      while (( ${#rest} > width )); do
        chunk="${rest[1,width]}"
        if [[ $chunk == *' '* && ${#chunk} -eq width ]]; then
          cut="${chunk% *}"
          if (( ${#cut} > 0 && ${#cut} < width )); then
            print -r -- "$cut"
            rest="${rest[$(( ${#cut} + 2 )),-1]}"
            continue
          fi
        fi
        print -r -- "$chunk"
        rest="${rest[$(( width + 1 )),-1]}"
      done
      print -r -- "$rest"
    done
  }

  # Paint exactly one terminal row of width maxw (truncate/pad; never soft-wrap).
  _dnav_paint_row() {
    local style="$1" text="$2" maxw="$3"
    local pad
    # Take first maxw-1 chars after leading space convention
    if (( ${#text} > maxw )); then
      text="${text[1,maxw-1]}…"
    fi
    pad=$(( maxw - ${#text} ))
    (( pad < 0 )) && pad=0
    case $style in
      hl)  printf "${HIGHLIGHT}%s%*s${RESET}" "$text" $pad "" ;;
      dim) printf "\e[2m%s%*s\e[22m" "$text" $pad "" ;;
      *)   printf "%s%*s" "$text" $pad "" ;;
    esac
  }

  # Paint a named chip strip; reply=(new_win).
  _dnav_about_paint_strip() {
    local aname="$1" sel="$2" win="$3" maxw="$4"
    if (( $+functions[_dfile_paint_strip] )); then
      _dfile_paint_strip "$aname" $sel $win 1 $maxw
      return
    fi
    local -a items
    items=("${(@P)aname}")
    local i label used=0 n=$#items cell_w
    local more_l=0 more_r=0
    (( win > 0 )) && more_l=1
    (( more_l )) && printf "\e[2m<\e[22m "
    for (( i=win; i < n; i++ )); do
      label="${items[i+1]}"
      cell_w=$(( ${#label} + 3 ))
      if (( used > 0 && used + cell_w > maxw )); then
        more_r=1
        break
      fi
      if (( i == sel )); then
        printf "${HIGHLIGHT} %s ${RESET} " "$label"
      else
        printf " %s  " "$label"
      fi
      (( used += cell_w ))
    done
    (( more_r )) && printf " \e[2m>\e[22m"
    printf "\e[K"
    reply=($win)
  }

  _dnav_about_refresh_style() {
    HIGHLIGHT_FG=${DNAV_CFG_COLOR_FG:-30}
    HIGHLIGHT_BG=${DNAV_CFG_COLOR_BG:-46}
    HIGHLIGHT=$'\e['"${HIGHLIGHT_FG}"';'"${HIGHLIGHT_BG}"'m'
    RESET=$'\e[0m'
    DNAV_HIGHLIGHT=$HIGHLIGHT
    DNAV_RESET=$RESET
    brand="${DNAV_CFG_BRAND:-DNav}"
  }

  # Temporarily leave raw mode, edit a file, restore TUI.
  _dnav_about_edit_file() {
    local file="$1"
    local ed="${EDITOR:-${VISUAL:-vi}}"
    [[ -n $file ]] || return 1
    # Clear about UI to a clean line
    printf "\r\e[2K"
    local i
    for (( i=0; i < help_extra; i++ )); do
      printf "\n\e[2K"
    done
    if (( help_extra > 0 )); then
      printf "\e[%dA" $help_extra
    fi
    help_extra=0
    printf "\r\e[2K\e[?25h"
    stty "$_DNAV_STTY_ORIG" 2>/dev/null
    ${=ed} -- "$file"
    stty -echo -icanon isig 2>/dev/null
    printf "\e[?25l"
    _dnav_config_load
    _dnav_about_refresh_style
    if [[ $file == */jumps ]] && (( $+functions[_djump_load] )); then
      _DJUMP_LOADED=0
      _djump_load 2>/dev/null || true
    fi
    _dnav_draw_about
  }

  _dnav_settings_apply_edit() {
    local kind="${about_row_kind[settings_row+1]}"
    local rkey="${about_row_key[settings_row+1]}"
    local ridx="${about_row_idx[settings_row+1]}"
    local val label path k
    case $kind in
      toggle)
        case $rkey in
          ls_after)
            DNAV_CFG_LS=$(( 1 - DNAV_CFG_LS ))
            _dnav_config_set ls_after "$DNAV_CFG_LS"
            ;;
          show_hidden)
            DNAV_CFG_SHOW_HIDDEN=$(( 1 - DNAV_CFG_SHOW_HIDDEN ))
            _dnav_config_set show_hidden "$DNAV_CFG_SHOW_HIDDEN"
            ;;
          success_anim)
            DNAV_CFG_SUCCESS_ANIM=$(( 1 - DNAV_CFG_SUCCESS_ANIM ))
            _dnav_config_set success_anim "$DNAV_CFG_SUCCESS_ANIM"
            ;;
          full_redraw)
            DNAV_CFG_FULL_REDRAW=$(( 1 - DNAV_CFG_FULL_REDRAW ))
            _dnav_config_set full_redraw "$DNAV_CFG_FULL_REDRAW"
            ;;
        esac
        ;;
      value)
        case $rkey in
          color_fg) _dnav_inline_edit "color_fg (Esc cancel): " "$DNAV_CFG_COLOR_FG" || return 1 ;;
          color_bg) _dnav_inline_edit "color_bg (Esc cancel): " "$DNAV_CFG_COLOR_BG" || return 1 ;;
          brand)    _dnav_inline_edit "brand (Esc cancel): " "$DNAV_CFG_BRAND" || return 1 ;;
          *) return 1 ;;
        esac
        val="${REPLY//[$'\r\n']/}"
        [[ -z $val ]] && return 1
        case $rkey in
          color_fg)
            _dnav_config_set color_fg "$val"
            DNAV_CFG_COLOR_FG="$(_dnav_color_num fg "$val")"
            _dnav_apply_colors
            _dnav_about_refresh_style
            ;;
          color_bg)
            _dnav_config_set color_bg "$val"
            DNAV_CFG_COLOR_BG="$(_dnav_color_num bg "$val")"
            _dnav_apply_colors
            _dnav_about_refresh_style
            ;;
          brand)
            _dnav_config_set brand "$val"
            DNAV_CFG_BRAND="$val"
            brand="$val"
            ;;
        esac
        ;;
      folder)
        (( ridx > 0 )) || return 1
        _dnav_inline_edit "label (Esc cancel): " "${DNAV_FOLDER_NAMES[ridx]}" || return 1
        label="${REPLY//[$'\r\n']/}"
        [[ -z $label ]] && return 1
        _dnav_inline_edit "path (Esc cancel): " "${DNAV_FOLDER_PATHS[ridx]}" || return 1
        val="${REPLY//[$'\r\n']/}"
        [[ -z $val ]] && return 1
        DNAV_FOLDER_NAMES[ridx]="$label"
        DNAV_FOLDER_PATHS[ridx]="$(_dnav_expand_path "$val")"
        _dnav_folders_save
        ;;
      folder_add)
        _dnav_inline_edit "new label (Esc cancel): " "" || return 1
        label="${REPLY//[$'\r\n']/}"
        [[ -z $label ]] && return 1
        _dnav_inline_edit "path for $label (Esc cancel): " "~" || return 1
        path="${REPLY//[$'\r\n']/}"
        [[ -z $path ]] && return 1
        DNAV_FOLDER_NAMES+=("$label")
        DNAV_FOLDER_PATHS+=("$(_dnav_expand_path "$path")")
        _dnav_folders_save
        ;;
      jump)
        [[ -n $rkey ]] || return 1
        _dnav_inline_edit "path d$rkey (Esc cancel): " "${_DJUMP_MAP[$rkey]}" || return 1
        val="${REPLY//[$'\r\n']/}"
        [[ -z $val ]] && return 1
        _DJUMP_MAP[$rkey]="$val"
        _dnav_jumps_save
        ;;
      jump_add)
        _dnav_inline_edit "jump key e.g. home (Esc cancel): " "" || return 1
        k="${REPLY//[$'\r\n']/}"
        k="${k#d}"
        [[ $k =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]] || return 1
        _dnav_inline_edit "path for d$k (Esc cancel): " "~" || return 1
        path="${REPLY//[$'\r\n']/}"
        [[ -z $path ]] && return 1
        if [[ -z ${_DJUMP_MAP[$k]:-} ]]; then
          _DJUMP_KEYS+=("$k")
        fi
        _DJUMP_MAP[$k]="$path"
        _dnav_jumps_save
        ;;
    esac
    return 0
  }

  # Delete selected folder/jump row (x key).
  _dnav_settings_delete_row() {
    local kind="${about_row_kind[settings_row+1]}"
    local rkey="${about_row_key[settings_row+1]}"
    local ridx="${about_row_idx[settings_row+1]}"
    local -a nkeys
    local i k
    case $kind in
      folder)
        (( ridx > 0 )) || return
        local -a nn np
        nn=() np=()
        for (( i=1; i <= $#DNAV_FOLDER_NAMES; i++ )); do
          (( i == ridx )) && continue
          nn+=("${DNAV_FOLDER_NAMES[i]}")
          np+=("${DNAV_FOLDER_PATHS[i]}")
        done
        DNAV_FOLDER_NAMES=("${nn[@]}")
        DNAV_FOLDER_PATHS=("${np[@]}")
        _dnav_folders_save
        (( settings_row > 0 )) && (( settings_row-- ))
        ;;
      jump)
        [[ -n $rkey ]] || return
        unset "_DJUMP_MAP[$rkey]"
        nkeys=()
        for k in "${_DJUMP_KEYS[@]}"; do
          [[ $k == "$rkey" ]] && continue
          nkeys+=("$k")
        done
        _DJUMP_KEYS=("${nkeys[@]}")
        _dnav_jumps_save
        (( settings_row > 0 )) && (( settings_row-- ))
        ;;
      *) return ;;
    esac
  }

  # Max body rows under header+strip so About never exceeds the terminal.
  local help_body_scroll=0

  _dnav_about_body_max() {
    local lim=$(( ${LINES:-24} - 5 ))
    (( lim < 4 )) && lim=4
    (( lim > 20 )) && lim=20
    print -rn -- $lim
  }

  _dnav_draw_about() {
    local -a blines raw
    local line n=0 i leftover old_extra=$help_extra
    local maxw=$cols topic body_max style
    local -a display
    mode=about
    body_max="$(_dnav_about_body_max)"
    (( maxw < 20 )) && maxw=20
    printf "\e[?25l\r"

    # Row 0: [ DNav About:] [ Help ] Settings   Tab to switch
    printf "${HIGHLIGHT} DNav About:${RESET} "
    if [[ $about_tab == help ]]; then
      printf "${HIGHLIGHT} Help ${RESET} "
      printf " Settings  "
    else
      printf " Help  "
      printf "${HIGHLIGHT} Settings ${RESET} "
    fi
    printf "\e[2mTab to switch\e[22m\e[K"

    # Row 1: section strip
    printf "\n\r"
    if [[ $about_tab == help ]]; then
      _dnav_about_paint_strip help_topics $help_sel $help_win $maxw
      help_win=$reply[1]
    else
      _dnav_about_paint_strip settings_tabs $settings_sel $settings_win $maxw
      settings_win=$reply[1]
    fi

    # Build wrapped display rows (each row ≤ maxw, so layout stays stable)
    display=()
    if [[ $about_tab == help ]]; then
      topic="${help_topics[help_sel+1]}"
      raw=("${(@f)$(_dnav_help_topic_body "$topic")}")
      blines=("${(@f)$(_dnav_wrap_lines $(( maxw - 2 )) "${raw[@]}")}")
      for line in "${blines[@]}"; do
        display+=(" $line")
      done
      # scroll window for long help
      (( help_body_scroll < 0 )) && help_body_scroll=0
      if (( $#display > body_max )); then
        (( help_body_scroll > $#display - body_max )) && help_body_scroll=$(( $#display - body_max ))
        display=("${display[$(( help_body_scroll + 1 )),$(( help_body_scroll + body_max ))]}")
      else
        help_body_scroll=0
      fi
      for line in "${display[@]}"; do
        printf "\n\r"
        _dnav_paint_row dim "$line" $maxw
        (( n++ ))
      done
    else
      _dnav_settings_fill_body
      raw=("${about_body_lines[@]}")
      # Settings: keep 1 logical row = 1 interactive row (truncate, don't multi-wrap)
      for (( i=1; i <= $#raw; i++ )); do
        line=" ${raw[i]}"
        if (( ${#line} > maxw )); then
          line="${line[1,maxw-1]}…"
        fi
        display+=("$line")
      done
      for (( i=1; i <= $#display; i++ )); do
        printf "\n\r"
        if (( (i - 1) == settings_row )); then
          _dnav_paint_row hl "${display[i]}" $maxw
        else
          _dnav_paint_row dim "${display[i]}" $maxw
        fi
        (( n++ ))
      done
    fi

    leftover=$(( old_extra - 1 - n ))
    for (( i=0; i < leftover; i++ )); do
      printf "\n\r\e[2K"
    done
    if (( leftover > 0 )); then
      printf "\e[%dA" $leftover
    fi

    help_extra=$(( 1 + n ))
    if (( help_extra > 0 )); then
      printf "\e[%dA" $help_extra
    fi
    printf "\r"
  }

  _dnav_show_about() {
    _dnav_about_init
    help_extra=0
    _dnav_draw_about
  }

  _dnav_about_move_h() {
    local dir="$1"
    if [[ $about_tab == help ]]; then
      local n=$#help_topics
      (( n == 0 )) && return
      (( help_sel += dir ))
      (( help_sel < 0 )) && help_sel=0
      (( help_sel >= n )) && help_sel=$(( n - 1 ))
      help_body_scroll=0
    else
      local n=$#settings_tabs
      (( n == 0 )) && return
      (( settings_sel += dir ))
      (( settings_sel < 0 )) && settings_sel=0
      (( settings_sel >= n )) && settings_sel=$(( n - 1 ))
      settings_row=0
    fi
    _dnav_draw_about
  }

  _dnav_about_move_v() {
    local dir="$1" maxr=0
    if [[ $about_tab == help ]]; then
      # Scroll long wrapped help body
      (( help_body_scroll += dir ))
      (( help_body_scroll < 0 )) && help_body_scroll=0
      _dnav_draw_about
      return
    fi
    [[ $about_tab == settings ]] || return
    (( about_interactive_rows <= 0 )) && _dnav_settings_fill_body
    maxr=$(( about_interactive_rows > 0 ? about_interactive_rows - 1 : 0 ))
    (( settings_row += dir ))
    (( settings_row < 0 )) && settings_row=0
    (( settings_row > maxr )) && settings_row=$maxr
    _dnav_draw_about
  }

  # Rebuild main bar arrays from config folders + hardcoded About.
  _dnav_reload_main_bar() {
    if (( ${#DNAV_FOLDER_NAMES} > 0 )); then
      names=("${DNAV_FOLDER_NAMES[@]}")
      paths=("${DNAV_FOLDER_PATHS[@]}")
    else
      names=()
      paths=()
    fi
    names+=(About)
    paths+=("")
    (( selected >= $#names )) && selected=$(( $#names - 1 ))
    (( selected < 0 )) && selected=0
    bar_win=0
    _dnav_ensure_bar_visible
    _dnav_compute_positions
  }

  _dnav_leave_about() {
    local i
    mode=main
    printf "\r\e[2K"
    for (( i=0; i < help_extra; i++ )); do
      printf "\n\e[2K"
    done
    if (( help_extra > 0 )); then
      printf "\e[%dA" $help_extra
    fi
    help_extra=0
    printf "\r"
    _dnav_about_refresh_style
    _dnav_reload_main_bar
    _dnav_draw
  }

  # Expand from selected chip, then full-width path bar (shared _dnav_success_bar).
  _dnav_success_from_sel() {
    local path="$1"
    local origin_start=${item_start[selected+1]:-0}
    local origin_end=${item_end[selected+1]:-$cols}
    local origin_mid=$(( (origin_start + origin_end) / 2 ))
    _dnav_success_bar "$path" "$origin_mid"
  }

  _dnav_compute_positions
  _dnav_draw

  while true; do
    # DNAV_ABORT: full UI teardown already done by _dnav_abort (trap or \x03)
    (( DNAV_ABORT )) && return 130
    read -k 1 key || true
    (( DNAV_ABORT )) && return 130
    # Ctrl+C may arrive as a byte in some terminals even with isig
    if [[ $key == $'\x03' ]]; then
      _dnav_abort
      return 130
    fi

    case $key in
      $'\e')  # Escape or arrow sequence
        if read -t 0.05 -k 1 key2 2>/dev/null; then
          if [[ $key2 == '[' ]]; then
            read -k 1 key3
            case $key3 in
              D)  # Left
                if [[ $mode == about ]]; then
                  _dnav_about_move_h -1
                elif [[ $mode == main ]]; then
                  _dnav_move_left
                fi
                ;;
              C)  # Right
                if [[ $mode == about ]]; then
                  _dnav_about_move_h 1
                elif [[ $mode == main ]]; then
                  _dnav_move_right
                fi
                ;;
              A)  # Up
                [[ $mode == about ]] && _dnav_about_move_v -1
                ;;
              B)  # Down
                [[ $mode == about ]] && _dnav_about_move_v 1
                ;;
              3)  # Delete key ESC [ 3 ~
                read -t 0.05 -k 1 key4 2>/dev/null || true
                if [[ $mode == about && $about_tab == settings ]]; then
                  (( about_interactive_rows <= 0 )) && _dnav_settings_fill_body
                  _dnav_settings_delete_row
                  _dnav_draw_about
                fi
                ;;
            esac
          fi
        else
          # Plain Esc
          if [[ $mode == about ]]; then
            _dnav_leave_about
          else
            _dnav_clear_menu
            _dnav_cleanup
            return 0
          fi
        fi
        ;;
      $'\n'|$'\r')  # Enter
        if [[ $mode == about ]]; then
          if [[ $about_tab == settings ]]; then
            (( about_interactive_rows <= 0 )) && _dnav_settings_fill_body
            _dnav_settings_apply_edit || true
            _dnav_draw_about
          fi
          continue
        fi

        # About chip (hardcoded empty path) → About overlay
        if [[ -z ${paths[selected+1]} || ${names[selected+1]} == About ]]; then
          _dnav_show_about
          continue
        fi

        target="${paths[selected+1]}"
        if [[ -d $target ]]; then
          cd -- "$target" || {
            _dnav_clear_menu
            printf "Could not change to %s\n" "${names[selected+1]}"
            _dnav_cleanup
            return 1
          }
          _dnav_success_from_sel "${target:A}"
          _dnav_cleanup
          _dnav_maybe_ls
          return 0
        else
          _dnav_clear_menu
          printf "Folder not found: %s\n" "$target"
          _dnav_cleanup
          return 1
        fi
        ;;
      $'\t')
        if [[ $mode == about ]]; then
          if [[ $about_tab == help ]]; then
            about_tab=settings
          else
            about_tab=help
          fi
          _dnav_draw_about
        fi
        ;;
      h)
        if [[ $mode == about ]]; then
          _dnav_about_move_h -1
        elif [[ $mode == main ]]; then
          _dnav_move_left
        fi
        ;;
      l)
        if [[ $mode == about ]]; then
          _dnav_about_move_h 1
        elif [[ $mode == main ]]; then
          _dnav_move_right
        fi
        ;;
      k)
        [[ $mode == about ]] && _dnav_about_move_v -1
        ;;
      j)
        [[ $mode == about ]] && _dnav_about_move_v 1
        ;;
      e|E)
        # Optional: open raw file in $EDITOR for bulk edits
        if [[ $mode == about && $about_tab == settings ]]; then
          case ${settings_tabs[settings_sel+1]} in
            General) _dnav_about_edit_file "${DNAV_CONFIG_DIR}/config" ;;
            Folders) _dnav_about_edit_file "${DNAV_CONFIG_DIR}/folders" ;;
            Jumps)   _dnav_about_edit_file "${DNAV_CONFIG_DIR}/jumps" ;;
          esac
        fi
        ;;
      x|X|$'\x7f')
        # x or Backspace: delete selected folder/jump in Settings
        if [[ $mode == about && $about_tab == settings ]]; then
          (( about_interactive_rows <= 0 )) && _dnav_settings_fill_body
          _dnav_settings_delete_row
          _dnav_draw_about
        fi
        ;;
      /|s|S)
        [[ $mode == about ]] && continue
        if [[ $mode == main ]] && _dsearch_available; then
          if _dsearch_start; then
            return 0   # navigated or finished with cleanup
          fi
          (( DNAV_ABORT )) && return 130
          mode=main
          _dnav_draw
        fi
        ;;
      f|F)
        [[ $mode == about ]] && continue
        if [[ $mode == main ]] && _dfile_available; then
          local fpath=""
          if [[ -n ${paths[selected+1]} && -d ${paths[selected+1]} ]]; then
            fpath="${paths[selected+1]}"
          fi
          [[ -z $fpath || ! -d $fpath ]] && fpath="$PWD"
          # Clear main bar line before explorer
          _dnav_clear_menu
          if _dfile_enter "$fpath"; then
            # exited to a folder or opened a file (cleanup already done)
            return 0
          fi
          (( DNAV_ABORT )) && return 130
          # Esc from dfile — still in raw TUI; redraw main
          mode=main
          _dnav_draw
        fi
        ;;
    esac
  done
}

# When sourced the function is available; when run directly it executes
if [[ "${ZSH_EVAL_CONTEXT:-}" != *:file ]]; then
  dnav "$@"
fi
