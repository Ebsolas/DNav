# Manual line editor (raw _DNAV_MODE). Handles Backspace/Delete; Esc cancels.
# Returns 0 and sets REPLY on Enter; returns 1 on Esc/cancel.
# Manual line editor (raw mode). Handles Backspace/Delete; Esc cancels.
# Returns 0 and sets REPLY on Enter; returns 1 on Esc/cancel.
_dnav_inline_edit() {
  local prompt="$1" buf="${2:-}" k
  local edit_row=$(( _DNAV_HELP_EXTRA > 0 ? _DNAV_HELP_EXTRA : 0 ))
  _DNAV_INLINE_EDIT=1
  {
    printf "\e[%dB" $edit_row
    printf "\e[?25h"
    stty -echo -icanon isig 2>/dev/null
    while true; do
      printf "\r\e[2K%s%s" "$prompt" "$buf"
      if (( $+functions[_dnav_read_token] )); then
        _dnav_read_token || { k=esc; }
        k="${REPLY:-esc}"
      else
        read -k 1 k || k=esc
      fi
      case $k in
        enter)
          REPLY="$buf"
          printf "\e[?25l\r\e[2K"
          (( edit_row > 0 )) && printf "\e[%dA" $edit_row
          return 0
          ;;
        esc|ctrl-c)
          REPLY=""
          printf "\e[?25l\r\e[2K"
          (( edit_row > 0 )) && printf "\e[%dA" $edit_row
          return 1
          ;;
        delete|backspace)
          (( ${#buf} > 0 )) && buf="${buf[1,-2]}"
          ;;
        [[:print:]])
          buf+="$k"
          ;;
      esac
    done
  } always {
    _DNAV_INLINE_EDIT=0
  }
}

# Word/hard wrap text to display width; prints one physical row per line.
_dnav_wrap_lines() {
  emulate -L zsh
  setopt localoptions multibyte
  local width="$1"
  shift
  local text rest acc ch cut
  integer i
  (( width < 8 )) && width=8
  for text in "$@"; do
    rest="$text"
    while (( ${(m)#rest} > width )); do
      acc=""
      for (( i=1; i <= ${#rest}; i++ )); do
        ch="${rest[i]}"
        if (( ${(m)#acc} + ${(m)#ch} > width )); then
          break
        fi
        acc+="$ch"
      done
      if [[ $acc == *' '* ]]; then
        cut="${acc% *}"
        if (( ${#cut} > 0 && ${(m)#cut} < width )); then
          print -r -- "$cut"
          rest="${rest[$(( ${#cut} + 2 )),-1]}"
          continue
        fi
      fi
      print -r -- "$acc"
      rest="${rest[$(( ${#acc} + 1 )),-1]}"
    done
    print -r -- "$rest"
  done
}

# Paint exactly one terminal row of width maxw (truncate/pad; never soft-wrap).
_dnav_paint_row() {
  emulate -L zsh
  setopt localoptions multibyte
  local style="$1" text="$2" maxw="$3"
  local pad
  if (( ${(m)#text} > maxw )); then
    text="$(_dnav_fit_start "$text" $maxw)"
  fi
  pad=$(( maxw - ${(m)#text} ))
  (( pad < 0 )) && pad=0
  case $style in
    hl)  printf "${DNAV_HIGHLIGHT}%s%*s${DNAV_RESET}" "$text" $pad "" ;;
    dim) printf "\e[2m%s%*s\e[22m" "$text" $pad "" ;;
    *)   printf "%s%*s" "$text" $pad "" ;;
  esac
}

# Paint a named chip strip; reply=(new_win).
_dnav_about_paint_strip() {
  _dnav_paint_strip "$1" $2 $3 1 $4
}

_dnav_about_refresh_style() {
  _dnav_apply_colors
  _DNAV_BRAND="${DNAV_CFG_BRAND:-DNav}"
}

# Temporarily leave raw _DNAV_MODE, edit a file, restore TUI.
_dnav_about_edit_file() {
  local file="$1"
  local ed="${EDITOR:-${VISUAL:-vi}}"
  [[ -n $file ]] || return 1
  # Clear about UI to a clean line
  printf "\r\e[2K"
  local i
  for (( i=0; i < _DNAV_HELP_EXTRA; i++ )); do
    printf "\n\e[2K"
  done
  if (( _DNAV_HELP_EXTRA > 0 )); then
    printf "\e[%dA" $_DNAV_HELP_EXTRA
  fi
  _DNAV_HELP_EXTRA=0
  printf "\r\e[2K\e[?25h"
  stty "$_DNAV_STTY_ORIG" 2>/dev/null
  ${=ed} -- "$file"
  stty -echo -icanon isig 2>/dev/null
  printf "\e[?25l"
  _dnav_autowrap_off
  _dnav_config_load
  _dnav_about_refresh_style
  if [[ $file == */jumps ]] && (( $+functions[_djump_load] )); then
    _DJUMP_LOADED=0
    _djump_load 2>/dev/null || true
  fi
  _dnav_draw_about
}

_dnav_settings_apply_edit() {
  local kind="${_DNAV_ABOUT_KIND[_DNAV_SETTINGS_ROW+1]}"
  local rkey="${_DNAV_ABOUT_KEY[_DNAV_SETTINGS_ROW+1]}"
  local ridx="${_DNAV_ABOUT_IDX[_DNAV_SETTINGS_ROW+1]}"
  local val label dest k
  case $kind in
    toggle)
      case $rkey in
        ls_after)
          DNAV_CFG_LS=$(( 1 - DNAV_CFG_LS ))
          _dnav_config_set ls_after "$DNAV_CFG_LS"
          ;;
        success_bar)
          DNAV_CFG_SUCCESS_BAR=$(( 1 - DNAV_CFG_SUCCESS_BAR ))
          _dnav_config_set success_bar "$DNAV_CFG_SUCCESS_BAR"
          ;;
        show_hidden)
          DNAV_CFG_SHOW_HIDDEN=$(( 1 - DNAV_CFG_SHOW_HIDDEN ))
          _dnav_config_set show_hidden "$DNAV_CFG_SHOW_HIDDEN"
          ;;
        success_anim)
          DNAV_CFG_SUCCESS_ANIM=$(( 1 - DNAV_CFG_SUCCESS_ANIM ))
          _dnav_config_set success_anim "$DNAV_CFG_SUCCESS_ANIM"
          ;;
        full_redraw)
          DNAV_CFG_FULL_REDRAW=$(( 1 - DNAV_CFG_FULL_REDRAW ))
          _dnav_config_set full_redraw "$DNAV_CFG_FULL_REDRAW"
          ;;
        inaccessible_icon)
          DNAV_CFG_INACC_ICON=$(( 1 - DNAV_CFG_INACC_ICON ))
          _dnav_config_set inaccessible_icon "$DNAV_CFG_INACC_ICON"
          ;;
      esac
      ;;
    cycle3)
      case $rkey in
        ls_after_dnav)
          case $DNAV_CFG_LS_DNAV in
            -1) DNAV_CFG_LS_DNAV=1 ;;
            1)  DNAV_CFG_LS_DNAV=0 ;;
            *)  DNAV_CFG_LS_DNAV=-1 ;;
          esac
          _dnav_config_set ls_after_dnav "$(_dnav_cfg_cycle3_store "$DNAV_CFG_LS_DNAV")"
          ;;
        ls_after_djump)
          case $DNAV_CFG_LS_DJUMP in
            -1) DNAV_CFG_LS_DJUMP=1 ;;
            1)  DNAV_CFG_LS_DJUMP=0 ;;
            *)  DNAV_CFG_LS_DJUMP=-1 ;;
          esac
          _dnav_config_set ls_after_djump "$(_dnav_cfg_cycle3_store "$DNAV_CFG_LS_DJUMP")"
          ;;
        success_bar_dnav)
          case $DNAV_CFG_SUCCESS_BAR_DNAV in
            -1) DNAV_CFG_SUCCESS_BAR_DNAV=1 ;;
            1)  DNAV_CFG_SUCCESS_BAR_DNAV=0 ;;
            *)  DNAV_CFG_SUCCESS_BAR_DNAV=-1 ;;
          esac
          _dnav_config_set success_bar_dnav "$(_dnav_cfg_cycle3_store "$DNAV_CFG_SUCCESS_BAR_DNAV")"
          ;;
        success_bar_djump)
          case $DNAV_CFG_SUCCESS_BAR_DJUMP in
            -1) DNAV_CFG_SUCCESS_BAR_DJUMP=1 ;;
            1)  DNAV_CFG_SUCCESS_BAR_DJUMP=0 ;;
            *)  DNAV_CFG_SUCCESS_BAR_DJUMP=-1 ;;
          esac
          _dnav_config_set success_bar_djump "$(_dnav_cfg_cycle3_store "$DNAV_CFG_SUCCESS_BAR_DJUMP")"
          ;;
      esac
      ;;
    cycle_dirs)
      case $DNAV_CFG_DFILE_SORT_DIRS in
        alpha) DNAV_CFG_DFILE_SORT_DIRS=hidden_first ;;
        *)     DNAV_CFG_DFILE_SORT_DIRS=alpha ;;
      esac
      _dnav_config_set dfile_sort_dirs "$DNAV_CFG_DFILE_SORT_DIRS"
      ;;
    cycle_files)
      case $DNAV_CFG_DFILE_SORT_FILES in
        alpha)     DNAV_CFG_DFILE_SORT_FILES=ext ;;
        ext)       DNAV_CFG_DFILE_SORT_FILES=dot_first ;;
        dot_first) DNAV_CFG_DFILE_SORT_FILES=dot_ext ;;
        *)         DNAV_CFG_DFILE_SORT_FILES=alpha ;;
      esac
      _dnav_config_set dfile_sort_files "$DNAV_CFG_DFILE_SORT_FILES"
      ;;
    value)
      case $rkey in
        color_fg) _dnav_inline_edit "color_fg (Esc cancel): " "$DNAV_CFG_COLOR_FG" || return 1 ;;
        color_bg) _dnav_inline_edit "color_bg (Esc cancel): " "$DNAV_CFG_COLOR_BG" || return 1 ;;
        brand)    _dnav_inline_edit "brand (Esc cancel): " "$DNAV_CFG_BRAND" || return 1 ;;
        dfile_jump_name_max) _dnav_inline_edit "dfile_jump_name_max (Esc cancel): " "$DNAV_CFG_DFILE_JUMP_NAME_MAX" || return 1 ;;
        status_timeout_ms) _dnav_inline_edit "status_timeout_ms (Esc cancel): " "$DNAV_CFG_STATUS_TIMEOUT_MS" || return 1 ;;
        inaccessible_color) _dnav_inline_edit "inaccessible_color (Esc cancel): " "$DNAV_CFG_INACC_COLOR" || return 1 ;;
        *) return 1 ;;
      esac
      val="${REPLY//[$'\r\n']/}"
      [[ -z $val ]] && return 1
      case $rkey in
        color_fg)
          _dnav_config_set color_fg "$val"
          DNAV_CFG_COLOR_FG="$(_dnav_color_num fg "$val")"
          _dnav_apply_colors
          _dnav_about_refresh_style
          ;;
        color_bg)
          _dnav_config_set color_bg "$val"
          DNAV_CFG_COLOR_BG="$(_dnav_color_num bg "$val")"
          _dnav_apply_colors
          _dnav_about_refresh_style
          ;;
        brand)
          _dnav_config_set brand "$val"
          DNAV_CFG_BRAND="$val"
          _DNAV_BRAND="$val"
          ;;
        dfile_jump_name_max)
          [[ $val == <-> ]] && (( val >= 1 )) || return 1
          _dnav_config_set dfile_jump_name_max "$val"
          DNAV_CFG_DFILE_JUMP_NAME_MAX=$val
          ;;
        status_timeout_ms)
          [[ $val == <-> ]] || return 1
          _dnav_config_set status_timeout_ms "$val"
          DNAV_CFG_STATUS_TIMEOUT_MS=$val
          ;;
        inaccessible_color)
          _dnav_config_set inaccessible_color "$val"
          DNAV_CFG_INACC_COLOR="$(_dnav_color_num fg "$val")"
          ;;
      esac
      ;;
    folder)
      (( ridx > 0 )) || return 1
      _dnav_inline_edit "label (Esc cancel): " "${DNAV_FOLDER_NAMES[ridx]}" || return 1
      label="${REPLY//[$'\r\n']/}"
      [[ -z $label ]] && return 1
      _dnav_inline_edit "path (Esc cancel): " "${DNAV_FOLDER_PATHS[ridx]}" || return 1
      val="${REPLY//[$'\r\n']/}"
      [[ -z $val ]] && return 1
      DNAV_FOLDER_NAMES[ridx]="$label"
      DNAV_FOLDER_PATHS[ridx]="$(_dnav_expand_path "$val")"
      _dnav_folders_save
      ;;
    folder_add)
      _dnav_inline_edit "new label (Esc cancel): " "" || return 1
      label="${REPLY//[$'\r\n']/}"
      [[ -z $label ]] && return 1
      _dnav_inline_edit "path for $label (Esc cancel): " "~" || return 1
      dest="${REPLY//[$'\r\n']/}"
      [[ -z $dest ]] && return 1
      DNAV_FOLDER_NAMES+=("$label")
      DNAV_FOLDER_PATHS+=("$(_dnav_expand_path "$dest")")
      _dnav_folders_save
      ;;
    jump)
      [[ -n $rkey ]] || return 1
      _dnav_inline_edit "path d$rkey (Esc cancel): " "${_DJUMP_MAP[$rkey]}" || return 1
      val="${REPLY//[$'\r\n']/}"
      [[ -z $val ]] && return 1
      (( $+functions[_djump_edit] )) || return 1
      _djump_edit "$rkey" "$val" || return 1
      ;;
    jump_add)
      _dnav_inline_edit "jump key e.g. home (Esc cancel): " "" || return 1
      k="${REPLY//[$'\r\n']/}"
      [[ -z $k ]] && return 1
      _dnav_inline_edit "path for d$k (Esc cancel): " "~" || return 1
      dest="${REPLY//[$'\r\n']/}"
      [[ -z $dest ]] && return 1
      (( $+functions[_djump_add] )) || return 1
      _djump_add "$k" "$dest" || return 1
      ;;
  esac
  return 0
}

# Delete _DNAV_SEL folder/jump row (x key).
_dnav_settings_delete_row() {
  local kind="${_DNAV_ABOUT_KIND[_DNAV_SETTINGS_ROW+1]}"
  local rkey="${_DNAV_ABOUT_KEY[_DNAV_SETTINGS_ROW+1]}"
  local ridx="${_DNAV_ABOUT_IDX[_DNAV_SETTINGS_ROW+1]}"
  local -a nkeys
  local i k
  case $kind in
    folder)
      (( ridx > 0 )) || return
      local -a nn np
      nn=() np=()
      for (( i=1; i <= $#DNAV_FOLDER_NAMES; i++ )); do
        (( i == ridx )) && continue
        nn+=("${DNAV_FOLDER_NAMES[i]}")
        np+=("${DNAV_FOLDER_PATHS[i]}")
      done
      DNAV_FOLDER_NAMES=("${nn[@]}")
      DNAV_FOLDER_PATHS=("${np[@]}")
      _dnav_folders_save
      (( _DNAV_SETTINGS_ROW > 0 )) && (( _DNAV_SETTINGS_ROW-- ))
      ;;
    jump)
      [[ -n $rkey ]] || return
      if (( $+functions[_djump_remove] )); then
        _djump_remove "$rkey" || return
      else
        unset "_DJUMP_MAP[$rkey]"
        nkeys=()
        for k in "${_DJUMP_KEYS[@]}"; do
          [[ $k == "$rkey" ]] && continue
          nkeys+=("$k")
        done
        _DJUMP_KEYS=("${nkeys[@]}")
        _dnav_jumps_save
      fi
      (( _DNAV_SETTINGS_ROW > 0 )) && (( _DNAV_SETTINGS_ROW-- ))
      ;;
    *) return ;;
  esac
}

_dnav_about_body_max() {
  local lim=$(( ${LINES:-24} - 5 ))
  (( lim < 4 )) && lim=4
  (( lim > 20 )) && lim=20
  print -rn -- $lim
}

_dnav_draw_about() {
  local -a blines raw
  local line n=0 i leftover old_extra=$_DNAV_HELP_EXTRA
  local maxw=$_DNAV_COLS topic body_max style
  local -a display
  _DNAV_MODE=about
  _DNAV_COLS="$(_dnav_usable_cols)"
  maxw=$_DNAV_COLS
  body_max="$(_dnav_about_body_max)"
  (( maxw < 20 )) && maxw=20
  printf "\e[?25l\r"

  # Row 0: [ DNav About:] [ Help ] Settings   Tab to switch
  printf "${DNAV_HIGHLIGHT} DNav About:${DNAV_RESET} "
  if [[ $_DNAV_ABOUT_TAB == help ]]; then
    printf "${DNAV_HIGHLIGHT} Help ${DNAV_RESET} "
    printf " Settings  "
  else
    printf " Help  "
    printf "${DNAV_HIGHLIGHT} Settings ${DNAV_RESET} "
  fi
  printf "\e[2mTab to switch\e[22m\e[K"

  # Row 1: section strip
  printf "\n\r"
  if [[ $_DNAV_ABOUT_TAB == help ]]; then
    _dnav_about_paint_strip _DNAV_HELP_TOPICS $_DNAV_HELP_SEL $_DNAV_HELP_WIN $maxw
    _DNAV_HELP_WIN=$reply[1]
  else
    _dnav_about_paint_strip _DNAV_SETTINGS_TABS $_DNAV_SETTINGS_SEL $_DNAV_SETTINGS_WIN $maxw
    _DNAV_SETTINGS_WIN=$reply[1]
  fi

  # Build wrapped display rows (each row ≤ maxw, so layout stays stable)
  display=()
  if [[ $_DNAV_ABOUT_TAB == help ]]; then
    topic="${_DNAV_HELP_TOPICS[_DNAV_HELP_SEL+1]}"
    raw=("${(@f)$(_dnav_help_topic_body "$topic")}")
    blines=("${(@f)$(_dnav_wrap_lines $(( maxw - 2 )) "${raw[@]}")}")
    for line in "${blines[@]}"; do
      display+=(" $line")
    done
    # scroll window for long help
    (( _DNAV_HELP_SCROLL < 0 )) && _DNAV_HELP_SCROLL=0
    if (( $#display > body_max )); then
      (( _DNAV_HELP_SCROLL > $#display - body_max )) && _DNAV_HELP_SCROLL=$(( $#display - body_max ))
      display=("${display[$(( _DNAV_HELP_SCROLL + 1 )),$(( _DNAV_HELP_SCROLL + body_max ))]}")
    else
      _DNAV_HELP_SCROLL=0
    fi
    for line in "${display[@]}"; do
      printf "\n\r"
      _dnav_paint_row dim "$line" $maxw
      (( n++ ))
    done
  else
    _dnav_settings_fill_body
    raw=("${_DNAV_ABOUT_BODY[@]}")
    # Settings: keep 1 logical row = 1 interactive row (truncate, don't multi-wrap)
    for (( i=1; i <= $#raw; i++ )); do
      line=" ${raw[i]}"
      if (( ${#line} > maxw )); then
        line="${line[1,maxw-1]}…"
      fi
      display+=("$line")
    done
    for (( i=1; i <= $#display; i++ )); do
      printf "\n\r"
      if (( (i - 1) == _DNAV_SETTINGS_ROW )); then
        _dnav_paint_row hl "${display[i]}" $maxw
      else
        _dnav_paint_row dim "${display[i]}" $maxw
      fi
      (( n++ ))
    done
  fi

  leftover=$(( old_extra - 1 - n ))
  if (( !_DNAV_RESIZING )); then
    for (( i=0; i < leftover; i++ )); do
      printf "\n\r\e[2K"
    done
    if (( leftover > 0 )); then
      printf "\e[%dA" $leftover
    fi
  fi

  _DNAV_HELP_EXTRA=$(( 1 + n ))
  printf "\e[J"
  if (( _DNAV_HELP_EXTRA > 0 )); then
    printf "\e[%dA" $_DNAV_HELP_EXTRA
  fi
  printf "\r"
}

_dnav_show_about() {
  _dnav_about_init
  _DNAV_HELP_EXTRA=0
  _dnav_draw_about
}

_dnav_about_move_h() {
  local dir="$1"
  if [[ $_DNAV_ABOUT_TAB == help ]]; then
    local n=$#_DNAV_HELP_TOPICS
    (( n == 0 )) && return
    (( _DNAV_HELP_SEL += dir ))
    (( _DNAV_HELP_SEL < 0 )) && _DNAV_HELP_SEL=0
    (( _DNAV_HELP_SEL >= n )) && _DNAV_HELP_SEL=$(( n - 1 ))
    _DNAV_HELP_SCROLL=0
  else
    local n=$#_DNAV_SETTINGS_TABS
    (( n == 0 )) && return
    (( _DNAV_SETTINGS_SEL += dir ))
    (( _DNAV_SETTINGS_SEL < 0 )) && _DNAV_SETTINGS_SEL=0
    (( _DNAV_SETTINGS_SEL >= n )) && _DNAV_SETTINGS_SEL=$(( n - 1 ))
    _DNAV_SETTINGS_ROW=0
  fi
  _dnav_draw_about
}

_dnav_about_move_v() {
  local dir="$1" maxr=0
  if [[ $_DNAV_ABOUT_TAB == help ]]; then
    # Scroll long wrapped help body
    (( _DNAV_HELP_SCROLL += dir ))
    (( _DNAV_HELP_SCROLL < 0 )) && _DNAV_HELP_SCROLL=0
    _dnav_draw_about
    return
  fi
  [[ $_DNAV_ABOUT_TAB == settings ]] || return
  (( _DNAV_ABOUT_NROWS <= 0 )) && _dnav_settings_fill_body
  maxr=$(( _DNAV_ABOUT_NROWS > 0 ? _DNAV_ABOUT_NROWS - 1 : 0 ))
  (( _DNAV_SETTINGS_ROW += dir ))
  (( _DNAV_SETTINGS_ROW < 0 )) && _DNAV_SETTINGS_ROW=0
  (( _DNAV_SETTINGS_ROW > maxr )) && _DNAV_SETTINGS_ROW=$maxr
  _dnav_draw_about
}

# Rebuild main bar arrays from config folders + hardcoded About.
_dnav_reload_main_bar() {
  if (( ${#DNAV_FOLDER_NAMES} > 0 )); then
    _DNAV_NAMES=("${DNAV_FOLDER_NAMES[@]}")
    _DNAV_PATHS=("${DNAV_FOLDER_PATHS[@]}")
  else
    _DNAV_NAMES=()
    _DNAV_PATHS=()
  fi
  _DNAV_NAMES+=(About)
  _DNAV_PATHS+=("")
  (( _DNAV_SEL >= $#_DNAV_NAMES )) && _DNAV_SEL=$(( $#_DNAV_NAMES - 1 ))
  (( _DNAV_SEL < 0 )) && _DNAV_SEL=0
  _DNAV_BAR_WIN=0
  _dnav_ensure_bar_visible
  _dnav_compute_positions
}

_dnav_leave_about() {
  local i
  _DNAV_MODE=main
  printf "\r\e[2K"
  for (( i=0; i < _DNAV_HELP_EXTRA; i++ )); do
    printf "\n\e[2K"
  done
  if (( _DNAV_HELP_EXTRA > 0 )); then
    printf "\e[%dA" $_DNAV_HELP_EXTRA
  fi
  _DNAV_HELP_EXTRA=0
  printf "\r"
  _dnav_about_refresh_style
  _dnav_reload_main_bar
  _dnav_draw
}

# Expand from _DNAV_SEL chip, then full-width path bar (shared _dnav_success_bar).
_dnav_success_from_sel() {
  local sel_path="$1"
  local origin_start=${_DNAV_ITEM_START[_DNAV_SEL+1]:-0}
  local origin_end=${_DNAV_ITEM_END[_DNAV_SEL+1]:-$_DNAV_COLS}
  local origin_mid=$(( (origin_start + origin_end) / 2 ))
  _dnav_success_bar "$sel_path" "$origin_mid" dnav
}

dnav() {
  local key target entry=main entry_arg=""
  case ${1:-} in
    -u|--update)
      shift
      _dnav_update "$@"
      return $?
      ;;
    -h|--help)
      print -r -- "usage: dnav [--update | f [PATH] | s [QUERY]]"
      print -r -- "  (no args)         open the folder navigator"
      print -r -- "  f, file [PATH]    open the file explorer (default: \$PWD)"
      print -r -- "  s, search [QUERY] open fuzzy search"
      print -r -- "  -u, --update      copy scripts from the DNav repo + merge new config keys"
      print -r -- "  -h, --help        this help"
      print -r -- "  dconfig           reload/edit config (~/.config/dnav)"
      print -r -- "  dhelp             list jump aliases (same as djump -l)"
      print -r -- "  djump             list jumps; djump KEY to go; add|edit|remove to manage"
      print -r -- "  djump -r          reload jumps file + dKEY commands"
      return 0
      ;;
    f|file)
      shift
      entry=file
      entry_arg="${1:-}"
      ;;
    s|search)
      shift
      entry=search
      entry_arg="$*"
      ;;
    '')
      ;;
    *)
      print -u2 -- "dnav: unknown option: $1 (try dnav -h)"
      return 1
      ;;
  esac

  _dnav_session_reset

  # Save terminal settings (globals: EXIT trap may run after function locals die).
  # LOCAL_TRAPS is required: without it, INT/TERM/QUIT traps leak into the
  # interactive shell after dnav returns.
  _DNAV_STTY_ORIG=$(stty -g 2>/dev/null)
  _DNAV_CLEANED=0
  setopt localoptions localtraps
  trap '_dnav_cleanup' EXIT
  trap '_dnav_abort; return 130' INT TERM QUIT
  trap '_DNAV_WINCH=1' WINCH

  stty -echo -icanon isig 2>/dev/null
  printf "\e[?25l"
  _dnav_autowrap_off

  _dnav_load_module dsearch
  (( $+functions[_dsearch_index_start_bg] )) && _dsearch_index_start_bg

  _dnav_sync_term_size
  _dnav_mark_size

  if [[ $entry == file ]]; then
    if ! _dfile_available; then
      _dnav_cleanup
      print -u2 -- "dnav: file explorer is not available"
      return 1
    fi
    if ! _dnav_resolve_dir "$entry_arg"; then
      _dnav_status_set error "Invalid Path"
    fi
    if _dfile_enter "$REPLY"; then
      return 0
    fi
    _dnav_aborted && return 130
    _dnav_cleanup
    return 0
  fi

  if [[ $entry == search ]]; then
    if ! _dsearch_available; then
      _dnav_cleanup
      print -u2 -- "dnav: search is not available"
      return 1
    fi
    if _dsearch_start "$entry_arg"; then
      return 0
    fi
    _dnav_aborted && return 130
    _dnav_cleanup
    return 0
  fi

  _dnav_compute_positions
  _dnav_draw

  while true; do
    _dnav_aborted && return 130
    if (( $+functions[_dnav_read_token] )); then
      _dnav_read_token || true
      key="$REPLY"
    else
      read -k 1 key || true
    fi
    _dnav_aborted && return 130
    case $key in
      ctrl-c|$'\x03')
        _dnav_abort
        return 130
        ;;
      left)
        if [[ $_DNAV_MODE == about ]]; then
          _dnav_about_move_h -1
        elif [[ $_DNAV_MODE == main ]]; then
          _dnav_move_left
        fi
        ;;
      right)
        if [[ $_DNAV_MODE == about ]]; then
          _dnav_about_move_h 1
        elif [[ $_DNAV_MODE == main ]]; then
          _dnav_move_right
        fi
        ;;
      up)
        [[ $_DNAV_MODE == about ]] && _dnav_about_move_v -1
        ;;
      down)
        [[ $_DNAV_MODE == about ]] && _dnav_about_move_v 1
        ;;
      delete|backspace|x|X)
        if [[ $_DNAV_MODE == about && $_DNAV_ABOUT_TAB == settings ]]; then
          (( _DNAV_ABOUT_NROWS <= 0 )) && _dnav_settings_fill_body
          _dnav_settings_delete_row
          _dnav_draw_about
        fi
        ;;
      esc)
        if [[ $_DNAV_MODE == about ]]; then
          _dnav_leave_about
        else
          _dnav_clear_menu
          _dnav_cleanup
          return 0
        fi
        ;;
      enter)
        if [[ $_DNAV_MODE == about ]]; then
          if [[ $_DNAV_ABOUT_TAB == settings ]]; then
            (( _DNAV_ABOUT_NROWS <= 0 )) && _dnav_settings_fill_body
            _dnav_settings_apply_edit || true
            _dnav_draw_about
          fi
          continue
        fi
        if [[ -z ${_DNAV_PATHS[_DNAV_SEL+1]} || ${_DNAV_NAMES[_DNAV_SEL+1]} == About ]]; then
          _dnav_show_about
          continue
        fi
        target="${_DNAV_PATHS[_DNAV_SEL+1]}"
        if [[ -d $target ]]; then
          cd -- "$target" || {
            _dnav_clear_menu
            printf "Could not change to %s\n" "${_DNAV_NAMES[_DNAV_SEL+1]}"
            _dnav_cleanup
            return 1
          }
          _dnav_success_from_sel "$(_dnav_logical_path "$target")"
          _dnav_cleanup
          _dnav_maybe_ls dnav
          return 0
        else
          _dnav_clear_menu
          printf "Folder not found: %s\n" "$target"
          _dnav_cleanup
          return 1
        fi
        ;;
      tab)
        if [[ $_DNAV_MODE == about ]]; then
          if [[ $_DNAV_ABOUT_TAB == help ]]; then
            _DNAV_ABOUT_TAB=settings
          else
            _DNAV_ABOUT_TAB=help
          fi
          _dnav_draw_about
        fi
        ;;
      h)
        if [[ $_DNAV_MODE == about ]]; then
          _dnav_about_move_h -1
        elif [[ $_DNAV_MODE == main ]]; then
          _dnav_move_left
        fi
        ;;
      l)
        if [[ $_DNAV_MODE == about ]]; then
          _dnav_about_move_h 1
        elif [[ $_DNAV_MODE == main ]]; then
          _dnav_move_right
        fi
        ;;
      k)
        [[ $_DNAV_MODE == about ]] && _dnav_about_move_v -1
        ;;
      j)
        [[ $_DNAV_MODE == about ]] && _dnav_about_move_v 1
        ;;
      e|E)
        if [[ $_DNAV_MODE == about && $_DNAV_ABOUT_TAB == settings ]]; then
          case ${_DNAV_SETTINGS_TABS[_DNAV_SETTINGS_SEL+1]} in
            General) _dnav_about_edit_file "${DNAV_CONFIG_DIR}/config" ;;
            Folders) _dnav_about_edit_file "${DNAV_CONFIG_DIR}/folders" ;;
            Jumps)   _dnav_about_edit_file "${DNAV_CONFIG_DIR}/jumps" ;;
          esac
        fi
        ;;
      /|s|S)
        [[ $_DNAV_MODE == about ]] && continue
        if [[ $_DNAV_MODE == main ]] && _dsearch_available; then
          if _dsearch_start; then
            return 0
          fi
          _dnav_aborted && return 130
          _DNAV_MODE=main
          _dnav_draw
        fi
        ;;
      f|F)
        [[ $_DNAV_MODE == about ]] && continue
        if [[ $_DNAV_MODE == main ]] && _dfile_available; then
          _dnav_clear_menu
          if _dfile_enter "$PWD"; then
            return 0
          fi
          _dnav_aborted && return 130
          _DNAV_MODE=main
          _dnav_draw
        fi
        ;;
    esac
  done
}


# When sourced the function is available; when run directly it executes
if [[ "${ZSH_EVAL_CONTEXT:-}" != *:file ]]; then
  dnav "$@"
fi
