# $1 = error|info|ok  $2 = text
_dnav_status_set() {
  local kind="${1:-info}" text="${2:-}"
  local ms
  case $kind in
    error|info|ok) ;;
    *) kind=info ;;
  esac
  _DNAV_STATUS_KIND=$kind
  _DNAV_STATUS_TEXT=$text
  ms=${DNAV_CFG_STATUS_TIMEOUT_MS:-3000}
  [[ $ms == <-> ]] || ms=3000
  if (( ms <= 0 )); then
    _DNAV_STATUS_LEFT=-1
  else
    _DNAV_STATUS_LEFT=$ms
  fi
}

# Called from the 40ms read poll. Returns 0 if the message just expired.
_dnav_status_tick() {
  (( _DNAV_STATUS_LEFT > 0 )) || return 1
  (( _DNAV_STATUS_LEFT -= 40 ))
  if (( _DNAV_STATUS_LEFT <= 0 )); then
    _dnav_status_clear
    return 0
  fi
  return 1
}

_dnav_status_style() {
  case ${_DNAV_STATUS_KIND:-info} in
    error) print -rn -- $'\e[31m' ;;
    ok)    print -rn -- $'\e[32m' ;;
    *)     print -rn -- $'\e[2m' ;;
  esac
}

# Paint the status text on the right of the current row. $1 = line width,
# $2 = columns already taken by left decorations (never shrink those).
_dnav_status_paint_right() {
  emulate -L zsh
  setopt localoptions multibyte
  local w="$1" left_w="${2:-0}"
  local msg mw room col
  [[ -n ${_DNAV_STATUS_TEXT:-} ]] || return 0
  [[ $w == <-> ]] || return 0
  msg=" ${_DNAV_STATUS_TEXT} "
  mw="$(_dnav_disp_w "$msg")"
  room=$(( w - left_w ))
  (( room < 1 )) && return 0
  if (( mw > room )); then
    msg="$(_dnav_fit_end "$msg" $room)"
    mw="$(_dnav_disp_w "$msg")"
  fi
  col=$(( w - mw + 1 ))
  (( col < left_w + 1 )) && col=$(( left_w + 1 ))
  printf "\e[%dG%s%s%s" $col "$(_dnav_status_style)" "$msg" $'\e[0m'
}

_dnav_status_repaint() {
