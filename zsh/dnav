  if (( ${+_DSEARCH_OPEN} && _DSEARCH_OPEN )); then
    print -r -- " DNav Search:"
  elif (( $+functions[_dfile_is_open] )) && _dfile_is_open; then
    print -r -- " DNav Files:"
  elif [[ ${_DNAV_MODE:-} == about ]]; then
    print -r -- " DNav About:"
  else
    print -r -- " ${DNAV_CFG_BRAND:-DNav} "
  fi
}

# Rows currently painted below the top TUI line (search 0–10, dfile 3, …).
_dnav_tui_below() {
  if (( ${+_DSEARCH_OPEN} && _DSEARCH_OPEN )); then
    print -rn -- "${_dsearch_extra_lines:-0}"
  elif (( $+functions[_dfile_is_open] )) && _dfile_is_open; then
    print -rn -- "${_DFILE_BODY:-3}"
  elif [[ ${_DNAV_MODE:-} == about ]]; then
    print -rn -- "${_DNAV_HELP_EXTRA:-0}"
  else
    print -rn -- 0
  fi
}

_dnav_wipe_below() {
  local n="${1:-0}" i
  [[ $n == <-> ]] || n=0
  (( n > 0 )) || return 0
  for (( i=0; i < n; i++ )); do
    printf "\n\r\e[2K"
  done
  printf "\e[%dA" $n
}

_dnav_paint_resize_chip() {
  local hl rst label below
  hl="${DNAV_HIGHLIGHT:-\e[30;46m}"
  rst="${DNAV_RESET:-\e[0m}"
  label="$(_dnav_resize_chip_label)"
  below="$(_dnav_tui_below)"
  printf "\e[?25l\r${hl}%s${rst}\e[K" "$label"
  _dnav_wipe_below "$below"
  printf "\r"
}

_dnav_mark_size() {
  _DNAV_LAST_COLS=${COLUMNS:-0}
  _DNAV_LAST_LINES=${LINES:-0}
}

_dnav_resize_finish() {
  _DNAV_RESIZE_MODE=0
  _DNAV_STEADY=0
  _DNAV_PEND_COLS=0
  _DNAV_PEND_LINES=0
  _DNAV_WINCH=0
  _dnav_handle_winch
  _dnav_mark_size
}

# Call from the TUI read loop. Compact chip while WINCH fires or stty is
# still changing. Full redraw only after STEADY_NEED identical samples.
_dnav_maybe_resize() {
  local c l
  (( ${DNAV_ABORT:-0} )) && return 1
  (( _DNAV_INLINE_EDIT )) && return 1
  # Idle polls read the cache. stty only on WINCH, first sample, or resize mode.
  if (( _DNAV_RESIZE_MODE || _DNAV_WINCH || _DNAV_LAST_COLS == 0 )); then
    _dnav_sync_term_size
  fi
  c=${COLUMNS:-0}
  l=${LINES:-0}
  if (( _DNAV_LAST_COLS == 0 )); then
    _dnav_mark_size
    return 1
  fi

  if (( _DNAV_WINCH || c != _DNAV_LAST_COLS || l != _DNAV_LAST_LINES )); then
    if (( _DNAV_WINCH || c != _DNAV_PEND_COLS || l != _DNAV_PEND_LINES || ! _DNAV_RESIZE_MODE )); then
      _DNAV_PEND_COLS=$c
      _DNAV_PEND_LINES=$l
      _DNAV_STEADY=0
      _DNAV_WINCH=0
      _DNAV_RESIZE_MODE=1
      _dnav_paint_resize_chip
      return 1
    fi
    # Same stty size as last sample, no new WINCH — still counting.
    (( _DNAV_STEADY++ ))
    if (( _DNAV_STEADY < _DNAV_STEADY_NEED )); then
      return 1
    fi
    _dnav_resize_finish
    return 0
  fi

  # stty matches the pre-resize size. Stay compact until WINCH/stty settle.
  if (( _DNAV_RESIZE_MODE )); then
    (( _DNAV_STEADY++ ))
    if (( _DNAV_STEADY < _DNAV_STEADY_NEED )); then
      return 1
    fi
    _dnav_resize_finish
    return 0
  fi

  _DNAV_WINCH=0
  return 1
}

# Blocking key read that still notices terminal resizes (WINCH often
# does not interrupt a bare read -k). Poll ~25×/sec so resize mode starts
# before the bar can reflow.
_dnav_read_key() {
  REPLY=""
  while true; do
    (( ${DNAV_ABORT:-0} )) && return 1
    if (( _DNAV_WINCH )); then
      (( $+functions[_dnav_maybe_resize] )) && _dnav_maybe_resize
    fi
    if read -t 0.04 -k 1 REPLY 2>/dev/null; then
      (( $+functions[_dnav_maybe_resize] )) && _dnav_maybe_resize
      [[ -n $REPLY ]] && return 0
    else
      (( $+functions[_dnav_maybe_resize] )) && _dnav_maybe_resize
      if _dnav_status_tick; then
        _dnav_status_repaint
      fi
    fi
  done
}

# One key token: esc/up/down/left/right/home/end/delete/enter/tab/backspace/
# ctrl-c/ctrl-a/ctrl-e/ctrl-n/ctrl-p/ctrl-u, or a single printable char.
_dnav_read_token() {
  local k k2 k3 k4
  REPLY=""
  while true; do
    (( ${DNAV_ABORT:-0} )) && return 1
    if (( $+functions[_dnav_read_key] )); then
      _dnav_read_key || return 1
      k="$REPLY"
    else
      read -k 1 k || return 1
    fi
    (( ${DNAV_ABORT:-0} )) && return 1
    [[ -n $k ]] || continue
    case $k in
      $'\x03') REPLY=ctrl-c; return 0 ;;
      $'\n'|$'\r') REPLY=enter; return 0 ;;
      $'\t') REPLY=tab; return 0 ;;
      $'\177'|$'\b') REPLY=backspace; return 0 ;;
      $'\x01') REPLY=ctrl-a; return 0 ;;
      $'\x05') REPLY=ctrl-e; return 0 ;;
      $'\x0e') REPLY=ctrl-n; return 0 ;;
      $'\x10') REPLY=ctrl-p; return 0 ;;
      $'\x15') REPLY=ctrl-u; return 0 ;;
      $'\e')
        if read -t 0.05 -k 1 k2 2>/dev/null; then
          if [[ $k2 == '[' ]]; then
            read -k 1 k3 2>/dev/null || k3=""
            case $k3 in
              A) REPLY=up; return 0 ;;
              B) REPLY=down; return 0 ;;
              C) REPLY=right; return 0 ;;
              D) REPLY=left; return 0 ;;
              H) REPLY=home; return 0 ;;
              F) REPLY=end; return 0 ;;
              3)
                read -t 0.05 -k 1 k4 2>/dev/null || true
                REPLY=delete
                return 0
                ;;
              1|4|7|8)
                read -t 0.05 -k 1 k4 2>/dev/null || true
                if [[ $k3 == 1 || $k3 == 7 ]]; then
                  REPLY=home
                else
                  REPLY=end
                fi
                return 0
                ;;
              *) REPLY=esc; return 0 ;;
            esac
          fi
          REPLY=esc
          return 0
        fi
        if (( $+functions[_dnav_maybe_resize] )) && _dnav_maybe_resize; then
          continue
        fi
        REPLY=esc
        return 0
        ;;
      *) REPLY="$k"; return 0 ;;
    esac
  done
}

# Redraw in place. Autowrap is off so shrink clips on the right; do not CUU
# (that is what walked the bar up the screen).
_dnav_handle_winch() {
  (( _DNAV_RESIZING )) && return 0
  (( ${DNAV_ABORT:-0} )) && return 0
  _DNAV_RESIZING=1
  _dnav_sync_term_size
  _DNAV_COLS="$(_dnav_usable_cols)"
  if (( _DNAV_INLINE_EDIT )); then
    _DNAV_RESIZING=0
    return 0
  fi
  printf "\e[?25l\r\e[2K\e[J"
  if (( ${+_DSEARCH_OPEN} && _DSEARCH_OPEN )); then
    (( $+functions[_dsearch_draw] )) && _dsearch_draw "${_dsearch_q:-}"
  elif (( $+functions[_dfile_is_open] )) && _dfile_is_open; then
    (( $+functions[_dfile_draw] )) && _dfile_draw
  elif [[ ${_DNAV_MODE:-} == about ]]; then
    (( $+functions[_dnav_draw_about] )) && _dnav_draw_about
  elif (( $+functions[_dnav_draw] )); then
    (( $+functions[_dnav_compute_positions] )) && _dnav_compute_positions
    _dnav_draw
  fi
  _DNAV_RESIZING=0
}

# Fit string to display width, keep the start (chips, About rows).
_dnav_fit_start() {
  emulate -L zsh
  setopt localoptions multibyte
  local s="$1" w="$2" acc="" ch
  integer i
  (( w < 1 )) && { print -rn -- ""; return }
  if (( ${(m)#s} <= w )); then
    print -r -- "$s"
    return
  fi
  if (( w == 1 )); then
    print -r -- "…"
    return
  fi
  for (( i=1; i <= ${#s}; i++ )); do
    ch="${s[i]}"
    if (( ${(m)#acc} + ${(m)#ch} + 1 > w )); then
      break
    fi
    acc+="$ch"
  done
  print -r -- "${acc}…"
}

# Fit string to display width, keep the end (most specific path tail).
_dnav_fit_end() {
  emulate -L zsh
  setopt localoptions multibyte
  local s="$1" w="$2" rest
  (( w < 1 )) && { print -rn -- ""; return }
  if (( ${(m)#s} <= w )); then
    print -r -- "$s"
    return
  fi
  if (( w == 1 )); then
    print -r -- "…"
    return
  fi
  rest="$s"
  while (( ${(m)#rest} > w - 1 && ${#rest} > 0 )); do
    rest="${rest[2,-1]}"
  done
  print -r -- "…${rest}"
}

# Set a key=value in ~/.config/dnav/config (preserves other lines / comments).
# Creates the file if needed. Always writes through a temp file + mv.
_dnav_config_set() {
  emulate -L zsh
  setopt localoptions no_multios clobber
  local key="$1" val="$2"
  local dir="${DNAV_CONFIG_DIR:-$(_dnav_config_dir)}"
  local f="$dir/config"
  local tmp line k found=0 stripped
  local key_l="${(L)key}"
  [[ -n $key ]] || return 1
  /bin/mkdir -p -- "$dir" || return 1
  [[ -f $f ]] || print -r -- "# DNav settings" > "$f" || return 1
  tmp="${f}.tmp.$$"
  {
    while IFS= read -r line || [[ -n $line ]]; do
      stripped="${line#"${line%%[![:space:]]*}"}"
      if [[ -z $stripped || $stripped == \#* ]]; then
        print -r -- "$line"
        continue
      fi
      if [[ $line == *=* ]]; then
        k="${line%%=*}"
        k="${k%"${k##*[![:space:]]}"}"
        k="${k#"${k%%[![:space:]]*}"}"
        if [[ ${(L)k} == $key_l ]]; then
          print -r -- "$key = $val"
          found=1
          continue
        fi
      fi
      print -r -- "$line"
    done
    (( found )) || print -r -- "$key = $val"
  } < "$f" > "$tmp" || { /bin/rm -f -- "$tmp"; return 1 }
  /bin/mv -f -- "$tmp" "$f" || { /bin/rm -f -- "$tmp"; return 1 }
  return 0
}

# Persist inherit/-1/1/0 cycle3 flags as inherit|1|0 in the config file.
_dnav_cfg_cycle3_store() {
  case $1 in
    -1) print -rn -- inherit ;;
    1)  print -rn -- 1 ;;
    *)  print -rn -- 0 ;;
  esac
}

# Shared location bar (TUI select, dsearch, and shell djump/dKEY).
# $1 = path; $2 = optional expand origin column; $3 = dnav|djump (bar visibility).
# Always one terminal row: width from stty, tail-truncate, never fill last column.
_dnav_success_bar() {
  local bar_path="$1"
  local origin_mid="${2:-}"
  local ctx="${3:-dnav}"
  local hl="${DNAV_HIGHLIGHT:-\e[30;46m}"
  local rst="${DNAV_RESET:-\e[0m}"
  local max_w usable
  local step left right width half display
  local anim=${DNAV_CFG_SUCCESS_ANIM:-1}
  local steps=${DNAV_CFG_SUCCESS_ANIM_STEPS:-8}
  local ms=${DNAV_CFG_SUCCESS_ANIM_MS:-25}
  local cs delay

  _dnav_want_bar "$ctx" || return 0

  max_w="$(_dnav_term_cols)"
  # Last column wrap (iSH / narrow ttys): keep one spare cell
  usable=$(( max_w > 1 ? max_w - 1 : 1 ))
  (( steps < 1 )) && steps=1
  (( ms < 1 )) && ms=1
  if [[ -z $origin_mid ]]; then
    origin_mid=$(( usable / 2 ))
  fi
  (( origin_mid >= usable )) && origin_mid=$(( usable / 2 ))

  if (( anim )); then
    cs=$(( (ms + 5) / 10 ))
    (( cs < 1 )) && cs=1
    delay=$(printf '0.%03d' $ms)
    for (( step=1; step <= steps; step++ )); do
      half=$(( (usable * step) / (2 * steps) ))
      left=$(( origin_mid - half ))
      right=$(( origin_mid + half ))
      (( left < 0 )) && left=0
      (( right > usable )) && right=$usable
      width=$(( right - left ))
      printf "\r\e[2K"
      printf "\e[${left}C${hl}%*s${rst}" $width ""
      if zmodload -F zsh/zselect b:zselect 2>/dev/null; then
        zselect -t $cs
      else
        /bin/sleep "$delay" 2>/dev/null || /usr/bin/sleep "$delay" 2>/dev/null || true
      fi
    done
  fi

  display="$(_dnav_fit_end "$bar_path" $usable)"
  printf "\r${hl}%-${usable}s${rst}\e[K\n" "$display"
}

# After a successful cd (or file pick). $1=path $2=dnav|djump $3=optional origin col
_dnav_finish() {
  local dest="$1" ctx="${2:-dnav}" origin="${3:-}"
  if (( $+functions[_dnav_success_bar] )); then
    _dnav_success_bar "$dest" "$origin" "$ctx"
  else
    print -r -- "$dest"
  fi
  if (( $+functions[_dnav_cleanup] )); then
    _dnav_cleanup
  else
    printf "\e[?25h"
  fi
  (( $+functions[_dnav_maybe_ls] )) && _dnav_maybe_ls "$ctx"
}

_dnav_cleanup() {
  (( _DNAV_CLEANED )) && return
  # Stop background search index if still running (user left early)
  (( $+functions[_dsearch_index_cancel] )) && _dsearch_index_cancel
  [[ -n $_DNAV_STTY_ORIG ]] && stty "$_DNAV_STTY_ORIG" 2>/dev/null
  _dnav_autowrap_on
  printf "\e[0 q\e[?25h"
  _DNAV_CLEANED=1
}

# Wipe the main bar / help overlay (not plugin body lines).
_dnav_clear_menu() {
  local i
  printf "\r\e[2K"
  for (( i=0; i < _DNAV_HELP_EXTRA; i++ )); do
    printf "\n\e[2K"
  done
  if (( _DNAV_HELP_EXTRA > 0 )); then
    printf "\e[%dA" $_DNAV_HELP_EXTRA
  fi
  printf "\r\e[2K"
  _DNAV_HELP_EXTRA=0
}

# Full abort: tear down plugin UIs, clear the bar, restore tty.
# Used by INT/TERM/QUIT and by Ctrl+C as a byte ($'\x03').
_dnav_abort() {
  DNAV_ABORT=1
  (( $+functions[_dsearch_index_cancel] )) && _dsearch_index_cancel
  # Innermost plugin UIs first (dsearch may sit on dfile or main).
  if (( $+functions[_dsearch_erase_ui] )) && {
       (( ${_dsearch_extra_lines:-0} > 0 )) || [[ -n ${_dsearch_tmpdir:-} ]]
     }; then
    _dsearch_erase_ui
    (( $+functions[_dsearch_session_cleanup] )) && _dsearch_session_cleanup
  fi
  if (( ${+_DFILE_OPEN} && _DFILE_OPEN )); then
    (( $+functions[_dfile_erase] )) && _dfile_erase
    _DFILE_OPEN=0
  fi
  _dnav_clear_menu
  _dnav_cleanup
}

# Brand width: " Brand " + trailing space
_dnav_brand_w() {
  emulate -L zsh
  setopt localoptions multibyte
  print -rn -- $(( ${(m)#_DNAV_BRAND} + 3 ))
}

# Keep _DNAV_SEL chip in the horizontal window; sets _DNAV_BAR_WIN.
_dnav_ensure_bar_visible() {
  local brand_w=$(_dnav_brand_w)
  local avail=$(( _DNAV_COLS - brand_w ))
  (( avail < 10 )) && avail=10
  local old_win=$_DNAV_BAR_WIN
  _dnav_window _DNAV_NAMES $_DNAV_SEL $_DNAV_BAR_WIN $avail
  _DNAV_BAR_WIN=$reply[1]
  reply=($old_win $_DNAV_BAR_WIN)
}

# Layout visible chips for partial paint / success animation origin.
_dnav_compute_positions() {
  local brand_w=$(_dnav_brand_w)
  local avail=$(( _DNAV_COLS - brand_w ))
  (( avail < 10 )) && avail=10
  local col=$brand_w more_l=0 more_r=0 content_w=$avail
  local i label cell_w used=0 n=$#_DNAV_NAMES
  _DNAV_ITEM_START=()
  _DNAV_ITEM_END=()
  _dnav_ensure_bar_visible
  (( _DNAV_BAR_WIN > 0 )) && more_l=1
  # rough more_r probe
  used=0
  for (( i=_DNAV_BAR_WIN; i < n; i++ )); do
    cell_w="$(_dnav_cell_w "${_DNAV_NAMES[i+1]}")"
    if (( used > 0 && used + cell_w > avail )); then
      more_r=1
      break
    fi
    (( used += cell_w ))
  done
  (( more_l )) && (( content_w -= 2 ))
  (( more_r )) && (( content_w -= 2 ))
  (( content_w < 4 )) && content_w=4
  col=$brand_w
  (( more_l )) && (( col += 2 ))
  used=0
  for (( i=_DNAV_BAR_WIN; i < n; i++ )); do
    label="${_DNAV_NAMES[i+1]}"
    cell_w="$(_dnav_cell_w "$label")"
    if (( used > 0 && used + cell_w > content_w )); then
      break
    fi
    _DNAV_ITEM_START[i+1]=$col
    (( col += cell_w ))
    _DNAV_ITEM_END[i+1]=$col
    (( used += cell_w ))
  done
}

# Full bar paint: _DNAV_BRAND + scrolling folder chips + < > overflow.
_dnav_draw() {
  _DNAV_COLS="$(_dnav_usable_cols)"
  local brand_w=$(_dnav_brand_w)
  local avail=$(( _DNAV_COLS - brand_w ))
  (( avail < 10 )) && avail=10
  printf "\e[?25l\r"
  printf "${DNAV_HIGHLIGHT} %s ${DNAV_RESET} " "$_DNAV_BRAND"
  _dnav_paint_strip _DNAV_NAMES $_DNAV_SEL $_DNAV_BAR_WIN 1 $avail
  _DNAV_BAR_WIN=$reply[1]
  _dnav_compute_positions
  printf "\r"
}

# Repaint one visible chip (partial redraw). idx = 0-based into _DNAV_NAMES.
_dnav_paint_item() {
  local idx="$1"
  local i=$(( idx + 1 ))
  [[ -n ${_DNAV_ITEM_START[i]:-} ]] || return
  printf "\e[%dG" $(( _DNAV_ITEM_START[i] + 1 ))
  if (( idx == _DNAV_SEL )); then
    printf "${DNAV_HIGHLIGHT} %s ${DNAV_RESET} " "${_DNAV_NAMES[i]}"
  else
    printf " %s  " "${_DNAV_NAMES[i]}"
  fi
}

_dnav_move_left() {
  local old=$_DNAV_SEL old_win=$_DNAV_BAR_WIN
  (( _DNAV_SEL > 0 )) || return
  (( _DNAV_SEL-- ))
  _dnav_ensure_bar_visible
  if (( DNAV_CFG_FULL_REDRAW || _DNAV_BAR_WIN != old_win )); then
    _dnav_draw
  else
    _dnav_compute_positions
    _dnav_paint_item $old
    _dnav_paint_item $_DNAV_SEL
    printf "\r"
  fi
}

_dnav_move_right() {
  local old=$_DNAV_SEL old_win=$_DNAV_BAR_WIN
  (( _DNAV_SEL < $#_DNAV_NAMES - 1 )) || return
  (( _DNAV_SEL++ ))
  _dnav_ensure_bar_visible
  if (( DNAV_CFG_FULL_REDRAW || _DNAV_BAR_WIN != old_win )); then
    _dnav_draw
  else
    _dnav_compute_positions
    _dnav_paint_item $old
    _dnav_paint_item $_DNAV_SEL
    printf "\r"
  fi
}

