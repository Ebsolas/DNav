# Best existing directory for an entry path. REPLY=dir.
# Returns 0 if $1 is already a directory; 1 if we climbed or fell back to $PWD.
_dnav_resolve_dir() {
  local raw="${1:-}" p
  if [[ -z $raw ]]; then
    REPLY="$PWD"
    return 0
  fi
  p="$(_dnav_expand_path "$raw")"
  [[ -n $p ]] || { REPLY="$PWD"; return 1 }
  if [[ -d $p ]]; then
    REPLY="$p"
    return 0
  fi
  if [[ -e $p ]]; then
    p="${p:h}"
    [[ -z $p ]] && p="/"
    if [[ -d $p ]]; then
      REPLY="$p"
      return 1
    fi
  fi
  while [[ -n $p && $p != / && ! -d $p ]]; do
    p="${p:h}"
  done
  if [[ -d $p ]]; then
    REPLY="$p"
  else
    REPLY="$PWD"
  fi
  return 1
}

