# djump is eager (dKEY commands). dfile/dsearch load on first use.
_dnav_load_module() {
  local name="$1" f
  f="$DNAV_DIR/$name"
  case $name in
    dfile)
      (( $+functions[_dfile_enter] )) && return 0
