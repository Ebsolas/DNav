# Screen columns of $1 (CJK/emoji occupy 2). ${#s} is characters, not cells.
_dnav_disp_w() {
  emulate -L zsh
  setopt localoptions multibyte
  local s="$1"
  print -rn -- ${(m)#s}
}

_dnav_inacc_icon() { _dnav_truthy "${DNAV_CFG_INACC_ICON:-1}"; }

_dnav_inacc_seq() {
  local sel="${1:-0}"
  local fg="${DNAV_CFG_INACC_COLOR:-31}"
  [[ $fg == <-> ]] || fg=31
  if (( sel )); then
    if (( fg >= 30 && fg <= 37 )); then
      print -rn -- $'\e['"$(( fg + 10 ))"';37m'
    else
      print -rn -- $'\e[7;'"${fg}"'m'
    fi
  else
    print -rn -- $'\e['"${fg}"'m'
  fi
}

_dnav_cell_w() {
  emulate -L zsh
  setopt localoptions multibyte
  local label="$1" locked="${2:-0}"
  local n=${(m)#label}
  if (( locked )) && _dnav_inacc_icon; then
    local lock='🔒'
    print -rn -- $(( n + ${(m)#lock} + 4 ))
  else
    print -rn -- $(( n + 3 ))
  fi
}

# Windowing: reply=(win_start), _dnav_vis=(labels). Also copies to _dfile_vis.
_dnav_window() {
  local aname="$1" sel="$2" win="$3" maxw="$4" lockname="${5:-}" sticky="${6:-0}"
  local -a all locks
  all=("${(@P)aname}")
  locks=()
  [[ -n $lockname ]] && locks=("${(@P)lockname}")
  local n=$#all
  (( n == 0 )) && { reply=(0); _dnav_vis=(); _dfile_vis=(); return 0 }

  (( sel < 0 )) && sel=0
  (( sel >= n )) && sel=$(( n - 1 ))
  (( win < 0 )) && win=0
  (( win > sel )) && win=$sel

  local -a vis
  local i w used label vcount sel_slot changed=1 guard=0 locked

  while (( changed && guard < 40 )); do
    (( guard++ ))
    changed=0
    vis=()
    used=0
    for (( i=win; i < n; i++ )); do
      label="${all[i+1]}"
      locked=${locks[i+1]:-0}
      w="$(_dnav_cell_w "$label" $locked)"
      if (( $#vis > 0 && used + w > maxw )); then
        break
      fi
      if (( $#vis == 0 && w > maxw )); then
        vis+=("$label")
        break
      fi
      vis+=("$label")
      (( used += w ))
    done
    vcount=$#vis
    (( vcount == 0 )) && break
    sel_slot=$(( sel - win ))
    if (( sel_slot >= vcount )); then
      if (( vcount >= 2 )); then
        win=$(( sel - (vcount - 2) ))
      else
        win=$sel
      fi
      (( win < 0 )) && win=0
      changed=1
      continue
    fi
    if (( sel_slot == vcount - 1 && sel < n - 1 && vcount >= 2 )); then
      if (( sticky && win == 0 )); then
        :
      else
        local nwin=$(( sel - (vcount - 2) ))
        (( nwin < 0 )) && nwin=0
        if (( nwin != win )); then
          win=$nwin
          changed=1
        fi
      fi
    fi
  done

  _dnav_vis=("${vis[@]}")
  _dfile_vis=("${vis[@]}")
  reply=($win)
}

_dnav_paint_strip() {
  local aname="$1"
  local sel="$2"
  local win="$3"
  local active="$4"
  local maxw="$5"
  local lockname="${6:-}"
  local sticky="${7:-0}"
  local hl rst
  local -a items locks
  items=("${(@P)aname}")
  locks=()
  [[ -n $lockname ]] && locks=("${(@P)lockname}")
  hl="${DNAV_HIGHLIGHT:-\e[30;46m}"
  rst="${DNAV_RESET:-\e[0m}"

  local n=$#items
  local more_l=0 more_r=0 ind_l=0 ind_r=0 content_w=$maxw
  local i label used=0 cell_w locked

  _dnav_window "$aname" "$sel" "$win" "$content_w" "$lockname" "$sticky"
  win=$reply[1]
  (( win > 0 )) && more_l=1
  (( n > 0 && win + $#_dnav_vis < n )) && more_r=1

  # Second pass only when < > markers steal columns. Do not window a third time.
  if (( more_l || more_r )); then
    (( more_l )) && ind_l=2
    (( more_r )) && ind_r=2
    content_w=$(( maxw - ind_l - ind_r ))
    (( content_w < 1 )) && content_w=1
    _dnav_window "$aname" "$sel" "$win" "$content_w" "$lockname" "$sticky"
    win=$reply[1]
    more_l=0
    more_r=0
    (( win > 0 )) && more_l=1
    (( n > 0 && win + $#_dnav_vis < n )) && more_r=1
  fi

  local printed=0 remain
  (( more_l )) && { printf "\e[2m<\e[22m "; printed=2 }

  used=0
  for (( i=win; i < n; i++ )); do
    label="${items[i+1]}"
    locked=${locks[i+1]:-0}
    cell_w="$(_dnav_cell_w "$label" $locked)"
    remain=$(( maxw - printed - (more_r ? 2 : 0) ))
    (( remain < 0 )) && remain=0
    if (( cell_w > remain )); then
      if (( used == 0 && remain > 0 )); then
        local pad=3
        if (( locked )) && _dnav_inacc_icon; then
          pad="$(_dnav_cell_w "" 1)"
        fi
        local room=$(( remain - pad ))
        (( room < 1 )) && room=1
        if (( $(_dnav_disp_w "$label") > room )); then
          label="$(_dnav_fit_start "$label" $room)"
        fi
        cell_w="$(_dnav_cell_w "$label" $locked)"
        (( cell_w > remain )) && cell_w=$remain
      else
        more_r=1
        break
      fi
    fi
    if (( locked )); then
      local iseq
      iseq="$(_dnav_inacc_seq $(( active && i == sel )))"
      if _dnav_inacc_icon; then
        printf "${iseq} 🔒 %s \e[0m " "$label"
      else
        printf "${iseq} %s \e[0m " "$label"
      fi
    elif (( active && i == sel )); then
      printf "${hl} %s ${rst} " "$label"
    else
      printf " %s  " "$label"
    fi
    (( used += cell_w ))
    (( printed += cell_w ))
  done

  if (( more_r && printed + 2 <= maxw )); then
    printf " \e[2m>\e[22m"
  fi
  printf "\e[K"
  reply=($win)
}

# ── Optional modules ──────────────────────────────────────────────────────
# djump is eager (dKEY commands). dfile/dsearch load on first use.
# dsearch-index loads for auto-index / --reindex without the search overlay.
_dnav_load_module() {
  local name="$1" f
  f="$DNAV_DIR/$name"
  case $name in
    dfile)
      (( $+functions[_dfile_enter] )) && return 0
      [[ -f $f ]] && source "$f"
      ;;
    dsearch-index)
      (( $+functions[_dsearch_reindex] )) && return 0
      [[ -f $f ]] && source "$f"
      ;;
    dsearch)
      (( $+functions[_dsearch_start] )) && return 0
      _dnav_load_module dsearch-index
      [[ -f $f ]] && source "$f"
      ;;
    djump)
      (( $+functions[_djump_goto] )) && return 0
      [[ -f $f ]] && source "$f"
      ;;
  esac
}

