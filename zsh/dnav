_dnav_settings_fill_body() {
  local tab="${_DNAV_SETTINGS_TABS[_DNAV_SETTINGS_SEL+1]}"
  local onoff i k path
  _DNAV_ABOUT_BODY=()
  _DNAV_ABOUT_KIND=()
  _DNAV_ABOUT_KEY=()
  _DNAV_ABOUT_IDX=()
  _DNAV_ABOUT_NROWS=0
  case $tab in
    General)
      (( DNAV_CFG_LS )) && onoff=on || onoff=off
      _DNAV_ABOUT_BODY+=("ls_after          $onoff          Enter toggle (default)")
