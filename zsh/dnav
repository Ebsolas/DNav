#!/usr/bin/env zsh
# dnav - quick navigation to common folders (zsh version of the PowerShell dnav)
#
# Optional modules (place next to this file):
#   dfile   – mini multi-column file explorer (expand below the nav bar)
#   dsearch – fuzzy path search (type-to-filter, works in both nav and dfile views)
#
# User config (created on first load):
#   ${XDG_CONFIG_HOME:-~/.config}/dnav/config    – colors, defaults, flags
#   ${XDG_CONFIG_HOME:-~/.config}/dnav/folders   – main bar labels + paths
#   ${XDG_CONFIG_HOME:-~/.config}/dnav/jumps     – dKEY jump aliases
#
# Env overrides (optional):
#   DNAV_JUMPS=path        alternate jumps file
#   DNAV_SEARCH_ROOTS=…    dsearch roots (space-separated)
#   DNAV_CONFIG_DIR=path   alternate config directory
#
# ls after select/jump is config only:  ls_after = 1  in ~/.config/dnav/config

# ── Locate this script’s directory (works when sourced or executed) ───────
typeset -g DNAV_DIR
if [[ -n ${(%):-%x} ]]; then
  DNAV_DIR=${${(%):-%x}:A:h}
else
  DNAV_DIR=${0:A:h}
fi

# ── Config globals (filled by _dnav_config_load) ──────────────────────────
typeset -g DNAV_CONFIG_DIR
typeset -g DNAV_CFG_COLOR_FG=30 DNAV_CFG_COLOR_BG=46
typeset -g DNAV_CFG_LS=0 DNAV_CFG_SHOW_HIDDEN=0
typeset -gi DNAV_CFG_LS_DNAV=-1 DNAV_CFG_LS_DJUMP=-1
typeset -g DNAV_CFG_SUCCESS_ANIM=1 DNAV_CFG_FULL_REDRAW=0
typeset -g DNAV_CFG_SUCCESS_BAR=1
typeset -gi DNAV_CFG_SUCCESS_BAR_DNAV=-1 DNAV_CFG_SUCCESS_BAR_DJUMP=-1
typeset -g DNAV_CFG_SUCCESS_ANIM_STEPS=8 DNAV_CFG_SUCCESS_ANIM_MS=25
typeset -g DNAV_CFG_BRAND=DNav
typeset -g DNAV_CFG_SEARCH_ROOTS=""
typeset -g DNAV_CFG_DFILE_SORT_DIRS=alpha
typeset -g DNAV_CFG_DFILE_SORT_FILES=alpha
typeset -g DNAV_CFG_DFILE_JUMP_NAME_MAX=20
typeset -ga DNAV_FOLDER_NAMES DNAV_FOLDER_PATHS
typeset -g DNAV_HIGHLIGHT DNAV_RESET
DNAV_HIGHLIGHT=$'\e[30;46m'
DNAV_RESET=$'\e[0m'

# ── Config helpers ────────────────────────────────────────────────────────
_dnav_config_dir() {
  if [[ -n ${DNAV_CONFIG_DIR:-} ]]; then
    print -r -- "$DNAV_CONFIG_DIR"
  else
    print -r -- "${XDG_CONFIG_HOME:-$HOME/.config}/dnav"
  fi
}

_dnav_truthy() {
  case ${(L)1} in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

# Map color names → ANSI numbers (fg 30–37 / 90–97, bg 40–47 / 100–107).
_dnav_color_num() {
  local kind="$1" name="${(L)2}" n
  # bare number
  if [[ $name == <-> ]]; then
    print -rn -- "$name"
    return 0
  fi
  case $kind in
    fg)
      case $name in
        black) n=30 ;; red) n=31 ;; green) n=32 ;; yellow) n=33 ;;
        blue) n=34 ;; magenta|purple) n=35 ;; cyan) n=36 ;; white) n=37 ;;
        bright-black|gray|grey) n=90 ;; bright-red) n=91 ;; bright-green) n=92 ;;
        bright-yellow) n=93 ;; bright-blue) n=94 ;; bright-magenta) n=95 ;;
        bright-cyan) n=96 ;; bright-white) n=97 ;;
        *) n=30 ;;
      esac
      ;;
    bg)
      case $name in
        black) n=40 ;; red) n=41 ;; green) n=42 ;; yellow) n=43 ;;
        blue) n=44 ;; magenta|purple) n=45 ;; cyan) n=46 ;; white) n=47 ;;
        bright-black|gray|grey) n=100 ;; bright-red) n=101 ;; bright-green) n=102 ;;
        bright-yellow) n=103 ;; bright-blue) n=104 ;; bright-magenta) n=105 ;;
        bright-cyan) n=106 ;; bright-white) n=107 ;;
        *) n=46 ;;
      esac
      ;;
    *) n=0 ;;
  esac
  print -rn -- "$n"
}

_dnav_apply_colors() {
  DNAV_CFG_COLOR_FG="$(_dnav_color_num fg "${DNAV_CFG_COLOR_FG:-30}")"
  DNAV_CFG_COLOR_BG="$(_dnav_color_num bg "${DNAV_CFG_COLOR_BG:-46}")"
  # If user gave a fg name for bg by mistake with 30–37, map to bg 40–47
  if (( DNAV_CFG_COLOR_BG >= 30 && DNAV_CFG_COLOR_BG <= 37 )); then
    DNAV_CFG_COLOR_BG=$(( DNAV_CFG_COLOR_BG + 10 ))
  fi
  DNAV_HIGHLIGHT=$'\e['"${DNAV_CFG_COLOR_FG}"';'"${DNAV_CFG_COLOR_BG}"'m'
  DNAV_RESET=$'\e[0m'
}

# Trim leading/trailing whitespace. Safe under EXTENDED_GLOB.
_dnav_trim() {
  emulate -L zsh
  setopt localoptions no_extended_glob
  local s="$1"
  s="${s%"${s##*[![:space:]]}"}"
  s="${s#"${s%%[![:space:]]*}"}"
  print -r -- "$s"
}

# Strip a # comment: only at start of line (after indent) or after whitespace.
# Foo#Bar and /tmp/proj#2 are kept. "Foo # note" drops " # note".
_dnav_strip_comment() {
  emulate -L zsh
  setopt localoptions no_extended_glob
  local s="$1" t i ch prev=""
  t="${s#"${s%%[![:space:]]*}"}"
  if [[ -z $t || $t == \#* ]]; then
    print -r -- ""
    return
  fi
  for (( i=1; i <= ${#s}; i++ )); do
    ch="${s[i]}"
    if [[ $ch == '#' && $prev == [[:space:]] ]]; then
      print -r -- "${s[1,i-1]}"
      return
    fi
    prev="$ch"
  done
  print -r -- "$s"
}

# Expand ~ in a path; empty stays empty.
_dnav_expand_path() {
  local p="$1"
  [[ -z $p || $p == - ]] && { print -r -- ""; return 0 }
  if [[ $p == '~' || $p == '~/'* ]]; then
    p="${p/#\~/$HOME}"
  fi
  print -r -- "$p"
}

# Write default user config files (first run).
_dnav_config_seed() {
  local dir="$1"
  mkdir -p "$dir" 2>/dev/null || return 1

  if [[ ! -f $dir/config ]]; then
    cat > "$dir/config" <<'EOF'
# DNav settings — edit freely, then run: dconfig -r
# (or open a new shell / re-source dnav)
#
# Colors: names (cyan, blue, …) or ANSI numbers
#   fg: 30–37 / 90–97    bg: 40–47 / 100–107
#   names: black red green yellow blue magenta cyan white
#          bright-red bright-cyan …
color_fg = black
color_bg = cyan

# Brand chip label on the main bar
brand = DNav

# ls -a after a successful select/jump
ls_after = 0
# ls_after_dnav = 1
# ls_after_djump = 0

# dfile: show hidden files/dirs by default (toggle still works with .)
show_hidden = 0
# dfile dir order: alpha | hidden_first
dfile_sort_dirs = alpha
# dfile file order: alpha | ext | dot_first | dot_ext
dfile_sort_files = alpha
# dfile Jump to: folder name max (cuts the end)
dfile_jump_name_max = 20

# Cyan path bar (0 = hide). *_dnav / *_djump override when set
success_bar = 1
# success_bar_dnav = 1
# success_bar_djump = 0

# Animate the expand-to-path success bar (0 = instant bar)
success_anim = 1
success_anim_steps = 8
success_anim_ms = 25

# 1 = full line redraw every move (more compatible); 0 = partial chip repaint
full_redraw = 0

# dsearch roots (space-separated). Empty = built-in defaults ($HOME + …)
# search_roots = $HOME /opt /mnt
EOF
  fi

  if [[ ! -f $dir/folders ]]; then
    cat > "$dir/folders" <<'EOF'
# Main dnav bar — one entry per line:  Label   path
# Paths: ~ expands.
# Note: About is always added by dnav (not listed here).
#
# Label     path
Home        ~
Docs        ~/Documents
Down        ~/Downloads
EbSync      ~/Eb_Transfer
Projects    ~/Projects
Config      ~/.config
Apps        ~/Apps
Share       ~/.local/share
EOF
  fi

  if [[ ! -f $dir/jumps ]]; then
    if [[ -f $DNAV_DIR/jumps ]]; then
      cp -- "$DNAV_DIR/jumps" "$dir/jumps" 2>/dev/null || true
    fi
    if [[ ! -f $dir/jumps ]]; then
      cat > "$dir/jumps" <<'EOF'
# djump table — key becomes shell command dKEY (home → dhome)
# Format:  key   path
# Reload: djump -r   or   dconfig -r
#
# key     path
home      ~
bk        ..
etc       /etc
con       ~/.config
doc       ~/Documents
down      ~/Downloads
proj      ~/Projects
share     ~/.local/share
EOF
    fi
  fi
}

_dnav_config_load_kv() {
  emulate -L zsh
  setopt localoptions no_extended_glob
  local f="$1" line key val
  [[ -f $f ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    line="$(_dnav_trim "$(_dnav_strip_comment "$line")")"
    [[ -z $line ]] && continue
    if [[ $line != *=* ]]; then
      continue
    fi
    key="${line%%=*}"
    val="${line#*=}"
    key="${key%"${key##*[![:space:]]}"}"
    key="${key#"${key%%[![:space:]]*}"}"
    val="${val%"${val##*[![:space:]]}"}"
    val="${val#"${val%%[![:space:]]*}"}"
    # strip optional quotes
    if [[ $val == \"*\" || $val == \'*\' ]]; then
      val="${val[2,-2]}"
    fi
    key="${(L)key}"
    case $key in
      color_fg|highlight_fg|fg)     DNAV_CFG_COLOR_FG="$val" ;;
      color_bg|highlight_bg|bg)     DNAV_CFG_COLOR_BG="$val" ;;
      brand)                        DNAV_CFG_BRAND="$val" ;;
      ls_after|ls)                  _dnav_truthy "$val" && DNAV_CFG_LS=1 || DNAV_CFG_LS=0 ;;
      ls_after_dnav)
        case ${(L)val} in inherit|-1|'') DNAV_CFG_LS_DNAV=-1 ;; *) _dnav_truthy "$val" && DNAV_CFG_LS_DNAV=1 || DNAV_CFG_LS_DNAV=0 ;; esac ;;
      ls_after_djump)
        case ${(L)val} in inherit|-1|'') DNAV_CFG_LS_DJUMP=-1 ;; *) _dnav_truthy "$val" && DNAV_CFG_LS_DJUMP=1 || DNAV_CFG_LS_DJUMP=0 ;; esac ;;
      show_hidden|hidden)           _dnav_truthy "$val" && DNAV_CFG_SHOW_HIDDEN=1 || DNAV_CFG_SHOW_HIDDEN=0 ;;
      success_bar)                  _dnav_truthy "$val" && DNAV_CFG_SUCCESS_BAR=1 || DNAV_CFG_SUCCESS_BAR=0 ;;
      success_bar_dnav)
        case ${(L)val} in inherit|-1|'') DNAV_CFG_SUCCESS_BAR_DNAV=-1 ;; *) _dnav_truthy "$val" && DNAV_CFG_SUCCESS_BAR_DNAV=1 || DNAV_CFG_SUCCESS_BAR_DNAV=0 ;; esac ;;
      success_bar_djump)
        case ${(L)val} in inherit|-1|'') DNAV_CFG_SUCCESS_BAR_DJUMP=-1 ;; *) _dnav_truthy "$val" && DNAV_CFG_SUCCESS_BAR_DJUMP=1 || DNAV_CFG_SUCCESS_BAR_DJUMP=0 ;; esac ;;
      success_anim|anim)            _dnav_truthy "$val" && DNAV_CFG_SUCCESS_ANIM=1 || DNAV_CFG_SUCCESS_ANIM=0 ;;
      success_anim_steps)           [[ $val == <-> ]] && DNAV_CFG_SUCCESS_ANIM_STEPS=$val ;;
      success_anim_ms)              [[ $val == <-> ]] && DNAV_CFG_SUCCESS_ANIM_MS=$val ;;
      full_redraw|redraw)           _dnav_truthy "$val" && DNAV_CFG_FULL_REDRAW=1 || DNAV_CFG_FULL_REDRAW=0 ;;
      search_roots)                 DNAV_CFG_SEARCH_ROOTS="$val" ;;
      dfile_sort_dirs)
        case ${(L)val} in hidden_first|hidden|dot_first) DNAV_CFG_DFILE_SORT_DIRS=hidden_first ;; *) DNAV_CFG_DFILE_SORT_DIRS=alpha ;; esac ;;
      dfile_sort_files)
        case ${(L)val} in
          ext|extension) DNAV_CFG_DFILE_SORT_FILES=ext ;;
          dot_first|hidden_first|dot) DNAV_CFG_DFILE_SORT_FILES=dot_first ;;
          dot_ext|dot_extension|hidden_ext) DNAV_CFG_DFILE_SORT_FILES=dot_ext ;;
          *) DNAV_CFG_DFILE_SORT_FILES=alpha ;;
        esac ;;
      dfile_jump_name_max|dfile_jump_max)
        if [[ $val == <-> ]] && (( val >= 1 )); then
          DNAV_CFG_DFILE_JUMP_NAME_MAX=$val
        fi ;;
    esac
  done < "$f"
}

_dnav_config_load_folders() {
  emulate -L zsh
  setopt localoptions no_extended_glob
  local f="$1" line label fpath
  DNAV_FOLDER_NAMES=()
  DNAV_FOLDER_PATHS=()
  [[ -f $f ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    line="$(_dnav_trim "$(_dnav_strip_comment "$line")")"
    [[ -z $line ]] && continue
    label="${line%%[[:space:]]*}"
    fpath="${line#"$label"}"
    fpath="${fpath#"${fpath%%[![:space:]]*}"}"
    [[ -z $label ]] && continue
    # Skip legacy Help/About rows — About is always hardcoded by dnav
    if [[ -z $fpath || $fpath == - ]]; then
      continue
    fi
    if [[ ${(L)label} == help || ${(L)label} == about ]]; then
      continue
    fi
    DNAV_FOLDER_NAMES+=("$label")
    DNAV_FOLDER_PATHS+=("$(_dnav_expand_path "$fpath")")
  done < "$f"
  (( ${#DNAV_FOLDER_NAMES} > 0 ))
}

# Persist folders file (About is never written — hardcoded in TUI).
_dnav_folders_save() {
  emulate -L zsh
  setopt localoptions no_multios clobber
  local dir="${DNAV_CONFIG_DIR:-$(_dnav_config_dir)}"
  local f="$dir/folders"
  local tmp i dest store
  /bin/mkdir -p -- "$dir" || return 1
  tmp="${f}.tmp.$$"
  {
    print -r -- "# Main dnav bar — Label path"
    print -r -- "# About is always added by dnav (do not list it here)."
    print -r -- "#"
    for (( i=1; i <= $#DNAV_FOLDER_NAMES; i++ )); do
      dest="${DNAV_FOLDER_PATHS[i]}"
      [[ -z $dest ]] && continue
      store="$dest"
      if [[ $store == "$HOME" ]]; then
        store="~"
      elif [[ $store == "$HOME/"* ]]; then
        store="~${store#$HOME}"
      fi
      print -r -- "${DNAV_FOLDER_NAMES[i]}  $store"
    done
  } > "$tmp" || { /bin/rm -f -- "$tmp"; return 1 }
  /bin/mv -f -- "$tmp" "$f" || { /bin/rm -f -- "$tmp"; return 1 }
}

# Persist jumps file from current map (shared with djump add|edit|remove).
_dnav_jumps_save() {
  if (( $+functions[_djump_save] )); then
    _djump_save
    return $?
  fi
  local f="${DNAV_CONFIG_DIR:-$(_dnav_config_dir)}/jumps"
  local k dest store
  {
    print -r -- "# djump table — key becomes dKEY (home → dhome)"
    print -r -- "# Format:  key   path"
    print -r -- "#"
    for k in "${_DJUMP_KEYS[@]}"; do
      dest="${_DJUMP_MAP[$k]}"
      store="$dest"
      if [[ $store == "$HOME" ]]; then
        store="~"
      elif [[ $store == "$HOME/"* ]]; then
        store="~${store#$HOME}"
      fi
      print -r -- "$k  $store"
    done
  } > "$f"
  if (( $+functions[_djump_load] )); then
    _DJUMP_LOADED=0
    _djump_load 2>/dev/null || true
  fi
}

# Current config keys + built-in defaults. One "key value" per line.
_dnav_config_defaults() {
  print -r -- "color_fg black"
  print -r -- "color_bg cyan"
  print -r -- "brand DNav"
  print -r -- "ls_after 0"
  print -r -- "ls_after_dnav inherit"
  print -r -- "ls_after_djump inherit"
  print -r -- "show_hidden 0"
  print -r -- "dfile_sort_dirs alpha"
  print -r -- "dfile_sort_files alpha"
  print -r -- "dfile_jump_name_max 20"
  print -r -- "success_bar 1"
  print -r -- "success_bar_dnav inherit"
  print -r -- "success_bar_djump inherit"
  print -r -- "success_anim 1"
  print -r -- "success_anim_steps 8"
  print -r -- "success_anim_ms 25"
  print -r -- "full_redraw 0"
}

# One-line note written above a key in the user config.
_dnav_config_key_note() {
  case $1 in
    color_fg) print -r -- "fg: color name or ANSI 30–37 / 90–97 (black red green yellow blue magenta cyan white)" ;;
    color_bg) print -r -- "bg: color name or ANSI 40–47 / 100–107" ;;
    brand) print -r -- "Brand chip label on the main bar" ;;
    ls_after) print -r -- "ls -a after a successful select/jump (1/0)" ;;
    ls_after_dnav) print -r -- "ls after dnav: 1/0/inherit (inherit uses ls_after)" ;;
    ls_after_djump) print -r -- "ls after djump: 1/0/inherit (inherit uses ls_after)" ;;
    show_hidden) print -r -- "dfile: show hidden files/dirs by default (toggle with .)" ;;
    dfile_sort_dirs) print -r -- "dfile dir order: alpha | hidden_first" ;;
    dfile_sort_files) print -r -- "dfile file order: alpha | ext | dot_first | dot_ext" ;;
    dfile_jump_name_max) print -r -- "dfile Jump to: folder name max (cuts the end)" ;;
    success_bar) print -r -- "Cyan path bar after select (0 = hide)" ;;
    success_bar_dnav) print -r -- "path bar after dnav: 1/0/inherit (inherit uses success_bar)" ;;
    success_bar_djump) print -r -- "path bar after djump: 1/0/inherit (inherit uses success_bar)" ;;
    success_anim) print -r -- "Animate the expand-to-path success bar (0 = instant)" ;;
    success_anim_steps) print -r -- "success bar expand: number of animation steps" ;;
    success_anim_ms) print -r -- "success bar expand: milliseconds between steps" ;;
    full_redraw) print -r -- "1 = full line redraw every move; 0 = partial chip repaint" ;;
    *) print -rn -- "" ;;
  esac
}

_dnav_config_canon_key() {
  case ${(L)1} in
    ls|ls_after) print -r -- ls_after ;;
    hidden|show_hidden) print -r -- show_hidden ;;
    anim|success_anim) print -r -- success_anim ;;
    fg|highlight_fg|color_fg) print -r -- color_fg ;;
    bg|highlight_bg|color_bg) print -r -- color_bg ;;
    redraw|full_redraw) print -r -- full_redraw ;;
    dfile_jump_max|dfile_jump_name_max) print -r -- dfile_jump_name_max ;;
    *) print -r -- "${(L)1}" ;;
  esac
}

# Uncommented assignment keys in a config file (canonical names).
_dnav_config_existing_keys() {
  local f="$1" line stripped k
  [[ -f $f ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    stripped="${line#"${line%%[![:space:]]*}"}"
    [[ -z $stripped || $stripped == \#* ]] && continue
    [[ $stripped == *=* ]] || continue
    k="${stripped%%=*}"
    k="${k%"${k##*[![:space:]]}"}"
    k="${k#"${k%%[![:space:]]*}"}"
    [[ -n $k ]] && _dnav_config_canon_key "$k"
  done < "$f"
}

# Append any missing default keys and ensure each known key has its note.
# Never changes existing values. Prints the number of keys added.
_dnav_config_merge_defaults() {
  emulate -L zsh
  setopt localoptions no_multios clobber
  local dir="${1:-${DNAV_CONFIG_DIR:-$(_dnav_config_dir)}}"
  local f="$dir/config"
  local tmp rec key val k added=0 changed=0
  local line stripped prev_comment=0 note last_comment=""
  typeset -A have
  /bin/mkdir -p -- "$dir" || return 1
  [[ -f $f ]] || print -r -- "# DNav settings" > "$f" || return 1
  for k in $(_dnav_config_existing_keys "$f"); do
    have[$k]=1
  done
  tmp="${f}.tmp.$$"
  {
    while IFS= read -r line || [[ -n $line ]]; do
      stripped="${line#"${line%%[![:space:]]*}"}"
      if [[ -z $stripped ]]; then
        print -r -- "$line"
        prev_comment=0
        continue
      fi
      if [[ $stripped == \#* ]]; then
        print -r -- "$line"
        prev_comment=1
        last_comment="$stripped"
        continue
      fi
      if [[ $stripped == *=* ]]; then
        k="${stripped%%=*}"
        k="${k%"${k##*[![:space:]]}"}"
        k="${k#"${k%%[![:space:]]*}"}"
        k="$(_dnav_config_canon_key "$k")"
        note="$(_dnav_config_key_note "$k")"
        if [[ -n $note ]]; then
          if (( prev_comment == 0 )) || [[ $last_comment == '# added by dnav'* || $last_comment == '# added by dupdate'* ]]; then
            print -r -- "# $note"
            changed=1
          fi
        fi
        print -r -- "$line"
        prev_comment=0
        continue
      fi
      print -r -- "$line"
      prev_comment=0
    done
  } < "$f" > "$tmp"
  while IFS= read -r rec; do
    key="${rec%% *}"
    val="${rec#* }"
    [[ -n ${have[$key]:-} ]] && continue
    if (( added == 0 )); then
      print -r -- "" >> "$tmp"
      print -r -- "# added by dnav (previous values were kept)" >> "$tmp"
    else
      print -r -- "" >> "$tmp"
    fi
    note="$(_dnav_config_key_note "$key")"
    [[ -n $note ]] && print -r -- "# $note" >> "$tmp"
    print -r -- "$key = $val" >> "$tmp"
    have[$key]=1
    (( added++ ))
    changed=1
  done < <(_dnav_config_defaults)
  if (( changed )); then
    /bin/mv -f -- "$tmp" "$f" || { /bin/rm -f -- "$tmp"; return 1 }
  else
    /bin/rm -f -- "$tmp"
  fi
  print -r -- "$added"
}

# Load (and seed) user config. Safe to call multiple times (dconfig -r).
_dnav_config_load() {
  DNAV_CONFIG_DIR="$(_dnav_config_dir)"
  # Defaults before file overlay
  DNAV_CFG_COLOR_FG=30
  DNAV_CFG_COLOR_BG=46
  DNAV_CFG_LS=0
  DNAV_CFG_LS_DNAV=-1
  DNAV_CFG_LS_DJUMP=-1
  DNAV_CFG_SHOW_HIDDEN=0
  DNAV_CFG_SUCCESS_ANIM=1
  DNAV_CFG_SUCCESS_BAR=1
  DNAV_CFG_SUCCESS_BAR_DNAV=-1
  DNAV_CFG_SUCCESS_BAR_DJUMP=-1
  DNAV_CFG_SUCCESS_ANIM_STEPS=8
  DNAV_CFG_SUCCESS_ANIM_MS=25
  DNAV_CFG_FULL_REDRAW=0
  DNAV_CFG_BRAND=DNav
  DNAV_CFG_SEARCH_ROOTS=""
  DNAV_CFG_DFILE_SORT_DIRS=alpha
  DNAV_CFG_DFILE_SORT_FILES=alpha
  DNAV_CFG_DFILE_JUMP_NAME_MAX=20
  DNAV_FOLDER_NAMES=()
  DNAV_FOLDER_PATHS=()

  if [[ ! -d $DNAV_CONFIG_DIR ]]; then
    _dnav_config_seed "$DNAV_CONFIG_DIR"
  else
    # Ensure missing pieces exist without clobbering user edits
    _dnav_config_seed "$DNAV_CONFIG_DIR"
  fi

  _dnav_config_load_kv "$DNAV_CONFIG_DIR/config"
  _dnav_apply_colors
  _dnav_config_load_folders "$DNAV_CONFIG_DIR/folders" || true

  # Export search roots for dsearch if config set and env not already set
  if [[ -n $DNAV_CFG_SEARCH_ROOTS && ! -v DNAV_SEARCH_ROOTS ]]; then
    # expand $HOME in config value
    DNAV_SEARCH_ROOTS="${DNAV_CFG_SEARCH_ROOTS//\$HOME/$HOME}"
  fi
}

# Reload config + jump commands.
dconfig() {
  case ${1:-} in
    -r|--reload|'')
      _dnav_config_load
      if (( $+functions[_djump_load] )); then
        _DJUMP_LOADED=0
        _djump_load 2>/dev/null || true
      fi
      if [[ -n ${1:-} || -o interactive ]]; then
        print -r -- "dconfig: ${DNAV_CONFIG_DIR}"
        print -r -- "  color  fg=${DNAV_CFG_COLOR_FG} bg=${DNAV_CFG_COLOR_BG}"
        print -r -- "  brand  ${DNAV_CFG_BRAND}"
        print -r -- "  ls_after=${DNAV_CFG_LS}  dnav=${DNAV_CFG_LS_DNAV}  djump=${DNAV_CFG_LS_DJUMP}"
        print -r -- "  success_bar=${DNAV_CFG_SUCCESS_BAR}  dnav=${DNAV_CFG_SUCCESS_BAR_DNAV}  djump=${DNAV_CFG_SUCCESS_BAR_DJUMP}"
        print -r -- "  success_anim=${DNAV_CFG_SUCCESS_ANIM}  steps=${DNAV_CFG_SUCCESS_ANIM_STEPS}  ms=${DNAV_CFG_SUCCESS_ANIM_MS}  full_redraw=${DNAV_CFG_FULL_REDRAW}"
        print -r -- "  show_hidden=${DNAV_CFG_SHOW_HIDDEN}"
        print -r -- "  folders ${#DNAV_FOLDER_NAMES}  jumps ${#_DJUMP_KEYS:-0}"
      fi
      ;;
    -e|--edit)
      local ed="${EDITOR:-${VISUAL:-vi}}"
      ${=ed} "$(_dnav_config_dir)/config" "$(_dnav_config_dir)/folders" "$(_dnav_config_dir)/jumps"
      ;;
    -p|--path)
      print -r -- "$(_dnav_config_dir)"
      ;;
    -h|--help)
      print -r -- "usage: dconfig [-r|-e|-p]"
      print -r -- "  -r, --reload   reload config + jumps (default)"
      print -r -- "  -e, --edit     open config files in \$EDITOR"
      print -r -- "  -p, --path     print config directory"
      print -r -- "files: config  folders  jumps  under \$XDG_CONFIG_HOME/dnav"
      print -r -- "scripts: dnav --update   refresh install + merge new config keys"
      ;;
    *)
      print -u2 -- "dconfig: unknown option: $1 (try dconfig -h)"
      return 1
      ;;
  esac
}

# Repo root used by dnav --update / install.sh --update.
# Order: DNAV_UPDATE_FROM, $DNAV_DIR/.source, sibling DNav/, ~/.local/share/DNav
_dnav_update_repo() {
  local c line
  local -a cands
  cands=()
  [[ -n ${DNAV_UPDATE_FROM:-} ]] && cands+=("$DNAV_UPDATE_FROM")
  if [[ -n ${DNAV_DIR:-} && -f $DNAV_DIR/.source ]]; then
    IFS= read -r line < "$DNAV_DIR/.source" || line=""
    [[ -n $line ]] && cands+=("$line")
  fi
  [[ -n ${DNAV_DIR:-} ]] && cands+=("${DNAV_DIR:h}/DNav" "${DNAV_DIR:h:h}/DNav")
  cands+=("${XDG_DATA_HOME:-$HOME/.local/share}/DNav")
  cands+=("$HOME/.local/share/DNav")
  [[ -n ${DNAV_DIR:-} ]] && cands+=("$DNAV_DIR")
  for c in "${cands[@]}"; do
    [[ -n $c ]] || continue
    if [[ -f $c/zsh/dnav ]]; then
      print -r -- "${c:A}"
      return 0
    fi
    # Candidate is the zsh/ package inside the repo
    if [[ -f $c/dnav && -f $c/dfile && -f ${c:h}/zsh/dnav ]]; then
      print -r -- "${c:h:A}"
      return 0
    fi
  done
  return 1
}

_dnav_update_copy() {
  local src="$1" dest="$2"
  shift 2
  local f
  command mkdir -p -- "$dest" || return 1
  for f in "$@"; do
    [[ -f $src/$f ]] || continue
    command cp -f -- "$src/$f" "$dest/$f" || return 1
    [[ -x $src/$f ]] && command chmod 0755 -- "$dest/$f"
  done
  return 0
}

# Refresh installed scripts from the git/source tree.
# Merges new config keys into ~/.config/dnav/config; never overwrites existing values.
_dnav_update() {
  emulate -L zsh
  setopt localoptions no_multios
  case ${1:-} in
    -h|--help)
      print -r -- "usage: dnav --update"
      print -r -- "  Copy zsh (and bash, if installed) scripts from the DNav repo"
      print -r -- "  onto this install. Adds any new config keys; keeps your values."
      print -r -- "  Override source:  DNAV_UPDATE_FROM=/path/to/DNav dnav --update"
      return 0
      ;;
  esac

  local repo dest bash_dest added
  repo="$(_dnav_update_repo)" || {
    print -u2 -- "dnav: cannot find the DNav repo (expected zsh/dnav)."
    print -u2 -- "  Clone it, or:  DNAV_UPDATE_FROM=/path/to/DNav dnav --update"
    return 1
  }

  dest="${DNAV_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/dnav}"
  if [[ ${dest:A} != ${repo:A}/zsh ]]; then
    print -r -- "dnav: $repo  →  $dest"
    _dnav_update_copy "$repo/zsh" "$dest" dnav dfile djump dsearch jumps || {
      print -u2 -- "dnav: failed to copy zsh scripts"
      return 1
    }
    if [[ -f $repo/install.sh ]]; then
      command cp -f -- "$repo/install.sh" "$dest/install.sh"
      command chmod 0755 -- "$dest/install.sh"
    fi
    print -r -- "$repo" > "$dest/.source"

    bash_dest="${XDG_DATA_HOME:-$HOME/.local/share}/dnav-bash"
    if [[ -d $bash_dest && -d $repo/bash ]]; then
      _dnav_update_copy "$repo/bash" "$bash_dest" dnav dfile djump dsearch jumps || {
        print -u2 -- "dnav: failed to copy bash scripts"
        return 1
      }
      print -r -- "dnav: bash  →  $bash_dest"
    fi
    source "$dest/dnav"
  else
    print -r -- "dnav: already running from $repo/zsh"
  fi

  added="$(_dnav_config_merge_defaults)"
  _dnav_config_load
  if [[ $added == <-> && added -gt 0 ]]; then
    print -r -- "dnav: config +$added new keys (previous values kept)  ${DNAV_CONFIG_DIR}/config"
  else
    print -r -- "dnav: config already current (previous values kept)  ${DNAV_CONFIG_DIR}/config"
  fi
}
_dnav_config_load

