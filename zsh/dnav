#!/usr/bin/env zsh
# dnav - quick navigation to common folders (zsh version of the PowerShell dnav)
#
# Optional modules (place next to this file):
#   dfile          – mini multi-column file explorer (expand below the nav bar)
#   dsearch-index  – directory cache (auto-index / dnav --reindex)
#   dsearch        – fuzzy path search overlay (loads dsearch-index)
#
# User config (created on first load):
#   ${XDG_CONFIG_HOME:-~/.config}/dnav/config    – colors, defaults, flags
#   ${XDG_CONFIG_HOME:-~/.config}/dnav/folders   – main bar labels + paths
#   ${XDG_CONFIG_HOME:-~/.config}/dnav/jumps     – dKEY jump aliases
#
# Env overrides (optional):
#   DNAV_JUMPS=path        alternate jumps file
#   DNAV_SEARCH_ROOTS=…    dsearch roots (space-separated)
#   DNAV_CONFIG_DIR=path   alternate config directory
#
# ls after select/jump is config only:  ls_after = 1  in ~/.config/dnav/config

# ── Locate this script’s directory (works when sourced or executed) ───────
typeset -g DNAV_DIR
if [[ -n ${(%):-%x} ]]; then
  DNAV_DIR=${${(%):-%x}:A:h}
else
  DNAV_DIR=${0:A:h}
fi

# ── Config globals (filled by _dnav_config_load) ──────────────────────────
typeset -g DNAV_CONFIG_DIR
typeset -g DNAV_CFG_COLOR_FG=30 DNAV_CFG_COLOR_BG=46
typeset -g DNAV_CFG_LS=0 DNAV_CFG_SHOW_HIDDEN=0
typeset -gi DNAV_CFG_LS_DNAV=-1 DNAV_CFG_LS_DJUMP=-1
typeset -g DNAV_CFG_SUCCESS_ANIM=1 DNAV_CFG_FULL_REDRAW=0
typeset -g DNAV_CFG_SUCCESS_BAR=1
typeset -gi DNAV_CFG_SUCCESS_BAR_DNAV=-1 DNAV_CFG_SUCCESS_BAR_DJUMP=-1
typeset -g DNAV_CFG_SUCCESS_ANIM_STEPS=8 DNAV_CFG_SUCCESS_ANIM_MS=2
typeset -g DNAV_CFG_BRAND=DNav
typeset -g DNAV_CFG_SEARCH_ROOTS=""
typeset -gi DNAV_CFG_INDEX_AUTO=1
typeset -g DNAV_CFG_INDEX_WHEN=open
typeset -gi DNAV_CFG_INDEX_TTL_HOURS=24
typeset -g DNAV_CFG_INDEX_FILE=""
typeset -g DNAV_CFG_DFILE_SORT_DIRS=alpha
typeset -g DNAV_CFG_DFILE_SORT_FILES=alpha
typeset -g DNAV_CFG_DFILE_JUMP_NAME_MAX=20
typeset -gi DNAV_CFG_STATUS_TIMEOUT_MS=3000
typeset -g DNAV_CFG_INACC_COLOR=31
typeset -g DNAV_CFG_INACC_ICON=1
typeset -ga DNAV_FOLDER_NAMES DNAV_FOLDER_PATHS
typeset -ga _DNAV_CFG_KEYS
typeset -gA _DNAV_CFG_TYPE _DNAV_CFG_VAR _DNAV_CFG_DEF
typeset -gA _DNAV_CFG_NOTE _DNAV_CFG_UI _DNAV_CFG_HINT _DNAV_CFG_CANON
typeset -g DNAV_HIGHLIGHT DNAV_RESET
DNAV_HIGHLIGHT=$'\e[30;46m'
DNAV_RESET=$'\e[0m'

_dnav_hl() { print -rn -- "${DNAV_HIGHLIGHT:-${HIGHLIGHT:-\e[30;46m}}"; }
_dnav_rst() { print -rn -- "${DNAV_RESET:-${RESET:-\e[0m}}"; }

# ── Config helpers ────────────────────────────────────────────────────────
_dnav_config_dir() {
  if [[ -n ${DNAV_CONFIG_DIR:-} ]]; then
    print -r -- "$DNAV_CONFIG_DIR"
  else
    print -r -- "${XDG_CONFIG_HOME:-$HOME/.config}/dnav"
  fi
}

_dnav_truthy() {
  case ${(L)1} in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

# Map color names → ANSI numbers (fg 30–37 / 90–97, bg 40–47 / 100–107).
_dnav_color_num() {
  local kind="$1" name="${(L)2}" n
  # bare number
  if [[ $name == <-> ]]; then
    print -rn -- "$name"
    return 0
  fi
  case $kind in
    fg)
      case $name in
        black) n=30 ;; red) n=31 ;; green) n=32 ;; yellow) n=33 ;;
        blue) n=34 ;; magenta|purple) n=35 ;; cyan) n=36 ;; white) n=37 ;;
        bright-black|gray|grey) n=90 ;; bright-red) n=91 ;; bright-green) n=92 ;;
        bright-yellow) n=93 ;; bright-blue) n=94 ;; bright-magenta) n=95 ;;
        bright-cyan) n=96 ;; bright-white) n=97 ;;
        *) n=30 ;;
      esac
      ;;
    bg)
      case $name in
        black) n=40 ;; red) n=41 ;; green) n=42 ;; yellow) n=43 ;;
        blue) n=44 ;; magenta|purple) n=45 ;; cyan) n=46 ;; white) n=47 ;;
        bright-black|gray|grey) n=100 ;; bright-red) n=101 ;; bright-green) n=102 ;;
        bright-yellow) n=103 ;; bright-blue) n=104 ;; bright-magenta) n=105 ;;
        bright-cyan) n=106 ;; bright-white) n=107 ;;
        *) n=46 ;;
      esac
      ;;
    *) n=0 ;;
  esac
  print -rn -- "$n"
}

_dnav_apply_colors() {
  DNAV_CFG_COLOR_FG="$(_dnav_color_num fg "${DNAV_CFG_COLOR_FG:-30}")"
  DNAV_CFG_COLOR_BG="$(_dnav_color_num bg "${DNAV_CFG_COLOR_BG:-46}")"
  # If user gave a fg name for bg by mistake with 30–37, map to bg 40–47
  if (( DNAV_CFG_COLOR_BG >= 30 && DNAV_CFG_COLOR_BG <= 37 )); then
    DNAV_CFG_COLOR_BG=$(( DNAV_CFG_COLOR_BG + 10 ))
  fi
  DNAV_HIGHLIGHT=$'\e['"${DNAV_CFG_COLOR_FG}"';'"${DNAV_CFG_COLOR_BG}"'m'
  DNAV_RESET=$'\e[0m'
}

# Trim leading/trailing whitespace. Safe under EXTENDED_GLOB.
_dnav_trim() {
  emulate -L zsh
  setopt localoptions no_extended_glob
  local s="$1"
  s="${s%"${s##*[![:space:]]}"}"
  s="${s#"${s%%[![:space:]]*}"}"
  print -r -- "$s"
}

# Strip a # comment: only at start of line (after indent) or after whitespace.
# Foo#Bar and /tmp/proj#2 are kept. "Foo # note" drops " # note".
_dnav_strip_comment() {
  emulate -L zsh
  setopt localoptions no_extended_glob
  local s="$1" t i ch prev=""
  t="${s#"${s%%[![:space:]]*}"}"
  if [[ -z $t || $t == \#* ]]; then
    print -r -- ""
    return
  fi
  for (( i=1; i <= ${#s}; i++ )); do
    ch="${s[i]}"
    if [[ $ch == '#' && $prev == [[:space:]] ]]; then
      print -r -- "${s[1,i-1]}"
      return
    fi
    prev="$ch"
  done
  print -r -- "$s"
}

# Expand ~ in a path; empty stays empty.
_dnav_expand_path() {
  local p="$1"
  [[ -z $p || $p == - ]] && { print -r -- ""; return 0 }
  if [[ $p == '~' || $p == '~/'* ]]; then
    p="${p/#\~/$HOME}"
  fi
  print -r -- "$p"
}

# Logical absolute path (no symlink resolve). Display + pin identity.
# Use :A / pwd -P only after cd when the physical location matters.
_dnav_logical_path() {
  local p="$1"
  [[ -z $p || $p == - ]] && { print -r -- ""; return 0 }
  print -r -- "${p:a}"
}

# Write default user config files (first run).
_dnav_config_seed() {
  local dir="$1"
  mkdir -p "$dir" 2>/dev/null || return 1

  if [[ ! -f $dir/config ]]; then
    cat > "$dir/config" <<'EOF'
# DNav settings — edit freely, then run: dconfig -r
# (or open a new shell / re-source dnav)
#
# Colors: names (cyan, blue, …) or ANSI numbers
#   fg: 30–37 / 90–97    bg: 40–47 / 100–107
#   names: black red green yellow blue magenta cyan white
#          bright-red bright-cyan …
color_fg = black
color_bg = cyan

# Brand chip label on the main bar
brand = DNav

# ls -a after a successful select/jump
ls_after = 0
# ls_after_dnav = 1
# ls_after_djump = 0

# dfile: show hidden files/dirs by default (toggle still works with .)
show_hidden = 0
# dfile dir order: alpha | hidden_first
dfile_sort_dirs = alpha
# dfile file order: alpha | ext | dot_first | dot_ext
dfile_sort_files = alpha
# dfile Jump to: folder name max (cuts the end)
dfile_jump_name_max = 20

# Cyan path bar (0 = hide). *_dnav / *_djump override when set
success_bar = 1
# success_bar_dnav = 1
# success_bar_djump = 0

# Animate the expand-to-path success bar (0 = instant bar)
success_anim = 1
success_anim_steps = 8
success_anim_ms = 2

# 1 = full line redraw every move (more compatible); 0 = partial chip repaint
full_redraw = 0

# dsearch roots (space-separated). Empty = $HOME only.
# search_roots = $HOME /opt /mnt

# Directory index for search (dirs.idx under ~/.cache/dnav).
# auto: 1 = rebuild when stale; 0 = only dnav --reindex
index_auto = 1
# when: open = start with dnav; search = wait until search opens
index_when = open
# Hours until the on-disk index is stale. 0 = never (still build if missing)
index_ttl_hours = 24
# If set, auto-index / dnav --reindex import this list instead of walking.
# index_file = ~/.cache/dnav/my-dirs

# Status message auto-clear (ms). 0 = keep until the next message
status_timeout_ms = 3000
# Locked / unreadable entries in dfile (color name or ANSI fg)
# inaccessible_color = red
# inaccessible_icon = 1
EOF
  fi

  if [[ ! -f $dir/folders ]]; then
    cat > "$dir/folders" <<'EOF'
# Main dnav bar — one entry per line:  Label   path
# Paths: ~ expands.
# Note: About is always added by dnav (not listed here).
#
# Label     path
Home        ~
Docs        ~/Documents
Down        ~/Downloads
Config      ~/.config
EOF
  fi

  if [[ ! -f $dir/jumps ]]; then
    if [[ -f $DNAV_DIR/jumps ]]; then
      cp -- "$DNAV_DIR/jumps" "$dir/jumps" 2>/dev/null || true
    fi
    if [[ ! -f $dir/jumps ]]; then
      cat > "$dir/jumps" <<'EOF'
# djump table — key becomes shell command dKEY (home → dhome)
# Format:  key   path
# Reload: djump -r   or   dconfig -r
#
# key     path
home      ~
bk        ..
con       ~/.config
doc       ~/Documents
down      ~/Downloads
EOF
    fi
  fi
}

# key|type|var|default|aliases|ui|hint|note
# empty default → load-only (not merged into existing configs)
_dnav_config_schema() {
  print -r -- 'color_fg|color:fg|DNAV_CFG_COLOR_FG|black|highlight_fg,fg|value|Enter edit number/name|fg: color name or ANSI 30–37 / 90–97 (black red green yellow blue magenta cyan white)'
  print -r -- 'color_bg|color:bg|DNAV_CFG_COLOR_BG|cyan|highlight_bg,bg|value|Enter edit number/name|bg: color name or ANSI 40–47 / 100–107'
  print -r -- 'brand|string|DNAV_CFG_BRAND|DNav||value|Enter edit text|Brand chip label on the main bar'
  print -r -- 'ls_after|bool|DNAV_CFG_LS|0|ls|toggle|Enter toggle (default)|ls -a after a successful select/jump (1/0)'
  print -r -- 'ls_after_dnav|cycle3|DNAV_CFG_LS_DNAV|inherit||cycle3|Enter cycle inherit/on/off|ls after dnav: 1/0/inherit (inherit uses ls_after)'
  print -r -- 'ls_after_djump|cycle3|DNAV_CFG_LS_DJUMP|inherit||cycle3|Enter cycle inherit/on/off|ls after djump: 1/0/inherit (inherit uses ls_after)'
  print -r -- 'show_hidden|bool|DNAV_CFG_SHOW_HIDDEN|0|hidden|toggle|Enter toggle|dfile: show hidden files/dirs by default (toggle with .)'
  print -r -- 'dfile_sort_dirs|enum:alpha,hidden_first|DNAV_CFG_DFILE_SORT_DIRS|alpha||enum|Enter cycle alpha/hidden_first|dfile dir order: alpha | hidden_first'
  print -r -- 'dfile_sort_files|enum:alpha,ext,dot_first,dot_ext|DNAV_CFG_DFILE_SORT_FILES|alpha||enum|Enter cycle alpha/ext/dot_first/dot_ext|dfile file order: alpha | ext | dot_first | dot_ext'
  print -r -- 'dfile_jump_name_max|int1|DNAV_CFG_DFILE_JUMP_NAME_MAX|20|dfile_jump_max|value|Enter edit (Jump to: name max)|dfile Jump to: folder name max (cuts the end)'
  print -r -- 'success_bar|bool|DNAV_CFG_SUCCESS_BAR|1||toggle|Enter toggle (default)|Cyan path bar after select (0 = hide)'
  print -r -- 'success_bar_dnav|cycle3|DNAV_CFG_SUCCESS_BAR_DNAV|inherit||cycle3|Enter cycle inherit/on/off|path bar after dnav: 1/0/inherit (inherit uses success_bar)'
  print -r -- 'success_bar_djump|cycle3|DNAV_CFG_SUCCESS_BAR_DJUMP|inherit||cycle3|Enter cycle inherit/on/off|path bar after djump: 1/0/inherit (inherit uses success_bar)'
  print -r -- 'success_anim|bool|DNAV_CFG_SUCCESS_ANIM|1|anim|toggle|Enter toggle|Animate the expand-to-path success bar (0 = instant)'
  print -r -- 'success_anim_steps|int|DNAV_CFG_SUCCESS_ANIM_STEPS|8||||success bar expand: number of animation steps'
  print -r -- 'success_anim_ms|int|DNAV_CFG_SUCCESS_ANIM_MS|2||||success bar expand: milliseconds between steps'
  print -r -- 'full_redraw|bool|DNAV_CFG_FULL_REDRAW|0|redraw|toggle|Enter toggle · full line vs partial|1 = full line redraw every move; 0 = partial chip repaint'
  print -r -- 'search_roots|string|DNAV_CFG_SEARCH_ROOTS|||||'
  print -r -- 'index_auto|bool|DNAV_CFG_INDEX_AUTO|1|auto_index|||Rebuild search index when stale (1) or only via dnav --reindex (0)'
  print -r -- 'index_when|enum:open,search|DNAV_CFG_INDEX_WHEN|open|index_on|||When to auto-index: open (with dnav) | search (when search opens)'
  print -r -- 'index_ttl_hours|int|DNAV_CFG_INDEX_TTL_HOURS|24|index_ttl|||Hours until the search index is stale (0 = never; still build if missing)'
  print -r -- 'index_file|string|DNAV_CFG_INDEX_FILE|||||Path list to import instead of walking (empty = find search_roots)'
  print -r -- 'status_timeout_ms|int|DNAV_CFG_STATUS_TIMEOUT_MS|3000|status_timeout|value|Enter edit (0 = keep)|Status message auto-clear in milliseconds (0 = keep)'
  print -r -- 'inaccessible_color|color:fg|DNAV_CFG_INACC_COLOR|red||value|Enter edit number/name|dfile locked/unreadable color (name or ANSI fg)'
  print -r -- 'inaccessible_icon|bool|DNAV_CFG_INACC_ICON|1||toggle|Enter toggle lock glyph|dfile lock glyph on inaccessible entries (1/0)'
}

_dnav_config_schema_init() {
  emulate -L zsh
  (( $#_DNAV_CFG_KEYS )) && return 0
  local line key type var def aliases ui hint note a
  local -a f
  _DNAV_CFG_KEYS=()
  _DNAV_CFG_TYPE=()
  _DNAV_CFG_VAR=()
  _DNAV_CFG_DEF=()
  _DNAV_CFG_NOTE=()
  _DNAV_CFG_UI=()
  _DNAV_CFG_HINT=()
  _DNAV_CFG_CANON=()
  while IFS= read -r line; do
    f=("${(@s:|:)line}")
    key="${f[1]}"; type="${f[2]}"; var="${f[3]}"; def="${f[4]}"
    aliases="${f[5]}"; ui="${f[6]}"; hint="${f[7]}"; note="${f[8]}"
    _DNAV_CFG_KEYS+=("$key")
    _DNAV_CFG_TYPE[$key]="$type"
    _DNAV_CFG_VAR[$key]="$var"
    _DNAV_CFG_DEF[$key]="$def"
    _DNAV_CFG_NOTE[$key]="$note"
    _DNAV_CFG_UI[$key]="$ui"
    _DNAV_CFG_HINT[$key]="$hint"
    _DNAV_CFG_CANON[$key]="$key"
    for a in ${(s:,:)aliases}; do
      [[ -n $a ]] && _DNAV_CFG_CANON[$a]="$key"
    done
  done < <(_dnav_config_schema)
}

_dnav_config_var_set() {
  local _dnav_vs_var="$1" _dnav_vs_val="$2"
  eval "$_dnav_vs_var=\"\$_dnav_vs_val\""
}

_dnav_config_enum_norm() {
  emulate -L zsh
  local key="$1" val="${(L)2}"
  case $key in
    dfile_sort_dirs)
      case $val in hidden_first|hidden|dot_first) print -r -- hidden_first ;; *) print -r -- alpha ;; esac ;;
    dfile_sort_files)
      case $val in
        ext|extension) print -r -- ext ;;
        dot_first|hidden_first|dot) print -r -- dot_first ;;
        dot_ext|dot_extension|hidden_ext) print -r -- dot_ext ;;
        *) print -r -- alpha ;;
      esac ;;
    index_when)
      case $val in search|s) print -r -- search ;; *) print -r -- open ;; esac ;;
    *) print -r -- "$2" ;;
  esac
}

_dnav_config_assign() {
  emulate -L zsh
  _dnav_config_schema_init
  local key="$(_dnav_config_canon_key "$1")" val="$2"
  local type="${_DNAV_CFG_TYPE[$key]:-}" var="${_DNAV_CFG_VAR[$key]:-}"
  [[ -n $type && -n $var ]] || return 0
  case $type in
    bool)
      if _dnav_truthy "$val"; then _dnav_config_var_set "$var" 1; else _dnav_config_var_set "$var" 0; fi ;;
    cycle3)
      case ${(L)val} in
        inherit|-1|'') _dnav_config_var_set "$var" -1 ;;
        *) if _dnav_truthy "$val"; then _dnav_config_var_set "$var" 1; else _dnav_config_var_set "$var" 0; fi ;;
      esac ;;
    int)
      [[ $val == <-> ]] || return 0
      _dnav_config_var_set "$var" "$val" ;;
    int1)
      [[ $val == <-> ]] && (( val >= 1 )) || return 0
      _dnav_config_var_set "$var" "$val" ;;
    string)
      _dnav_config_var_set "$var" "$val" ;;
    color:fg)
      _dnav_config_var_set "$var" "$(_dnav_color_num fg "$val")" ;;
    color:bg)
      _dnav_config_var_set "$var" "$(_dnav_color_num bg "$val")" ;;
    enum:*)
      _dnav_config_var_set "$var" "$(_dnav_config_enum_norm "$key" "$val")" ;;
  esac
}

_dnav_config_load_kv() {
  emulate -L zsh
  setopt localoptions no_extended_glob
  local f="$1" line key val
  [[ -f $f ]] || return 1
  _dnav_config_schema_init
  while IFS= read -r line || [[ -n $line ]]; do
    line="$(_dnav_trim "$(_dnav_strip_comment "$line")")"
    [[ -z $line ]] && continue
    [[ $line == *=* ]] || continue
    key="${line%%=*}"
    val="${line#*=}"
    key="${key%"${key##*[![:space:]]}"}"
    key="${key#"${key%%[![:space:]]*}"}"
    val="${val%"${val##*[![:space:]]}"}"
    val="${val#"${val%%[![:space:]]*}"}"
    if [[ $val == \"*\" || $val == \'*\' ]]; then
      val="${val[2,-2]}"
    fi
    _dnav_config_assign "$key" "$val"
  done < "$f"
}

_dnav_config_load_folders() {
  emulate -L zsh
  setopt localoptions no_extended_glob
  local f="$1" line label fpath
  DNAV_FOLDER_NAMES=()
  DNAV_FOLDER_PATHS=()
  [[ -f $f ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    line="$(_dnav_trim "$(_dnav_strip_comment "$line")")"
    [[ -z $line ]] && continue
    label="${line%%[[:space:]]*}"
    fpath="${line#"$label"}"
    fpath="${fpath#"${fpath%%[![:space:]]*}"}"
    [[ -z $label ]] && continue
    # Skip legacy Help/About rows — About is always hardcoded by dnav
    if [[ -z $fpath || $fpath == - ]]; then
      continue
    fi
    if [[ ${(L)label} == help || ${(L)label} == about ]]; then
      continue
    fi
    DNAV_FOLDER_NAMES+=("$label")
    DNAV_FOLDER_PATHS+=("$(_dnav_expand_path "$fpath")")
  done < "$f"
  (( ${#DNAV_FOLDER_NAMES} > 0 ))
}

# Persist folders file (About is never written — hardcoded in TUI).
_dnav_folders_save() {
  emulate -L zsh
  setopt localoptions no_multios clobber
  local dir="${DNAV_CONFIG_DIR:-$(_dnav_config_dir)}"
  local f="$dir/folders"
  local tmp i dest store
  /bin/mkdir -p -- "$dir" || return 1
  tmp="${f}.tmp.$$"
  {
    print -r -- "# Main dnav bar — Label path"
    print -r -- "# About is always added by dnav (do not list it here)."
    print -r -- "#"
    for (( i=1; i <= $#DNAV_FOLDER_NAMES; i++ )); do
      dest="${DNAV_FOLDER_PATHS[i]}"
      [[ -z $dest ]] && continue
      store="$dest"
      if [[ $store == "$HOME" ]]; then
        store="~"
      elif [[ $store == "$HOME/"* ]]; then
        store="~${store#$HOME}"
      fi
      print -r -- "${DNAV_FOLDER_NAMES[i]}  $store"
    done
  } > "$tmp" || { /bin/rm -f -- "$tmp"; return 1 }
  /bin/mv -f -- "$tmp" "$f" || { /bin/rm -f -- "$tmp"; return 1 }
}

# Persist jumps file from current map (shared with djump add|edit|remove).
_dnav_jumps_save() {
  (( $+functions[_djump_save] )) || return 1
  _djump_save
}

# Current config keys + built-in defaults. One "key value" per line.
_dnav_config_defaults() {
  emulate -L zsh
  _dnav_config_schema_init
  local key def
  for key in "${_DNAV_CFG_KEYS[@]}"; do
    def="${_DNAV_CFG_DEF[$key]}"
    [[ -n $def ]] || continue
    print -r -- "$key $def"
  done
}

_dnav_config_key_note() {
  _dnav_config_schema_init
  local n="${_DNAV_CFG_NOTE[$1]:-}"
  [[ -n $n ]] && print -r -- "$n"
}

_dnav_config_canon_key() {
  emulate -L zsh
  _dnav_config_schema_init
  local k="${(L)1}"
  print -r -- "${_DNAV_CFG_CANON[$k]:-$k}"
}

# Uncommented assignment keys in a config file (canonical names).
_dnav_config_existing_keys() {
  local f="$1" line stripped k
  [[ -f $f ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    stripped="${line#"${line%%[![:space:]]*}"}"
    [[ -z $stripped || $stripped == \#* ]] && continue
    [[ $stripped == *=* ]] || continue
    k="${stripped%%=*}"
    k="${k%"${k##*[![:space:]]}"}"
    k="${k#"${k%%[![:space:]]*}"}"
    [[ -n $k ]] && _dnav_config_canon_key "$k"
  done < "$f"
}

# Append any missing default keys and ensure each known key has its note.
# Never changes existing values. Prints the number of keys added.
_dnav_config_merge_defaults() {
  emulate -L zsh
  setopt localoptions no_multios clobber
  local dir="${1:-${DNAV_CONFIG_DIR:-$(_dnav_config_dir)}}"
  local f="$dir/config"
  local tmp rec key val k added=0 changed=0
  local line stripped prev_comment=0 note last_comment=""
  typeset -A have
  /bin/mkdir -p -- "$dir" || return 1
  [[ -f $f ]] || print -r -- "# DNav settings" > "$f" || return 1
  for k in $(_dnav_config_existing_keys "$f"); do
    have[$k]=1
  done
  tmp="${f}.tmp.$$"
  {
    while IFS= read -r line || [[ -n $line ]]; do
      stripped="${line#"${line%%[![:space:]]*}"}"
      if [[ -z $stripped ]]; then
        print -r -- "$line"
        prev_comment=0
        continue
      fi
      if [[ $stripped == \#* ]]; then
        print -r -- "$line"
        prev_comment=1
        last_comment="$stripped"
        continue
      fi
      if [[ $stripped == *=* ]]; then
        k="${stripped%%=*}"
        k="${k%"${k##*[![:space:]]}"}"
        k="${k#"${k%%[![:space:]]*}"}"
        k="$(_dnav_config_canon_key "$k")"
        note="$(_dnav_config_key_note "$k")"
        if [[ -n $note ]]; then
          if (( prev_comment == 0 )) || [[ $last_comment == '# added by dnav'* || $last_comment == '# added by dupdate'* ]]; then
            print -r -- "# $note"
            changed=1
          fi
        fi
        print -r -- "$line"
        prev_comment=0
        continue
      fi
      print -r -- "$line"
      prev_comment=0
    done
  } < "$f" > "$tmp"
  while IFS= read -r rec; do
    key="${rec%% *}"
    val="${rec#* }"
    [[ -n ${have[$key]:-} ]] && continue
    if (( added == 0 )); then
      print -r -- "" >> "$tmp"
      print -r -- "# added by dnav (previous values were kept)" >> "$tmp"
    else
      print -r -- "" >> "$tmp"
    fi
    note="$(_dnav_config_key_note "$key")"
    [[ -n $note ]] && print -r -- "# $note" >> "$tmp"
    print -r -- "$key = $val" >> "$tmp"
    have[$key]=1
    (( added++ ))
    changed=1
  done < <(_dnav_config_defaults)
  if (( changed )); then
    /bin/mv -f -- "$tmp" "$f" || { /bin/rm -f -- "$tmp"; return 1 }
  else
    /bin/rm -f -- "$tmp"
  fi
  print -r -- "$added"
}

# Load (and seed) user config. Safe to call multiple times (dconfig -r).
_dnav_config_load() {
  DNAV_CONFIG_DIR="$(_dnav_config_dir)"
  local key
  _dnav_config_schema_init
  for key in "${_DNAV_CFG_KEYS[@]}"; do
    _dnav_config_assign "$key" "${_DNAV_CFG_DEF[$key]}"
  done
  DNAV_FOLDER_NAMES=()
  DNAV_FOLDER_PATHS=()

  # Creates only files that are missing; never overwrites user edits.
  _dnav_config_seed "$DNAV_CONFIG_DIR"

  _dnav_config_load_kv "$DNAV_CONFIG_DIR/config"
  _dnav_apply_colors
  _dnav_config_load_folders "$DNAV_CONFIG_DIR/folders" || true

  # Export search roots for dsearch (bg index worker inherits the environment).
  if [[ -n $DNAV_CFG_SEARCH_ROOTS && ! -v DNAV_SEARCH_ROOTS ]]; then
    export DNAV_SEARCH_ROOTS="${DNAV_CFG_SEARCH_ROOTS//\$HOME/$HOME}"
  fi
}

