# After successful navigation (call only once terminal is restored). No-op on cancel paths.
# $1 = dnav | djump  (specific flags inherit ls_after when unset / -1)
_dnav_want_ls() {
  local ctx="${1:-dnav}"
  case $ctx in
    djump)
      if (( DNAV_CFG_LS_DJUMP >= 0 )); then (( DNAV_CFG_LS_DJUMP )); else (( DNAV_CFG_LS )); fi ;;
    *)
      if (( DNAV_CFG_LS_DNAV >= 0 )); then (( DNAV_CFG_LS_DNAV )); else (( DNAV_CFG_LS )); fi ;;
  esac
}

_dnav_want_bar() {
  local ctx="${1:-dnav}"
  case $ctx in
    djump)
      if (( DNAV_CFG_SUCCESS_BAR_DJUMP >= 0 )); then (( DNAV_CFG_SUCCESS_BAR_DJUMP )); else (( DNAV_CFG_SUCCESS_BAR )); fi ;;
    *)
      if (( DNAV_CFG_SUCCESS_BAR_DNAV >= 0 )); then (( DNAV_CFG_SUCCESS_BAR_DNAV )); else (( DNAV_CFG_SUCCESS_BAR )); fi ;;
  esac
}

_dnav_maybe_ls() {
  _dnav_want_ls "${1:-dnav}" || return 0
  command ls -a --color=auto
}

_dnav_term_cols() {
  local r c
  if read -r r c <<< "$(stty size 2>/dev/null)"; then
    if [[ $c == <-> ]] && (( c >= 8 )); then
      print -rn -- "$c"
      return 0
    fi
  fi
  if [[ ${COLUMNS:-0} == <-> ]] && (( COLUMNS >= 8 )); then
    print -rn -- "$COLUMNS"
    return 0
  fi
  print -rn -- 80
}

_dnav_sync_term_size() {
  local r c
  if read -r r c <<< "$(stty size 2>/dev/null)"; then
    if [[ $c == <-> ]] && (( c >= 8 )); then
      COLUMNS=$c
    fi
    if [[ $r == <-> ]] && (( r >= 4 )); then
      LINES=$r
    fi
  fi
}

# Paint width. Spare 2, not 1: a line painted at COLUMNS-1 becomes exactly
# full-width after a 1-col shrink, the terminal soft-wraps, and the screen
# scrolls (bar walks up; blank lines pile up below). COLUMNS-2 stays short.
_dnav_usable_from() {
  local w="${1:-0}"
  [[ $w == <-> ]] || w=80
  (( w > 2 )) && (( w -= 2 ))
  (( w < 8 )) && w=8
  print -rn -- "$w"
}

_dnav_usable_cols() {
  _dnav_usable_from "$(_dnav_term_cols)"
}

# DECAWM (CSI ? 7). Off: write/shrink clips on the right instead of wrapping
# onto the next row. Must be restored in cleanup or the user's shell wraps wrong.
_dnav_autowrap_off() { printf '\e[?7l'; }
_dnav_autowrap_on()  { printf '\e[?7h'; }

typeset -gi _DNAV_RESIZING=0
typeset -gi _DNAV_RESIZE_MODE=0
typeset -gi _DNAV_INLINE_EDIT=0
typeset -gi _DNAV_WINCH=0
typeset -gi _DNAV_LAST_COLS=0
typeset -gi _DNAV_LAST_LINES=0
typeset -gi _DNAV_PEND_COLS=0
typeset -gi _DNAV_PEND_LINES=0
typeset -gi _DNAV_STEADY=0
# Identical stty samples required before leaving resize mode (~6×0.04s).
typeset -gi _DNAV_STEADY_NEED=6

# Brand chip text only — same bytes as the live TUI, no extra spaces.
_dnav_resize_chip_label() {
  if (( ${+_DSEARCH_OPEN} && _DSEARCH_OPEN )); then
    print -r -- " DNav Search:"
  elif (( $+functions[_dfile_is_open] )) && _dfile_is_open; then
    print -r -- " DNav Files:"
  elif [[ ${mode:-} == about ]]; then
    print -r -- " DNav About:"
  else
    print -r -- " ${DNAV_CFG_BRAND:-DNav} "
  fi
}

# Rows currently painted below the top TUI line (search 0–10, dfile 3, …).
_dnav_tui_below() {
  if (( ${+_DSEARCH_OPEN} && _DSEARCH_OPEN )); then
    print -rn -- "${_dsearch_extra_lines:-0}"
  elif (( $+functions[_dfile_is_open] )) && _dfile_is_open; then
    print -rn -- "${body:-3}"
  elif [[ ${mode:-} == about ]]; then
    print -rn -- "${help_extra:-0}"
  else
    print -rn -- 0
  fi
}

_dnav_wipe_below() {
  local n="${1:-0}" i
  [[ $n == <-> ]] || n=0
  (( n > 0 )) || return 0
  for (( i=0; i < n; i++ )); do
    printf "\n\r\e[2K"
  done
  printf "\e[%dA" $n
}

_dnav_paint_resize_chip() {
  local hl rst label below
  hl="${DNAV_HIGHLIGHT:-\e[30;46m}"
  rst="${DNAV_RESET:-\e[0m}"
  label="$(_dnav_resize_chip_label)"
  below="$(_dnav_tui_below)"
  printf "\e[?25l\r${hl}%s${rst}\e[K" "$label"
  _dnav_wipe_below "$below"
  printf "\r"
}

_dnav_mark_size() {
  _DNAV_LAST_COLS=${COLUMNS:-0}
  _DNAV_LAST_LINES=${LINES:-0}
}

_dnav_resize_finish() {
  _DNAV_RESIZE_MODE=0
  _DNAV_STEADY=0
  _DNAV_PEND_COLS=0
  _DNAV_PEND_LINES=0
  _DNAV_WINCH=0
  _dnav_handle_winch
  _dnav_mark_size
}

# Call from the TUI read loop. Compact chip while WINCH fires or stty is
# still changing. Full redraw only after STEADY_NEED identical samples.
_dnav_maybe_resize() {
  local c l
  (( ${DNAV_ABORT:-0} )) && return 1
  (( _DNAV_INLINE_EDIT )) && return 1
  _dnav_sync_term_size
  c=${COLUMNS:-0}
  l=${LINES:-0}
  if (( _DNAV_LAST_COLS == 0 )); then
    _dnav_mark_size
    return 1
  fi

  if (( _DNAV_WINCH || c != _DNAV_LAST_COLS || l != _DNAV_LAST_LINES )); then
    if (( _DNAV_WINCH || c != _DNAV_PEND_COLS || l != _DNAV_PEND_LINES || ! _DNAV_RESIZE_MODE )); then
      _DNAV_PEND_COLS=$c
      _DNAV_PEND_LINES=$l
      _DNAV_STEADY=0
      _DNAV_WINCH=0
      _DNAV_RESIZE_MODE=1
      _dnav_paint_resize_chip
      return 1
    fi
    # Same stty size as last sample, no new WINCH — still counting.
    (( _DNAV_STEADY++ ))
    if (( _DNAV_STEADY < _DNAV_STEADY_NEED )); then
      return 1
    fi
    _dnav_resize_finish
    return 0
  fi

  # stty matches the pre-resize size. Stay compact until WINCH/stty settle.
  if (( _DNAV_RESIZE_MODE )); then
    (( _DNAV_STEADY++ ))
    if (( _DNAV_STEADY < _DNAV_STEADY_NEED )); then
      return 1
    fi
    _dnav_resize_finish
    return 0
  fi

  _DNAV_WINCH=0
  return 1
}

# Blocking key read that still notices terminal resizes (WINCH often
# does not interrupt a bare read -k). Poll ~25×/sec so resize mode starts
# before the bar can reflow.
_dnav_read_key() {
  REPLY=""
  while true; do
    (( ${DNAV_ABORT:-0} )) && return 1
    if (( _DNAV_WINCH )); then
      (( $+functions[_dnav_maybe_resize] )) && _dnav_maybe_resize
    fi
    if read -t 0.04 -k 1 REPLY 2>/dev/null; then
      (( $+functions[_dnav_maybe_resize] )) && _dnav_maybe_resize
      [[ -n $REPLY ]] && return 0
    else
      (( $+functions[_dnav_maybe_resize] )) && _dnav_maybe_resize
    fi
  done
}

# Redraw in place. Autowrap is off so shrink clips on the right; do not CUU
# (that is what walked the bar up the screen).
_dnav_handle_winch() {
  (( _DNAV_RESIZING )) && return 0
  (( ${DNAV_ABORT:-0} )) && return 0
  _DNAV_RESIZING=1
  _dnav_sync_term_size
  if [[ -n ${cols+x} ]]; then
    cols="$(_dnav_usable_cols)"
  fi
  if (( _DNAV_INLINE_EDIT )); then
    _DNAV_RESIZING=0
    return 0
  fi
  printf "\e[?25l\r\e[2K\e[J"
  if (( ${+_DSEARCH_OPEN} && _DSEARCH_OPEN )); then
    (( $+functions[_dsearch_draw] )) && _dsearch_draw "${_dsearch_q:-}"
  elif (( $+functions[_dfile_is_open] )) && _dfile_is_open; then
    (( $+functions[_dfile_draw] )) && _dfile_draw
  elif [[ ${mode:-} == about ]]; then
    (( $+functions[_dnav_draw_about] )) && _dnav_draw_about
  elif (( $+functions[_dnav_draw] )); then
    (( $+functions[_dnav_compute_positions] )) && _dnav_compute_positions
    _dnav_draw
  fi
  _DNAV_RESIZING=0
}

# Fit string to width, keep the end (most specific path tail).
_dnav_fit_end() {
  local s="$1" w="$2"
  (( w < 1 )) && { print -rn -- ""; return }
  if (( ${#s} <= w )); then
    print -r -- "$s"
    return
  fi
  if (( w == 1 )); then
    print -r -- "…"
    return
  fi
  print -r -- "…${s: -$((w - 1))}"
}

# Set a key=value in ~/.config/dnav/config (preserves other lines / comments).
# Creates the file if needed. Always writes through a temp file + mv.
_dnav_config_set() {
  emulate -L zsh
  setopt localoptions no_multios clobber
  local key="$1" val="$2"
  local dir="${DNAV_CONFIG_DIR:-$(_dnav_config_dir)}"
  local f="$dir/config"
  local tmp line k found=0 stripped
  local key_l="${(L)key}"
  [[ -n $key ]] || return 1
  /bin/mkdir -p -- "$dir" || return 1
  [[ -f $f ]] || print -r -- "# DNav settings" > "$f" || return 1
  tmp="${f}.tmp.$$"
  {
    while IFS= read -r line || [[ -n $line ]]; do
      stripped="${line#"${line%%[![:space:]]*}"}"
      if [[ -z $stripped || $stripped == \#* ]]; then
        print -r -- "$line"
        continue
      fi
      if [[ $line == *=* ]]; then
        k="${line%%=*}"
        k="${k%"${k##*[![:space:]]}"}"
        k="${k#"${k%%[![:space:]]*}"}"
        if [[ ${(L)k} == $key_l ]]; then
          print -r -- "$key = $val"
          found=1
          continue
        fi
      fi
      print -r -- "$line"
    done
    (( found )) || print -r -- "$key = $val"
  } < "$f" > "$tmp" || { /bin/rm -f -- "$tmp"; return 1 }
  /bin/mv -f -- "$tmp" "$f" || { /bin/rm -f -- "$tmp"; return 1 }
  return 0
}

# Persist inherit/-1/1/0 cycle3 flags as inherit|1|0 in the config file.
_dnav_cfg_cycle3_store() {
  case $1 in
    -1) print -rn -- inherit ;;
    1)  print -rn -- 1 ;;
    *)  print -rn -- 0 ;;
  esac
}

# Shared location bar (TUI select, dsearch, and shell djump/dKEY).
# $1 = path; $2 = optional expand origin column; $3 = dnav|djump (bar visibility).
# Always one terminal row: width from stty, tail-truncate, never fill last column.
_dnav_success_bar() {
  local bar_path="$1"
  local origin_mid="${2:-}"
  local ctx="${3:-dnav}"
  local hl="${DNAV_HIGHLIGHT:-\e[30;46m}"
  local rst="${DNAV_RESET:-\e[0m}"
  local max_w usable
  local step left right width half display
  local anim=${DNAV_CFG_SUCCESS_ANIM:-1}
  local steps=${DNAV_CFG_SUCCESS_ANIM_STEPS:-8}
  local ms=${DNAV_CFG_SUCCESS_ANIM_MS:-25}
  local cs delay

  _dnav_want_bar "$ctx" || return 0

  max_w="$(_dnav_term_cols)"
  # Last column wrap (iSH / narrow ttys): keep one spare cell
  usable=$(( max_w > 1 ? max_w - 1 : 1 ))
  (( steps < 1 )) && steps=1
  (( ms < 1 )) && ms=1
  if [[ -z $origin_mid ]]; then
    origin_mid=$(( usable / 2 ))
  fi
  (( origin_mid >= usable )) && origin_mid=$(( usable / 2 ))

  if (( anim )); then
    cs=$(( (ms + 5) / 10 ))
    (( cs < 1 )) && cs=1
    delay=$(printf '0.%03d' $ms)
    for (( step=1; step <= steps; step++ )); do
      half=$(( (usable * step) / (2 * steps) ))
      left=$(( origin_mid - half ))
      right=$(( origin_mid + half ))
      (( left < 0 )) && left=0
      (( right > usable )) && right=$usable
      width=$(( right - left ))
      printf "\r\e[2K"
      printf "\e[${left}C${hl}%*s${rst}" $width ""
      if zmodload -F zsh/zselect b:zselect 2>/dev/null; then
        zselect -t $cs
      else
        /bin/sleep "$delay" 2>/dev/null || /usr/bin/sleep "$delay" 2>/dev/null || true
      fi
    done
  fi

  display="$(_dnav_fit_end "$bar_path" $usable)"
  printf "\r${hl}%-${usable}s${rst}\e[K\n" "$display"
}

# List shell-facing DNav commands (not in-TUI plugins).
dhelp() {
  local hl="${DNAV_HIGHLIGHT:-\e[30;46m}"
  local rst="${DNAV_RESET:-\e[0m}"
  local k path

  print -r -- "${hl} DNav ${rst}"
  print -r -- "  dnav                 open the folder navigator"
  print -r -- "  dnav --update        refresh scripts + merge new config keys"
  print -r -- "  dhelp                this command list"
  print -r -- "  dconfig              reload/edit config (~/.config/dnav)"
  print -r -- "  djump                list jump aliases (djump -l)"
  print -r -- "  djump KEY            jump to KEY (same as dKEY)"
  print -r -- "  djump add|edit|rm    manage jump favorites"
  print -r -- "  djump -r             reload jumps file + dKEY commands"
  print -r -- "  config dir           ${DNAV_CONFIG_DIR:-$(_dnav_config_dir)}"
  print -r -- "  ls_after             set in config (not an env var)"

  if (( $+functions[_djump_available] )) && _djump_available 2>/dev/null; then
    if _djump_ensure 2>/dev/null; then
      print -r -- ""
      print -r -- "${hl} DJump aliases ${rst}"
      local cmd
      for k in "${_DJUMP_KEYS[@]}"; do
        cmd="d${k}"
        path="${_DJUMP_MAP[$k]}"
        print -r -- "  ${(r:18:)cmd}  $path"
      done
      (( $+functions[_djump_warn_stolen] )) && _djump_warn_stolen
    fi
  fi
}

dnav() {
  case ${1:-} in
    -u|--update)
      shift
      _dnav_update "$@"
      return $?
      ;;
    -h|--help)
      print -r -- "usage: dnav [--update]"
      print -r -- "  (no args)      open the folder navigator"
      print -r -- "  -u, --update   copy scripts from the DNav repo + merge new config keys"
      print -r -- "  -h, --help     this help"
      return 0
      ;;
  esac

  # ── Style from config (~/.config/dnav/config) ───────────────────────────
  local HIGHLIGHT_FG=${DNAV_CFG_COLOR_FG:-30}
  local HIGHLIGHT_BG=${DNAV_CFG_COLOR_BG:-46}
  local HIGHLIGHT=$'\e['"${HIGHLIGHT_FG}"';'"${HIGHLIGHT_BG}"'m'
  local RESET=$'\e[0m'
  typeset -g DNAV_HIGHLIGHT=$HIGHLIGHT DNAV_RESET=$RESET

  local -a names paths
  local selected=0
  local key key2 key3
  local i
  local current
  local target
  local cols="$(_dnav_usable_cols)"
  local -a item_start item_end   # column positions for animation (visible chips)
  local mode=main                # main | about
  local brand="${DNAV_CFG_BRAND:-DNav}"
  local help_extra=0             # lines below top while in about overlay
  local bar_win=0                # first visible selectable index (scroll)

  # Folder list from config (fallback defaults), then always append About
  if (( ${#DNAV_FOLDER_NAMES} > 0 )); then
    names=("${DNAV_FOLDER_NAMES[@]}")
    paths=("${DNAV_FOLDER_PATHS[@]}")
  else
    names=(Home Docs Down EbSync Projects Config Apps Share)
    paths=(
      "$HOME"
      "${XDG_DOCUMENTS_DIR:-$HOME/Documents}"
      "${XDG_DOWNLOAD_DIR:-$HOME/Downloads}"
      "${XDG_EBTRANSFER_DIR:-$HOME/Eb_Transfer}"
      "${XDG_PROJECTS_DIR:-$HOME/Projects}"
      "${XDG_CONFIG_HOME:-$HOME/.config}"
      "${XDG_APPS_DIR:-$HOME/Apps}"
      "${XDG_DATA_HOME:-$HOME/.local/share}"
    )
  fi
  # Hardcoded About chip (not user-configurable)
  names+=(About)
  paths+=("")

  # Pre-select the folder that matches the current directory, if any
  current="${PWD:A}"
  for (( i=1; i <= $#paths; i++ )); do
    if [[ -n ${paths[i]} && "${paths[i]:A}" == "$current" ]]; then
      selected=$((i - 1))
      break
    fi
  done

  # Save terminal settings (globals: EXIT trap may run after function locals die)
  typeset -g _DNAV_STTY_ORIG _DNAV_CLEANED
  _DNAV_STTY_ORIG=$(stty -g 2>/dev/null)
  _DNAV_CLEANED=0
  # Ctrl+C must restore tty AND leave the TUI (trap alone would only run cleanup
  # and then continue the read loop — shell felt "stuck").
  #
  # LOCAL_TRAPS is required: without it, INT/TERM/QUIT traps set here leak into
  # the interactive shell after dnav returns, so Ctrl+C no longer interrupts
  # (it only runs our trap body). With localtraps, EXIT also runs on function
  # return (not only shell exit), which is what we want for tty restore.
  setopt localoptions localtraps
  typeset -g DNAV_ABORT=0
  DNAV_ABORT=0

  _dnav_cleanup() {
    (( _DNAV_CLEANED )) && return
    # Stop background search index if still running (user left early)
    (( $+functions[_dsearch_index_cancel] )) && _dsearch_index_cancel
    [[ -n $_DNAV_STTY_ORIG ]] && stty "$_DNAV_STTY_ORIG" 2>/dev/null
    _dnav_autowrap_on
    printf "\e[0 q\e[?25h"
    _DNAV_CLEANED=1
  }

  # Wipe the main bar / help overlay (not plugin body lines).
  _dnav_clear_menu() {
    local i
    printf "\r\e[2K"
    for (( i=0; i < help_extra; i++ )); do
      printf "\n\e[2K"
    done
    if (( help_extra > 0 )); then
      printf "\e[%dA" $help_extra
    fi
    printf "\r\e[2K"
    help_extra=0
  }

  # Full abort: tear down plugin UIs, clear the bar, restore tty.
  # Used by INT/TERM/QUIT and by Ctrl+C as a byte ($'\x03').
  _dnav_abort() {
    DNAV_ABORT=1
    (( $+functions[_dsearch_index_cancel] )) && _dsearch_index_cancel
    # Innermost plugin UIs first (dsearch may sit on dfile or main).
    if (( $+functions[_dsearch_erase_ui] )) && {
         (( ${_dsearch_extra_lines:-0} > 0 )) || [[ -n ${_dsearch_tmpdir:-} ]]
       }; then
      _dsearch_erase_ui
      (( $+functions[_dsearch_session_cleanup] )) && _dsearch_session_cleanup
    fi
    if (( ${+_DFILE_OPEN} && _DFILE_OPEN )); then
      (( $+functions[_dfile_erase] )) && _dfile_erase
      _DFILE_OPEN=0
    fi
    _dnav_clear_menu
    _dnav_cleanup
  }

  trap '_dnav_cleanup' EXIT
  # return 130 exits the interrupted function (dnav / nested plugin loop).
  # Parents check DNAV_ABORT and propagate so we fully leave the TUI.
  trap '_dnav_abort; return 130' INT TERM QUIT
  trap '_DNAV_WINCH=1' WINCH

  # Hide cursor, disable echo and line buffering (keep isig for Ctrl+C)
  stty -echo -icanon isig 2>/dev/null
  printf "\e[?25l"
  _dnav_autowrap_off

  # Warm the directory search index in the background (interruptible on exit)
  if (( $+functions[_dsearch_index_start_bg] )); then
    _dsearch_index_start_bg
  fi

  # Brand width: " Brand " + trailing space
  _dnav_brand_w() { print -rn -- $(( ${#brand} + 3 )); }

  # Keep selected chip in the horizontal window; sets bar_win.
  _dnav_ensure_bar_visible() {
    local brand_w=$(_dnav_brand_w)
    local avail=$(( cols - brand_w ))
    (( avail < 10 )) && avail=10
    local old_win=$bar_win
    if (( $+functions[_dfile_window] )); then
      _dfile_window names $selected $bar_win $avail
      bar_win=$reply[1]
    else
      (( selected < bar_win )) && bar_win=$selected
      # grow window from bar_win until selected fits or overflow
      local used=0 i w
      for (( i=bar_win; i <= selected; i++ )); do
        w=$(( ${#names[i+1]} + 3 ))
        (( used + w > avail && i > bar_win )) && bar_win=$(( selected > 0 ? selected : 0 ))
        (( used += w ))
      done
      (( bar_win < 0 )) && bar_win=0
    fi
    reply=($old_win $bar_win)
  }

  # Layout visible chips for partial paint / success animation origin.
  _dnav_compute_positions() {
    local brand_w=$(_dnav_brand_w)
    local avail=$(( cols - brand_w ))
    (( avail < 10 )) && avail=10
    local col=$brand_w more_l=0 more_r=0 content_w=$avail
    local i label cell_w used=0 n=$#names
    item_start=()
    item_end=()
    _dnav_ensure_bar_visible
    (( bar_win > 0 )) && more_l=1
    # rough more_r probe
    used=0
    for (( i=bar_win; i < n; i++ )); do
      cell_w=$(( ${#names[i+1]} + 3 ))
      if (( used > 0 && used + cell_w > avail )); then
        more_r=1
        break
      fi
      (( used += cell_w ))
    done
    (( more_l )) && (( content_w -= 2 ))
    (( more_r )) && (( content_w -= 2 ))
    (( content_w < 4 )) && content_w=4
    col=$brand_w
    (( more_l )) && (( col += 2 ))
    used=0
    for (( i=bar_win; i < n; i++ )); do
      label="${names[i+1]}"
      cell_w=$(( ${#label} + 3 ))
      if (( used > 0 && used + cell_w > content_w )); then
        break
      fi
      item_start[i+1]=$col
      (( col += cell_w ))
      item_end[i+1]=$col
      (( used += cell_w ))
    done
  }

  # Full bar paint: brand + scrolling folder chips + < > overflow.
  _dnav_draw() {
    cols="$(_dnav_usable_cols)"
    local brand_w=$(_dnav_brand_w)
    local avail=$(( cols - brand_w ))
    (( avail < 10 )) && avail=10
    printf "\e[?25l\r"
    printf "${HIGHLIGHT} %s ${RESET} " "$brand"
    if (( $+functions[_dfile_paint_strip] )); then
      _dfile_paint_strip names $selected $bar_win 1 $avail
      bar_win=$reply[1]
    else
      _dnav_ensure_bar_visible
      local i label used=0 n=$#names cell_w more_l=0 more_r=0
      (( bar_win > 0 )) && more_l=1
      for (( i=bar_win; i < n; i++ )); do
        cell_w=$(( ${#names[i+1]} + 3 ))
        if (( used > 0 && used + cell_w > avail - (more_l ? 2 : 0) - 2 )); then
          more_r=1
          break
        fi
        (( used += cell_w ))
      done
      (( more_l )) && printf "\e[2m<\e[22m "
      used=0
      local content_w=$(( avail - (more_l ? 2 : 0) - (more_r ? 2 : 0) ))
      (( content_w < 4 )) && content_w=4
      for (( i=bar_win; i < n; i++ )); do
        label="${names[i+1]}"
        cell_w=$(( ${#label} + 3 ))
        if (( used > 0 && used + cell_w > content_w )); then
          break
        fi
        if (( i == selected )); then
          printf "${HIGHLIGHT} %s ${RESET} " "$label"
        else
          printf " %s  " "$label"
        fi
        (( used += cell_w ))
      done
      (( more_r )) && printf " \e[2m>\e[22m"
      printf "\e[K"
    fi
    _dnav_compute_positions
    printf "\r"
  }

  # Repaint one visible chip (partial redraw). idx = 0-based into names.
  _dnav_paint_item() {
    local idx="$1"
    local i=$(( idx + 1 ))
    [[ -n ${item_start[i]:-} ]] || return
    printf "\e[%dG" $(( item_start[i] + 1 ))
    if (( idx == selected )); then
      printf "${HIGHLIGHT} %s ${RESET} " "${names[i]}"
    else
      printf " %s  " "${names[i]}"
    fi
  }

  _dnav_move_left() {
    local old=$selected old_win=$bar_win
    (( selected > 0 )) || return
    (( selected-- ))
    _dnav_ensure_bar_visible
    if (( DNAV_CFG_FULL_REDRAW || bar_win != old_win )); then
      _dnav_draw
    else
      _dnav_compute_positions
      _dnav_paint_item $old
      _dnav_paint_item $selected
      printf "\r"
    fi
  }

  _dnav_move_right() {
    local old=$selected old_win=$bar_win
    (( selected < $#names - 1 )) || return
    (( selected++ ))
    _dnav_ensure_bar_visible
    if (( DNAV_CFG_FULL_REDRAW || bar_win != old_win )); then
      _dnav_draw
    else
      _dnav_compute_positions
      _dnav_paint_item $old
      _dnav_paint_item $selected
      printf "\r"
    fi
  }

