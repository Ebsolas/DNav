#!/usr/bin/env zsh
# dsearch - fuzzy directory search plugin for dnav
#
# Provides:
#   _dsearch_available    – always true when this file is sourced
#   _dsearch_start        – search overlay (return 0 = navigated/done, 1 = cancel → main)
#   _dsearch_ensure_index – ensure on-disk directory path cache is fresh
#
# Strategy: load-once path list, awk scorer (soft-AND, component-bounded, not pure zsh).
# Index: ${XDG_CACHE_HOME:-$HOME/.cache}/dnav/dirs.idx  (dirs only)
# Auto-rebuild: config index_auto / index_when / index_ttl_hours (dnav --reindex always rebuilds).
# Scope: $HOME by default. Extra trees via DNAV_SEARCH_ROOTS or config search_roots.

_dsearch_available() { return 0 }

# ── Background index (starts with dnav; interruptible) ────────────────────
# Uses an external zsh worker + PID file so interactive shells never print
# "done" job lines (breaks TUI layout on iSH / busybox environments).
typeset -gi _DSEARCH_INDEX_PID=0
typeset -gi _DSEARCH_INDEX_HAS_SID=0
typeset -g  _DSEARCH_INDEX_COUNT_FILE=""
typeset -g  _DSEARCH_INDEX_PID_FILE=""
typeset -g  _DSEARCH_INDEX_TMP=""
typeset -g  _DSEARCH_INDEX_STATE=idle   # idle|running|done|failed|cancelled

# ── Index ─────────────────────────────────────────────────────────────────
_dsearch_index_path() {
  print -r -- "${XDG_CACHE_HOME:-$HOME/.cache}/dnav/dirs.idx"
}

_dsearch_index_dir() {
  print -r -- "${XDG_CACHE_HOME:-$HOME/.cache}/dnav"
}

# Portable mtime (GNU stat, BSD stat, or python fallback).
_dsearch_file_mtime() {
  local f="$1" m
  m=$(stat -c %Y -- "$f" 2>/dev/null) && { print -rn -- "$m"; return 0; }
  m=$(stat -f %m -- "$f" 2>/dev/null) && { print -rn -- "$m"; return 0; }
  m=$(python3 -c 'import os,sys; print(int(os.path.getmtime(sys.argv[1])))' "$f" 2>/dev/null) && {
    print -rn -- "$m"; return 0
  }
  return 1
}

# Seconds until dirs.idx is stale. 0 = never (missing/empty still counts as stale).
_dsearch_index_ttl_sec() {
  local h="${DNAV_CFG_INDEX_TTL_HOURS:-24}"
  [[ $h == <-> ]] || h=24
  print -rn -- $(( h * 3600 ))
}

# 0 if auto-index should run in this context (open | search).
_dsearch_index_wanted() {
  local ctx="${1:-open}"
  (( ${DNAV_CFG_INDEX_AUTO:-1} )) || return 1
  local when="${(L)DNAV_CFG_INDEX_WHEN:-open}"
  case $when in
    search|s)
      [[ $ctx == search ]]
      ;;
    *)
      return 0
      ;;
  esac
}

_dsearch_index_stale() {
  local idx="$1" now mtime age ttl
  [[ ! -f $idx || ! -s $idx ]] && return 0
  ttl="$(_dsearch_index_ttl_sec)"
  (( ttl <= 0 )) && return 1
  now=$(date +%s 2>/dev/null) || return 0
  mtime="$(_dsearch_file_mtime "$idx")" || return 0
  age=$(( now - mtime ))
  (( age > ttl ))
}

_dsearch_index_count() {
  local n=0 f="$_DSEARCH_INDEX_COUNT_FILE"
  [[ -z $f || ! -f $f ]] && { print -rn -- 0; return; }
  n=$(tr -cd '0-9' <"$f" 2>/dev/null)
  [[ -n $n ]] || n=0
  print -rn -- "$n"
}

# Constrained environments (iSH): keep indexing light.
# A desktop box that happens to have a busybox binary is not light mode.
_dsearch_constrained_env() {
  [[ -n ${DNAV_SEARCH_LIGHT:-} ]] && return 0
  [[ -d /var/ish || -d /ish || -e /proc/ish ]] && return 0
  uname -a 2>/dev/null | grep -Eiq 'ish|iphone|ipod|ipad' && return 0
  return 1
}

# True if a background index is still running (poll PID file; never wait).
_dsearch_index_running() {
  local pid=$_DSEARCH_INDEX_PID pf="$_DSEARCH_INDEX_PID_FILE"
  if (( pid <= 0 )) && [[ -n $pf && -f $pf ]]; then
    pid=$(tr -cd '0-9' <"$pf" 2>/dev/null)
    [[ -n $pid ]] && _DSEARCH_INDEX_PID=$pid
  fi
  (( _DSEARCH_INDEX_PID > 0 )) || return 1
  if kill -0 $_DSEARCH_INDEX_PID 2>/dev/null; then
    return 0
  fi
  # Process gone — clear without wait (avoids job-control "done" lines)
  _DSEARCH_INDEX_PID=0
  [[ -n $pf ]] && rm -f -- "$pf" 2>/dev/null
  return 1
}

# True if mount/path is virtual or not useful for interactive navigation.
_dsearch_skip_root() {
  case $1 in
    /proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/run|/run/user/*|/run/systemd/*) return 0 ;;
    /boot|/boot/*|/tmp|/var/tmp|/var/log|/var/cache|/var/lib/docker/*) return 0 ;;
    /snap|/var/lib/snapd/snap) return 0 ;;
    *) return 1 ;;
  esac
}

# Collect user-facing directory roots to index.
_dsearch_collect_roots() {
  local -a roots
  local -A seen
  local r m

  _dsearch_add_root() {
    local p="$1"
    [[ -n $p && -d $p && -r $p ]] || return
    _dsearch_skip_root "$p" && return
    if (( $+functions[_dnav_logical_path] )); then
      p="$(_dnav_logical_path "$p")"
    else
      p="${p:a}"
    fi
    [[ -n ${seen[$p]:-} ]] && return
    seen[$p]=1
    roots+=("$p")
  }

  if [[ -n ${DNAV_SEARCH_ROOTS:-} ]]; then
    for r in ${=DNAV_SEARCH_ROOTS}; do
      _dsearch_add_root "$r"
    done
    print -l -- "${roots[@]}"
    return 0
  fi

  # Default: $HOME only. Add more with DNAV_SEARCH_ROOTS or search_roots=.
  _dsearch_add_root "$HOME"
  print -l -- "${roots[@]}"
}

# List dirs under $1, pruning noisy trees. Extra find flags follow (e.g. -xdev).
# Portable: no -readable. BusyBox-safe.
_dsearch_find_dirs() {
  local root="$1"
  shift
  find "$root" "$@" \
    \( \
      -name .git -o -name node_modules -o -name target -o \
      -name __pycache__ -o -name .npm -o -name .cargo -o \
      -name .cache -o -path '*/.cache/*' -o \
      -path '*/.local/share/Trash' -o -path '*/.local/share/Trash/*' -o \
      -name Trash -o -name .Trash -o -name Caches -o \
      -name .gradle -o -name .m2 -o -name vendor -o \
      -name .tox -o -name .venv -o -name venv -o -name '.Trash-*' \
    \) -prune -o -type d -print 2>/dev/null
}

# Build index while writing a running directory count to $2.
# $3 = tmp path (optional; default $idx.building so cancel can remove it).
_dsearch_build_index_with_count() {
  local idx="$1" countfile="$2"
  local tmp="${3:-${idx}.building}"
  local -a roots
  local r n=0 line

  mkdir -p "${idx:h}" 2>/dev/null || return 1
  roots=("${(@f)$(_dsearch_collect_roots)}")
  (( $#roots )) || roots=("$HOME")

  print -rn -- 0 > "$countfile"
  : > "$tmp"

  {
    for r in "${roots[@]}"; do
      [[ -d $r ]] || continue
      # No -readable (unsupported on BusyBox/iSH). -xdev when supported.
      if find "$r" -xdev -maxdepth 0 >/dev/null 2>&1; then
        _dsearch_find_dirs "$r" -xdev
      else
        _dsearch_find_dirs "$r"
      fi
    done
  } | {
    n=0
    while IFS= read -r line || [[ -n $line ]]; do
      [[ -z $line ]] && continue
      print -r -- "$line"
      (( n++ ))
      if (( n % 10 == 0 )); then
        print -rn -- $n > "$countfile"
      fi
    done
    print -rn -- $n > "$countfile"
  } > "$tmp"

  if [[ -f $tmp ]]; then
    n=$(wc -l < "$tmp" 2>/dev/null | tr -cd '0-9')
    print -rn -- ${n:-0} > "$countfile"
  fi

  if command -v sort >/dev/null 2>&1; then
    sort -u "$tmp" -o "$tmp" 2>/dev/null || true
  fi

  mv -f "$tmp" "$idx" 2>/dev/null || return 1
  return 0
}

# Start background reindex if stale. Worker is fully detached (no job table).
# $1 = 1|--force → rebuild even when the on-disk index is still fresh.
_dsearch_index_lock_dir() {
  print -r -- "$(_dsearch_index_dir)/index.lock"
}

_dsearch_index_unlock() {
  rmdir -- "$(_dsearch_index_lock_dir)" 2>/dev/null || true
}

_dsearch_index_start_bg() {
  local force=0 idx countfile pidfile lock tmp self=""
  case ${1:-} in
    1|--force) force=1 ;;
  esac
  idx="$(_dsearch_index_path)"

  if (( _DSEARCH_INDEX_PID > 0 )) && ! kill -0 $_DSEARCH_INDEX_PID 2>/dev/null; then
    _DSEARCH_INDEX_PID=0
  fi

  if (( force )); then
    if _dsearch_index_running; then
      _dsearch_index_cancel
    fi
  else
    if ! _dsearch_index_stale "$idx"; then
      _DSEARCH_INDEX_STATE=done
      return 0
    fi
    if _dsearch_index_running; then
      return 0
    fi
  fi

  mkdir -p "$(_dsearch_index_dir)" 2>/dev/null || return 1
  lock="$(_dsearch_index_lock_dir)"
  if ! mkdir -- "$lock" 2>/dev/null; then
    if _dsearch_index_running; then
      return 0
    fi
    rmdir -- "$lock" 2>/dev/null || true
    mkdir -- "$lock" 2>/dev/null || return 0
  fi

  countfile="$(_dsearch_index_dir)/index.count"
  pidfile="$(_dsearch_index_dir)/index.pid"
  tmp="${idx}.building"
  _DSEARCH_INDEX_COUNT_FILE="$countfile"
  _DSEARCH_INDEX_PID_FILE="$pidfile"
  _DSEARCH_INDEX_TMP="$tmp"
  print -rn -- 0 > "$countfile"
  _DSEARCH_INDEX_STATE=running
  _DSEARCH_INDEX_HAS_SID=0

  if _dsearch_constrained_env; then
    export DNAV_SEARCH_LIGHT=1
  fi

  if [[ -n ${DNAV_DIR:-} && -f $DNAV_DIR/dsearch ]]; then
    self="$DNAV_DIR/dsearch"
  elif [[ -n ${(%):-%x} ]]; then
    self="${${(%):-%x}:A}"
  fi
  [[ -f $self ]] || self=""

  # Detached external zsh — not a job of the interactive shell.
  # setsid so cancel can kill that group only (never the interactive shell).
  if [[ -n $self ]]; then
    if command -v setsid >/dev/null 2>&1; then
      nohup setsid zsh -fc '
        emulate -L zsh
        setopt nomonitor nonotify
        source "$1"
        _dsearch_build_index_with_count "$2" "$3" "$4"
        rm -f -- "$5"
        rmdir -- "${2:h}/index.lock" 2>/dev/null || true
      ' dnav-index-worker "$self" "$idx" "$countfile" "$tmp" "$pidfile" \
        </dev/null >/dev/null 2>&1 &!
      _DSEARCH_INDEX_HAS_SID=1
    else
      nohup zsh -fc '
        emulate -L zsh
        setopt nomonitor nonotify
        source "$1"
        _dsearch_build_index_with_count "$2" "$3" "$4"
        rm -f -- "$5"
        rmdir -- "${2:h}/index.lock" 2>/dev/null || true
      ' dnav-index-worker "$self" "$idx" "$countfile" "$tmp" "$pidfile" \
        </dev/null >/dev/null 2>&1 &!
    fi
    _DSEARCH_INDEX_PID=$!
  else
    setopt localoptions nomonitor nonotify
    ( _dsearch_build_index_with_count "$idx" "$countfile" "$tmp"
      rm -f -- "$pidfile"
      _dsearch_index_unlock
    ) </dev/null >/dev/null 2>&1 &!
    _DSEARCH_INDEX_PID=$!
  fi
  print -rn -- $_DSEARCH_INDEX_PID > "$pidfile"
  return 0
}

# Cancel background index (user left dnav early / Ctrl+C).
_dsearch_index_cancel() {
  local pid=$_DSEARCH_INDEX_PID pf="$_DSEARCH_INDEX_PID_FILE"
  if (( pid <= 0 )) && [[ -n $pf && -f $pf ]]; then
    pid=$(tr -cd '0-9' <"$pf" 2>/dev/null)
  fi
  if [[ $pid == <-> ]] && (( pid > 1 && pid != $$ )); then
    if (( _DSEARCH_INDEX_HAS_SID )); then
      kill -TERM -- -$pid 2>/dev/null || kill -TERM -- $pid 2>/dev/null || true
    else
      kill -TERM -- $pid 2>/dev/null || true
      pkill -TERM -P $pid 2>/dev/null || true
    fi
  fi
  _DSEARCH_INDEX_PID=0
  _DSEARCH_INDEX_HAS_SID=0
  _DSEARCH_INDEX_STATE=cancelled
  [[ -n $_DSEARCH_INDEX_TMP ]] && rm -f -- "$_DSEARCH_INDEX_TMP" 2>/dev/null
  [[ -n $_DSEARCH_INDEX_COUNT_FILE ]] && rm -f -- "$_DSEARCH_INDEX_COUNT_FILE" 2>/dev/null
  [[ -n $pf ]] && rm -f -- "$pf" 2>/dev/null
  _dsearch_index_unlock
  _DSEARCH_INDEX_COUNT_FILE=""
  _DSEARCH_INDEX_PID_FILE=""
  _DSEARCH_INDEX_TMP=""
}

# Paint "Indexing... N" on one line; clear with \r\e[2K when done (no newlines).
_dsearch_index_paint_status() {
  local count="$1"
  local hl="${DNAV_HIGHLIGHT:-${HIGHLIGHT:-\e[30;46m}}"
  local rst="${DNAV_RESET:-${RESET:-\e[0m}}"
  printf "\r${hl} Indexing...${rst} %s\e[K" "$count"
}

# Wait for background index if needed. Always leaves the cursor line clean.
# Returns 0 if a usable index exists OR after creating an empty fallback.
_dsearch_index_wait_ui() {
  local idx count
  idx="$(_dsearch_index_path)"

  _dsearch_index_start_bg

  if ! _dsearch_index_running && [[ -f $idx && -s $idx ]]; then
    _DSEARCH_INDEX_STATE=done
    return 0
  fi

  if _dsearch_index_running; then
    printf "\e[?25l"
    while _dsearch_index_running; do
      count="$(_dsearch_index_count)"
      _dsearch_index_paint_status "$count"
      sleep 0.15
    done
    count="$(_dsearch_index_count)"
    _dsearch_index_paint_status "$count"
    sleep 0.05
    printf "\r\e[2K"
    _DSEARCH_INDEX_PID=0
    [[ -n $_DSEARCH_INDEX_COUNT_FILE ]] && rm -f -- "$_DSEARCH_INDEX_COUNT_FILE" 2>/dev/null
    [[ -n $_DSEARCH_INDEX_PID_FILE ]] && rm -f -- "$_DSEARCH_INDEX_PID_FILE" 2>/dev/null
    _DSEARCH_INDEX_COUNT_FILE=""
    _DSEARCH_INDEX_PID_FILE=""
    _DSEARCH_INDEX_TMP=""
  fi

  if [[ -f $idx && -s $idx ]]; then
    _DSEARCH_INDEX_STATE=done
    return 0
  fi

  # Fallback so search still opens (empty results better than kick-out)
  mkdir -p "${idx:h}" 2>/dev/null
  if [[ ! -f $idx ]]; then
    : > "$idx"
  fi
  _DSEARCH_INDEX_STATE=failed
  return 0
}

# Ensure index is ready (start bg if needed, wait with UI if still running).
# Never hard-fails: search UI should still open.
# Respects index_auto / index_when; dnav --reindex is the manual path.
_dsearch_ensure_index() {
  local idx
  idx="$(_dsearch_index_path)"

  if ! _dsearch_index_stale "$idx" && ! _dsearch_index_running; then
    return 0
  fi

  if ! _dsearch_index_wanted search; then
    return 0
  fi

  _dsearch_index_wait_ui
  return 0
}

# Rebuild dirs.idx from the shell (always; ignores index_auto / TTL).
_dsearch_reindex() {
  emulate -L zsh
  local idx count n
  case ${1:-} in
    -h|--help)
      print -r -- "Usage: dnav --reindex"
      print -r -- "Rebuild the directory search index and exit."
      print -r -- "Always walks search_roots (default: \$HOME). Does not open the TUI."
      return 0
      ;;
  esac

  idx="$(_dsearch_index_path)"
  _dsearch_index_start_bg 1 || {
    print -u2 -- "dnav: could not start indexing"
    return 1
  }

  if _dsearch_index_running; then
    printf "\e[?25l"
    while _dsearch_index_running; do
      count="$(_dsearch_index_count)"
      printf "\rIndexing... %s\e[K" "$count"
      sleep 0.15
    done
    count="$(_dsearch_index_count)"
    printf "\rIndexing... %s\e[K" "$count"
    sleep 0.05
    printf "\r\e[2K\e[?25h"
    _DSEARCH_INDEX_PID=0
    [[ -n $_DSEARCH_INDEX_COUNT_FILE ]] && rm -f -- "$_DSEARCH_INDEX_COUNT_FILE" 2>/dev/null
    [[ -n $_DSEARCH_INDEX_PID_FILE ]] && rm -f -- "$_DSEARCH_INDEX_PID_FILE" 2>/dev/null
    _DSEARCH_INDEX_COUNT_FILE=""
    _DSEARCH_INDEX_PID_FILE=""
    _DSEARCH_INDEX_TMP=""
  fi

  if [[ -f $idx && -s $idx ]]; then
    n=$(wc -l < "$idx" 2>/dev/null | tr -cd '0-9')
    print -r -- "dnav: indexed ${n:-0} directories  $idx"
    _DSEARCH_INDEX_STATE=done
    return 0
  fi
  print -u2 -- "dnav: index rebuild failed  $idx"
  _DSEARCH_INDEX_STATE=failed
  return 1
}

# ── Session state (search UI) ─────────────────────────────────────────────
typeset -ga _dsearch_matches
typeset -gi _dsearch_sel=0
typeset -gi _dsearch_extra_lines=0
typeset -gi _dsearch_cur=0
typeset -gi _dsearch_qwin=0
typeset -gi _DSEARCH_OPEN=0
typeset -g  _dsearch_tmpdir=""

_dsearch_session_cleanup() {
  _dsearch_worker_stop
  if [[ -n $_dsearch_tmpdir && -d $_dsearch_tmpdir ]]; then
    /bin/rm -rf -- "$_dsearch_tmpdir" 2>/dev/null
  fi
  _dsearch_tmpdir=""
  _dsearch_q=""
  _dsearch_cur=0
  _dsearch_qwin=0
  _dsearch_focus=list
  _dsearch_view=search
  _DSEARCH_OPEN=0
  _DSEARCH_DIRTY=0
  _DSEARCH_WORKER_PID=0
  _DSEARCH_GEN=0
  _DSEARCH_LAST_TICK=0
  _DSEARCH_WORK_Q=""
  _DSEARCH_SHOWN_Q=""
}

_dsearch_cur_clamp() {
  (( _dsearch_cur < 0 )) && _dsearch_cur=0
  (( _dsearch_cur > ${#_dsearch_q} )) && _dsearch_cur=${#_dsearch_q}
}

# Insert $1 at the caret; move caret forward.
_dsearch_insert() {
  local ch="$1"
  _dsearch_cur_clamp
  _dsearch_q="${_dsearch_q[1,_dsearch_cur]}${ch}${_dsearch_q[_dsearch_cur+1,-1]}"
  (( _dsearch_cur++ ))
}

# Delete the character before the caret.
_dsearch_backspace() {
  _dsearch_cur_clamp
  (( _dsearch_cur > 0 )) || return 1
  _dsearch_q="${_dsearch_q[1,_dsearch_cur-1]}${_dsearch_q[_dsearch_cur+1,-1]}"
  (( _dsearch_cur-- ))
}

# Delete the character at the caret (forward delete).
_dsearch_delete() {
  _dsearch_cur_clamp
  (( _dsearch_cur < ${#_dsearch_q} )) || return 1
  _dsearch_q="${_dsearch_q[1,_dsearch_cur]}${_dsearch_q[_dsearch_cur+2,-1]}"
}

_dsearch_cursor_hide() {
  printf "\e[0 q\e[?25l"
}

# Thin bar caret on the query. Call after painting the search bar.
_dsearch_place_cursor() {
  local label=" DNav Search:" col maxw
  if [[ ${_dsearch_view:-search} != search || ${_dsearch_focus:-list} != list ]]; then
    _dsearch_cursor_hide
    return
  fi
  _dsearch_cur_clamp
  maxw="$(_dsearch_cols)"
  col=$(( ${#label} + 2 + _dsearch_cur - _dsearch_qwin ))
  (( col < 1 )) && col=1
  (( col >= maxw )) && col=$(( maxw - 1 ))
  printf "\r\e[6 q\e[%dG\e[?25h" $col
}

# ── awk filter (hot path) ─────────────────────────────────────────────────
# Args: query, maxn, src_file
# Prints top maxn paths (one per line). Soft-AND: a missed token penalizes
# instead of dropping the path. All-token hits always rank above near-misses.
_dsearch_awk_filter() {
  local query="$1" maxn="$2" src="$3"
  local home_p config_p data_p state_p cache_p
  [[ -n $src ]] || src="$(_dsearch_index_path)"
  [[ -f $src ]] || return 0

  home_p="${HOME%/}"
  config_p="${XDG_CONFIG_HOME:-$HOME/.config}"
  data_p="${XDG_DATA_HOME:-$HOME/.local/share}"
  state_p="${XDG_STATE_HOME:-$HOME/.local/state}"
  cache_p="${XDG_CACHE_HOME:-$HOME/.cache}"
  config_p="${config_p%/}"
  data_p="${data_p%/}"
  state_p="${state_p%/}"
  cache_p="${cache_p%/}"

  awk -v query="$query" -v maxn="$maxn" \
      -v home="$home_p" \
      -v xdg_config="$config_p" -v xdg_data="$data_p" \
      -v xdg_state="$state_p" -v xdg_cache="$cache_p" '
  function better(sc, path, osc, opath) {
    if (sc > osc) return 1
    if (sc < osc) return 0
    return (length(path) < length(opath))
  }
  function consider(sc, path,   i) {
    if (pool <= 0) return
    if (tn == pool && !better(sc, path, tsc[tn], tpath[tn])) return
    if (tn < pool) tn++
    i = tn
    while (i > 1 && better(sc, path, tsc[i-1], tpath[i-1])) {
      tsc[i] = tsc[i-1]
      tpath[i] = tpath[i-1]
      i--
    }
    tsc[i] = sc
    tpath[i] = path
  }

  function norm(s) {
    if (substr(s, 1, 1) == ".") s = substr(s, 2)
    return s
  }
  function stem_s(s) {
    if (length(s) > 3 && substr(s, length(s), 1) == "s" && substr(s, length(s) - 1, 1) != "s")
      return substr(s, 1, length(s) - 1)
    return s
  }
  function is_transpose(a, b,   n, i) {
    if (length(a) != length(b)) return 0
    n = length(a)
    for (i = 1; i < n; i++) {
      if (substr(a, i, 1) != substr(b, i, 1))
        return (substr(a, i, 1) == substr(b, i + 1, 1) && substr(a, i + 1, 1) == substr(b, i, 1) && substr(a, i + 2) == substr(b, i + 2))
    }
    return 0
  }
  function first_two_swap(a, b) {
    return (length(a) == length(b) && length(a) >= 2 && substr(a, 1, 1) == substr(b, 2, 1) && substr(a, 2, 1) == substr(b, 1, 1) && substr(a, 3) == substr(b, 3))
  }
  function edit_dist(a, b, maxd,   n, m, i, j, tmp, prev, cur, cost, del, ins, repl, ai, rowmin, v) {
    n = length(a)
    m = length(b)
    if (n > m) { tmp = a; a = b; b = tmp; n = length(a); m = length(b) }
    if (m - n > maxd) return -1
    for (j = 0; j <= m; j++) v[j] = j
    for (i = 1; i <= n; i++) {
      prev = v[0]
      v[0] = i
      rowmin = i
      ai = substr(a, i, 1)
      for (j = 1; j <= m; j++) {
        cur = v[j]
        cost = (ai == substr(b, j, 1)) ? 0 : 1
        del = v[j] + 1
        ins = v[j - 1] + 1
        repl = prev + cost
        v[j] = del
        if (ins < v[j]) v[j] = ins
        if (repl < v[j]) v[j] = repl
        prev = cur
        if (v[j] < rowmin) rowmin = v[j]
      }
      if (rowmin > maxd) return -1
    }
    if (v[m] > maxd) return -1
    return v[m]
  }

  # Score tok against one path component. 100 = last-component exact.
  # Prefix of a component is enough (typeahead). No letter-skip across the path.
  function token_hit(tok, seg, islast,   t, s, idx, extra, d, maxd) {
    t = norm(tolower(tok))
    s = norm(tolower(seg))
    if (t == "" || s == "") return -1
    if (t == s) return islast ? 100 : 86
    if (t != s && stem_s(t) == stem_s(s)) return islast ? 92 : 80
    if (length(t) == 1) {
      if (substr(s, 1, 1) == t) return islast ? 48 : 36
      return -1
    }
    idx = index(s, t)
    if (idx == 1) {
      extra = length(s) - length(t)
      if (extra < 0) extra = 0
      if (extra > 8) extra = 8
      return (islast ? 88 : 74) - 2 * extra
    }
    if (idx > 1) return islast ? 68 : 58
    if (length(t) >= 4) {
      if (is_transpose(t, s) || first_two_swap(t, s)) return islast ? 78 : 66
      maxd = (length(t) < 6) ? 1 : 2
      d = edit_dist(t, s, maxd)
      if (d == 1) return islast ? 78 : 66
      if (d == 2) return islast ? 62 : 52
    }
    return -1
  }

  function under(path, root) {
    if (root == "" || path == "") return 0
    if (path == root) return 1
    return (index(path, root "/") == 1)
  }
  function is_under(child, parent) {
    return (length(child) > length(parent) && index(child, parent "/") == 1)
  }
  function is_wellknown(name,   n) {
    n = tolower(name)
    return (n == "documents" || n == "downloads" || n == "desktop" || n == "pictures" || n == "music" || n == "videos" || n == "projects")
  }
  function first_home_seg(path,   rest, n, segs) {
    if (!under(path, home) || path == home) return ""
    rest = substr(path, length(home) + 2)
    n = split(rest, segs, "/")
    return (n > 0) ? segs[1] : ""
  }
  function rel_depth(path,   rest, n, segs, i, d) {
    if (under(path, home)) {
      if (path == home) return 0
      rest = substr(path, length(home) + 2)
      n = split(rest, segs, "/")
      d = 0
      for (i = 1; i <= n; i++) if (segs[i] != "") d++
      return d
    }
    n = split(path, segs, "/")
    d = 0
    for (i = 1; i <= n; i++) if (segs[i] != "") d++
    if (d > 0) d--
    return d
  }
  function path_leaf(path,   n, segs) {
    n = split(path, segs, "/")
    while (n > 0 && segs[n] == "") n--
    return (n > 0) ? segs[n] : ""
  }
  function in_cache(path) {
    return (under(path, xdg_cache) || under(path, home "/.cache"))
  }
  function location_boost(path,   s, sl) {
    if (in_cache(path)) return 0
    if (path == xdg_config || path == home "/.config" || path == xdg_data || path == home "/.local/share" || path == xdg_state || path == home "/.local/state" || path == home "/.local" || path == home "/.local/bin")
      return 16
    s = first_home_seg(path)
    sl = tolower(s)
    if (sl == ".config" || sl == ".local") return 12
    if (under(path, xdg_config) || under(path, xdg_data) || under(path, xdg_state)) return 12
    if (is_wellknown(s)) return 16
    return 0
  }
  function home_boost(path) {
    if (home == "") return 0
    if (under(path, home)) return 8
    return -12
  }
  function cache_penalty(path) {
    return in_cache(path) ? -18 : 0
  }
  function depth_penalty(path,   d, p, leaf, h) {
    leaf = path_leaf(path)
    if (last_qtok != "" && leaf != "") {
      h = token_hit(last_qtok, leaf, 1)
      if (h >= 88) return 0
    }
    d = rel_depth(path)
    if (d <= 2) return 0
    p = (d - 2) * 6
    if (p > 24) p = 24
    return -p
  }
  function pref_of(path,   p) {
    p = location_boost(path) + home_boost(path) + cache_penalty(path) + depth_penalty(path)
    if (p > 30) p = 30
    if (p < -30) p = -30
    return p
  }

  # Whitespace splits tokens (any order; trailing space ignored).
  # Soft AND: missed tokens score 0. All-token band is 200+avg; partials stay < 200.
  function query_score(path,   i, j, nseg, hit, best, total, hits, avg) {
    if (ntok == 0) return -1
    nseg = split(path, segs, "/")
    total = 0
    hits = 0
    for (i = 1; i <= ntok; i++) {
      best = -1
      for (j = 1; j <= nseg; j++) {
        if (segs[j] == "") continue
        hit = token_hit(qtok[i], segs[j], (j == nseg))
        if (hit > best) best = hit
      }
      if (best < 0) best = 0
      else hits++
      total += best
    }
    if (hits == 0) return -1
    avg = int(total / ntok)
    if (hits == ntok) return 200 + avg
    return int((100 * hits) / ntok) + int(avg / 2)
  }

  function ingest(path,   base, sc) {
    if (path == "" || path in seen) return
    base = query_score(path)
    if (base < 0) return
    sc = base + pref_of(path)
    if (base >= 200 && sc < 200) sc = 200
    if (base < 200 && sc >= 200) sc = 199
    seen[path] = 1
    consider(sc, path)
  }

  BEGIN {
    ntok = 0
    last_qtok = ""
    n = split(query, tok, /[ \t]+/)
    for (i = 1; i <= n; i++) {
      if (tok[i] == "") continue
      ntok++
      qtok[ntok] = tok[i]
    }
    if (ntok > 0) last_qtok = qtok[ntok]
    tn = 0
    pool = (maxn > 0) ? maxn : 0
    if (pool > 0 && pool < 40) pool = 40
  }
  { ingest($0) }
  END {
    if (maxn <= 0 || tn == 0) exit
    an = 0
    best = tsc[1]
    if (best >= 200) {
      if (best >= 290) floor = 272
      else if (best >= 270) floor = best - 10
      else floor = 200
      for (i = 1; i <= tn; i++) {
        if (tsc[i] < 200) break
        if (tsc[i] < floor) continue
        drop = 0
        for (j = 1; j <= an; j++) {
          if (is_under(tpath[i], apath[j])) { drop = 1; break }
        }
        if (drop) continue
        an++
        apath[an] = tpath[i]
        if (an >= maxn) break
      }
    }
    if (an < maxn) {
      for (i = 1; i <= tn; i++) {
        if (tsc[i] >= 200) continue
        an++
        apath[an] = tpath[i]
        if (an >= maxn) break
      }
    }
    for (i = 1; i <= an; i++) print apath[i]
  }
  ' "$src"
}

# Apply filter for $query against the full directory index.
# Sets _dsearch_matches (top maxn). Jump aliases that contain every token are pinned.
_dsearch_apply_filter() {
  local query="$1"
  local maxn="${2:-10}"
  local idx
  local -a top

  _dsearch_matches=()
  idx="$(_dsearch_index_path)"

  if [[ -z $query ]]; then
    return 0
  fi
  [[ -f $idx ]] || return 0

  top=("${(@f)$(_dsearch_awk_filter "$query" "$maxn" "$idx")}")
  _dsearch_take_top "${top[@]}"
  _dsearch_pin_jumps "$query" "$maxn"
}

# Drop the empty element zsh leaves when awk prints nothing.
_dsearch_take_top() {
  emulate -L zsh
  local p
  _dsearch_matches=()
  for p in "$@"; do
    [[ -n $p ]] && _dsearch_matches+=("$p")
  done
}

# 0 if $1 contains every whitespace-separated token from $2 as a
# contiguous substring (any order). Single-token queries skip this
# check (the scorer already gated them).
_dsearch_path_has_tokens() {
  emulate -L zsh
  local p="${(L)1}" q="$2" tok
  local -a toks
  toks=(${=q})
  (( $#toks <= 1 )) && return 0
  for tok in "${toks[@]}"; do
    [[ -z $tok ]] && continue
    [[ $p == *${(L)tok}* ]] || return 1
  done
  return 0
}

# Prepend djump matches for the query (dirs only), then cap to maxn.
_dsearch_pin_jumps() {
  local query="$1" maxn="${2:-10}"
  (( $+functions[_djump_available] )) && _djump_available || return 0
  local -a keys pinned out
  local k p m found
  keys=("${(@f)$(_djump_match_query "$query")}")
  pinned=()
  for k in "${keys[@]}"; do
    p="$(_djump_resolve "$k" 2>/dev/null)" || continue
    [[ -d $p ]] || continue
    _dsearch_path_has_tokens "$p" "$query" || continue
    if (( $+functions[_dnav_logical_path] )); then
      p="$(_dnav_logical_path "$p")"
    else
      p="${p:a}"
    fi
    found=0
    for m in "${pinned[@]}"; do
      [[ $m == $p ]] && { found=1; break }
    done
    (( found )) || pinned+=("$p")
  done
  (( $#pinned == 0 )) && return 0
  out=("${pinned[@]}")
  for m in "${_dsearch_matches[@]}"; do
    found=0
    for p in "${pinned[@]}"; do
      [[ $m == $p ]] && { found=1; break }
    done
    (( found )) || out+=("$m")
  done
  _dsearch_matches=("${out[@]:0:$maxn}")
}

# ── UI ────────────────────────────────────────────────────────────────────
# Matches dnav: black-on-cyan full-width bars (same DNAV_HIGHLIGHT / success bar).

_dsearch_hl() {
  print -rn -- "${DNAV_HIGHLIGHT:-${HIGHLIGHT:-\e[30;46m}}"
}
_dsearch_rst() {
  print -rn -- "${DNAV_RESET:-${RESET:-\e[0m}}"
}

_dsearch_cols() {
  if (( $+functions[_dnav_usable_cols] )); then
    _dnav_usable_cols
    return
  fi
  local w=${COLUMNS:-80}
  [[ $w == <-> ]] || w=80
  (( w > 2 )) && (( w -= 2 ))
  (( w < 8 )) && w=8
  print -rn -- "$w"
}

# Shorten path for display (~ for $HOME); optional max length.
_dsearch_display_path() {
  local p="$1" maxw="${2:-0}"
  local home="$HOME"
  if [[ $p == $home || $p == $home/* ]]; then
    p="~${p#$home}"
  fi
  if (( maxw > 0 )); then
    if (( $+functions[_dnav_fit_end] )); then
      p="$(_dnav_fit_end "$p" $maxw)"
    elif (( ${#p} > maxw )); then
      p="…${p:$(( ${#p} - maxw + 1 ))}"
    fi
  fi
  print -r -- "$p"
}

# Truncate/pad a string to exactly w display columns.
_dsearch_fit() {
  local s="$1" w="$2" pad
  if (( $+functions[_dnav_fit_end] )); then
    s="$(_dnav_fit_end "$s" $w)"
    if (( $+functions[_dnav_disp_w] )); then
      pad=$(( w - $(_dnav_disp_w "$s") ))
    else
      pad=$(( w - ${#s} ))
    fi
    (( pad < 0 )) && pad=0
    printf "%s%*s" "$s" $pad ""
    return
  fi
  if (( ${#s} > w )); then
    if (( w <= 1 )); then
      s="${s[1,w]}"
    else
      s="…${s:$(( ${#s} - w + 1 ))}"
    fi
  fi
  printf "%-${w}s" "$s"
}

# Focus: list (result rows) | help (Help chip on the bar)
typeset -g _dsearch_focus=list
# View: search (normal) | help (help overlay inside dsearch)
typeset -g _dsearch_view=search

# Help body lines (shown under the bar when Help is opened)
_dsearch_help_lines() {
  print -r -- "Type to search. Last word is a prefix; extra words narrow the list but a miss still shows near matches."
  print -r -- "↑, ↓, Ctrl+N, Ctrl+P        move selection"
  print -r -- "Enter                       open the selected folder"
  print -r -- "←, →                        move the caret; → at the end focuses Help"
  print -r -- "Home, End, Ctrl+A, Ctrl+E   start or end of the query"
  print -r -- "Backspace, Delete           delete before or at the caret"
  print -r -- "Enter on Help               show this help"
  print -r -- "Esc                         close help, or leave search"
  print -r -- "Ctrl+U                      clear the query"
}

# Paint one row. Bar uses chip styling (not a full-width cyan fill).
# $1 = mode: bar | sel | row | blank | help_row
# $2 = text (ignored for blank)
_dsearch_paint_row() {
  local mode="$1" text="${2:-}"
  local hl rst maxw inner
  maxw="$(_dsearch_cols)"
  hl="$(_dsearch_hl)"
  rst="$(_dsearch_rst)"

  case $mode in
    bar)
      # [ DNav Search:] query…          count  [Help]
      local label count helpchip gap avail qshow
      label=" DNav Search:"
      helpchip=" Help "
      if [[ $_dsearch_q != "$_DSEARCH_SHOWN_Q" ]]; then
        count=""
      elif (( $#_dsearch_matches > 0 )) && [[ ${_dsearch_focus:-list} == list ]]; then
        count=" $(( _dsearch_sel + 1 ))/$#_dsearch_matches "
      else
        count=""
      fi
      # Room for query: label + space after chip + count + Help
      avail=$(( maxw - ${#label} - 1 - ${#count} - ${#helpchip} ))
      (( avail < 1 )) && avail=1
      _dsearch_cur_clamp
      _dsearch_qwin=0
      qshow="$text"
      if (( ${#text} > avail )); then
        _dsearch_qwin=$(( _dsearch_cur - avail + 1 ))
        (( _dsearch_qwin < 0 )) && _dsearch_qwin=0
        if (( _dsearch_qwin + avail > ${#text} )); then
          _dsearch_qwin=$(( ${#text} - avail ))
          (( _dsearch_qwin < 0 )) && _dsearch_qwin=0
        fi
        qshow="${text[_dsearch_qwin+1,_dsearch_qwin+avail]}"
      fi
      gap=$(( maxw - ${#label} - 1 - ${#qshow} - ${#count} - ${#helpchip} ))
      (( gap < 0 )) && gap=0
      # Label chip always cyan; space + query normal; Help cyan when focused
      printf "\r${hl}%s${rst} %s%*s%s" "$label" "$qshow" $gap "" "$count"
      if [[ ${_dsearch_focus:-list} == help ]]; then
        printf "${hl}%s${rst}" "$helpchip"
      else
        printf "%s" "$helpchip"
      fi
      printf "\e[K"
      ;;
    sel)
      # Selected match: cyan chip-style row (full width for clean overwrite)
      inner=$(( maxw - 2 ))
      (( inner < 1 )) && inner=1
      printf "\r${hl}▶ %s${rst}" "$(_dsearch_fit "$text" $inner)"
      ;;
    row)
      # Unselected: faint, full-width pad so old cyan is fully overwritten
      inner=$(( maxw - 2 ))
      (( inner < 1 )) && inner=1
      printf "\r\e[2m  %s${rst}" "$(_dsearch_fit "$text" $inner)"
      ;;
    help_row)
      # Help overlay body line (cyan bar, matches main dnav help)
      printf "\r${hl}%-${maxw}s${rst}" "$(_dsearch_fit " $text" $maxw)"
      ;;
    blank)
      printf "\r%*s" $maxw ""
      ;;
  esac
}

# Full redraw of prompt + dropdown (or help overlay).
_dsearch_draw() {
  local query="$1"
  local n p disp i leftover
  local -a hlines

  _dsearch_cursor_hide

  _dsearch_paint_row bar "$query"

  n=0
  if [[ ${_dsearch_view:-search} == help ]]; then
    hlines=("${(@f)$(_dsearch_help_lines)}")
    for p in "${hlines[@]}"; do
      printf "\n"
      _dsearch_paint_row help_row "$p"
      (( n++ ))
    done
  else
    for p in "${_dsearch_matches[@]}"; do
      disp="$(_dsearch_display_path "$p")"
      printf "\n"
      # When Help chip is focused, no list row looks selected
      if [[ ${_dsearch_focus:-list} == list ]] && (( n == _dsearch_sel )); then
        _dsearch_paint_row sel "$disp"
      else
        _dsearch_paint_row row "$disp"
      fi
      (( n++ ))
    done
  fi

  leftover=$(( _dsearch_extra_lines - n ))
  if (( !_DNAV_RESIZING )); then
    for (( i=0; i < leftover; i++ )); do
      printf "\n"
      _dsearch_paint_row blank
    done
    if (( leftover > 0 )); then
      printf "\e[%dA" $leftover
    fi
  fi

  _dsearch_extra_lines=$n
  printf "\e[J"
  if (( n > 0 )); then
    printf "\e[%dA" $n
  fi
  _dsearch_place_cursor
}

# Selection moved only — repaint two rows + bar (minimal flicker).
_dsearch_draw_sel() {
  local query="$1"
  local old="$2"   # previous index
  local n=$#_dsearch_matches
  local disp

  [[ ${_dsearch_view:-search} == search ]] || return 0
  (( n == 0 )) && return 0
  _dsearch_cursor_hide

  _dsearch_paint_row bar "$query"

  if (( old >= 0 && old < n )); then
    printf "\e[%dB" $(( old + 1 ))
    disp="$(_dsearch_display_path "${_dsearch_matches[old+1]}")"
    _dsearch_paint_row row "$disp"
    printf "\e[%dA" $(( old + 1 ))
  fi

  if [[ ${_dsearch_focus:-list} == list ]]; then
    printf "\e[%dB" $(( _dsearch_sel + 1 ))
    disp="$(_dsearch_display_path "${_dsearch_matches[_dsearch_sel+1]}")"
    _dsearch_paint_row sel "$disp"
    printf "\e[%dA" $(( _dsearch_sel + 1 ))
  fi
  _dsearch_place_cursor
}

_dsearch_erase_ui() {
  local i maxw
  maxw="$(_dsearch_cols)"
  _dsearch_cursor_hide
  printf "\r%*s" $maxw ""
  for (( i=0; i < _dsearch_extra_lines; i++ )); do
    printf "\n"
    _dsearch_paint_row blank
  done
  if (( _dsearch_extra_lines > 0 )); then
    printf "\e[%dA" $_dsearch_extra_lines
  fi
  printf "\r%*s\r" $maxw ""
  _dsearch_extra_lines=0
}

_dsearch_focus_help() {
  _dsearch_focus=help
  _dsearch_draw "$_dsearch_q"
}

_dsearch_focus_list() {
  _dsearch_focus=list
  _dsearch_draw "$_dsearch_q"
}

_dsearch_open_help() {
  _dsearch_view=help
  _dsearch_focus=help
  _dsearch_draw "$_dsearch_q"
}

_dsearch_close_help() {
  _dsearch_view=search
  _dsearch_focus=list
  _dsearch_draw "$_dsearch_q"
}

# Query bar is always live. Ranking runs in a background job; the list
# is refreshed about every 30ms from that job (never on the key path).
typeset -gi _DSEARCH_DIRTY=0
typeset -gi _DSEARCH_WORKER_PID=0
typeset -gi _DSEARCH_GEN=0
typeset -gi _DSEARCH_LAST_TICK=0
typeset -g  _DSEARCH_WORK_Q=""
typeset -g  _DSEARCH_SHOWN_Q=""

zmodload -F zsh/datetime p:EPOCHREALTIME 2>/dev/null || true

_dsearch_now_ms() {
  emulate -L zsh
  local -i ms
  if [[ -n ${EPOCHREALTIME:-} ]]; then
    ms=$(( EPOCHREALTIME * 1000 ))
    print -rn -- $ms
  else
    print -rn -- 0
  fi
}

# Pull already-buffered print/edit keys into the query. Navigation is pushback.
_dsearch_drain_query() {
  while _dnav_try_read_token; do
    case $REPLY in
      backspace)
        _dsearch_backspace || true
        ;;
      delete)
        _dsearch_delete || true
        ;;
      ctrl-u)
        _dsearch_q=""
        _dsearch_cur=0
        ;;
      esc|enter|up|down|left|right|home|end|tab|ctrl-c|ctrl-n|ctrl-p|ctrl-a|ctrl-e)
        _DSEARCH_PUSHBACK="$REPLY"
        return
        ;;
      [[:print:]])
        _dsearch_insert "$REPLY"
        ;;
    esac
  done
}

_dsearch_worker_stop() {
  local pid=$_DSEARCH_WORKER_PID
  (( pid > 1 )) || { _DSEARCH_WORKER_PID=0; return 0 }
  kill "$pid" 2>/dev/null || true
  command pkill -P "$pid" 2>/dev/null || true
  _DSEARCH_WORKER_PID=0
}

# Rank $_dsearch_q off-thread. Hits land in $tmpdir/hits.$gen.
# In-flight work is only cancelled for an empty query or a flush.
_dsearch_worker_start() {
  local q="$_dsearch_q" gen tmp
  tmp="$_dsearch_tmpdir"
  [[ -n $tmp && -d $tmp ]] || return 1
  _dsearch_worker_stop
  if [[ -z $q ]]; then
    _dsearch_matches=()
    _DSEARCH_WORK_Q=""
    _DSEARCH_SHOWN_Q=""
    _DSEARCH_DIRTY=0
    _dsearch_draw ""
    return 0
  fi
  (( ++_DSEARCH_GEN ))
  gen=$_DSEARCH_GEN
  _DSEARCH_WORK_Q="$q"
  setopt nomonitor nonotify
  (
    emulate -L zsh
    setopt nomonitor nonotify
    _dsearch_apply_filter "$q" 10
    if (( $#_dsearch_matches )); then
      print -l -- "${_dsearch_matches[@]}" > "$tmp/hits.$gen.tmp"
    else
      : > "$tmp/hits.$gen.tmp"
    fi
    /bin/mv -f -- "$tmp/hits.$gen.tmp" "$tmp/hits.$gen"
  ) </dev/null >/dev/null 2>&1 &
  _DSEARCH_WORKER_PID=$!
  disown $_DSEARCH_WORKER_PID 2>/dev/null || true
}

# 0 if the current generation produced a hits file (caller draws).
_dsearch_worker_poll() {
  local gen=$_DSEARCH_GEN tmp="$_dsearch_tmpdir" f
  [[ -n $tmp && $gen -gt 0 ]] || return 1
  f="$tmp/hits.$gen"
  [[ -f $f ]] || return 1
  _dsearch_take_top "${(@f)$(<"$f")}"
  /bin/rm -f -- "$f"
  _DSEARCH_SHOWN_Q="$_DSEARCH_WORK_Q"
  _DSEARCH_WORKER_PID=0
  _DSEARCH_DIRTY=0
  _dsearch_sel=0
  return 0
}

# About every 30ms: reap a finished job and start one for the live query
# if nothing is running. Do not cancel an in-flight rank — that is what
# keeps the list moving while the user types.
_dsearch_maybe_tick() {
  local now
  now="$(_dsearch_now_ms)"
  if (( now > 0 && _DSEARCH_LAST_TICK > 0 && now - _DSEARCH_LAST_TICK < 30 )); then
    return 0
  fi
  _DSEARCH_LAST_TICK=$now
  if (( _DSEARCH_WORKER_PID > 1 )) && ! kill -0 $_DSEARCH_WORKER_PID 2>/dev/null; then
    _DSEARCH_WORKER_PID=0
  fi
  if _dsearch_worker_poll; then
    _dsearch_draw "$_dsearch_q"
  fi
  if [[ -z $_dsearch_q ]]; then
    if (( _DSEARCH_WORKER_PID > 1 )) || [[ -n $_DSEARCH_SHOWN_Q ]]; then
      _dsearch_worker_start
    fi
    return 0
  fi
  if (( _DSEARCH_WORKER_PID == 0 )) && [[ $_dsearch_q != "$_DSEARCH_SHOWN_Q" ]]; then
    _dsearch_worker_start
  fi
}

# Paint the query now. Never ranks here.
_dsearch_note_query() {
  _dsearch_drain_query
  _dsearch_sel=0
  _dsearch_focus=list
  if [[ ${_dsearch_view:-search} == help ]]; then
    _dsearch_view=search
  fi
  _DSEARCH_DIRTY=1
  _dsearch_paint_row bar "$_dsearch_q"
  _dsearch_place_cursor
  _dsearch_maybe_tick
}

# Need results for the live query now (Enter / arrows).
_dsearch_flush_filter() {
  local i
  if [[ $_dsearch_q == "$_DSEARCH_SHOWN_Q" ]]; then
    _DSEARCH_DIRTY=0
    return 0
  fi
  if (( _DSEARCH_WORKER_PID > 1 )) && [[ $_dsearch_q == "$_DSEARCH_WORK_Q" ]]; then
    for (( i=0; i < 40; i++ )); do
      if _dsearch_worker_poll; then
        _dsearch_draw "$_dsearch_q"
        return 0
      fi
      if ! kill -0 $_DSEARCH_WORKER_PID 2>/dev/null; then
        _DSEARCH_WORKER_PID=0
        if _dsearch_worker_poll; then
          _dsearch_draw "$_dsearch_q"
          return 0
        fi
        break
      fi
      if zmodload -F zsh/zselect b:zselect 2>/dev/null; then
        zselect -t 3
      else
        /bin/sleep 0.03 2>/dev/null || true
      fi
    done
  fi
  _dsearch_worker_stop
  _dsearch_apply_filter "$_dsearch_q" 10
  _DSEARCH_SHOWN_Q="$_dsearch_q"
  _DSEARCH_WORK_Q="$_dsearch_q"
  _DSEARCH_DIRTY=0
  _dsearch_draw "$_dsearch_q"
}

# 0 = REPLY is a key; 1 = 30ms tick (or abort). Keys already waiting never wait.
_dsearch_wait_key() {
  local k
  REPLY=""
  (( ${DNAV_ABORT:-0} )) && return 1
  if [[ -n ${_DSEARCH_PUSHBACK:-} ]]; then
    REPLY="$_DSEARCH_PUSHBACK"
    _DSEARCH_PUSHBACK=""
    return 0
  fi
  if (( $+functions[_dnav_try_read_token] )) && _dnav_try_read_token; then
    return 0
  fi
  if read -t 0.03 -k 1 k 2>/dev/null; then
    (( $+functions[_dnav_maybe_resize] )) && _dnav_maybe_resize
    [[ -n $k ]] || return 1
    if (( $+functions[_dnav_classify_key] )); then
      _dnav_classify_key "$k"
    else
      REPLY="$k"
    fi
    return 0
  fi
  (( $+functions[_dnav_maybe_resize] )) && _dnav_maybe_resize
  if (( ! ${_DNAV_RESIZE_MODE:-0} )) && (( $+functions[_dnav_status_tick] )) && _dnav_status_tick; then
    _dnav_status_repaint
  fi
  return 1
}

# Move highlight in the dropdown (arrows / Ctrl+N / Ctrl+P — not j/k, those type)
_dsearch_sel_up() {
  [[ ${_dsearch_view:-search} == search ]] || return 1
  if [[ ${_dsearch_focus:-list} == help ]]; then
    # Leave Help chip, keep current list index
    _dsearch_focus_list
    return 0
  fi
  (( $#_dsearch_matches && _dsearch_sel > 0 )) || return 1
  local old=$_dsearch_sel
  (( _dsearch_sel-- ))
  _dsearch_draw_sel "$_dsearch_q" $old
}

_dsearch_sel_down() {
  [[ ${_dsearch_view:-search} == search ]] || return 1
  if [[ ${_dsearch_focus:-list} == help ]]; then
    _dsearch_focus_list
    return 0
  fi
  (( $#_dsearch_matches && _dsearch_sel < $#_dsearch_matches - 1 )) || return 1
  local old=$_dsearch_sel
  (( _dsearch_sel++ ))
  _dsearch_draw_sel "$_dsearch_q" $old
}

# ── Main entry ────────────────────────────────────────────────────────────
# Return 0 → navigated/done (or for_dfile: path in DNAV_SEARCH_RESULT)
# Return 1 → cancelled
typeset -gi _DSEARCH_FOR_DFILE=0
typeset -g  DNAV_SEARCH_RESULT=""

# Search while dfile is open: confirm stays in explorer (no dnav exit/cleanup).
_dsearch_start_for_dfile() {
  _DSEARCH_FOR_DFILE=1
  DNAV_SEARCH_RESULT=""
  _dsearch_start
  local ret=$?
  _DSEARCH_FOR_DFILE=0
  return $ret
}

_dsearch_start() {
  # Legacy stub path only if for_dfile not set
  if (( ! _DSEARCH_FOR_DFILE )) && _dfile_available && (( $+functions[_dfile_is_open] )) && _dfile_is_open; then
    if (( $+functions[_dsearch_start_for_dfile] )); then
      _dsearch_start_for_dfile
      return $?
    fi
  fi

  local key key2 key3
  local target
  local maxn=10
  typeset -g _DSEARCH_PUSHBACK=""
  typeset -g _dsearch_q=""

  setopt localoptions nomonitor nonotify

  _dsearch_q="${1:-}"
  _dsearch_cur=${#_dsearch_q}
  _dsearch_qwin=0
  _dsearch_matches=()
  _dsearch_sel=0
  _dsearch_extra_lines=0
  _dsearch_focus=list
  _dsearch_view=search
  _DSEARCH_WORKER_PID=0
  _DSEARCH_GEN=0
  _DSEARCH_LAST_TICK=0
  _DSEARCH_WORK_Q=""
  _DSEARCH_SHOWN_Q=""
  _DSEARCH_DIRTY=0
  _DSEARCH_PUSHBACK=""

  _dsearch_tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/dnav-dsearch.XXXXXX") || {
    printf "\r\e[2K"
    printf "\e[?25l"
    return 1
  }

  # Wipe previous TUI line (main bar / dfile) so only search remains
  printf "\r\e[2K\e[?25l"

  # Wait for background index if needed — "Indexing... N" on this line, then clear.
  # ensure_index always returns 0 so we still enter search (even with empty index).
  _dsearch_ensure_index
  printf "\r\e[2K\e[?25l"
  _dsearch_extra_lines=0
  if [[ -n $_dsearch_q ]]; then
    _dsearch_apply_filter "$_dsearch_q" $maxn
    _DSEARCH_WORK_Q="$_dsearch_q"
    _DSEARCH_SHOWN_Q="$_dsearch_q"
  fi
  _DSEARCH_OPEN=1
  _dsearch_draw "$_dsearch_q"

  while true; do
    (( ${DNAV_ABORT:-0} )) && { _DSEARCH_OPEN=0; _dsearch_worker_stop; return 130; }
    if ! _dsearch_wait_key; then
      (( ${DNAV_ABORT:-0} )) && { _DSEARCH_OPEN=0; _dsearch_worker_stop; return 130; }
      _dsearch_maybe_tick
      continue
    fi
    key="$REPLY"
    (( ${DNAV_ABORT:-0} )) && { _DSEARCH_OPEN=0; _dsearch_worker_stop; return 130; }
    if [[ $key == ctrl-c || $key == $'\x03' ]]; then
      _DSEARCH_OPEN=0
      _dsearch_worker_stop
      if (( $+functions[_dnav_abort] )); then
        _dnav_abort
      else
        _dsearch_erase_ui
        _dsearch_session_cleanup
        DNAV_ABORT=1
        printf "\e[?25h"
      fi
      return 130
    fi

    case $key in
      up)
        _dsearch_flush_filter
        _dsearch_sel_up
        ;;
      down)
        _dsearch_flush_filter
        _dsearch_sel_down
        ;;
      right)
        if [[ ${_dsearch_view:-search} == search ]]; then
          if [[ ${_dsearch_focus:-list} == help ]]; then
            :
          elif (( _dsearch_cur < ${#_dsearch_q} )); then
            (( _dsearch_cur++ ))
            _dsearch_draw "$_dsearch_q"
          else
            _dsearch_focus_help
          fi
        fi
        ;;
      left)
        if [[ ${_dsearch_view:-search} == search && ${_dsearch_focus:-list} == help ]]; then
          _dsearch_focus_list
        elif [[ ${_dsearch_view:-search} == search ]]; then
          if (( _dsearch_cur > 0 )); then
            (( _dsearch_cur-- ))
            _dsearch_draw "$_dsearch_q"
          fi
        fi
        ;;
      home|ctrl-a)
        _dsearch_cur=0
        _dsearch_draw "$_dsearch_q"
        ;;
      end|ctrl-e)
        _dsearch_cur=${#_dsearch_q}
        _dsearch_draw "$_dsearch_q"
        ;;
      delete)
        if [[ ${_dsearch_view:-search} != help ]]; then
          _dsearch_delete && _dsearch_note_query
        fi
        ;;
      esc)
        if [[ ${_dsearch_view:-search} == help ]]; then
          _dsearch_close_help
        else
          _dsearch_erase_ui
          _dsearch_session_cleanup
          printf "\e[?25l"
          return 1
        fi
        ;;
      enter)
        if [[ ${_dsearch_view:-search} == help ]]; then
          continue
        fi
        if [[ ${_dsearch_focus:-list} == help ]]; then
          _dsearch_open_help
          continue
        fi
        _dsearch_flush_filter
        if (( $#_dsearch_matches == 0 )); then
          continue
        fi
        target="${_dsearch_matches[_dsearch_sel+1]}"
        _dsearch_erase_ui
        _dsearch_session_cleanup
        printf "\e[?25l"
        if [[ -d $target ]]; then
          if (( _DSEARCH_FOR_DFILE )); then
            cd -- "$target" 2>/dev/null || true
            DNAV_SEARCH_RESULT="${target:a}"
            return 0
          fi
          cd -- "$target" || {
            printf "Could not change to %s\n" "$target"
            (( $+functions[_dnav_cleanup] )) && _dnav_cleanup
            return 0
          }
          if (( $+functions[_dnav_finish] )); then
            _dnav_finish "${target:a}" dnav
          else
            print -r -- "${target:a}"
            (( $+functions[_dnav_cleanup] )) && _dnav_cleanup
            (( $+functions[_dnav_maybe_ls] )) && _dnav_maybe_ls dnav
          fi
          return 0
        else
          if (( _DSEARCH_FOR_DFILE )); then
            return 1
          fi
          printf "Folder not found: %s\n" "$target"
          (( $+functions[_dnav_cleanup] )) && _dnav_cleanup
          return 0
        fi
        ;;
      backspace)
        if [[ ${_dsearch_view:-search} == help ]]; then
          continue
        fi
        if _dsearch_backspace; then
          _dsearch_note_query
        fi
        ;;
      ctrl-u)
        if [[ ${_dsearch_view:-search} == help ]]; then
          continue
        fi
        _dsearch_q=""
        _dsearch_cur=0
        _dsearch_sel=0
        _dsearch_matches=()
        _dsearch_focus=list
        _dsearch_worker_stop
        _DSEARCH_WORK_Q=""
        _DSEARCH_SHOWN_Q=""
        _DSEARCH_DIRTY=0
        _dsearch_draw "$_dsearch_q"
        ;;
      ctrl-p)
        _dsearch_flush_filter
        _dsearch_sel_up
        ;;
      ctrl-n)
        _dsearch_flush_filter
        _dsearch_sel_down
        ;;
      [[:print:]])
        if [[ ${_dsearch_view:-search} == help ]]; then
          _dsearch_view=search
        fi
        _dsearch_focus=list
        _dsearch_insert "$key"
        _dsearch_note_query
        ;;
    esac
    _dsearch_maybe_tick
  done
}
