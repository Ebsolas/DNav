#!/usr/bin/env zsh
# dsearch — fuzzy directory search overlay
# Index library: dsearch-index. Disk crawl: optional dindexer.

if (( ! $+functions[_dsearch_reindex] )); then
  _dsearch_idx="${DNAV_DIR:-${${(%):-%x}:A:h}}/dsearch-index"
  [[ -f $_dsearch_idx ]] && source "$_dsearch_idx"
  unset _dsearch_idx
fi

_dsearch_available() { return 0 }

# Session state
typeset -ga _dsearch_matches
typeset -gi _dsearch_sel=0
typeset -gi _dsearch_extra_lines=0
typeset -gi _dsearch_cur=0
typeset -gi _dsearch_qwin=0
typeset -gi _DSEARCH_OPEN=0
typeset -g  _dsearch_tmpdir=""

_dsearch_session_cleanup() {
  _dsearch_worker_stop
  if [[ -n $_dsearch_tmpdir && -d $_dsearch_tmpdir ]]; then
    /bin/rm -rf -- "$_dsearch_tmpdir" 2>/dev/null
  fi
  _dsearch_tmpdir=""
  _dsearch_q=""
  _dsearch_cur=0
  _dsearch_qwin=0
  _dsearch_focus=list
  _dsearch_view=search
  _DSEARCH_OPEN=0
  _DSEARCH_DIRTY=0
  _DSEARCH_WORKER_PID=0
  _DSEARCH_GEN=0
  _DSEARCH_LAST_TICK=0
  _DSEARCH_LAST_KEY_MS=0
  _DSEARCH_IDLE_TICKS=0
  _DSEARCH_WORK_Q=""
  _DSEARCH_SHOWN_Q=""
  _DSEARCH_PHASE=""
  _DSEARCH_USED_FULL=0
}

_dsearch_cur_clamp() {
  (( _dsearch_cur < 0 )) && _dsearch_cur=0
  (( _dsearch_cur > ${#_dsearch_q} )) && _dsearch_cur=${#_dsearch_q}
}

# Insert $1 at the caret.
_dsearch_insert() {
  local ch="$1"
  _dsearch_cur_clamp
  _dsearch_q="${_dsearch_q[1,_dsearch_cur]}${ch}${_dsearch_q[_dsearch_cur+1,-1]}"
  (( _dsearch_cur++ ))
}

# Backspace.
_dsearch_backspace() {
  _dsearch_cur_clamp
  (( _dsearch_cur > 0 )) || return 1
  _dsearch_q="${_dsearch_q[1,_dsearch_cur-1]}${_dsearch_q[_dsearch_cur+1,-1]}"
  (( _dsearch_cur-- ))
}

# Forward delete.
_dsearch_delete() {
  _dsearch_cur_clamp
  (( _dsearch_cur < ${#_dsearch_q} )) || return 1
  _dsearch_q="${_dsearch_q[1,_dsearch_cur]}${_dsearch_q[_dsearch_cur+2,-1]}"
}

_dsearch_cursor_hide() {
  printf "\e[0 q\e[?25l"
}

# Query caret. Call after painting the bar.
_dsearch_place_cursor() {
  local label=" DNav Search:" col maxw
  if [[ ${_dsearch_view:-search} != search || ${_dsearch_focus:-list} != list ]]; then
    _dsearch_cursor_hide
    return
  fi
  _dsearch_cur_clamp
  maxw="$(_dsearch_cols)"
  col=$(( ${#label} + 2 + _dsearch_cur - _dsearch_qwin ))
  (( col < 1 )) && col=1
  (( col >= maxw )) && col=$(( maxw - 1 ))
  printf "\r\e[6 q\e[%dG\e[?25h" $col
}

# query, maxn, src_file [, fuzzy] → top paths. Soft-AND; all-token hits beat near-misses.
# fuzzy=0 skips edit_dist (hot pass). Order is a within-band weight, not a filter.
_dsearch_awk_filter() {
  local query="$1" maxn="$2" src="$3" fuzzy="${4:-1}"
  local home_p config_p data_p state_p cache_p
  [[ -n $src ]] || src="$(_dsearch_index_path)"
  [[ -f $src ]] || return 0

  home_p="${HOME%/}"
  config_p="${XDG_CONFIG_HOME:-$HOME/.config}"
  data_p="${XDG_DATA_HOME:-$HOME/.local/share}"
  state_p="${XDG_STATE_HOME:-$HOME/.local/state}"
  cache_p="${XDG_CACHE_HOME:-$HOME/.cache}"
  config_p="${config_p%/}"
  data_p="${data_p%/}"
  state_p="${state_p%/}"
  cache_p="${cache_p%/}"

  awk -v query="$query" -v maxn="$maxn" -v fuzzy="$fuzzy" \
      -v home="$home_p" \
      -v xdg_config="$config_p" -v xdg_data="$data_p" \
      -v xdg_state="$state_p" -v xdg_cache="$cache_p" '
  function better(sc, path, osc, opath) {
    if (sc > osc) return 1
    if (sc < osc) return 0
    return (length(path) < length(opath))
  }
  function consider(sc, path,   i) {
    if (pool <= 0) return
    if (tn == pool && !better(sc, path, tsc[tn], tpath[tn])) return
    if (tn < pool) tn++
    i = tn
    while (i > 1 && better(sc, path, tsc[i-1], tpath[i-1])) {
      tsc[i] = tsc[i-1]
      tpath[i] = tpath[i-1]
      i--
    }
    tsc[i] = sc
    tpath[i] = path
  }

  function strip_dot(s) {
    if (substr(s, 1, 1) == ".") return substr(s, 2)
    return s
  }
  function stem_s(s) {
    if (length(s) > 3 && substr(s, length(s), 1) == "s" && substr(s, length(s) - 1, 1) != "s")
      return substr(s, 1, length(s) - 1)
    return s
  }
  function is_transpose(a, b,   n, i) {
    if (length(a) != length(b)) return 0
    n = length(a)
    for (i = 1; i < n; i++) {
      if (substr(a, i, 1) != substr(b, i, 1))
        return (substr(a, i, 1) == substr(b, i + 1, 1) && substr(a, i + 1, 1) == substr(b, i, 1) && substr(a, i + 2) == substr(b, i + 2))
    }
    return 0
  }
  function first_two_swap(a, b) {
    return (length(a) == length(b) && length(a) >= 2 && substr(a, 1, 1) == substr(b, 2, 1) && substr(a, 2, 1) == substr(b, 1, 1) && substr(a, 3) == substr(b, 3))
  }
  function edit_dist(a, b, maxd,   n, m, i, j, tmp, prev, cur, cost, del, ins, repl, ai, rowmin, v) {
    n = length(a)
    m = length(b)
    if (n > m) { tmp = a; a = b; b = tmp; n = length(a); m = length(b) }
    if (m - n > maxd) return -1
    for (j = 0; j <= m; j++) v[j] = j
    for (i = 1; i <= n; i++) {
      prev = v[0]
      v[0] = i
      rowmin = i
      ai = substr(a, i, 1)
      for (j = 1; j <= m; j++) {
        cur = v[j]
        cost = (ai == substr(b, j, 1)) ? 0 : 1
        del = v[j] + 1
        ins = v[j - 1] + 1
        repl = prev + cost
        v[j] = del
        if (ins < v[j]) v[j] = ins
        if (repl < v[j]) v[j] = repl
        prev = cur
        if (v[j] < rowmin) rowmin = v[j]
      }
      if (rowmin > maxd) return -1
    }
    if (v[m] > maxd) return -1
    return v[m]
  }

  # Score tok against one path component. 100 = last-component exact.
  # Dots are kept: .cache ≠ cache (bare cache still matches .cache, weaker).
  # Prefix of a component is enough (typeahead). No letter-skip across the path.
  function token_hit(tok, seg, islast,   t, s, tnd, snd, tok_dot, seg_dot, idx, extra, d, maxd) {
    t = tolower(tok)
    s = tolower(seg)
    if (t == "" || s == "") return -1
    tok_dot = (substr(t, 1, 1) == ".")
    seg_dot = (substr(s, 1, 1) == ".")
    tnd = strip_dot(t)
    snd = strip_dot(s)
    if (tnd == "" || snd == "") return -1
    if (t == s) return islast ? 100 : 86
    if (tnd == snd) {
      if (!tok_dot && seg_dot) return islast ? 94 : 80
      if (tok_dot && !seg_dot) return islast ? 90 : 76
      return islast ? 100 : 86
    }
    if (stem_s(tnd) == stem_s(snd) && stem_s(tnd) != tnd) {
      if (!tok_dot && seg_dot) return islast ? 88 : 76
      return islast ? 92 : 80
    }
    if (length(tnd) == 1) {
      if (substr(s, 1, 1) == t) return islast ? 48 : 36
      if (substr(snd, 1, 1) == tnd) return islast ? 44 : 32
      return -1
    }
    idx = index(s, t)
    if (idx != 1) idx = index(snd, tnd)
    if (idx == 1) {
      extra = length(snd) - length(tnd)
      if (extra < 0) extra = 0
      if (extra > 8) extra = 8
      return (islast ? 88 : 74) - 2 * extra
    }
    if (idx > 1) return islast ? 68 : 58
    if (fuzzy && length(tnd) >= 4) {
      if (is_transpose(tnd, snd) || first_two_swap(tnd, snd)) return islast ? 78 : 66
      maxd = (length(tnd) < 6) ? 1 : 2
      d = edit_dist(tnd, snd, maxd)
      if (d == 1) return islast ? 78 : 66
      if (d == 2) return islast ? 62 : 52
    }
    return -1
  }

  function under(path, root) {
    if (root == "" || path == "") return 0
    if (path == root) return 1
    return (index(path, root "/") == 1)
  }
  function is_under(child, parent) {
    return (length(child) > length(parent) && index(child, parent "/") == 1)
  }
  function is_wellknown(name,   n) {
    n = tolower(name)
    return (n == "documents" || n == "downloads" || n == "desktop" || n == "pictures" || n == "music" || n == "videos" || n == "projects")
  }
  function is_scope_tok(tok,   n) {
    n = tolower(tok)
    n = strip_dot(n)
    return (n == "etc" || n == "usr" || n == "var" || n == "opt" || n == "tmp" || n == "home" || n == "root" || n == "cache" || n == "config" || n == "local" || n == "desktop" || n == "documents" || n == "downloads" || n == "pictures" || n == "music" || n == "videos" || n == "projects" || n == "bin" || n == "lib" || n == "share" || n == "include")
  }
  function fill_segs(path,   n, raw, i) {
    n = split(path, raw, "/")
    nseg = 0
    for (i = 1; i <= n; i++) {
      if (raw[i] == "") continue
      nseg++
      segs[nseg] = raw[i]
    }
  }
  function first_home_seg(path) {
    if (!under(path, home) || path == home) return ""
    if (home_ncomp + 1 <= nseg) return segs[home_ncomp + 1]
    return ""
  }
  function rel_depth(path,   rest, n, rs, i, d) {
    if (under(path, home)) {
      if (path == home) return 0
      rest = substr(path, length(home) + 2)
      n = split(rest, rs, "/")
      d = 0
      for (i = 1; i <= n; i++) if (rs[i] != "") d++
      return d
    }
    n = split(path, rs, "/")
    d = 0
    for (i = 1; i <= n; i++) if (rs[i] != "") d++
    if (d > 0) d--
    return d
  }
  function path_leaf() {
    return (nseg > 0) ? segs[nseg] : ""
  }
  function in_cache(path) {
    return (under(path, xdg_cache) || under(path, home "/.cache"))
  }
  function location_boost(path,   s, sl) {
    if (in_cache(path)) return 0
    if (path == xdg_config || path == home "/.config" || path == xdg_data || path == home "/.local/share" || path == xdg_state || path == home "/.local/state" || path == home "/.local" || path == home "/.local/bin")
      return 16
    s = first_home_seg(path)
    sl = tolower(s)
    if (sl == ".config" || sl == ".local") return 12
    if (under(path, xdg_config) || under(path, xdg_data) || under(path, xdg_state)) return 12
    if (is_wellknown(s)) return 16
    return 0
  }
  function home_boost(path) {
    if (home == "") return 0
    if (under(path, home)) return 8
    return -12
  }
  function cache_penalty(path) {
    if (!in_cache(path)) return 0
    if (cache_intent) return 0
    return -18
  }
  function depth_penalty(path,   d, p, leaf, h) {
    leaf = path_leaf()
    if (last_qtok != "" && leaf != "" && !is_scope_tok(last_qtok)) {
      h = token_hit(last_qtok, leaf, 1)
      if (h >= 88) return 0
    }
    d = rel_depth(path)
    if (d <= 2) return 0
    p = (d - 2) * 6
    if (is_scope_tok(last_qtok)) p = (d - 2) * 12
    if (p > 24) p = 24
    return -p
  }
  function scope_boost(path,   i, j, d, hit, b) {
    b = 0
    for (j = 1; j <= nseg; j++) {
      if (under(path, home) && home != "") d = j - home_ncomp
      else d = j
      if (d < 1 || d > 2) continue
      for (i = 1; i <= ntok; i++) {
        hit = token_hit(qtok[i], segs[j], 0)
        if (hit >= 74) { b += 16; break }
      }
    }
    if (b > 24) b = 24
    return b
  }
  function pref_of(path,   p) {
    p = location_boost(path) + home_boost(path) + cache_penalty(path) + depth_penalty(path)
    if (p > 30) p = 30
    if (p < -30) p = -30
    return p
  }
  function order_weight(   i, mono, rev) {
    if (nhit < 2) return 0
    mono = 1
    rev = 1
    for (i = 2; i <= nhit; i++) {
      if (hitj[i] < hitj[i - 1]) mono = 0
      if (hitj[i] > hitj[i - 1]) rev = 0
    }
    if (mono) return 14
    if (rev) return -8
    return 0
  }

  # Whitespace splits tokens (trailing space ignored). Each token matches independently.
  # Soft AND: missed tokens score 0. All-token band is 200+avg; partials stay < 200.
  # Chosen segment indices add a within-band order bonus (or a smaller reverse penalty).
  function query_score(path,   i, j, hit, best, bestj, total, hits, avg, prev) {
    if (ntok == 0) return -1
    total = 0
    hits = 0
    nhit = 0
    prev = 0
    for (i = 1; i <= ntok; i++) {
      best = -1
      bestj = 0
      for (j = 1; j <= nseg; j++) {
        hit = token_hit(qtok[i], segs[j], (j == nseg))
        if (hit > best) { best = hit; bestj = j }
        else if (hit == best && best > 0 && prev > 0) {
          if (j >= prev && bestj < prev) bestj = j
        }
      }
      if (best < 0) best = 0
      else {
        hits++
        nhit++
        hitj[nhit] = bestj
        prev = bestj
      }
      total += best
    }
    if (hits == 0) return -1
    avg = int(total / ntok)
    if (hits == ntok) return 200 + avg
    return int((100 * hits) / ntok) + int(avg / 2)
  }

  function ingest(path,   base, sc) {
    if (path == "" || path in seen) return
    fill_segs(path)
    base = query_score(path)
    if (base < 0) return
    sc = base + pref_of(path) + order_weight() + scope_boost(path)
    if (base >= 200 && sc < 200) sc = 200
    if (base < 200 && sc >= 200) sc = 199
    seen[path] = 1
    consider(sc, path)
  }

  BEGIN {
    if (fuzzy == "") fuzzy = 1
    ntok = 0
    last_qtok = ""
    cache_intent = 0
    home_ncomp = 0
    if (home != "") {
      n = split(home, hs, "/")
      for (i = 1; i <= n; i++) if (hs[i] != "") home_ncomp++
    }
    n = split(query, tok, /[ \t]+/)
    for (i = 1; i <= n; i++) {
      if (tok[i] == "") continue
      ntok++
      qtok[ntok] = tok[i]
      if (tolower(tok[i]) == ".cache") cache_intent = 1
    }
    if (ntok > 0) last_qtok = qtok[ntok]
    tn = 0
    pool = (maxn > 0) ? maxn : 0
    if (pool > 0 && pool < 40) pool = 40
  }
  { ingest($0) }
  END {
    if (maxn <= 0 || tn == 0) exit
    an = 0
    best = tsc[1]
    if (best >= 200) {
      if (best >= 290) floor = 272
      else if (best >= 270) floor = best - 10
      else floor = 200
      for (i = 1; i <= tn; i++) {
        if (tsc[i] < 200) break
        if (tsc[i] < floor) continue
        drop = 0
        for (j = 1; j <= an; j++) {
          if (is_under(tpath[i], apath[j])) { drop = 1; break }
        }
        if (drop) continue
        an++
        apath[an] = tpath[i]
        if (an >= maxn) break
      }
    }
    if (an < maxn) {
      for (i = 1; i <= tn; i++) {
        if (tsc[i] >= 200) continue
        an++
        apath[an] = tpath[i]
        if (an >= maxn) break
      }
    }
    for (i = 1; i <= an; i++) print apath[i]
  }
  ' "$src"
}

# 0 if $1 contains every whitespace token from $2 (substring, any order).
_dsearch_tokens_in_path() {
  emulate -L zsh
  local p="${(L)1}" q="$2" tok
  local -a toks
  toks=(${=q})
  (( $#toks )) || return 1
  for tok in "${toks[@]}"; do
    [[ -z $tok ]] && continue
    [[ $p == *${(L)tok}* ]] || return 1
  done
  return 0
}

_dsearch_all_token_n() {
  emulate -L zsh
  local q="$1" p n=0
  for p in "${_dsearch_matches[@]}"; do
    _dsearch_tokens_in_path "$p" "$q" && (( n++ ))
  done
  print -rn -- $n
}

# 0 if hot-list leaf $1 is a strong match for token $2 (prefix/exact, optional dot).
_dsearch_leaf_matches_token() {
  emulate -L zsh
  local leaf="${(L)1}" tok="${(L)2}"
  local leaf_nd="${leaf#.}" tok_nd="${tok#.}"
  [[ -z $tok_nd ]] && return 1
  [[ $leaf == $tok || $leaf == $tok* || $leaf_nd == $tok_nd || $leaf_nd == $tok_nd* ]]
}

# Hot paths whose leaf a query token matches, excluding $HOME / /.
_dsearch_scope_prefixes() {
  emulate -L zsh
  local query="$1" hot p leaf tok
  local -a toks
  local -A seen
  hot="$(_dsearch_hot_path)"
  [[ -f $hot && -s $hot ]] || return 0
  toks=(${=query})
  (( $#toks )) || return 0
  while IFS= read -r p; do
    [[ -n $p ]] || continue
    [[ $p == "$HOME" || $p == / ]] && continue
    leaf="${p:t}"
    [[ -n $leaf ]] || continue
    for tok in "${toks[@]}"; do
      [[ -z $tok ]] && continue
      if _dsearch_leaf_matches_token "$leaf" "$tok"; then
        [[ -n ${seen[$p]:-} ]] && continue
        seen[$p]=1
        print -r -- "$p"
        break
      fi
    done
  done < "$hot"
}

# Idx lines under any scope prefix → $2. 0 if the file was written.
_dsearch_write_scope_src() {
  emulate -L zsh
  local query="$1" dest="$2" idx
  local -a prefs
  idx="$(_dsearch_index_path)"
  [[ -f $idx && -n $dest ]] || return 1
  prefs=("${(@f)$(_dsearch_scope_prefixes "$query")}")
  (( $#prefs )) || return 1
  awk -v prefs="${(j:\n:)prefs}" '
    BEGIN { n = split(prefs, a, "\n") }
    {
      for (i = 1; i <= n; i++) {
        if (a[i] == "") continue
        if ($0 == a[i] || index($0, a[i] "/") == 1) { print; next }
      }
    }
  ' "$idx" > "$dest"
  [[ -s $dest ]]
}

# Hot → named subtree → full idx. Writes $3 after each phase that has hits.
# Full idx only if a cheaper phase still has fewer than maxn all-token hits.
_dsearch_rank_phases() {
  emulate -L zsh
  local query="$1"
  local maxn="${2:-10}"
  local out="${3:-}"
  local idx hot sub=""
  local -a top
  local n=0

  _dsearch_matches=()
  _DSEARCH_PHASE=""
  _DSEARCH_USED_FULL=0
  [[ -n $query ]] || return 0

  idx="$(_dsearch_index_path)"
  hot="$(_dsearch_hot_path)"

  _dsearch_emit_phase() {
    local -a hits
    local p
    hits=()
    for p in "$@"; do
      [[ -n $p ]] && hits+=("$p")
    done
    (( $#hits )) || return 1
    _dsearch_take_top "${hits[@]}"
    _dsearch_pin_jumps "$query" "$maxn"
    if [[ -n $out ]]; then
      if (( $#_dsearch_matches )); then
        print -l -- "${_dsearch_matches[@]}" > "$out.tmp"
      else
        : > "$out.tmp"
      fi
      /bin/mv -f -- "$out.tmp" "$out" 2>/dev/null || true
    fi
    return 0
  }

  if [[ -f $hot && -s $hot ]]; then
    top=("${(@f)$(_dsearch_awk_filter "$query" "$maxn" "$hot" 0)}")
    if _dsearch_emit_phase "${top[@]}"; then
      _DSEARCH_PHASE=hot
      n="$(_dsearch_all_token_n "$query")"
      (( n >= maxn )) && return 0
    fi
  fi

  if [[ -n ${_dsearch_tmpdir:-} && -d ${_dsearch_tmpdir:-} ]]; then
    sub="$_dsearch_tmpdir/scope.src"
  else
    sub="${TMPDIR:-/tmp}/dnav-scope.$$"
  fi
  if _dsearch_write_scope_src "$query" "$sub"; then
    top=("${(@f)$(_dsearch_awk_filter "$query" "$maxn" "$sub" 1)}")
    if _dsearch_emit_phase "${top[@]}"; then
      _DSEARCH_PHASE=sub
      n="$(_dsearch_all_token_n "$query")"
      (( n >= maxn )) && return 0
    fi
  fi
  [[ $sub == "${TMPDIR:-/tmp}/dnav-scope.$$" ]] && rm -f -- "$sub" 2>/dev/null

  [[ -f $idx ]] || return 0
  top=("${(@f)$(_dsearch_awk_filter "$query" "$maxn" "$idx" 1)}")
  if _dsearch_emit_phase "${top[@]}"; then
    _DSEARCH_PHASE=full
    _DSEARCH_USED_FULL=1
  elif [[ -z $_DSEARCH_PHASE ]]; then
    _DSEARCH_PHASE=full
    _DSEARCH_USED_FULL=1
  fi
  return 0
}

# Fill _dsearch_matches (top maxn). Pins jump aliases that contain every token.
_dsearch_apply_filter() {
  local query="$1"
  local maxn="${2:-10}"
  local out=""

  _dsearch_matches=()
  if [[ -z $query ]]; then
    return 0
  fi
  if [[ -n ${_dsearch_tmpdir:-} && -d ${_dsearch_tmpdir:-} ]]; then
    out="$_dsearch_tmpdir/apply.hits"
  fi
  _dsearch_rank_phases "$query" "$maxn" "$out"
}

# Drop the empty element zsh leaves when awk prints nothing.
_dsearch_take_top() {
  emulate -L zsh
  local p
  _dsearch_matches=()
  for p in "$@"; do
    [[ -n $p ]] && _dsearch_matches+=("$p")
  done
}

# 0 if $1 contains every token from $2 (any order). Single-token skips (scorer).
_dsearch_path_has_tokens() {
  emulate -L zsh
  local p="${(L)1}" q="$2" tok
  local -a toks
  toks=(${=q})
  (( $#toks <= 1 )) && return 0
  for tok in "${toks[@]}"; do
    [[ -z $tok ]] && continue
    [[ $p == *${(L)tok}* ]] || return 1
  done
  return 0
}

# Prepend matching jump dirs, then cap to maxn.
_dsearch_pin_jumps() {
  local query="$1" maxn="${2:-10}"
  (( $+functions[_djump_available] )) && _djump_available || return 0
  local -a keys pinned out
  local k p m
  keys=("${(@f)$(_djump_match_query "$query")}")
  typeset -A seen
  pinned=()
  for k in "${keys[@]}"; do
    p="$(_djump_resolve "$k" 2>/dev/null)" || continue
    [[ -d $p ]] || continue
    _dsearch_path_has_tokens "$p" "$query" || continue
    if (( $+functions[_dnav_logical_path] )); then
      p="$(_dnav_logical_path "$p")"
    else
      p="${p:a}"
    fi
    [[ -n ${seen[$p]:-} ]] && continue
    seen[$p]=1
    pinned+=("$p")
  done
  (( $#pinned == 0 )) && return 0
  out=("${pinned[@]}")
  for m in "${_dsearch_matches[@]}"; do
    [[ -n ${seen[$m]:-} ]] && continue
    out+=("$m")
  done
  _dsearch_matches=("${out[@]:0:$maxn}")
}

# UI (same highlight as the main bar).

_dsearch_cols() {
  if (( $+functions[_dnav_usable_cols] )); then
    _dnav_usable_cols
    return
  fi
  local w=${COLUMNS:-80}
  [[ $w == <-> ]] || w=80
  (( w > 2 )) && (( w -= 2 ))
  (( w < 8 )) && w=8
  print -rn -- "$w"
}

# Display path (~ for $HOME).
_dsearch_display_path() {
  local p="$1" maxw="${2:-0}"
  local home="$HOME"
  if [[ $p == $home || $p == $home/* ]]; then
    p="~${p#$home}"
  fi
  if (( maxw > 0 )); then
    if (( $+functions[_dnav_fit_end] )); then
      p="$(_dnav_fit_end "$p" $maxw)"
    elif (( ${#p} > maxw )); then
      p="…${p:$(( ${#p} - maxw + 1 ))}"
    fi
  fi
  print -r -- "$p"
}

# Truncate/pad to w columns.
_dsearch_fit() {
  local s="$1" w="$2" pad
  if (( $+functions[_dnav_fit_end] )); then
    s="$(_dnav_fit_end "$s" $w)"
    if (( $+functions[_dnav_disp_w] )); then
      pad=$(( w - $(_dnav_disp_w "$s") ))
    else
      pad=$(( w - ${#s} ))
    fi
    (( pad < 0 )) && pad=0
    printf "%s%*s" "$s" $pad ""
    return
  fi
  if (( ${#s} > w )); then
    if (( w <= 1 )); then
      s="${s[1,w]}"
    else
      s="…${s:$(( ${#s} - w + 1 ))}"
    fi
  fi
  printf "%-${w}s" "$s"
}

# Focus: list | help
typeset -g _dsearch_focus=list
# View: search | help
typeset -g _dsearch_view=search

# Help overlay body.
_dsearch_help_lines() {
  print -r -- "Type to search. Last word is a prefix; extra words narrow the list but a miss still shows near matches."
  print -r -- "↑, ↓, Ctrl+N, Ctrl+P        move selection"
  print -r -- "Enter                       open the selected folder"
  print -r -- "←, →                        move the caret; → at the end focuses Help"
  print -r -- "Home, End, Ctrl+A, Ctrl+E   start or end of the query"
  print -r -- "Backspace, Delete           delete before or at the caret"
  print -r -- "Enter on Help               show this help"
  print -r -- "Esc                         close help, or leave search"
  print -r -- "Ctrl+U                      clear the query"
}

# $1 = bar | sel | row | blank | help_row. Bar is a chip, not a full-width fill.
_dsearch_paint_row() {
  local mode="$1" text="${2:-}"
  local hl rst maxw inner
  maxw="$(_dsearch_cols)"
  hl="$(_dnav_hl)"
  rst="$(_dnav_rst)"

  case $mode in
    bar)
      # [ DNav Search:] query…          count  [Help]
      local label count helpchip gap avail qshow
      label=" DNav Search:"
      helpchip=" Help "
      if [[ $_dsearch_q != "$_DSEARCH_SHOWN_Q" ]]; then
        count=""
      elif (( $#_dsearch_matches > 0 )) && [[ ${_dsearch_focus:-list} == list ]]; then
        count=" $(( _dsearch_sel + 1 ))/$#_dsearch_matches "
      else
        count=""
      fi
      # Room for query: label + space after chip + count + Help
      avail=$(( maxw - ${#label} - 1 - ${#count} - ${#helpchip} ))
      (( avail < 1 )) && avail=1
      _dsearch_cur_clamp
      _dsearch_qwin=0
      qshow="$text"
      if (( ${#text} > avail )); then
        _dsearch_qwin=$(( _dsearch_cur - avail + 1 ))
        (( _dsearch_qwin < 0 )) && _dsearch_qwin=0
        if (( _dsearch_qwin + avail > ${#text} )); then
          _dsearch_qwin=$(( ${#text} - avail ))
          (( _dsearch_qwin < 0 )) && _dsearch_qwin=0
        fi
        qshow="${text[_dsearch_qwin+1,_dsearch_qwin+avail]}"
      fi
      gap=$(( maxw - ${#label} - 1 - ${#qshow} - ${#count} - ${#helpchip} ))
      (( gap < 0 )) && gap=0
      # Label chip always cyan; space + query normal; Help cyan when focused
      printf "\r${hl}%s${rst} %s%*s%s" "$label" "$qshow" $gap "" "$count"
      if [[ ${_dsearch_focus:-list} == help ]]; then
        printf "${hl}%s${rst}" "$helpchip"
      else
        printf "%s" "$helpchip"
      fi
      printf "\e[K"
      ;;
    sel)
      # Selected match: cyan chip-style row (full width for clean overwrite)
      inner=$(( maxw - 2 ))
      (( inner < 1 )) && inner=1
      printf "\r${hl}▶ %s${rst}" "$(_dsearch_fit "$text" $inner)"
      ;;
    row)
      # Unselected: faint, full-width pad so old cyan is fully overwritten
      inner=$(( maxw - 2 ))
      (( inner < 1 )) && inner=1
      printf "\r\e[2m  %s${rst}" "$(_dsearch_fit "$text" $inner)"
      ;;
    help_row)
      # Help overlay body line (cyan bar, matches main dnav help)
      printf "\r${hl}%-${maxw}s${rst}" "$(_dsearch_fit " $text" $maxw)"
      ;;
    blank)
      printf "\r%*s" $maxw ""
      ;;
  esac
}

# Full redraw of bar + list (or help).
_dsearch_draw() {
  local query="$1"
  local n p disp i leftover
  local -a hlines

  _dsearch_cursor_hide

  _dsearch_paint_row bar "$query"

  n=0
  if [[ ${_dsearch_view:-search} == help ]]; then
    hlines=("${(@f)$(_dsearch_help_lines)}")
    for p in "${hlines[@]}"; do
      printf "\n"
      _dsearch_paint_row help_row "$p"
      (( n++ ))
    done
  else
    for p in "${_dsearch_matches[@]}"; do
      disp="$(_dsearch_display_path "$p")"
      printf "\n"
      # When Help chip is focused, no list row looks selected
      if [[ ${_dsearch_focus:-list} == list ]] && (( n == _dsearch_sel )); then
        _dsearch_paint_row sel "$disp"
      else
        _dsearch_paint_row row "$disp"
      fi
      (( n++ ))
    done
  fi

  leftover=$(( _dsearch_extra_lines - n ))
  if (( !_DNAV_RESIZING )); then
    for (( i=0; i < leftover; i++ )); do
      printf "\n"
      _dsearch_paint_row blank
    done
    if (( leftover > 0 )); then
      printf "\e[%dA" $leftover
    fi
  fi

  _dsearch_extra_lines=$n
  printf "\e[J"
  if (( n > 0 )); then
    printf "\e[%dA" $n
  fi
  _dsearch_place_cursor
}

# Selection moved: repaint two rows + bar.
_dsearch_draw_sel() {
  local query="$1"
  local old="$2"   # previous index
  local n=$#_dsearch_matches
  local disp

  [[ ${_dsearch_view:-search} == search ]] || return 0
  (( n == 0 )) && return 0
  _dsearch_cursor_hide

  _dsearch_paint_row bar "$query"

  if (( old >= 0 && old < n )); then
    printf "\e[%dB" $(( old + 1 ))
    disp="$(_dsearch_display_path "${_dsearch_matches[old+1]}")"
    _dsearch_paint_row row "$disp"
    printf "\e[%dA" $(( old + 1 ))
  fi

  if [[ ${_dsearch_focus:-list} == list ]]; then
    printf "\e[%dB" $(( _dsearch_sel + 1 ))
    disp="$(_dsearch_display_path "${_dsearch_matches[_dsearch_sel+1]}")"
    _dsearch_paint_row sel "$disp"
    printf "\e[%dA" $(( _dsearch_sel + 1 ))
  fi
  _dsearch_place_cursor
}

_dsearch_erase_ui() {
  local i
  _dsearch_cursor_hide
  printf "\r\e[2K"
  for (( i=0; i < _dsearch_extra_lines; i++ )); do
    printf "\n\r\e[2K"
  done
  (( _dsearch_extra_lines > 0 )) && printf "\e[%dA" $_dsearch_extra_lines
  printf "\r\e[2K"
  _dsearch_extra_lines=0
}

_dsearch_focus_help() {
  _dsearch_focus=help
  _dsearch_draw "$_dsearch_q"
}

_dsearch_focus_list() {
  _dsearch_focus=list
  _dsearch_draw "$_dsearch_q"
}

_dsearch_open_help() {
  _dsearch_view=help
  _dsearch_focus=help
  _dsearch_draw "$_dsearch_q"
}

_dsearch_close_help() {
  _dsearch_view=search
  _dsearch_focus=list
  _dsearch_draw "$_dsearch_q"
}

# Query is live. Rank in a background job; refresh ~30ms, never on the key path.
typeset -gi _DSEARCH_DIRTY=0
typeset -gi _DSEARCH_WORKER_PID=0
typeset -gi _DSEARCH_GEN=0
typeset -gi _DSEARCH_LAST_TICK=0
typeset -gi _DSEARCH_LAST_KEY_MS=0
typeset -gi _DSEARCH_DEBOUNCE_MS=40
typeset -gi _DSEARCH_IDLE_TICKS=0
typeset -gi _DSEARCH_USED_FULL=0
typeset -g  _DSEARCH_WORK_Q=""
typeset -g  _DSEARCH_SHOWN_Q=""
typeset -g  _DSEARCH_PHASE=""

zmodload -F zsh/datetime p:EPOCHREALTIME 2>/dev/null || true

_dsearch_now_ms() {
  emulate -L zsh
  local -i ms
  if [[ -n ${EPOCHREALTIME:-} ]]; then
    ms=$(( EPOCHREALTIME * 1000 ))
    print -rn -- $ms
  else
    print -rn -- 0
  fi
}

# Drain buffered print/edit keys. Navigation is pushback.
_dsearch_drain_query() {
  while _dnav_try_read_token; do
    case $REPLY in
      backspace)
        _dsearch_backspace || true
        ;;
      delete)
        _dsearch_delete || true
        ;;
      ctrl-u)
        _dsearch_q=""
        _dsearch_cur=0
        ;;
      esc|enter|up|down|left|right|home|end|tab|ctrl-c|ctrl-n|ctrl-p|ctrl-a|ctrl-e)
        _DSEARCH_PUSHBACK="$REPLY"
        return
        ;;
      [[:print:]])
        _dsearch_insert "$REPLY"
        ;;
    esac
  done
}

# wait(2) the ranker. Call whenever _DSEARCH_WORKER_PID is cleared.
_dsearch_worker_reap() {
  local pid=$_DSEARCH_WORKER_PID
  _DSEARCH_WORKER_PID=0
  (( pid > 1 )) || return 0
  wait "$pid" 2>/dev/null || true
}

_dsearch_worker_stop() {
  local pid=$_DSEARCH_WORKER_PID
  (( pid > 1 )) || { _DSEARCH_WORKER_PID=0; return 0 }
  kill "$pid" 2>/dev/null || true
  command pkill -P "$pid" 2>/dev/null || true
  _dsearch_worker_reap
}

# Enter: highlighted row. Re-rank only if empty. Path in REPLY (flush may paint).
_dsearch_commit_target() {
  emulate -L zsh
  if (( $#_dsearch_matches == 0 )); then
    _dsearch_flush_filter
  fi
  (( $#_dsearch_matches )) || return 1
  (( _dsearch_sel < 0 )) && _dsearch_sel=0
  (( _dsearch_sel >= $#_dsearch_matches )) && _dsearch_sel=$(( $#_dsearch_matches - 1 ))
  REPLY="${_dsearch_matches[_dsearch_sel+1]}"
}

# Rank $_dsearch_q off-thread → $tmpdir/hits.$gen (phased awk, not nested apply_filter).
_dsearch_worker_start() {
  local q="$_dsearch_q" gen tmp
  tmp="$_dsearch_tmpdir"
  [[ -n $tmp && -d $tmp ]] || return 1
  _dsearch_worker_stop
  if [[ -z $q ]]; then
    _dsearch_matches=()
    _DSEARCH_WORK_Q=""
    _DSEARCH_SHOWN_Q=""
    _DSEARCH_DIRTY=0
    _dsearch_draw ""
    return 0
  fi
  (( ++_DSEARCH_GEN ))
  gen=$_DSEARCH_GEN
  _DSEARCH_WORK_Q="$q"
  _DSEARCH_IDLE_TICKS=0
  setopt localoptions nomonitor nonotify
  (
    emulate -L zsh
    setopt nomonitor nonotify
    : > "$tmp/run.$gen"
    _dsearch_rank_phases "$q" 10 "$tmp/hits.$gen"
  ) </dev/null >/dev/null 2>&1 &!
  _DSEARCH_WORKER_PID=$!
  if (( _DSEARCH_WORKER_PID <= 1 )); then
    _DSEARCH_WORKER_PID=0
    _dsearch_rank_phases "$q" 10 "$tmp/hits.$gen"
    _dsearch_take_top "${(@f)$(<"$tmp/hits.$gen")}" 2>/dev/null || _dsearch_apply_filter "$q" 10
    _DSEARCH_SHOWN_Q="$q"
    _DSEARCH_WORK_Q="$q"
    _DSEARCH_DIRTY=0
    _dsearch_draw "$q"
  fi
}

# 0 if this generation has a hits file (caller draws). Later phases may rewrite it.
_dsearch_worker_poll() {
  local gen=$_DSEARCH_GEN tmp="$_dsearch_tmpdir" f pid=$_DSEARCH_WORKER_PID
  [[ -n $tmp && $gen -gt 0 ]] || return 1
  f="$tmp/hits.$gen"
  [[ -f $f ]] || return 1
  _dsearch_take_top "${(@f)$(<"$f")}"
  /bin/rm -f -- "$f"
  if (( pid > 1 )) && ! kill -0 $pid 2>/dev/null; then
    _dsearch_worker_reap
    /bin/rm -f -- "$tmp/run.$gen"
  fi
  _DSEARCH_SHOWN_Q="$_DSEARCH_WORK_Q"
  _DSEARCH_DIRTY=0
  _dsearch_sel=0
  return 0
}

_dsearch_debounce_ready() {
  emulate -L zsh
  local now
  now="$(_dsearch_now_ms)"
  (( now <= 0 || _DSEARCH_LAST_KEY_MS <= 0 )) && return 0
  (( now - _DSEARCH_LAST_KEY_MS >= _DSEARCH_DEBOUNCE_MS ))
}

# If the query only grew, re-score the current hits with the same awk (tiny src).
_dsearch_preview_if_prefix() {
  emulate -L zsh
  local tmp top
  local -a prev
  [[ -n $_dsearch_q && -n $_DSEARCH_SHOWN_Q ]] || return 1
  [[ $_dsearch_q == ${_DSEARCH_SHOWN_Q}* ]] || return 1
  (( $#_dsearch_matches )) || return 1
  tmp="$_dsearch_tmpdir"
  [[ -n $tmp && -d $tmp ]] || return 1
  prev=("${_dsearch_matches[@]}")
  print -l -- "${prev[@]}" > "$tmp/narrow"
  top=("${(@f)$(_dsearch_awk_filter "$_dsearch_q" 10 "$tmp/narrow")}")
  _dsearch_take_top "${top[@]}"
  _dsearch_pin_jumps "$_dsearch_q" 10
  return 0
}

# ~30ms: reap a finished job; cancel stale work; start after debounce for the live query.
_dsearch_maybe_tick() {
  local now f
  now="$(_dsearch_now_ms)"
  if (( now > 0 && _DSEARCH_LAST_TICK > 0 && now - _DSEARCH_LAST_TICK < 30 )); then
    return 0
  fi
  _DSEARCH_LAST_TICK=$now
  if (( _DSEARCH_WORKER_PID > 1 )) && [[ $_dsearch_q != "$_DSEARCH_WORK_Q" ]]; then
    _dsearch_worker_stop
  fi
  if (( _DSEARCH_WORKER_PID > 1 )) && ! kill -0 $_DSEARCH_WORKER_PID 2>/dev/null; then
    _dsearch_worker_reap
  fi
  if _dsearch_worker_poll; then
    _DSEARCH_IDLE_TICKS=0
    _dsearch_draw "$_dsearch_q"
  elif (( _DSEARCH_WORKER_PID > 1 )) && [[ $_dsearch_q == "$_DSEARCH_WORK_Q" ]]; then
    # Child not producing hits — iSH often never schedules it. Same awk, in-process.
    (( _DSEARCH_IDLE_TICKS++ ))
    f="$_dsearch_tmpdir/hits.$_DSEARCH_GEN"
    if (( _DSEARCH_IDLE_TICKS >= 8 )) && [[ ! -f $f && ! -f $_dsearch_tmpdir/run.$_DSEARCH_GEN ]]; then
      _dsearch_worker_stop
      _dsearch_rank_phases "$_dsearch_q" 10 "$_dsearch_tmpdir/hits.$_DSEARCH_GEN"
      _dsearch_take_top "${(@f)$(<"$_dsearch_tmpdir/hits.$_DSEARCH_GEN")}" 2>/dev/null || \
        _dsearch_apply_filter "$_dsearch_q" 10
      _DSEARCH_SHOWN_Q="$_dsearch_q"
      _DSEARCH_WORK_Q="$_dsearch_q"
      _DSEARCH_DIRTY=0
      _DSEARCH_IDLE_TICKS=0
      _dsearch_draw "$_dsearch_q"
    fi
  else
    _DSEARCH_IDLE_TICKS=0
  fi
  if [[ -z $_dsearch_q ]]; then
    if (( _DSEARCH_WORKER_PID > 1 )) || [[ -n $_DSEARCH_SHOWN_Q ]]; then
      _dsearch_worker_start
    fi
    return 0
  fi
  if (( _DSEARCH_WORKER_PID == 0 )) && [[ $_dsearch_q != "$_DSEARCH_SHOWN_Q" ]]; then
    _dsearch_debounce_ready || return 0
    _dsearch_worker_start
  fi
}

# Paint the query. Does not rank. While keys land, only re-score on-screen hits.
_dsearch_note_query() {
  _dsearch_drain_query
  _dsearch_sel=0
  _dsearch_focus=list
  if [[ ${_dsearch_view:-search} == help ]]; then
    _dsearch_view=search
  fi
  _DSEARCH_DIRTY=1
  _DSEARCH_LAST_KEY_MS="$(_dsearch_now_ms)"
  _dsearch_paint_row bar "$_dsearch_q"
  _dsearch_place_cursor
  if _dsearch_preview_if_prefix; then
    _dsearch_draw "$_dsearch_q"
  fi
  _dsearch_maybe_tick
}

# Block until results match the live query (Enter / arrows).
_dsearch_flush_filter() {
  local i
  if [[ $_dsearch_q == "$_DSEARCH_SHOWN_Q" ]]; then
    _DSEARCH_DIRTY=0
    return 0
  fi
  if (( _DSEARCH_WORKER_PID > 1 )) && [[ $_dsearch_q == "$_DSEARCH_WORK_Q" ]]; then
    for (( i=0; i < 40; i++ )); do
      if _dsearch_worker_poll; then
        _dsearch_draw "$_dsearch_q"
        return 0
      fi
      if ! kill -0 $_DSEARCH_WORKER_PID 2>/dev/null; then
        _DSEARCH_WORKER_PID=0
        if _dsearch_worker_poll; then
          _dsearch_draw "$_dsearch_q"
          return 0
        fi
        break
      fi
      _dsearch_yield
    done
  fi
  _dsearch_worker_stop
  _dsearch_apply_filter "$_dsearch_q" 10
  _DSEARCH_SHOWN_Q="$_dsearch_q"
  _DSEARCH_WORK_Q="$_dsearch_q"
  _DSEARCH_DIRTY=0
  _dsearch_draw "$_dsearch_q"
}

# Yield ~30ms so the ranker can run. `read -t` often never times out on iSH.
_dsearch_yield() {
  if zmodload -F zsh/zselect b:zselect 2>/dev/null; then
    zselect -t 3
    return 0
  fi
  /bin/sleep 0.03 2>/dev/null || true
}

# 0 = REPLY is a key; 1 = 30ms tick. Waiting keys never wait.
# Never block on read/select-for-stdin: on iSH those can wait forever
# (tty looks readable, or read -t never times out) and the ranker starves.
_dsearch_wait_key() {
  REPLY=""
  (( ${DNAV_ABORT:-0} )) && return 1
  if [[ -n ${_DSEARCH_PUSHBACK:-} ]]; then
    REPLY="$_DSEARCH_PUSHBACK"
    _DSEARCH_PUSHBACK=""
    return 0
  fi
  if (( $+functions[_dnav_try_read_token] )) && _dnav_try_read_token; then
    return 0
  fi
  _dsearch_yield
  if (( $+functions[_dnav_try_read_token] )) && _dnav_try_read_token; then
    return 0
  fi
  (( $+functions[_dnav_maybe_resize] )) && _dnav_maybe_resize
  if (( ! ${_DNAV_RESIZE_MODE:-0} )) && (( $+functions[_dnav_status_tick] )) && _dnav_status_tick; then
    _dnav_status_repaint
  fi
  return 1
}

# Move highlight (arrows / Ctrl+N/P). j/k type.
_dsearch_sel_up() {
  [[ ${_dsearch_view:-search} == search ]] || return 1
  if [[ ${_dsearch_focus:-list} == help ]]; then
    # Leave Help chip, keep current list index
    _dsearch_focus_list
    return 0
  fi
  (( $#_dsearch_matches && _dsearch_sel > 0 )) || return 1
  local old=$_dsearch_sel
  (( _dsearch_sel-- ))
  _dsearch_draw_sel "$_dsearch_q" $old
}

_dsearch_sel_down() {
  [[ ${_dsearch_view:-search} == search ]] || return 1
  if [[ ${_dsearch_focus:-list} == help ]]; then
    _dsearch_focus_list
    return 0
  fi
  (( $#_dsearch_matches && _dsearch_sel < $#_dsearch_matches - 1 )) || return 1
  local old=$_dsearch_sel
  (( _dsearch_sel++ ))
  _dsearch_draw_sel "$_dsearch_q" $old
}

# 0 = navigated (or DNAV_SEARCH_RESULT for dfile). 1 = cancelled.
typeset -gi _DSEARCH_FOR_DFILE=0
typeset -g  DNAV_SEARCH_RESULT=""

# Search from dfile: confirm stays in the explorer.
_dsearch_start_for_dfile() {
  _DSEARCH_FOR_DFILE=1
  DNAV_SEARCH_RESULT=""
  _dsearch_start
  local ret=$?
  _DSEARCH_FOR_DFILE=0
  return $ret
}

_dsearch_start() {
  # Legacy stub path only if for_dfile not set
  if (( ! _DSEARCH_FOR_DFILE )) && _dfile_available && (( $+functions[_dfile_is_open] )) && _dfile_is_open; then
    if (( $+functions[_dsearch_start_for_dfile] )); then
      _dsearch_start_for_dfile
      return $?
    fi
  fi

  local key key2 key3
  local target
  local maxn=10
  typeset -g _DSEARCH_PUSHBACK=""
  typeset -g _dsearch_q=""

  setopt localoptions nomonitor nonotify

  _dsearch_q="${1:-}"
  _dsearch_cur=${#_dsearch_q}
  _dsearch_qwin=0
  _dsearch_matches=()
  _dsearch_sel=0
  _dsearch_extra_lines=0
  _dsearch_focus=list
  _dsearch_view=search
  _DSEARCH_WORKER_PID=0
  _DSEARCH_GEN=0
  _DSEARCH_LAST_TICK=0
  _DSEARCH_LAST_KEY_MS=0
  _DSEARCH_IDLE_TICKS=0
  _DSEARCH_WORK_Q=""
  _DSEARCH_SHOWN_Q=""
  _DSEARCH_PHASE=""
  _DSEARCH_USED_FULL=0
  _DSEARCH_DIRTY=0
  _DSEARCH_PUSHBACK=""

  _dsearch_tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/dnav-dsearch.XXXXXX") || {
    printf "\r\e[2K"
    printf "\e[?25l"
    return 1
  }

  # Wipe previous TUI line (main bar / dfile) so only search remains
  printf "\r\e[2K\e[?25l"

  # Wait for background index if needed — "Indexing... N" on this line, then clear.
  # ensure_index always returns 0 so we still enter search (even with empty index).
  _dsearch_ensure_index
  printf "\r\e[2K\e[?25l"
  _dsearch_extra_lines=0
  if [[ -n $_dsearch_q ]]; then
    _dsearch_apply_filter "$_dsearch_q" $maxn
    _DSEARCH_WORK_Q="$_dsearch_q"
    _DSEARCH_SHOWN_Q="$_dsearch_q"
  fi
  _DSEARCH_OPEN=1
  _dsearch_draw "$_dsearch_q"

  while true; do
    (( ${DNAV_ABORT:-0} )) && { _DSEARCH_OPEN=0; _dsearch_worker_stop; return 130; }
    if ! _dsearch_wait_key; then
      (( ${DNAV_ABORT:-0} )) && { _DSEARCH_OPEN=0; _dsearch_worker_stop; return 130; }
      _dsearch_maybe_tick
      continue
    fi
    key="$REPLY"
    (( ${DNAV_ABORT:-0} )) && { _DSEARCH_OPEN=0; _dsearch_worker_stop; return 130; }
    if [[ $key == ctrl-c || $key == $'\x03' ]]; then
      _DSEARCH_OPEN=0
      _dsearch_worker_stop
      if (( $+functions[_dnav_abort] )); then
        _dnav_abort
      else
        _dsearch_erase_ui
        _dsearch_session_cleanup
        DNAV_ABORT=1
        printf "\e[?25h"
      fi
      return 130
    fi

    case $key in
      up)
        _dsearch_flush_filter
        _dsearch_sel_up
        ;;
      down)
        _dsearch_flush_filter
        _dsearch_sel_down
        ;;
      right)
        if [[ ${_dsearch_view:-search} == search ]]; then
          if [[ ${_dsearch_focus:-list} == help ]]; then
            :
          elif (( _dsearch_cur < ${#_dsearch_q} )); then
            (( _dsearch_cur++ ))
            _dsearch_draw "$_dsearch_q"
          else
            _dsearch_focus_help
          fi
        fi
        ;;
      left)
        if [[ ${_dsearch_view:-search} == search && ${_dsearch_focus:-list} == help ]]; then
          _dsearch_focus_list
        elif [[ ${_dsearch_view:-search} == search ]]; then
          if (( _dsearch_cur > 0 )); then
            (( _dsearch_cur-- ))
            _dsearch_draw "$_dsearch_q"
          fi
        fi
        ;;
      home|ctrl-a)
        _dsearch_cur=0
        _dsearch_draw "$_dsearch_q"
        ;;
      end|ctrl-e)
        _dsearch_cur=${#_dsearch_q}
        _dsearch_draw "$_dsearch_q"
        ;;
      delete)
        if [[ ${_dsearch_view:-search} != help ]]; then
          _dsearch_delete && _dsearch_note_query
        fi
        ;;
      esc)
        if [[ ${_dsearch_view:-search} == help ]]; then
          _dsearch_close_help
        else
          _dsearch_erase_ui
          _dsearch_session_cleanup
          printf "\e[?25l"
          return 1
        fi
        ;;
      enter)
        if [[ ${_dsearch_view:-search} == help ]]; then
          continue
        fi
        if [[ ${_dsearch_focus:-list} == help ]]; then
          _dsearch_open_help
          continue
        fi
        _dsearch_commit_target || continue
        target="$REPLY"
        _dsearch_erase_ui
        _dsearch_session_cleanup
        if [[ -d $target ]]; then
          if (( _DSEARCH_FOR_DFILE )); then
            cd -- "$target" 2>/dev/null || true
            DNAV_SEARCH_RESULT="${target:a}"
            return 0
          fi
          cd -- "$target" || {
            printf "Could not change to %s\n" "$target"
            (( $+functions[_dnav_cleanup] )) && _dnav_cleanup
            return 0
          }
          # Same path bar as dfile.
          if (( $+functions[_dnav_finish] )); then
            _dnav_finish "${target:a}" dnav
          else
            print -r -- "${target:a}"
            (( $+functions[_dnav_cleanup] )) && _dnav_cleanup
            (( $+functions[_dnav_maybe_ls] )) && _dnav_maybe_ls dnav
          fi
          return 0
        else
          if (( _DSEARCH_FOR_DFILE )); then
            return 1
          fi
          printf "Folder not found: %s\n" "$target"
          (( $+functions[_dnav_cleanup] )) && _dnav_cleanup
          return 0
        fi
        ;;
      backspace)
        if [[ ${_dsearch_view:-search} == help ]]; then
          continue
        fi
        if _dsearch_backspace; then
          _dsearch_note_query
        fi
        ;;
      ctrl-u)
        if [[ ${_dsearch_view:-search} == help ]]; then
          continue
        fi
        _dsearch_q=""
        _dsearch_cur=0
        _dsearch_sel=0
        _dsearch_matches=()
        _dsearch_focus=list
        _dsearch_worker_stop
        _DSEARCH_WORK_Q=""
        _DSEARCH_SHOWN_Q=""
        _DSEARCH_DIRTY=0
        _dsearch_draw "$_dsearch_q"
        ;;
      ctrl-p)
        _dsearch_flush_filter
        _dsearch_sel_up
        ;;
      ctrl-n)
        _dsearch_flush_filter
        _dsearch_sel_down
        ;;
      [[:print:]])
        if [[ ${_dsearch_view:-search} == help ]]; then
          _dsearch_view=search
        fi
        _dsearch_focus=list
        _dsearch_insert "$key"
        _dsearch_note_query
        ;;
    esac
    _dsearch_maybe_tick
  done
}
