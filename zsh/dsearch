#!/usr/bin/env zsh
# dsearch - fuzzy directory search plugin for dnav
#
# Provides:
#   _dsearch_available    – always true when this file is sourced
#   _dsearch_start        – search overlay (return 0 = navigated/done, 1 = cancel → main)
#   _dsearch_ensure_index – ensure on-disk directory path cache is fresh
#
# Strategy: load-once path list, incremental filter-out, awk scorer (not pure zsh).
# Index: ${XDG_CACHE_HOME:-$HOME/.cache}/dnav/dirs.idx  (dirs only, rebuilt after 24h)
# Scope: $HOME by default. Extra trees via DNAV_SEARCH_ROOTS or config search_roots.

_dsearch_available() { return 0 }

# ── Background index (starts with dnav; interruptible) ────────────────────
# Uses an external zsh worker + PID file so interactive shells never print
# "done" job lines (breaks TUI layout on iSH / busybox environments).
typeset -gi _DSEARCH_INDEX_PID=0
typeset -gi _DSEARCH_INDEX_HAS_SID=0
typeset -g  _DSEARCH_INDEX_COUNT_FILE=""
typeset -g  _DSEARCH_INDEX_PID_FILE=""
typeset -g  _DSEARCH_INDEX_TMP=""
typeset -g  _DSEARCH_INDEX_STATE=idle   # idle|running|done|failed|cancelled

# ── Index ─────────────────────────────────────────────────────────────────
_dsearch_index_path() {
  print -r -- "${XDG_CACHE_HOME:-$HOME/.cache}/dnav/dirs.idx"
}

_dsearch_index_dir() {
  print -r -- "${XDG_CACHE_HOME:-$HOME/.cache}/dnav"
}

# Portable mtime (GNU stat, BSD stat, or python fallback).
_dsearch_file_mtime() {
  local f="$1" m
  m=$(stat -c %Y -- "$f" 2>/dev/null) && { print -rn -- "$m"; return 0; }
  m=$(stat -f %m -- "$f" 2>/dev/null) && { print -rn -- "$m"; return 0; }
  m=$(python3 -c 'import os,sys; print(int(os.path.getmtime(sys.argv[1])))' "$f" 2>/dev/null) && {
    print -rn -- "$m"; return 0
  }
  return 1
}

_dsearch_index_stale() {
  local idx="$1" now mtime age
  [[ ! -f $idx || ! -s $idx ]] && return 0
  now=$(date +%s 2>/dev/null) || return 0
  mtime="$(_dsearch_file_mtime "$idx")" || return 0
  age=$(( now - mtime ))
  (( age > 86400 ))
}

_dsearch_index_count() {
  local n=0 f="$_DSEARCH_INDEX_COUNT_FILE"
  [[ -z $f || ! -f $f ]] && { print -rn -- 0; return; }
  n=$(tr -cd '0-9' <"$f" 2>/dev/null)
  [[ -n $n ]] || n=0
  print -rn -- "$n"
}

# Constrained environments (iSH): keep indexing light.
# A desktop box that happens to have a busybox binary is not light mode.
_dsearch_constrained_env() {
  [[ -n ${DNAV_SEARCH_LIGHT:-} ]] && return 0
  [[ -d /var/ish || -d /ish || -e /proc/ish ]] && return 0
  uname -a 2>/dev/null | grep -Eiq 'ish|iphone|ipod|ipad' && return 0
  return 1
}

# True if a background index is still running (poll PID file; never wait).
_dsearch_index_running() {
  local pid=$_DSEARCH_INDEX_PID pf="$_DSEARCH_INDEX_PID_FILE"
  if (( pid <= 0 )) && [[ -n $pf && -f $pf ]]; then
    pid=$(tr -cd '0-9' <"$pf" 2>/dev/null)
    [[ -n $pid ]] && _DSEARCH_INDEX_PID=$pid
  fi
  (( _DSEARCH_INDEX_PID > 0 )) || return 1
  if kill -0 $_DSEARCH_INDEX_PID 2>/dev/null; then
    return 0
  fi
  # Process gone — clear without wait (avoids job-control "done" lines)
  _DSEARCH_INDEX_PID=0
  [[ -n $pf ]] && rm -f -- "$pf" 2>/dev/null
  return 1
}

# True if mount/path is virtual or not useful for interactive navigation.
_dsearch_skip_root() {
  case $1 in
    /proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/run|/run/user/*|/run/systemd/*) return 0 ;;
    /boot|/boot/*|/tmp|/var/tmp|/var/log|/var/cache|/var/lib/docker/*) return 0 ;;
    /snap|/var/lib/snapd/snap) return 0 ;;
    *) return 1 ;;
  esac
}

# Collect user-facing directory roots to index.
_dsearch_collect_roots() {
  local -a roots
  local -A seen
  local r m

  _dsearch_add_root() {
    local p="$1"
    [[ -n $p && -d $p && -r $p ]] || return
    _dsearch_skip_root "$p" && return
    if (( $+functions[_dnav_logical_path] )); then
      p="$(_dnav_logical_path "$p")"
    else
      p="${p:a}"
    fi
    [[ -n ${seen[$p]:-} ]] && return
    seen[$p]=1
    roots+=("$p")
  }

  if [[ -n ${DNAV_SEARCH_ROOTS:-} ]]; then
    for r in ${=DNAV_SEARCH_ROOTS}; do
      _dsearch_add_root "$r"
    done
    print -l -- "${roots[@]}"
    return 0
  fi

  # Default: $HOME only. Add more with DNAV_SEARCH_ROOTS or search_roots=.
  _dsearch_add_root "$HOME"
  print -l -- "${roots[@]}"
}

# List dirs under $1, pruning noisy trees. Extra find flags follow (e.g. -xdev).
# Portable: no -readable. BusyBox-safe.
_dsearch_find_dirs() {
  local root="$1"
  shift
  find "$root" "$@" \
    \( \
      -name .git -o -name node_modules -o -name target -o \
      -name __pycache__ -o -name .npm -o -name .cargo -o \
      -name .cache -o -path '*/.cache/*' -o \
      -path '*/.local/share/Trash' -o -path '*/.local/share/Trash/*' -o \
      -name Trash -o -name .Trash -o -name Caches -o \
      -name .gradle -o -name .m2 -o -name vendor -o \
      -name .tox -o -name .venv -o -name venv -o -name '.Trash-*' \
    \) -prune -o -type d -print 2>/dev/null
}

# Build index while writing a running directory count to $2.
# $3 = tmp path (optional; default $idx.building so cancel can remove it).
_dsearch_build_index_with_count() {
  local idx="$1" countfile="$2"
  local tmp="${3:-${idx}.building}"
  local -a roots
  local r n=0 line

  mkdir -p "${idx:h}" 2>/dev/null || return 1
  roots=("${(@f)$(_dsearch_collect_roots)}")
  (( $#roots )) || roots=("$HOME")

  print -rn -- 0 > "$countfile"
  : > "$tmp"

  {
    for r in "${roots[@]}"; do
      [[ -d $r ]] || continue
      # No -readable (unsupported on BusyBox/iSH). -xdev when supported.
      if find "$r" -xdev -maxdepth 0 >/dev/null 2>&1; then
        _dsearch_find_dirs "$r" -xdev
      else
        _dsearch_find_dirs "$r"
      fi
    done
  } | {
    n=0
    while IFS= read -r line || [[ -n $line ]]; do
      [[ -z $line ]] && continue
      print -r -- "$line"
      (( n++ ))
      if (( n % 10 == 0 )); then
        print -rn -- $n > "$countfile"
      fi
    done
    print -rn -- $n > "$countfile"
  } > "$tmp"

  if [[ -f $tmp ]]; then
    n=$(wc -l < "$tmp" 2>/dev/null | tr -cd '0-9')
    print -rn -- ${n:-0} > "$countfile"
  fi

  if command -v sort >/dev/null 2>&1; then
    sort -u "$tmp" -o "$tmp" 2>/dev/null || true
  fi

  mv -f "$tmp" "$idx" 2>/dev/null || return 1
  return 0
}

# Start background reindex if stale. Worker is fully detached (no job table).
_dsearch_index_lock_dir() {
  print -r -- "$(_dsearch_index_dir)/index.lock"
}

_dsearch_index_unlock() {
  rmdir -- "$(_dsearch_index_lock_dir)" 2>/dev/null || true
}

_dsearch_index_start_bg() {
  local idx countfile pidfile lock tmp self=""
  idx="$(_dsearch_index_path)"

  if (( _DSEARCH_INDEX_PID > 0 )) && ! kill -0 $_DSEARCH_INDEX_PID 2>/dev/null; then
    _DSEARCH_INDEX_PID=0
  fi

  if ! _dsearch_index_stale "$idx"; then
    _DSEARCH_INDEX_STATE=done
    return 0
  fi

  if _dsearch_index_running; then
    return 0
  fi

  mkdir -p "$(_dsearch_index_dir)" 2>/dev/null || return 1
  lock="$(_dsearch_index_lock_dir)"
  if ! mkdir -- "$lock" 2>/dev/null; then
    if _dsearch_index_running; then
      return 0
    fi
    rmdir -- "$lock" 2>/dev/null || true
    mkdir -- "$lock" 2>/dev/null || return 0
  fi

  countfile="$(_dsearch_index_dir)/index.count"
  pidfile="$(_dsearch_index_dir)/index.pid"
  tmp="${idx}.building"
  _DSEARCH_INDEX_COUNT_FILE="$countfile"
  _DSEARCH_INDEX_PID_FILE="$pidfile"
  _DSEARCH_INDEX_TMP="$tmp"
  print -rn -- 0 > "$countfile"
  _DSEARCH_INDEX_STATE=running
  _DSEARCH_INDEX_HAS_SID=0

  if _dsearch_constrained_env; then
    export DNAV_SEARCH_LIGHT=1
  fi

  if [[ -n ${DNAV_DIR:-} && -f $DNAV_DIR/dsearch ]]; then
    self="$DNAV_DIR/dsearch"
  elif [[ -n ${(%):-%x} ]]; then
    self="${${(%):-%x}:A}"
  fi
  [[ -f $self ]] || self=""

  # Detached external zsh — not a job of the interactive shell.
  # setsid so cancel can kill that group only (never the interactive shell).
  if [[ -n $self ]]; then
    if command -v setsid >/dev/null 2>&1; then
      nohup setsid zsh -fc '
        emulate -L zsh
        setopt nomonitor nonotify
        source "$1"
        _dsearch_build_index_with_count "$2" "$3" "$4"
        rm -f -- "$5"
        rmdir -- "${2:h}/index.lock" 2>/dev/null || true
      ' dnav-index-worker "$self" "$idx" "$countfile" "$tmp" "$pidfile" \
        </dev/null >/dev/null 2>&1 &!
      _DSEARCH_INDEX_HAS_SID=1
    else
      nohup zsh -fc '
        emulate -L zsh
        setopt nomonitor nonotify
        source "$1"
        _dsearch_build_index_with_count "$2" "$3" "$4"
        rm -f -- "$5"
        rmdir -- "${2:h}/index.lock" 2>/dev/null || true
      ' dnav-index-worker "$self" "$idx" "$countfile" "$tmp" "$pidfile" \
        </dev/null >/dev/null 2>&1 &!
    fi
    _DSEARCH_INDEX_PID=$!
  else
    setopt localoptions nomonitor nonotify
    ( _dsearch_build_index_with_count "$idx" "$countfile" "$tmp"
      rm -f -- "$pidfile"
      _dsearch_index_unlock
    ) </dev/null >/dev/null 2>&1 &!
    _DSEARCH_INDEX_PID=$!
  fi
  print -rn -- $_DSEARCH_INDEX_PID > "$pidfile"
  return 0
}

# Cancel background index (user left dnav early / Ctrl+C).
_dsearch_index_cancel() {
  local pid=$_DSEARCH_INDEX_PID pf="$_DSEARCH_INDEX_PID_FILE"
  if (( pid <= 0 )) && [[ -n $pf && -f $pf ]]; then
    pid=$(tr -cd '0-9' <"$pf" 2>/dev/null)
  fi
  if [[ $pid == <-> ]] && (( pid > 1 && pid != $$ )); then
    if (( _DSEARCH_INDEX_HAS_SID )); then
      kill -TERM -- -$pid 2>/dev/null || kill -TERM -- $pid 2>/dev/null || true
    else
      kill -TERM -- $pid 2>/dev/null || true
      pkill -TERM -P $pid 2>/dev/null || true
    fi
  fi
  _DSEARCH_INDEX_PID=0
  _DSEARCH_INDEX_HAS_SID=0
  _DSEARCH_INDEX_STATE=cancelled
  [[ -n $_DSEARCH_INDEX_TMP ]] && rm -f -- "$_DSEARCH_INDEX_TMP" 2>/dev/null
  [[ -n $_DSEARCH_INDEX_COUNT_FILE ]] && rm -f -- "$_DSEARCH_INDEX_COUNT_FILE" 2>/dev/null
  [[ -n $pf ]] && rm -f -- "$pf" 2>/dev/null
  _dsearch_index_unlock
  _DSEARCH_INDEX_COUNT_FILE=""
  _DSEARCH_INDEX_PID_FILE=""
  _DSEARCH_INDEX_TMP=""
}

# Paint "Indexing... N" on one line; clear with \r\e[2K when done (no newlines).
_dsearch_index_paint_status() {
  local count="$1"
  local hl="${DNAV_HIGHLIGHT:-${HIGHLIGHT:-\e[30;46m}}"
  local rst="${DNAV_RESET:-${RESET:-\e[0m}}"
  printf "\r${hl} Indexing...${rst} %s\e[K" "$count"
}

# Wait for background index if needed. Always leaves the cursor line clean.
# Returns 0 if a usable index exists OR after creating an empty fallback.
_dsearch_index_wait_ui() {
  local idx count
  idx="$(_dsearch_index_path)"

  _dsearch_index_start_bg

  if ! _dsearch_index_running && [[ -f $idx && -s $idx ]]; then
    _DSEARCH_INDEX_STATE=done
    return 0
  fi

  if _dsearch_index_running; then
    printf "\e[?25l"
    while _dsearch_index_running; do
      count="$(_dsearch_index_count)"
      _dsearch_index_paint_status "$count"
      sleep 0.15
    done
    count="$(_dsearch_index_count)"
    _dsearch_index_paint_status "$count"
    sleep 0.05
    printf "\r\e[2K"
    _DSEARCH_INDEX_PID=0
    [[ -n $_DSEARCH_INDEX_COUNT_FILE ]] && rm -f -- "$_DSEARCH_INDEX_COUNT_FILE" 2>/dev/null
    [[ -n $_DSEARCH_INDEX_PID_FILE ]] && rm -f -- "$_DSEARCH_INDEX_PID_FILE" 2>/dev/null
    _DSEARCH_INDEX_COUNT_FILE=""
    _DSEARCH_INDEX_PID_FILE=""
    _DSEARCH_INDEX_TMP=""
  fi

  if [[ -f $idx && -s $idx ]]; then
    _DSEARCH_INDEX_STATE=done
    return 0
  fi

  # Fallback so search still opens (empty results better than kick-out)
  mkdir -p "${idx:h}" 2>/dev/null
  if [[ ! -f $idx ]]; then
    : > "$idx"
  fi
  _DSEARCH_INDEX_STATE=failed
  return 0
}

# Ensure index is ready (start bg if needed, wait with UI if still running).
# Never hard-fails: search UI should still open.
_dsearch_ensure_index() {
  local idx
  idx="$(_dsearch_index_path)"

  if ! _dsearch_index_stale "$idx" && ! _dsearch_index_running; then
    return 0
  fi

  _dsearch_index_wait_ui
  return 0
}

# ── Session state (search UI) ─────────────────────────────────────────────
typeset -ga _dsearch_matches
typeset -gi _dsearch_sel=0
typeset -gi _dsearch_extra_lines=0
typeset -gi _dsearch_cur=0
typeset -gi _dsearch_qwin=0
typeset -gi _DSEARCH_OPEN=0
typeset -g  _dsearch_tmpdir=""
typeset -g  _dsearch_prev_query=""
# Sparse map: length -> candidate file of ALL survivors for that query
typeset -gA _dsearch_cand_stack

_dsearch_session_cleanup() {
  if [[ -n $_dsearch_tmpdir && -d $_dsearch_tmpdir ]]; then
    rm -rf -- "$_dsearch_tmpdir" 2>/dev/null
  fi
  _dsearch_tmpdir=""
  _dsearch_prev_query=""
  _dsearch_q=""
  _dsearch_cur=0
  _dsearch_qwin=0
  _dsearch_cand_stack=()
  _dsearch_focus=list
  _dsearch_view=search
  _DSEARCH_OPEN=0
}

_dsearch_cur_clamp() {
  (( _dsearch_cur < 0 )) && _dsearch_cur=0
  (( _dsearch_cur > ${#_dsearch_q} )) && _dsearch_cur=${#_dsearch_q}
}

# Insert $1 at the caret; move caret forward.
_dsearch_insert() {
  local ch="$1"
  _dsearch_cur_clamp
  _dsearch_q="${_dsearch_q[1,_dsearch_cur]}${ch}${_dsearch_q[_dsearch_cur+1,-1]}"
  (( _dsearch_cur++ ))
}

# Delete the character before the caret.
_dsearch_backspace() {
  _dsearch_cur_clamp
  (( _dsearch_cur > 0 )) || return 1
  _dsearch_q="${_dsearch_q[1,_dsearch_cur-1]}${_dsearch_q[_dsearch_cur+1,-1]}"
  (( _dsearch_cur-- ))
}

# Delete the character at the caret (forward delete).
_dsearch_delete() {
  _dsearch_cur_clamp
  (( _dsearch_cur < ${#_dsearch_q} )) || return 1
  _dsearch_q="${_dsearch_q[1,_dsearch_cur]}${_dsearch_q[_dsearch_cur+2,-1]}"
}

_dsearch_cursor_hide() {
  printf "\e[0 q\e[?25l"
}

# Thin bar caret on the query. Call after painting the search bar.
_dsearch_place_cursor() {
  local label=" DNav Search:" col maxw
  if [[ ${_dsearch_view:-search} != search || ${_dsearch_focus:-list} != list ]]; then
    _dsearch_cursor_hide
    return
  fi
  _dsearch_cur_clamp
  maxw="$(_dsearch_cols)"
  col=$(( ${#label} + 2 + _dsearch_cur - _dsearch_qwin ))
  (( col < 1 )) && col=1
  (( col >= maxw )) && col=$(( maxw - 1 ))
  printf "\r\e[6 q\e[%dG\e[?25h" $col
}

# ── awk filter (hot path) ─────────────────────────────────────────────────
# Args: query, mode (prefix1|fuzzy), maxn, src_file, survivors_out
# Prints top maxn paths (one per line) to stdout.
# Writes ALL matching paths to survivors_out.
_dsearch_awk_filter() {
  local query="$1" mode="$2" maxn="$3" src="$4" survivors="$5"

  awk -v query="$query" -v mode="$mode" -v maxn="$maxn" -v surv="$survivors" '
  function consider(sc, path,   i) {
    # top-N insert (desc)
    if (maxn > 0) {
      if (tn == maxn && sc <= tsc[tn]) {
        # still a survivor overall; just skip top list
      } else {
        if (tn < maxn) tn++
        i = tn
        while (i > 1 && sc > tsc[i-1]) {
          tsc[i] = tsc[i-1]
          tpath[i] = tpath[i-1]
          i--
        }
        tsc[i] = sc
        tpath[i] = path
      }
    }
  }

  function fuzzy_score(path, q,   lp, qlen, plen, score, run, last, pi, qi, ch, pc, prev, found) {
    lp = tolower(path)
    q = tolower(q)
    qlen = length(q)
    plen = length(lp)
    if (qlen == 0) return -1
    score = 0; run = 0; last = -2; pi = 1
    for (qi = 1; qi <= qlen; qi++) {
      ch = substr(q, qi, 1)
      found = 0
      for (; pi <= plen; pi++) {
        pc = substr(lp, pi, 1)
        if (pc == ch) {
          found = 1
          if (pi == last + 1) { run++; score += 8 + run }
          else { run = 0; score += 2 }
          prev = (pi == 1) ? "" : substr(lp, pi - 1, 1)
          if (pi == 1 || prev == "/") score += 12
          if (prev == "-" || prev == "_" || prev == ".") score += 4
          last = pi
          pi++
          break
        }
      }
      if (!found) return -1
    }
    score += 40 - (plen < 40 ? plen : 40)
    return score
  }

  # Component-prefix: any path segment starts with the (single) query char
  function prefix1_score(path, q,   lp, ch, n, i, seg, best, sc, plen) {
    lp = tolower(path)
    ch = tolower(substr(q, 1, 1))
    if (ch == "") return -1
    n = split(lp, seg, "/")
    best = -1
    for (i = 1; i <= n; i++) {
      if (seg[i] == "") continue
      if (substr(seg[i], 1, 1) == ch) {
        sc = 50
        # Prefer shorter segment / shorter full path
        sc += 20 - (length(seg[i]) < 20 ? length(seg[i]) : 20)
        plen = length(lp)
        sc += 30 - (plen < 30 ? plen : 30)
        # Prefer last component match
        if (i == n) sc += 15
        if (sc > best) best = sc
      }
    }
    return best
  }

  # Whitespace splits AND tokens (any order). Each token is the same
  # fuzzy/partial match as a one-word query. Trailing spaces are ignored.
  function query_score(path, q,   n, i, tok, sc, total, nt, one) {
    n = split(q, tok, /[ \t]+/)
    nt = 0
    one = ""
    for (i = 1; i <= n; i++) {
      if (tok[i] == "") continue
      nt++
      if (nt == 1) one = tok[i]
    }
    if (nt == 0) return -1
    if (nt == 1) return fuzzy_score(path, one)
    total = 0
    for (i = 1; i <= n; i++) {
      if (tok[i] == "") continue
      sc = fuzzy_score(path, tok[i])
      if (sc < 0) return -1
      total += sc
    }
    return total
  }

  BEGIN { tn = 0 }
  {
    path = $0
    if (path == "") next
    if (mode == "prefix1") sc = prefix1_score(path, query)
    else sc = query_score(path, query)
    if (sc < 0) next
    print path >> surv
    consider(sc, path)
  }
  END {
    for (i = 1; i <= tn; i++) print tpath[i]
  }
  ' "$src"
}

# Apply filter for $query using incremental candidate stack when possible.
# Sets _dsearch_matches (top 10). Updates stack for this query length.
_dsearch_apply_filter() {
  local query="$1"
  local maxn="${2:-10}"
  local qlen=${#query}
  local idx src mode survivors
  local -a top

  _dsearch_matches=()
  idx="$(_dsearch_index_path)"

  if (( qlen == 0 )); then
    _dsearch_prev_query=""
    return 0
  fi

  survivors="$_dsearch_tmpdir/c.${qlen}"
  : > "$survivors"

  local prev_len=${#_dsearch_prev_query}
  local i partial

  # Choose source + mode
  if (( qlen == 1 )); then
    src="$idx"
    mode="prefix1"
  elif (( qlen < prev_len )) && [[ -n $_dsearch_prev_query && $_dsearch_prev_query == "$query"* ]] \
      && [[ -n ${_dsearch_cand_stack[$qlen]:-} && -s ${_dsearch_cand_stack[$qlen]} ]]; then
    # Shortened from the end: re-rank survivors stored for this length
    src="${_dsearch_cand_stack[$qlen]}"
    mode="fuzzy"
    (( qlen == 1 )) && mode="prefix1"
    top=("${(@f)$(_dsearch_awk_filter "$query" "$mode" "$maxn" "$src" "$survivors")}")
    _dsearch_matches=("${top[@]}")
    _dsearch_cand_stack[$qlen]="$survivors"
    _dsearch_prev_query="$query"
    _dsearch_pin_jumps "$query" "$maxn"
    return 0
  elif [[ -n $_dsearch_prev_query && $query == "$_dsearch_prev_query"* ]] && (( qlen > prev_len )); then
    # Query grew (1+ chars) — filter previous survivors only (incremental)
    if [[ -n ${_dsearch_cand_stack[$prev_len]:-} && -s ${_dsearch_cand_stack[$prev_len]} ]]; then
      src="${_dsearch_cand_stack[$prev_len]}"
    else
      src="$idx"
    fi
    mode="fuzzy"
  elif (( qlen > 1 )) && [[ -z ${_dsearch_cand_stack[1]:-} || ! -s ${_dsearch_cand_stack[1]} ]]; then
    # Cold multi-char query (e.g. coalesced "proj"): progressive 1..qlen once
    for (( i=1; i <= qlen; i++ )); do
      partial="${query[1,i]}"
      survivors="$_dsearch_tmpdir/c.${i}"
      : > "$survivors"
      if (( i == 1 )); then
        src="$idx"
        mode="prefix1"
      else
        src="${_dsearch_cand_stack[$((i - 1))]}"
        mode="fuzzy"
        [[ -s $src ]] || src="$idx"
      fi
      if (( i == qlen )); then
        top=("${(@f)$(_dsearch_awk_filter "$partial" "$mode" "$maxn" "$src" "$survivors")}")
      else
        _dsearch_awk_filter "$partial" "$mode" 0 "$src" "$survivors" >/dev/null
      fi
      _dsearch_cand_stack[$i]="$survivors"
    done
    _dsearch_matches=("${top[@]}")
    _dsearch_prev_query="$query"
    _dsearch_pin_jumps "$query" "$maxn"
    return 0
  else
    src="$idx"
    mode="fuzzy"
    (( qlen == 1 )) && mode="prefix1"
  fi

  top=("${(@f)$(_dsearch_awk_filter "$query" "$mode" "$maxn" "$src" "$survivors")}")
  _dsearch_matches=("${top[@]}")
  _dsearch_cand_stack[$qlen]="$survivors"
  _dsearch_prev_query="$query"
  _dsearch_pin_jumps "$query" "$maxn"
}

# 0 if $1 fuzzy-matches every whitespace-separated token from $2.
# Single-token queries skip this check (the scorer already handled them).
_dsearch_path_has_tokens() {
  emulate -L zsh
  local p="${(L)1}" q="$2" tok t i j c
  local -a toks
  toks=(${=q})
  (( $#toks <= 1 )) && return 0
  for tok in "${toks[@]}"; do
    [[ -z $tok ]] && continue
    t="${(L)tok}"
    j=1
    for (( i=1; i <= ${#t}; i++ )); do
      c="${t[i]}"
      while (( j <= ${#p} )) && [[ ${p[j]} != $c ]]; do
        (( j++ ))
      done
      (( j <= ${#p} )) || return 1
      (( j++ ))
    done
  done
  return 0
}

# Prepend djump matches for the query (dirs only), then cap to maxn.
_dsearch_pin_jumps() {
  local query="$1" maxn="${2:-10}"
  (( $+functions[_djump_available] )) && _djump_available || return 0
  local -a keys pinned out
  local k p m found
  keys=("${(@f)$(_djump_match_query "$query")}")
  pinned=()
  for k in "${keys[@]}"; do
    p="$(_djump_resolve "$k" 2>/dev/null)" || continue
    [[ -d $p ]] || continue
    _dsearch_path_has_tokens "$p" "$query" || continue
    if (( $+functions[_dnav_logical_path] )); then
      p="$(_dnav_logical_path "$p")"
    else
      p="${p:a}"
    fi
    found=0
    for m in "${pinned[@]}"; do
      [[ $m == $p ]] && { found=1; break }
    done
    (( found )) || pinned+=("$p")
  done
  (( $#pinned == 0 )) && return 0
  out=("${pinned[@]}")
  for m in "${_dsearch_matches[@]}"; do
    found=0
    for p in "${pinned[@]}"; do
      [[ $m == $p ]] && { found=1; break }
    done
    (( found )) || out+=("$m")
  done
  _dsearch_matches=("${out[@]:0:$maxn}")
}

# ── UI ────────────────────────────────────────────────────────────────────
# Matches dnav: black-on-cyan full-width bars (same DNAV_HIGHLIGHT / success bar).

_dsearch_hl() {
  print -rn -- "${DNAV_HIGHLIGHT:-${HIGHLIGHT:-\e[30;46m}}"
}
_dsearch_rst() {
  print -rn -- "${DNAV_RESET:-${RESET:-\e[0m}}"
}

_dsearch_cols() {
  if (( $+functions[_dnav_usable_cols] )); then
    _dnav_usable_cols
    return
  fi
  local w=${COLUMNS:-80}
  [[ $w == <-> ]] || w=80
  (( w > 2 )) && (( w -= 2 ))
  (( w < 8 )) && w=8
  print -rn -- "$w"
}

# Shorten path for display (~ for $HOME); optional max length.
_dsearch_display_path() {
  local p="$1" maxw="${2:-0}"
  local home="$HOME"
  if [[ $p == $home || $p == $home/* ]]; then
    p="~${p#$home}"
  fi
  if (( maxw > 0 )); then
    if (( $+functions[_dnav_fit_end] )); then
      p="$(_dnav_fit_end "$p" $maxw)"
    elif (( ${#p} > maxw )); then
      p="…${p:$(( ${#p} - maxw + 1 ))}"
    fi
  fi
  print -r -- "$p"
}

# Truncate/pad a string to exactly w display columns.
_dsearch_fit() {
  local s="$1" w="$2" pad
  if (( $+functions[_dnav_fit_end] )); then
    s="$(_dnav_fit_end "$s" $w)"
    if (( $+functions[_dnav_disp_w] )); then
      pad=$(( w - $(_dnav_disp_w "$s") ))
    else
      pad=$(( w - ${#s} ))
    fi
    (( pad < 0 )) && pad=0
    printf "%s%*s" "$s" $pad ""
    return
  fi
  if (( ${#s} > w )); then
    if (( w <= 1 )); then
      s="${s[1,w]}"
    else
      s="…${s:$(( ${#s} - w + 1 ))}"
    fi
  fi
  printf "%-${w}s" "$s"
}

# Focus: list (result rows) | help (Help chip on the bar)
typeset -g _dsearch_focus=list
# View: search (normal) | help (help overlay inside dsearch)
typeset -g _dsearch_view=search

# Help body lines (shown under the bar when Help is opened)
_dsearch_help_lines() {
  print -r -- "Type to fuzzy-find; spaces AND every word (partials, any order)"
  print -r -- "↑/↓  or  Ctrl+N / Ctrl+P    move selection"
  print -r -- "Enter                       open selected folder"
  print -r -- "← / →                       move in query; → at end focuses Help"
  print -r -- "Home / End  or  Ctrl+A / E  start / end of query"
  print -r -- "Backspace / Delete          delete before / at caret"
  print -r -- "Enter on Help               show this help"
  print -r -- "Esc                         close help / leave search"
  print -r -- "Ctrl+U                      clear query"
}

# Paint one row. Bar uses chip styling (not a full-width cyan fill).
# $1 = mode: bar | sel | row | blank | help_row
# $2 = text (ignored for blank)
_dsearch_paint_row() {
  local mode="$1" text="${2:-}"
  local hl rst maxw inner
  maxw="$(_dsearch_cols)"
  hl="$(_dsearch_hl)"
  rst="$(_dsearch_rst)"

  case $mode in
    bar)
      # [ DNav Search:] query…          count  [Help]
      local label count helpchip gap avail qshow
      label=" DNav Search:"
      helpchip=" Help "
      if (( $#_dsearch_matches > 0 )) && [[ ${_dsearch_focus:-list} == list ]]; then
        count=" $(( _dsearch_sel + 1 ))/$#_dsearch_matches "
      else
        count=""
      fi
      # Room for query: label + space after chip + count + Help
      avail=$(( maxw - ${#label} - 1 - ${#count} - ${#helpchip} ))
      (( avail < 1 )) && avail=1
      _dsearch_cur_clamp
      _dsearch_qwin=0
      qshow="$text"
      if (( ${#text} > avail )); then
        _dsearch_qwin=$(( _dsearch_cur - avail + 1 ))
        (( _dsearch_qwin < 0 )) && _dsearch_qwin=0
        if (( _dsearch_qwin + avail > ${#text} )); then
          _dsearch_qwin=$(( ${#text} - avail ))
          (( _dsearch_qwin < 0 )) && _dsearch_qwin=0
        fi
        qshow="${text[_dsearch_qwin+1,_dsearch_qwin+avail]}"
      fi
      gap=$(( maxw - ${#label} - 1 - ${#qshow} - ${#count} - ${#helpchip} ))
      (( gap < 0 )) && gap=0
      # Label chip always cyan; space + query normal; Help cyan when focused
      printf "\r${hl}%s${rst} %s%*s%s" "$label" "$qshow" $gap "" "$count"
      if [[ ${_dsearch_focus:-list} == help ]]; then
        printf "${hl}%s${rst}" "$helpchip"
      else
        printf "%s" "$helpchip"
      fi
      printf "\e[K"
      ;;
    sel)
      # Selected match: cyan chip-style row (full width for clean overwrite)
      inner=$(( maxw - 2 ))
      (( inner < 1 )) && inner=1
      printf "\r${hl}▶ %s${rst}" "$(_dsearch_fit "$text" $inner)"
      ;;
    row)
      # Unselected: faint, full-width pad so old cyan is fully overwritten
      inner=$(( maxw - 2 ))
      (( inner < 1 )) && inner=1
      printf "\r\e[2m  %s${rst}" "$(_dsearch_fit "$text" $inner)"
      ;;
    help_row)
      # Help overlay body line (cyan bar, matches main dnav help)
      printf "\r${hl}%-${maxw}s${rst}" "$(_dsearch_fit " $text" $maxw)"
      ;;
    blank)
      printf "\r%*s" $maxw ""
      ;;
  esac
}

# Full redraw of prompt + dropdown (or help overlay).
_dsearch_draw() {
  local query="$1"
  local n p disp i leftover
  local -a hlines

  _dsearch_cursor_hide

  _dsearch_paint_row bar "$query"

  n=0
  if [[ ${_dsearch_view:-search} == help ]]; then
    hlines=("${(@f)$(_dsearch_help_lines)}")
    for p in "${hlines[@]}"; do
      printf "\n"
      _dsearch_paint_row help_row "$p"
      (( n++ ))
    done
  else
    for p in "${_dsearch_matches[@]}"; do
      disp="$(_dsearch_display_path "$p")"
      printf "\n"
      # When Help chip is focused, no list row looks selected
      if [[ ${_dsearch_focus:-list} == list ]] && (( n == _dsearch_sel )); then
        _dsearch_paint_row sel "$disp"
      else
        _dsearch_paint_row row "$disp"
      fi
      (( n++ ))
    done
  fi

  leftover=$(( _dsearch_extra_lines - n ))
  if (( !_DNAV_RESIZING )); then
    for (( i=0; i < leftover; i++ )); do
      printf "\n"
      _dsearch_paint_row blank
    done
    if (( leftover > 0 )); then
      printf "\e[%dA" $leftover
    fi
  fi

  _dsearch_extra_lines=$n
  printf "\e[J"
  if (( n > 0 )); then
    printf "\e[%dA" $n
  fi
  _dsearch_place_cursor
}

# Selection moved only — repaint two rows + bar (minimal flicker).
_dsearch_draw_sel() {
  local query="$1"
  local old="$2"   # previous index
  local n=$#_dsearch_matches
  local disp

  [[ ${_dsearch_view:-search} == search ]] || return 0
  (( n == 0 )) && return 0
  _dsearch_cursor_hide

  _dsearch_paint_row bar "$query"

  if (( old >= 0 && old < n )); then
    printf "\e[%dB" $(( old + 1 ))
    disp="$(_dsearch_display_path "${_dsearch_matches[old+1]}")"
    _dsearch_paint_row row "$disp"
    printf "\e[%dA" $(( old + 1 ))
  fi

  if [[ ${_dsearch_focus:-list} == list ]]; then
    printf "\e[%dB" $(( _dsearch_sel + 1 ))
    disp="$(_dsearch_display_path "${_dsearch_matches[_dsearch_sel+1]}")"
    _dsearch_paint_row sel "$disp"
    printf "\e[%dA" $(( _dsearch_sel + 1 ))
  fi
  _dsearch_place_cursor
}

_dsearch_erase_ui() {
  local i maxw
  maxw="$(_dsearch_cols)"
  _dsearch_cursor_hide
  printf "\r%*s" $maxw ""
  for (( i=0; i < _dsearch_extra_lines; i++ )); do
    printf "\n"
    _dsearch_paint_row blank
  done
  if (( _dsearch_extra_lines > 0 )); then
    printf "\e[%dA" $_dsearch_extra_lines
  fi
  printf "\r%*s\r" $maxw ""
  _dsearch_extra_lines=0
}

_dsearch_focus_help() {
  _dsearch_focus=help
  _dsearch_draw "$_dsearch_q"
}

_dsearch_focus_list() {
  _dsearch_focus=list
  _dsearch_draw "$_dsearch_q"
}

_dsearch_open_help() {
  _dsearch_view=help
  _dsearch_focus=help
  _dsearch_draw "$_dsearch_q"
}

_dsearch_close_help() {
  _dsearch_view=search
  _dsearch_focus=list
  _dsearch_draw "$_dsearch_q"
}

# Coalesce further keystrokes into $_dsearch_q, then filter once + draw.
# Main loop keeps query in $_dsearch_q for the session.
_dsearch_refresh_query() {
  local maxn=10
  local k
  local -i coalescing=1

  # Debounce / drain buffered input so fast typing = one filter
  while (( coalescing )); do
    if ! read -t 0.05 -k 1 k 2>/dev/null; then
      coalescing=0
      break
    fi
    case $k in
      $'\177'|$'\b')
        _dsearch_backspace || true
        ;;
      $'\x15')
        _dsearch_q=""
        _dsearch_cur=0
        ;;
      $'\e'|$'\n'|$'\r')
        _DSEARCH_PUSHBACK="$k"
        coalescing=0
        ;;
      $'\x0e'|$'\x10'|$'\x01'|$'\x05')  # Ctrl+N/P/A/E — not query text
        _DSEARCH_PUSHBACK="$k"
        coalescing=0
        ;;
      [[:print:]])
        _dsearch_insert "$k"
        ;;
      *)
        ;;
    esac
  done

  _dsearch_sel=0
  _dsearch_focus=list
  # Stay in search view while typing (don't clobber open help mid-key — typing leaves help)
  if [[ ${_dsearch_view:-search} == help ]]; then
    _dsearch_view=search
  fi
  _dsearch_apply_filter "$_dsearch_q" $maxn
  _dsearch_draw "$_dsearch_q"
}

# Move highlight in the dropdown (arrows / Ctrl+N / Ctrl+P — not j/k, those type)
_dsearch_sel_up() {
  [[ ${_dsearch_view:-search} == search ]] || return 1
  if [[ ${_dsearch_focus:-list} == help ]]; then
    # Leave Help chip, keep current list index
    _dsearch_focus_list
    return 0
  fi
  (( $#_dsearch_matches && _dsearch_sel > 0 )) || return 1
  local old=$_dsearch_sel
  (( _dsearch_sel-- ))
  _dsearch_draw_sel "$_dsearch_q" $old
}

_dsearch_sel_down() {
  [[ ${_dsearch_view:-search} == search ]] || return 1
  if [[ ${_dsearch_focus:-list} == help ]]; then
    _dsearch_focus_list
    return 0
  fi
  (( $#_dsearch_matches && _dsearch_sel < $#_dsearch_matches - 1 )) || return 1
  local old=$_dsearch_sel
  (( _dsearch_sel++ ))
  _dsearch_draw_sel "$_dsearch_q" $old
}

# ── Main entry ────────────────────────────────────────────────────────────
# Return 0 → navigated/done (or for_dfile: path in DNAV_SEARCH_RESULT)
# Return 1 → cancelled
typeset -gi _DSEARCH_FOR_DFILE=0
typeset -g  DNAV_SEARCH_RESULT=""

# Search while dfile is open: confirm stays in explorer (no dnav exit/cleanup).
_dsearch_start_for_dfile() {
  _DSEARCH_FOR_DFILE=1
  DNAV_SEARCH_RESULT=""
  _dsearch_start
  local ret=$?
  _DSEARCH_FOR_DFILE=0
  return $ret
}

_dsearch_start() {
  # Legacy stub path only if for_dfile not set
  if (( ! _DSEARCH_FOR_DFILE )) && _dfile_available && (( $+functions[_dfile_is_open] )) && _dfile_is_open; then
    if (( $+functions[_dsearch_start_for_dfile] )); then
      _dsearch_start_for_dfile
      return $?
    fi
  fi

  local key key2 key3
  local target
  local maxn=10
  typeset -g _DSEARCH_PUSHBACK=""
  typeset -g _dsearch_q=""

  _dsearch_q="${1:-}"
  _dsearch_cur=${#_dsearch_q}
  _dsearch_qwin=0
  _dsearch_matches=()
  _dsearch_sel=0
  _dsearch_extra_lines=0
  _dsearch_prev_query=""
  _dsearch_cand_stack=()
  _dsearch_focus=list
  _dsearch_view=search

  _dsearch_tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/dnav-dsearch.XXXXXX") || {
    printf "\r\e[2K"
    printf "\e[?25l"
    return 1
  }

  # Wipe previous TUI line (main bar / dfile) so only search remains
  printf "\r\e[2K\e[?25l"

  # Wait for background index if needed — "Indexing... N" on this line, then clear.
  # ensure_index always returns 0 so we still enter search (even with empty index).
  _dsearch_ensure_index
  printf "\r\e[2K\e[?25l"
  _dsearch_extra_lines=0
  if [[ -n $_dsearch_q ]]; then
    _dsearch_apply_filter "$_dsearch_q" $maxn
  fi
  _DSEARCH_OPEN=1
  _dsearch_draw "$_dsearch_q"

  while true; do
    (( ${DNAV_ABORT:-0} )) && { _DSEARCH_OPEN=0; return 130; }
    if [[ -n $_DSEARCH_PUSHBACK ]]; then
      local pb="$_DSEARCH_PUSHBACK"
      _DSEARCH_PUSHBACK=""
      case $pb in
        $'\e') key=esc ;;
        $'\n'|$'\r') key=enter ;;
        $'\x0e') key=ctrl-n ;;
        $'\x10') key=ctrl-p ;;
        $'\x01') key=ctrl-a ;;
        $'\x05') key=ctrl-e ;;
        *) key="$pb" ;;
      esac
    elif (( $+functions[_dnav_read_token] )); then
      _dnav_read_token || true
      key="$REPLY"
    else
      read -k 1 key || true
    fi
    (( ${DNAV_ABORT:-0} )) && { _DSEARCH_OPEN=0; return 130; }
    if [[ $key == ctrl-c || $key == $'\x03' ]]; then
      _DSEARCH_OPEN=0
      if (( $+functions[_dnav_abort] )); then
        _dnav_abort
      else
        _dsearch_erase_ui
        _dsearch_session_cleanup
        DNAV_ABORT=1
        printf "\e[?25h"
      fi
      return 130
    fi

    case $key in
      up) _dsearch_sel_up ;;
      down) _dsearch_sel_down ;;
      right)
        if [[ ${_dsearch_view:-search} == search ]]; then
          if [[ ${_dsearch_focus:-list} == help ]]; then
            :
          elif (( _dsearch_cur < ${#_dsearch_q} )); then
            (( _dsearch_cur++ ))
            _dsearch_draw "$_dsearch_q"
          else
            _dsearch_focus_help
          fi
        fi
        ;;
      left)
        if [[ ${_dsearch_view:-search} == search && ${_dsearch_focus:-list} == help ]]; then
          _dsearch_focus_list
        elif [[ ${_dsearch_view:-search} == search ]]; then
          if (( _dsearch_cur > 0 )); then
            (( _dsearch_cur-- ))
            _dsearch_draw "$_dsearch_q"
          fi
        fi
        ;;
      home|ctrl-a)
        _dsearch_cur=0
        _dsearch_draw "$_dsearch_q"
        ;;
      end|ctrl-e)
        _dsearch_cur=${#_dsearch_q}
        _dsearch_draw "$_dsearch_q"
        ;;
      delete)
        if [[ ${_dsearch_view:-search} != help ]]; then
          _dsearch_delete && _dsearch_refresh_query
        fi
        ;;
      esc)
        if [[ ${_dsearch_view:-search} == help ]]; then
          _dsearch_close_help
        else
          _dsearch_erase_ui
          _dsearch_session_cleanup
          printf "\e[?25l"
          return 1
        fi
        ;;
      enter)
        if [[ ${_dsearch_view:-search} == help ]]; then
          continue
        fi
        if [[ ${_dsearch_focus:-list} == help ]]; then
          _dsearch_open_help
          continue
        fi
        if (( $#_dsearch_matches == 0 )); then
          continue
        fi
        target="${_dsearch_matches[_dsearch_sel+1]}"
        _dsearch_erase_ui
        _dsearch_session_cleanup
        printf "\e[?25l"
        if [[ -d $target ]]; then
          if (( _DSEARCH_FOR_DFILE )); then
            cd -- "$target" 2>/dev/null || true
            DNAV_SEARCH_RESULT="${target:a}"
            return 0
          fi
          cd -- "$target" || {
            printf "Could not change to %s\n" "$target"
            (( $+functions[_dnav_cleanup] )) && _dnav_cleanup
            return 0
          }
          if (( $+functions[_dnav_finish] )); then
            _dnav_finish "${target:a}" dnav
          else
            print -r -- "${target:a}"
            (( $+functions[_dnav_cleanup] )) && _dnav_cleanup
            (( $+functions[_dnav_maybe_ls] )) && _dnav_maybe_ls dnav
          fi
          return 0
        else
          if (( _DSEARCH_FOR_DFILE )); then
            return 1
          fi
          printf "Folder not found: %s\n" "$target"
          (( $+functions[_dnav_cleanup] )) && _dnav_cleanup
          return 0
        fi
        ;;
      backspace)
        if [[ ${_dsearch_view:-search} == help ]]; then
          continue
        fi
        if _dsearch_backspace; then
          _dsearch_refresh_query
        fi
        ;;
      ctrl-u)
        if [[ ${_dsearch_view:-search} == help ]]; then
          continue
        fi
        _dsearch_q=""
        _dsearch_cur=0
        _dsearch_sel=0
        _dsearch_matches=()
        _dsearch_prev_query=""
        _dsearch_focus=list
        _dsearch_draw "$_dsearch_q"
        ;;
      ctrl-p) _dsearch_sel_up ;;
      ctrl-n) _dsearch_sel_down ;;
      [[:print:]])
        if [[ ${_dsearch_view:-search} == help ]]; then
          _dsearch_view=search
        fi
        _dsearch_focus=list
        _dsearch_insert "$key"
        _dsearch_refresh_query
        ;;
    esac
  done
}
