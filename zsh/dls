_dls_color_code() {
  case $1 in
    black) print -rn -- 30 ;;
    red) print -rn -- 31 ;;
    green) print -rn -- 32 ;;
    yellow) print -rn -- 33 ;;
    blue) print -rn -- 34 ;;
    magenta) print -rn -- 35 ;;
    cyan) print -rn -- 36 ;;
    white) print -rn -- 37 ;;
    bright-black) print -rn -- 90 ;;
    bright-red) print -rn -- 91 ;;
    bright-green) print -rn -- 92 ;;
    bright-yellow) print -rn -- 93 ;;
    bright-blue) print -rn -- 94 ;;
    bright-magenta) print -rn -- 95 ;;
    bright-cyan) print -rn -- 96 ;;
    bright-white) print -rn -- 97 ;;
    *) return 1 ;;
  esac
}

# Words after the kind. Sets _DLS_STYLE_CODE. 1 on an unknown word.
_dls_join_style() {
  emulate -L zsh
  local w code="" part
  _DLS_STYLE_CODE=""
  for w in "$@"; do
    case $w in
      default) code=""; continue ;;
      bold) part=1 ;;
      dim) part=2 ;;
      underline) part=4 ;;
      reverse) part=7 ;;
      *)
        if [[ $w == <-> ]] && (( w >= 0 && w <= 255 )); then
          part="38;5;$w"
        else
          part="$(_dls_color_code "$w")" || return 1
        fi
        ;;
    esac
    if [[ -n $code ]]; then
      code+=";$part"
    else
      code="$part"
    fi
  done
  _DLS_STYLE_CODE="$code"
  return 0
}

# SGR for a kind, with the selection style stacked on top when $2 is non-zero.
_dls_style() {
  emulate -L zsh
  _dls_style_set "$1" "${2:-0}"
  print -rn -- "$REPLY"
}

_dls_apply_colorscheme() {
  local name="${(L)1}"
  local f base
  case $name in
    default)
      _dls_style_defaults
      _DLS_COLORSCHEME=default
      return 0
      ;;
    plain)
      _dls_style_defaults
      _DLS_STYLE[dir]=""
      _DLS_STYLE[link]=""
      _DLS_STYLE[exec]=""
      _DLS_STYLE[file]=""
      _DLS_STYLE[image]=""
      _DLS_STYLE[archive]=""
      _DLS_STYLE[media]=""
      _DLS_STYLE[selected]=7
      _DLS_STYLE[status]=2
      _DLS_COLORSCHEME=plain
      return 0
      ;;
  esac
  base="${XDG_CONFIG_HOME:-$HOME/.config}/dls/colorschemes/$name"
  if [[ -f $base && -r $base ]]; then
    _dls_style_defaults
    _DLS_COLORSCHEME="$name"
    _dls_config_load_file "$base" scheme
    return 0
  fi
  _dls_config_warn "${_DLS_RC_LINE:-1}" "unknown colorscheme: $name"
  _dls_style_defaults
  _DLS_COLORSCHEME=default
  return 0
}

# One auto_cls term. Sets _DLS_TERM_KIND, _DLS_TERM_OP, and _DLS_TERM_N.
# kind is always, never, key, action, pct, or rows. 1 if the word is unknown.
# Operators are quoted so '>' stays in the pattern. N% means pct >= N.
_dls_auto_cls_term() {
  emulate -L zsh
  local term="$1" n=""
  _DLS_TERM_KIND=""
  _DLS_TERM_OP=""
  _DLS_TERM_N=0
  case $term in
    off|never|false|no|0) _DLS_TERM_KIND=never; return 0 ;;
    on|always|true|yes|1) _DLS_TERM_KIND=always; return 0 ;;
    enter|shift-enter|s-enter|esc|ctrl-c) _DLS_TERM_KIND=key; return 0 ;;
    quit|quit-dir|cancel) _DLS_TERM_KIND=action; return 0 ;;
    pct'=='<->) _DLS_TERM_OP='=='; n="${term#'pct=='}" ;;
    pct'>='<->) _DLS_TERM_OP='>='; n="${term#'pct>='}" ;;
    pct'<='<->) _DLS_TERM_OP='<='; n="${term#'pct<='}" ;;
    pct'='<->)  _DLS_TERM_OP='=';  n="${term#'pct='}" ;;
    pct'>'<->)  _DLS_TERM_OP='>';  n="${term#'pct>'}" ;;
    pct'<'<->)  _DLS_TERM_OP='<';  n="${term#'pct<'}" ;;
    rows'=='<->) _DLS_TERM_OP='=='; n="${term#'rows=='}" ;;
    rows'>='<->) _DLS_TERM_OP='>='; n="${term#'rows>='}" ;;
    rows'<='<->) _DLS_TERM_OP='<='; n="${term#'rows<='}" ;;
    rows'='<->)  _DLS_TERM_OP='=';  n="${term#'rows='}" ;;
    rows'>'<->)  _DLS_TERM_OP='>';  n="${term#'rows>'}" ;;
    rows'<'<->)  _DLS_TERM_OP='<';  n="${term#'rows<'}" ;;
    <->%) _DLS_TERM_OP='>='; n="${term%'%'}" ;;
    *) return 1 ;;
  esac
  [[ $n == <-> ]] || return 1
  if [[ $term == rows* ]]; then
    _DLS_TERM_KIND=rows
  else
    (( n <= 100 )) || { _DLS_TERM_OP=""; return 1; }
    _DLS_TERM_KIND=pct
  fi
  _DLS_TERM_N=$n
  return 0
}

# 0 when $1 $2 $3 is true. rows below 1 makes a percent false.
_dls_auto_cls_cmp() {
  emulate -L zsh
  local -i left=$1 right=$3
  case $2 in
    '>=') (( left >= right )) ;;
    '>') (( left > right )) ;;
    '<=') (( left <= right )) ;;
    '<') (( left < right )) ;;
    '='|'==') (( left == right )) ;;
    *) return 1 ;;
  esac
}

# 0 when this term matches the leave. $2 key, $3 action, $4 drawn lines, $5 screen rows.
# rows compares the painted line count. pct is drawn * 100 / screen rows.
_dls_auto_cls_term_hit() {
  emulate -L zsh
  local term="$1" key="$2" action="$3"
  local -i drawn=$4 rows=$5 pct=0
  _dls_auto_cls_term "$term" || return 1
  case $_DLS_TERM_KIND in
    never) return 1 ;;
    always) return 0 ;;
    key)
      if [[ $term == shift-enter || $term == s-enter ]]; then
        [[ $key == shift-enter ]]
      else
        [[ $key == $term ]]
      fi
      ;;
    action)
      [[ $action == $term ]]
      ;;
    pct)
      (( rows >= 1 )) || return 1
      pct=$(( drawn * 100 / rows ))
      _dls_auto_cls_cmp "$pct" "$_DLS_TERM_OP" "$_DLS_TERM_N"
      ;;
    rows)
      _dls_auto_cls_cmp "$drawn" "$_DLS_TERM_OP" "$_DLS_TERM_N"
      ;;
    *) return 1 ;;
  esac
}

# 0 when every term is known. Empty clauses and empty terms are rejected.
_dls_auto_cls_valid() {
  emulate -L zsh
  local expr="$1" clause term
  local -a clauses terms
  [[ -n $expr ]] || return 1
  clauses=("${(@s:|:)expr}")
  (( $#clauses )) || return 1
  for clause in "${clauses[@]}"; do
    [[ -n $clause ]] || return 1
    terms=("${(@s:&:)clause}")
    (( $#terms )) || return 1
    for term in "${terms[@]}"; do
      [[ -n $term ]] || return 1
      _dls_auto_cls_term "$term" || return 1
    done
  done
  return 0
}

# Store a normalized expression. Lowercase, spaces removed. Previous value stays on failure.
_dls_auto_cls_set() {
  emulate -L zsh
  local expr="${(L)1}"
  expr="${expr//[[:space:]]/}"
  _dls_auto_cls_valid "$expr" || return 1
  _DLS_AUTO_CLS="$expr"
  return 0
}

# 0 when any clause matches. A clause matches when every term matches.
_dls_auto_cls_hit() {
  emulate -L zsh
  local expr="${_DLS_AUTO_CLS:-off}" key="$1" action="$2"
  local -i drawn=${3:-0} rows=${4:-0} ok=0
  local clause term
  local -a clauses terms
  [[ -n $expr ]] || return 1
  clauses=("${(@s:|:)expr}")
  for clause in "${clauses[@]}"; do
    [[ -n $clause ]] || continue
    terms=("${(@s:&:)clause}")
    (( $#terms )) || continue
    ok=1
    for term in "${terms[@]}"; do
      [[ -n $term ]] || { ok=0; break; }
      _dls_auto_cls_term_hit "$term" "$key" "$action" "$drawn" "$rows" || { ok=0; break; }
    done
    (( ok )) && return 0
  done
  return 1
}

_dls_config_set() {
  emulate -L zsh
  setopt localoptions noglob
  local -a w
  w=(${=1})
  (( $#w >= 2 )) || return 1
  if [[ ${(L)w[1]} == auto_cls ]]; then
    _dls_auto_cls_set "${(j: :)w[2,-1]}" || return 1
    return 0
  fi
  (( $#w == 2 )) || return 1
  case ${(L)w[1]} in
    show_hidden)
      case ${(L)w[2]} in
        true|yes|1) _DLS_SHOW_HIDDEN=1 ;;
        false|no|0) _DLS_SHOW_HIDDEN=0 ;;
        *) return 1 ;;
      esac ;;
    sort)
      case ${(L)w[2]} in
        name|natural|ext|size|mtime) _DLS_SORT="${(L)w[2]}" ;;
        *) return 1 ;;
      esac ;;
    sort_dirs)
      case ${(L)w[2]} in
        first|last|mixed) _DLS_SORT_DIRS="${(L)w[2]}" ;;
        *) return 1 ;;
      esac ;;
    sort_dots)
      case ${(L)w[2]} in
        first|last|mixed) _DLS_SORT_DOTS="${(L)w[2]}" ;;
        *) return 1 ;;
      esac ;;
    sort_reverse)
      case ${(L)w[2]} in
        true|yes|1) _DLS_SORT_REVERSE=1 ;;
        false|no|0) _DLS_SORT_REVERSE=0 ;;
        *) return 1 ;;
      esac ;;
    sort_case)
      case ${(L)w[2]} in
        ignore|sensitive) _DLS_SORT_CASE="${(L)w[2]}" ;;
        *) return 1 ;;
      esac ;;
    colorscheme)
      _dls_apply_colorscheme "${w[2]}"
      ;;
    shift_enter_ls)
      case ${(L)w[2]} in
        off|none|false|no|0) _DLS_SHIFT_LS=off ;;
        on|true|yes|1|ls) _DLS_SHIFT_LS=ls ;;
        dls) _DLS_SHIFT_LS=dls ;;
        *) return 1 ;;
      esac ;;
    *) return 1 ;;
  esac
  return 0
}

_dls_config_highlight() {
  emulate -L zsh
  setopt localoptions noglob extended_glob
  local -a w
  local kind
  w=(${=1})
  (( $#w >= 2 )) || return 1
  kind="${(L)w[1]}"
  [[ $kind == [a-z_][a-z0-9_-]# ]] || return 1
  _dls_join_style "${(@)w[2,-1]}" || return 1
  _DLS_STYLE[$kind]="$_DLS_STYLE_CODE"
  return 0
}

_dls_config_ext() {
  emulate -L zsh
  setopt localoptions noglob extended_glob
  local -a w parts
  local kind s
  w=(${=1})
  (( $#w == 2 )) || return 1
  kind="${(L)w[2]}"
  [[ $kind == [a-z_][a-z0-9_-]# ]] || return 1
  parts=("${(@s:,:)w[1]}")
  (( $#parts )) || return 1
  for s in "${parts[@]}"; do
    s="${${${(L)s}#.}:-}"
    [[ -n $s ]] || continue
    _DLS_EXT[$s]="$kind"
  done
  return 0
}

_dls_config_map() {
  emulate -L zsh
  setopt localoptions noglob
  local -a w
  local key action
  w=(${=1})
  (( $#w == 2 )) || return 1
  action="${(L)w[2]}"
  case $action in
    move-left|move-right|move-up|move-down|open|parent|quit|quit-dir|cancel|toggle-hidden|cycle-sort|reload|filter) ;;
    *) return 1 ;;
  esac
  case ${(L)w[1]} in
    '<enter>') key=enter ;;
    '<s-enter>'|'<shift-enter>') key=shift-enter ;;
    '<esc>') key=esc ;;
    '<bs>') key=backspace ;;
    '<left>') key=left ;;
    '<right>') key=right ;;
    '<up>') key=up ;;
    '<down>') key=down ;;
    *)
      (( ${#w[1]} == 1 )) || return 1
      key="$w[1]"
      ;;
  esac
  [[ $key == ctrl-c ]] && return 1
  _DLS_MAP[$key]="$action"
  return 0
}

_dls_config_line() {
  emulate -L zsh
  local line="$1" n="$2" only="${3:-}"
  local cmd rest
  line="${line%$'\r'}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [[ -z $line || $line == \#* ]] && return 0
  _DLS_RC_LINE="$n"
  cmd="${line%%[[:space:]]*}"
  rest="${line#$cmd}"
  rest="${rest#"${rest%%[![:space:]]*}"}"
  if [[ $only == scheme && $cmd != highlight && $cmd != ext ]]; then
    _dls_config_warn "$n" "not allowed in a colorscheme: $cmd"
    return 0
  fi
  case $cmd in
    set) _dls_config_set "$rest" || _dls_config_warn "$n" "bad set: $rest" ;;
    highlight) _dls_config_highlight "$rest" || _dls_config_warn "$n" "bad highlight: $rest" ;;
    ext) _dls_config_ext "$rest" || _dls_config_warn "$n" "bad ext: $rest" ;;
    map) _dls_config_map "$rest" || _dls_config_warn "$n" "bad map: $rest" ;;
    source) _dls_config_source "$rest" ;;
    *) _dls_config_warn "$n" "unknown command: $cmd" ;;
  esac
  return 0
}

_dls_config_source() {
  emulate -L zsh
  local spec="$1" path
  spec="${spec#"${spec%%[![:space:]]*}"}"
  spec="${spec%"${spec##*[![:space:]]}"}"
  [[ -n $spec ]] || { _dls_config_warn "${_DLS_RC_LINE:-1}" "bad source"; return 0; }
  spec="${spec/#\~/$HOME}"
  if [[ $spec == /* ]]; then
    path="$spec"
  else
    path="${_DLS_RC_DIR:-$PWD}/$spec"
  fi
  path="${path:a}"
  if (( ${_DLS_RC_SEEN[$path]:-0} )); then
    _dls_config_warn "${_DLS_RC_LINE:-1}" "source cycle: ${path:t}"
    return 0
  fi
  if [[ ! -f $path || ! -r $path ]]; then
    _dls_config_warn "${_DLS_RC_LINE:-1}" "cannot read ${path:t}"
    return 0
  fi
  _dls_config_load_file "$path"
}

# $2 = scheme to allow only highlight and ext.
_dls_config_load_file() {
  emulate -L zsh
  local path="$1" only="${2:-}" line n=0 prev_dir
  path="${path:a}"
  [[ -f $path && -r $path ]] || return 1
  _DLS_RC_SEEN[$path]=1
  prev_dir="${_DLS_RC_DIR:-}"
  _DLS_RC_DIR="${path:h}"
  while IFS= read -r line || [[ -n $line ]]; do
    n=$(( n + 1 ))
    _dls_config_line "$line" "$n" "$only"
  done < "$path"
  _DLS_RC_DIR="$prev_dir"
  unset "_DLS_RC_SEEN[$path]"
  return 0
}

_dls_config_discover() {
  emulate -L zsh
  if [[ -n ${_DLS_CONFIG_ARG:-} ]]; then
    print -rn -- "${_DLS_CONFIG_ARG/#\~/$HOME}"
    return
  fi
  if [[ -n ${DLS_CONFIG:-} ]]; then
    print -rn -- "${DLS_CONFIG/#\~/$HOME}"
    return
  fi
  print -rn -- "${XDG_CONFIG_HOME:-$HOME/.config}/dls/rc"
}

# $1 path (empty = discover). $2 = 1 to warn when that path is missing.
_dls_config_load() {
  emulate -L zsh
  local path="${1:-}" warn_missing="${2:-0}"
  _DLS_RC_WARN=()
  _DLS_RC_SEEN=()
  _DLS_RC_DIR=""
  _DLS_RC_LINE=0
  if [[ -z $path ]]; then
    path="$(_dls_config_discover)"
    if [[ -n ${_DLS_CONFIG_ARG:-} || -n ${DLS_CONFIG:-} ]]; then
      warn_missing=1
      _DLS_RC_EXPLICIT=1
    else
      _DLS_RC_EXPLICIT=0
    fi
  fi
  _DLS_RC_PATH="$path"
  _dls_config_defaults
  if [[ ! -f $path ]]; then
    (( warn_missing )) && _dls_config_warn 1 "not found: ${path:t}"
    return 0
  fi
  if [[ ! -r $path ]]; then
    _dls_config_warn 1 "cannot read: ${path:t}"
    return 0
  fi
  _dls_config_load_file "$path"
  return 0
}

_dls_action() {
  emulate -L zsh
  if [[ $1 == ctrl-c ]]; then
    print -rn -- cancel
    return
  fi
  print -rn -- "${_DLS_MAP[$1]:-}"
}

_dls_usage() {
  print -r -- "usage: dls [OPTION]... [PATH]..."
  print -r -- "config: ${XDG_CONFIG_HOME:-$HOME/.config}/dls/rc"
  print -r -- "Shift+Enter cds into the folder and leaves. map <s-enter> ACTION"
  print -r -- "  -a -A -B -d -f -F -h -i -l -r -s -S -t -U -v -X"
  print -r -- "  -c -u -g -o -G -n -p -L -H -w COLS -I PAT"
  print -r -- "  --all --almost-all --ignore-backups --ignore=PAT --hide=PAT"
  print -r -- "  --directory --reverse --group-directories-first --sort=WORD"
  print -r -- "  --time=WORD --time-style=STYLE --full-time --human-readable --si"
  print -r -- "  --classify --file-type --indicator-style=WORD --color=WHEN"
  print -r -- "  --config FILE"
  print -r -- "set: show_hidden sort sort_dirs sort_dots sort_reverse sort_case colorscheme auto_cls shift_enter_ls"
  print -r -- "auto_cls: off always KEY ACTION N% pct>=N rows>=N. | is or. & is and."
  print -r -- "shift_enter_ls: off | ls | dls. Listing after Shift+Enter leaves."
  print -r -- "highlight KIND ATTRS    ext SUFFIXES KIND    map KEY ACTION    source FILE"
}

_dls_set_sort_word() {
  case ${(L)1} in
    name) _DLS_CLI_SORT=name ;;
    size) _DLS_CLI_SORT=size ;;
    time) _DLS_CLI_SORT=time ;;
    version) _DLS_CLI_SORT=version ;;
    extension) _DLS_CLI_SORT=extension ;;
    none) _DLS_CLI_SORT=none ;;
    *) print -u2 -- "dls: invalid sort: $1"; return 2 ;;
  esac
}

_dls_set_time_word() {
  case ${(L)1} in
    mtime|modification) _DLS_CLI_TIME=mtime; _DLS_CLI_TIME_FROM=time ;;
    ctime|status) _DLS_CLI_TIME=ctime; _DLS_CLI_TIME_FROM=time ;;
    atime|access|use) _DLS_CLI_TIME=atime; _DLS_CLI_TIME_FROM=time ;;
    birth|creation) _DLS_CLI_TIME=birth; _DLS_CLI_TIME_FROM=time ;;
    *) print -u2 -- "dls: invalid time: $1"; return 2 ;;
  esac
}

_dls_parse_args() {
  emulate -L zsh
  local -i end=0
  local arg cluster c pat word
  _dls_cli_reset
  _DLS_CONFIG_ARG=""
  while (( $# )); do
    arg=$1
    shift
    if (( end )) || [[ $arg != -* || $arg == - ]]; then
      _DLS_PATHS+=("$arg")
      continue
    fi
    if [[ $arg == -- ]]; then
      end=1
      continue
    fi
    if [[ $arg == --help ]]; then
      _DLS_HELP=1
      return 0
    fi
    if [[ $arg == --* ]]; then
      case $arg in
        --config)
          (( $# )) || { print -u2 -- "dls: --config needs a path"; return 2 }
          _DLS_CONFIG_ARG=$1
          shift
          ;;
        --config=*) _DLS_CONFIG_ARG=${arg#--config=} ;;
        --all) _DLS_CLI_DOTS=a ;;
        --almost-all) _DLS_CLI_DOTS=A ;;
        --ignore-backups) _DLS_CLI_BACKUPS=1 ;;
        --directory) _DLS_CLI_DIRECTORY=1 ;;
        --reverse) _DLS_CLI_REVERSE=1 ;;
        --group-directories-first) _DLS_CLI_GROUP_DIRS=1 ;;
        --human-readable) _DLS_CLI_HUMAN=1 ;;
        --si) _DLS_CLI_SI=1 ;;
        --inode) _DLS_CLI_INODE=1 ;;
        --size) _DLS_CLI_BLOCKS=1 ;;
        --numeric-uid-gid) _DLS_CLI_NUMERIC=1; _DLS_CLI_LONG=1 ;;
        --no-group) _DLS_CLI_NO_GROUP=1 ;;
        --full-time) _DLS_CLI_LONG=1; _DLS_CLI_STYLE=full-iso ;;
        --file-type) _DLS_CLI_INDICATOR=file-type ;;
        --dereference) _DLS_CLI_DEREF=1 ;;
        --dereference-command-line) _DLS_CLI_DEREF_CMD=1 ;;
        --classify) _DLS_CLI_INDICATOR=classify ;;
        --classify=*)
          word=${arg#--classify=}
          case ${(L)word} in
            always|auto) _DLS_CLI_INDICATOR=classify ;;
            never) _DLS_CLI_INDICATOR=none ;;
            *) print -u2 -- "dls: invalid classify: $word"; return 2 ;;
          esac
          ;;
        --ignore=*) _DLS_CLI_IGNORE+=("${arg#--ignore=}") ;;
        --ignore)
          (( $# )) || { print -u2 -- "dls: --ignore needs a pattern"; return 2 }
          _DLS_CLI_IGNORE+=("$1")
          shift
          ;;
        --hide=*) _DLS_CLI_HIDE+=("${arg#--hide=}") ;;
        --hide)
          (( $# )) || { print -u2 -- "dls: --hide needs a pattern"; return 2 }
          _DLS_CLI_HIDE+=("$1")
          shift
          ;;
        --sort=*) _dls_set_sort_word "${arg#--sort=}" || return $? ;;
        --sort)
          (( $# )) || { print -u2 -- "dls: --sort needs a value"; return 2 }
          _dls_set_sort_word "$1" || return $?
          shift
          ;;
        --time=*) _dls_set_time_word "${arg#--time=}" || return $? ;;
        --time)
          (( $# )) || { print -u2 -- "dls: --time needs a value"; return 2 }
          _dls_set_time_word "$1" || return $?
          shift
          ;;
        --time-style=*) _DLS_CLI_STYLE=${arg#--time-style=} ;;
        --time-style)
          (( $# )) || { print -u2 -- "dls: --time-style needs a value"; return 2 }
          _DLS_CLI_STYLE=$1
          shift
          ;;
        --indicator-style=*)
          word=${arg#--indicator-style=}
          case $word in
            none|slash|file-type|classify) _DLS_CLI_INDICATOR=$word ;;
            *) print -u2 -- "dls: invalid indicator style: $word"; return 2 ;;
          esac
          ;;
        --indicator-style)
          (( $# )) || { print -u2 -- "dls: --indicator-style needs a value"; return 2 }
          word=$1
          shift
          case $word in
            none|slash|file-type|classify) _DLS_CLI_INDICATOR=$word ;;
            *) print -u2 -- "dls: invalid indicator style: $word"; return 2 ;;
          esac
          ;;
        --color) _DLS_CLI_COLOR=always ;;
        --color=*)
          word=${${arg#--color=}:l}
          case $word in
            always|auto|never) _DLS_CLI_COLOR=$word ;;
            *) print -u2 -- "dls: invalid color: $word"; return 2 ;;
          esac
          ;;
        --width=*)
          word=${arg#--width=}
          [[ $word == <-> ]] || { print -u2 -- "dls: invalid width: $word"; return 2 }
          _DLS_CLI_WIDTH_SET=1
          _DLS_CLI_WIDTH=$word
          ;;
        --width)
          (( $# )) || { print -u2 -- "dls: --width needs a value"; return 2 }
          word=$1
          shift
          [[ $word == <-> ]] || { print -u2 -- "dls: invalid width: $word"; return 2 }
          _DLS_CLI_WIDTH_SET=1
          _DLS_CLI_WIDTH=$word
          ;;
        *)
          print -u2 -- "dls: unknown option: $arg"
          return 2
          ;;
      esac
      continue
    fi
    cluster=${arg#-}
    while [[ -n $cluster ]]; do
      c=${cluster[1]}
      cluster=${cluster[2,-1]}
      case $c in
        a) _DLS_CLI_DOTS=a ;;
        A) _DLS_CLI_DOTS=A ;;
        B) _DLS_CLI_BACKUPS=1 ;;
        d) _DLS_CLI_DIRECTORY=1 ;;
        f) _DLS_CLI_DOTS=a; _DLS_CLI_SORT=none ;;
        F) _DLS_CLI_INDICATOR=classify ;;
        p) _DLS_CLI_INDICATOR=slash ;;
        h) _DLS_CLI_HUMAN=1 ;;
        i) _DLS_CLI_INODE=1 ;;
        l) _DLS_CLI_LONG=1 ;;
        r) _DLS_CLI_REVERSE=1 ;;
        s) _DLS_CLI_BLOCKS=1 ;;
        S) _DLS_CLI_SORT=size ;;
        t) _DLS_CLI_SORT=time ;;
        U) _DLS_CLI_SORT=none ;;
        v) _DLS_CLI_SORT=version ;;
        X) _DLS_CLI_SORT=extension ;;
        c) _DLS_CLI_TIME=ctime; _DLS_CLI_TIME_FROM=c ;;
        u) _DLS_CLI_TIME=atime; _DLS_CLI_TIME_FROM=u ;;
        g) _DLS_CLI_LONG=1; _DLS_CLI_NO_OWNER=1 ;;
        o) _DLS_CLI_LONG=1; _DLS_CLI_NO_GROUP=1 ;;
        G) _DLS_CLI_NO_GROUP=1 ;;
        n) _DLS_CLI_LONG=1; _DLS_CLI_NUMERIC=1 ;;
        L) _DLS_CLI_DEREF=1 ;;
        H) _DLS_CLI_DEREF_CMD=1 ;;
        I)
          if [[ -n $cluster ]]; then
            pat=$cluster
            cluster=""
          else
            (( $# )) || { print -u2 -- "dls: -I needs a pattern"; return 2 }
            pat=$1
            shift
          fi
          _DLS_CLI_IGNORE+=("$pat")
          ;;
        w)
          if [[ -n $cluster ]]; then
            word=$cluster
            cluster=""
          else
            (( $# )) || { print -u2 -- "dls: -w needs a width"; return 2 }
            word=$1
            shift
          fi
          [[ $word == <-> ]] || { print -u2 -- "dls: invalid width: $word"; return 2 }
          _DLS_CLI_WIDTH_SET=1
          _DLS_CLI_WIDTH=$word
          ;;
        *)
          print -u2 -- "dls: unknown option: -$c"
          return 2
          ;;
      esac
    done
  done
  if (( $#_DLS_PATHS )); then
    _DLS_START="${_DLS_PATHS[1]}"
  else
    _DLS_START="."
  fi
  return 0
}

_dls_sort_label() {
  emulate -L zsh
  local s="${_DLS_SORT:-name}"
  [[ $s == time ]] && s="${_DLS_TIME:-mtime}"
  (( ${_DLS_SORT_REVERSE:-0} )) && s+="~"
  [[ ${_DLS_SORT_DIRS:-mixed} != mixed ]] && s+=" dirs"
  [[ ${_DLS_SORT_DOTS:-mixed} != mixed ]] && s+=" dots"
  print -rn -- "$s"
}

# Zero-pad digit runs so f2 sorts before f10. Sets REPLY.
_dls_natural_set() {
  local rest="$1" out="" pre num
  [[ ${_DLS_SORT_CASE:-ignore} == ignore ]] && rest="${(L)rest}"
  while [[ -n $rest ]]; do
    if [[ $rest =~ '^([^0-9]*)([0-9]+)(.*)$' ]]; then
      pre="${match[1]}"
      num="${match[2]}"
      rest="${match[3]}"
      if (( ${#num} < 12 )); then
        num=$(( 10#$num ))
        num="${(l:12::0:)num}"
      fi
      out+="${pre}${num}"
    else
      out+="$rest"
      break
    fi
  done
  REPLY=$out
}

_dls_natural_key() {
  emulate -L zsh
  _dls_natural_set "$1"
  print -rn -- "$REPLY"
}

# 20-wide zero pad, sign first, matching printf '%020d'.
_dls_zpad() {
  local n="$1" w=20 body bw
  [[ $n == <-> ]] || n=0
  if [[ $n == -* ]]; then
    body="${n#-}"
    bw=$(( w - 1 ))
    (( ${#body} < bw )) && body="${(l:bw::0:)body}"
    REPLY="-$body"
  elif (( ${#n} < w )); then
    REPLY="${(l:w::0:)n}"
  else
    REPLY=$n
  fi
}

_dls_sort_key_set() {
  local i="$1" name="${_DLS_NAMES[$1]}" key ext stamp
  case ${_DLS_SORT:-name} in
    natural)
      _dls_natural_set "$name"
      key=$REPLY
      ;;
    ext)
      ext="${name:e}"
      if [[ ${_DLS_SORT_CASE:-ignore} == ignore ]]; then
        ext="${(L)ext}"
        name="${(L)name}"
      fi
      key="${ext} ${name}"
      ;;
    size)
      stamp="${_DLS_SIZE[$i]:-0}"
      _dls_zpad "$stamp"
      key="$REPLY $name"
      ;;
    mtime)
      stamp="${_DLS_MTIME[$i]:-0}"
      _dls_zpad "$stamp"
      key="$REPLY $name"
      ;;
    time)
      case ${_DLS_TIME:-mtime} in
        ctime) stamp="${_DLS_CTIME[$i]:-0}" ;;
        atime) stamp="${_DLS_ATIME[$i]:-0}" ;;
        birth) stamp="${_DLS_BIRTH[$i]:-0}" ;;
        *) stamp="${_DLS_MTIME[$i]:-0}" ;;
      esac
      [[ $stamp == <-> ]] || stamp=0
      _dls_zpad "$stamp"
      key="$REPLY $name"
      ;;
    *)
      [[ ${_DLS_SORT_CASE:-ignore} == ignore ]] && name="${(L)name}"
      key="$name"
      ;;
  esac
  REPLY=$key
}

_dls_sort_key() {
  emulate -L zsh
  _dls_sort_key_set "$1"
  print -rn -- "$REPLY"
}

# Group, then sort inside each group. sort_dirs and sort_dots each add a
# split; mixed leaves that split out. Reverse flips inside a group only.
# dirs first + dots first: dot dirs, dirs, dot files, files.
_dls_apply_sort() {
  emulate -L zsh
  local -a b0 b1 b2 b3 items nn nd nl ne ns nm nk
  local -i i n=$#_DLS_NAMES dc hc g
  local rec key name
  (( n == 0 )) && return 0
  for (( i = 1; i <= n; i++ )); do
    _dls_sort_key_set "$i"
    key=$REPLY
    rec="${key}"$'\t'"$i"
    name="${_DLS_NAMES[i]}"
    case ${_DLS_SORT_DIRS:-mixed} in
      mixed) dc=0 ;;
      last) (( _DLS_ISDIR[i] )) && dc=1 || dc=0 ;;
      *) (( _DLS_ISDIR[i] )) && dc=0 || dc=1 ;;
    esac
    case ${_DLS_SORT_DOTS:-mixed} in
      mixed) hc=0 ;;
      last) [[ $name == .* ]] && hc=1 || hc=0 ;;
      *) [[ $name == .* ]] && hc=0 || hc=1 ;;
    esac
    g=$(( dc * 2 + hc ))
    case $g in
      0) b0+=("$rec") ;;
      1) b1+=("$rec") ;;
      2) b2+=("$rec") ;;
      *) b3+=("$rec") ;;
    esac
  done
  if [[ ${_DLS_SORT:-name} == none ]]; then
    if (( ${_DLS_SORT_REVERSE:-0} )); then
      (( $#b0 )) && b0=("${(@Oa)b0}")
      (( $#b1 )) && b1=("${(@Oa)b1}")
      (( $#b2 )) && b2=("${(@Oa)b2}")
      (( $#b3 )) && b3=("${(@Oa)b3}")
    fi
  elif (( ${_DLS_SORT_REVERSE:-0} )); then
    (( $#b0 )) && b0=("${(@O)b0}")
    (( $#b1 )) && b1=("${(@O)b1}")
    (( $#b2 )) && b2=("${(@O)b2}")
    (( $#b3 )) && b3=("${(@O)b3}")
  else
    (( $#b0 )) && b0=("${(@o)b0}")
    (( $#b1 )) && b1=("${(@o)b1}")
    (( $#b2 )) && b2=("${(@o)b2}")
    (( $#b3 )) && b3=("${(@o)b3}")
  fi
  items=("${b0[@]}" "${b1[@]}" "${b2[@]}" "${b3[@]}")
  local -a nfull nmode nnlink nuid ngid natime nctime nbirth ninode nblocks ntarget
  for rec in "${items[@]}"; do
    i="${rec##*$'\t'}"
    nn+=("${_DLS_NAMES[i]}")
    nd+=("${_DLS_ISDIR[i]}")
    nl+=("${_DLS_LINK[i]}")
    ne+=("${_DLS_EXEC[i]}")
    ns+=("${_DLS_SIZE[i]}")
    nm+=("${_DLS_MTIME[i]}")
    nk+=("${_DLS_KIND[i]}")
    nfull+=("${_DLS_FULL[i]:-}")
    nmode+=("${_DLS_MODE[i]:-0}")
    nnlink+=("${_DLS_NLINK[i]:-0}")
    nuid+=("${_DLS_UID[i]:-0}")
    ngid+=("${_DLS_GID[i]:-0}")
    natime+=("${_DLS_ATIME[i]:-0}")
    nctime+=("${_DLS_CTIME[i]:-0}")
    nbirth+=("${_DLS_BIRTH[i]:-0}")
    ninode+=("${_DLS_INODE_N[i]:-0}")
    nblocks+=("${_DLS_BLOCKS_N[i]:-0}")
    ntarget+=("${_DLS_TARGET[i]:-}")
  done
  _DLS_NAMES=("${nn[@]}")
  _DLS_ISDIR=("${nd[@]}")
  _DLS_LINK=("${nl[@]}")
  _DLS_EXEC=("${ne[@]}")
  _DLS_SIZE=("${ns[@]}")
  _DLS_MTIME=("${nm[@]}")
  _DLS_KIND=("${nk[@]}")
  _DLS_FULL=("${nfull[@]}")
  _DLS_MODE=("${nmode[@]}")
  _DLS_NLINK=("${nnlink[@]}")
  _DLS_UID=("${nuid[@]}")
  _DLS_GID=("${ngid[@]}")
  _DLS_ATIME=("${natime[@]}")
  _DLS_CTIME=("${nctime[@]}")
  _DLS_BIRTH=("${nbirth[@]}")
  _DLS_INODE_N=("${ninode[@]}")
  _DLS_BLOCKS_N=("${nblocks[@]}")
  _DLS_TARGET=("${ntarget[@]}")
}

