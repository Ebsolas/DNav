_dls_disp_w() {
  emulate -L zsh
  setopt localoptions multibyte
  print -rn -- ${(m)#1}
}

# Shorten $1 to at most $2 display columns. Sets REPLY.
_dls_cut_set() {
  emulate -L zsh
  setopt localoptions multibyte
  local s="$1" max="${2:-0}"
  [[ $max == <-> ]] || max=0
  (( max < 0 )) && max=0
  while (( ${(m)#s} > max && ${#s} > 0 )); do
    s="${s[1,-2]}"
  done
  REPLY=$s
}

_dls_cut() {
  emulate -L zsh
  _dls_cut_set "$@"
  print -rn -- "$REPLY"
}

# Visible cell text. $2 is the indicator suffix, kept inside the width.
_dls_fit_set() {
  emulate -L zsh
  setopt localoptions multibyte
  local name="$1" slash="${2:-}" maxw="${3:-1}" nw budget ell="…" ew
  [[ $maxw == <-> ]] || maxw=1
  (( maxw < 1 )) && { REPLY=""; return }
  nw=${(m)#name}
  if (( nw + ${#slash} <= maxw )); then
    REPLY="${name}${slash}"
    return
  fi
  ew=${(m)#ell}
  (( ew < 1 )) && ew=1
  budget=$(( maxw - ${#slash} - ew ))
  if (( budget < 1 )); then
    _dls_cut_set "${name}${slash}" "$maxw"
    return
  fi
  _dls_cut_set "$name" "$budget"
  REPLY="${REPLY}${ell}${slash}"
}

_dls_fit() {
  emulate -L zsh
  _dls_fit_set "$@"
  print -rn -- "$REPLY"
}

_dls_pad_set() {
  emulate -L zsh
  setopt localoptions multibyte
  local s="$1" w="${2:-0}" n pad
  [[ $w == <-> ]] || w=0
  n=${(m)#s}
  if (( n < w )); then
    printf -v pad '%*s' $(( w - n )) ''
    s+="$pad"
  fi
  REPLY=$s
}

_dls_pad() {
  emulate -L zsh
  _dls_pad_set "$@"
  print -rn -- "$REPLY"
}

_dls_show_path() {
  emulate -L zsh
  local p="$1" home="${HOME%/}"
  if [[ -n $home && $p == "$home" ]]; then
    print -rn -- "~"
  elif [[ -n $home && $p == "$home"/* ]]; then
    print -rn -- "~${p#$home}"
  else
    print -rn -- "$p"
  fi
}

_dls_visible_set() {
  REPLY="${1//$'\e'/?}"
  REPLY="${REPLY//[^[:print:]]/?}"
}

_dls_visible_name() {
  emulate -L zsh
  _dls_visible_set "$1"
  print -rn -- "$REPLY"
}

_dls_config_warn() {
  local n="$1" msg="$2" text
  text="dls: rc:${n}: ${msg}"
  _DLS_RC_WARN+=("$text")
  print -u2 -- "$text"
}

