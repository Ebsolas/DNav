#!/usr/bin/env zsh
# dsearch-index — dirs.idx cache (~/.cache/dnav)
# Import a path list (--from / index_file). Walking the disk is dindexer.

# Background worker + PID file (avoids "done" job lines on iSH / busybox).
typeset -gi _DSEARCH_INDEX_PID=0
typeset -gi _DSEARCH_INDEX_HAS_SID=0
typeset -g  _DSEARCH_INDEX_COUNT_FILE=""
typeset -g  _DSEARCH_INDEX_PID_FILE=""
typeset -g  _DSEARCH_INDEX_TMP=""
typeset -g  _DSEARCH_INDEX_STATE=idle   # idle|running|done|failed|cancelled

# Index path
_dsearch_index_path() {
  print -r -- "${XDG_CACHE_HOME:-$HOME/.cache}/dnav/dirs.idx"
}

_dsearch_hot_path() {
  print -r -- "${XDG_CACHE_HOME:-$HOME/.cache}/dnav/dirs.hot"
}

_dsearch_index_dir() {
  print -r -- "${XDG_CACHE_HOME:-$HOME/.cache}/dnav"
}

# Shallow subset of $1 (home depth ≤ 2, other paths depth ≤ 2). Writes dirs.hot.
_dsearch_write_hot() {
  emulate -L zsh
  local idx="$1" hot tmp home_p
  [[ -n $idx ]] || idx="$(_dsearch_index_path)"
  hot="$(_dsearch_hot_path)"
  mkdir -p "${hot:h}" 2>/dev/null || return 1
  tmp="${hot}.$$"
  if [[ ! -f $idx || ! -s $idx ]]; then
    : > "$hot"
    return 0
  fi
  home_p="${HOME%/}"
  awk -v home="$home_p" '
    function ncomp(path,   n, segs, i, d) {
      n = split(path, segs, "/")
      d = 0
      for (i = 1; i <= n; i++) if (segs[i] != "") d++
      return d
    }
    {
      if (home != "" && ($0 == home || index($0, home "/") == 1)) {
        if ($0 == home) { print; next }
        if (ncomp(substr($0, length(home) + 2)) <= 2) print
      } else if (ncomp($0) <= 2) print
    }
  ' "$idx" > "$tmp" || { rm -f -- "$tmp"; return 1; }
  mv -f "$tmp" "$hot" 2>/dev/null || { rm -f -- "$tmp"; return 1; }
  return 0
}

# Rebuild dirs.hot when missing or older than dirs.idx.
_dsearch_ensure_hot() {
  emulate -L zsh
  local idx hot im hm
  idx="$(_dsearch_index_path)"
  hot="$(_dsearch_hot_path)"
  [[ -f $idx && -s $idx ]] || return 0
  if [[ -f $hot && -s $hot ]]; then
    im="$(_dsearch_file_mtime "$idx")" || im=0
    hm="$(_dsearch_file_mtime "$hot")" || hm=0
    (( hm >= im && im > 0 )) && return 0
  fi
  _dsearch_write_hot "$idx"
}

# mtime: GNU stat, BSD stat, or python.
_dsearch_file_mtime() {
  local f="$1" m
  m=$(stat -c %Y -- "$f" 2>/dev/null) && { print -rn -- "$m"; return 0; }
  m=$(stat -f %m -- "$f" 2>/dev/null) && { print -rn -- "$m"; return 0; }
  m=$(python3 -c 'import os,sys; print(int(os.path.getmtime(sys.argv[1])))' "$f" 2>/dev/null) && {
    print -rn -- "$m"; return 0
  }
  return 1
}

# Seconds until dirs.idx is stale. 0 = never (missing/empty still stale).
_dsearch_index_ttl_sec() {
  local h="${DNAV_CFG_INDEX_TTL_HOURS:-24}"
  [[ $h == <-> ]] || h=24
  print -rn -- $(( h * 3600 ))
}

# 0 if auto-index should run here (open | search).
_dsearch_index_wanted() {
  local ctx="${1:-open}"
  (( ${DNAV_CFG_INDEX_AUTO:-1} )) || return 1
  local when="${(L)DNAV_CFG_INDEX_WHEN:-open}"
  case $when in
    search|s)
      [[ $ctx == search ]]
      ;;
    *)
      return 0
      ;;
  esac
}

_dsearch_index_stale() {
  local idx="$1" now mtime age ttl
  [[ ! -f $idx || ! -s $idx ]] && return 0
  ttl="$(_dsearch_index_ttl_sec)"
  (( ttl <= 0 )) && return 1
  now=$(date +%s 2>/dev/null) || return 0
  mtime="$(_dsearch_file_mtime "$idx")" || return 0
  age=$(( now - mtime ))
  (( age > ttl ))
}

_dsearch_index_count() {
  local n=0 f="$_DSEARCH_INDEX_COUNT_FILE"
  [[ -z $f || ! -f $f ]] && { print -rn -- 0; return; }
  n=$(tr -cd '0-9' <"$f" 2>/dev/null)
  [[ -n $n ]] || n=0
  print -rn -- "$n"
}

# iSH / similar: light index. A desktop busybox binary is not light mode.
_dsearch_constrained_env() {
  [[ -n ${DNAV_SEARCH_LIGHT:-} ]] && return 0
  [[ -d /var/ish || -d /ish || -e /proc/ish ]] && return 0
  uname -a 2>/dev/null | grep -Eiq 'ish|iphone|ipod|ipad' && return 0
  return 1
}

# 1 if a background index is still running (PID file; never wait).
_dsearch_index_running() {
  local pid=$_DSEARCH_INDEX_PID pf="$_DSEARCH_INDEX_PID_FILE"
  if (( pid <= 0 )) && [[ -n $pf && -f $pf ]]; then
    pid=$(tr -cd '0-9' <"$pf" 2>/dev/null)
    [[ -n $pid ]] && _DSEARCH_INDEX_PID=$pid
  fi
  (( _DSEARCH_INDEX_PID > 0 )) || return 1
  if kill -0 $_DSEARCH_INDEX_PID 2>/dev/null; then
    return 0
  fi
  # Process gone — clear without wait (avoids job-control "done" lines)
  _DSEARCH_INDEX_PID=0
  [[ -n $pf ]] && rm -f -- "$pf" 2>/dev/null
  return 1
}

_dsearch_meta_path() {
  print -r -- "$(_dsearch_index_dir)/dirs.idx.meta"
}

_dsearch_index_file_resolved() {
  local f="${DNAV_CFG_INDEX_FILE:-}" p
  [[ -n $f ]] || return 1
  if (( $+functions[_dnav_expand_path] )); then
    p="$(_dnav_expand_path "$f")"
  else
    p="$f"
    [[ $p == '~' ]] && p="$HOME"
    [[ $p == '~/'* ]] && p="$HOME/${p#~/}"
  fi
  print -r -- "$p"
}

# Install a path list as dirs.idx. $1 = file or -. Prints count kept.
_dsearch_import_index() {
  emulate -L zsh
  local src="$1" idx tmp line p n=0
  idx="$(_dsearch_index_path)"
  mkdir -p "${idx:h}" 2>/dev/null || return 1
  tmp="${idx}.import.$$"
  if [[ $src != - ]]; then
    [[ -f $src ]] || return 1
  fi
  {
    if [[ $src == - ]]; then
      cat
    else
      cat -- "$src"
    fi
  } | while IFS= read -r line || [[ -n $line ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z $line || $line == \#* ]] && continue
    if (( $+functions[_dnav_expand_path] )); then
      p="$(_dnav_expand_path "$line")"
    else
      p="$line"
      [[ $p == '~' ]] && p="$HOME"
      [[ $p == '~/'* ]] && p="$HOME/${p#~/}"
    fi
    [[ -d $p ]] || continue
    if (( $+functions[_dnav_logical_path] )); then
      p="$(_dnav_logical_path "$p")"
    fi
    print -r -- "$p"
  done | sort -u > "$tmp" || true
  n=$(wc -l < "$tmp" 2>/dev/null | tr -cd '0-9')
  mv -f "$tmp" "$idx" 2>/dev/null || { rm -f -- "$tmp"; return 1; }
  rm -f -- "$(_dsearch_meta_path)" 2>/dev/null
  _dsearch_write_hot "$idx"
  print -rn -- ${n:-0}
  return 0
}

# Start a detached reindex if stale. $1=1|--force ignores TTL.
_dsearch_index_lock_dir() {
  print -r -- "$(_dsearch_index_dir)/index.lock"
}

_dsearch_index_unlock() {
  rmdir -- "$(_dsearch_index_lock_dir)" 2>/dev/null || true
}

_dsearch_index_file_due() {
  local src idx sm im
  src="$(_dsearch_index_file_resolved)" || return 1
  [[ -f $src ]] || return 1
  idx="$(_dsearch_index_path)"
  [[ ! -f $idx || ! -s $idx ]] && return 0
  sm="$(_dsearch_file_mtime "$src")" || return 0
  im="$(_dsearch_file_mtime "$idx")" || return 0
  (( sm > im ))
}

# Import config index_file when due. Never walks. $1=1|--force.
_dsearch_index_apply_file() {
  local force=0 src idx n
  case ${1:-} in
    1|--force) force=1 ;;
  esac
  src="$(_dsearch_index_file_resolved)" || return 1
  idx="$(_dsearch_index_path)"
  if [[ ! -f $src ]]; then
    (( force )) && print -u2 -- "dnav: index_file not found: $src"
    _DSEARCH_INDEX_STATE=done
    return 0
  fi
  if (( force )) || _dsearch_index_file_due || _dsearch_index_stale "$idx"; then
    n="$(_dsearch_import_index "$src")" || {
      _DSEARCH_INDEX_STATE=failed
      return 1
    }
  fi
  _DSEARCH_INDEX_STATE=done
  return 0
}

_dsearch_load_dindexer() {
  (( $+functions[_dindexer_start_bg] )) && return 0
  local f="${DNAV_DIR:-}/dindexer"
  if [[ ! -f $f && -n ${(%):-%x} ]]; then
    f="${${(%):-%x}:A:h}/dindexer"
  fi
  [[ -f $f ]] && source "$f"
  (( $+functions[_dindexer_start_bg] ))
}

# Import index_file if set; otherwise start the crawler when dindexer is installed.
# $1=1|--force ignores TTL. Without dindexer this does not walk.
_dsearch_index_start_bg() {
  local force=0
  case ${1:-} in
    1|--force) force=1 ;;
  esac
  if (( _DSEARCH_INDEX_PID > 0 )) && ! kill -0 $_DSEARCH_INDEX_PID 2>/dev/null; then
    _DSEARCH_INDEX_PID=0
  fi
  if _dsearch_index_file_resolved >/dev/null; then
    _dsearch_index_apply_file $force
    return $?
  fi
  _dsearch_load_dindexer || {
    _DSEARCH_INDEX_STATE=done
    return 0
  }
  _dindexer_start_bg $force
}

# Cancel a background index.
_dsearch_index_cancel() {
  local pid=$_DSEARCH_INDEX_PID pf="$_DSEARCH_INDEX_PID_FILE"
  if (( pid <= 0 )) && [[ -n $pf && -f $pf ]]; then
    pid=$(tr -cd '0-9' <"$pf" 2>/dev/null)
  fi
  if [[ $pid == <-> ]] && (( pid > 1 && pid != $$ )); then
    if (( _DSEARCH_INDEX_HAS_SID )); then
      kill -TERM -- -$pid 2>/dev/null || kill -TERM -- $pid 2>/dev/null || true
    else
      kill -TERM -- $pid 2>/dev/null || true
      pkill -TERM -P $pid 2>/dev/null || true
    fi
  fi
  _DSEARCH_INDEX_PID=0
  _DSEARCH_INDEX_HAS_SID=0
  _DSEARCH_INDEX_STATE=cancelled
  [[ -n $_DSEARCH_INDEX_TMP ]] && rm -f -- "$_DSEARCH_INDEX_TMP" 2>/dev/null
  [[ -n $_DSEARCH_INDEX_COUNT_FILE ]] && rm -f -- "$_DSEARCH_INDEX_COUNT_FILE" 2>/dev/null
  [[ -n $pf ]] && rm -f -- "$pf" 2>/dev/null
  _dsearch_index_unlock
  _DSEARCH_INDEX_COUNT_FILE=""
  _DSEARCH_INDEX_PID_FILE=""
  _DSEARCH_INDEX_TMP=""
}

# "Indexing... N" on one line; clear with CR/EL (no newlines).
_dsearch_index_paint_status() {
  local count="$1"
  local hl rst
  hl="$(_dnav_hl)"
  rst="$(_dnav_rst)"
  printf "\r${hl} Indexing...${rst} %s\e[K" "$count"
}

# Poll worker. $1=tui (chip) or cli (plain).
_dsearch_index_finish_wait() {
  local how="${1:-tui}" count
  _dsearch_index_running || return 0
  printf "\e[?25l"
  while _dsearch_index_running; do
    count="$(_dsearch_index_count)"
    if [[ $how == cli ]]; then
      printf "\rIndexing... %s\e[K" "$count"
    else
      _dsearch_index_paint_status "$count"
    fi
    sleep 0.15
  done
  count="$(_dsearch_index_count)"
  if [[ $how == cli ]]; then
    printf "\rIndexing... %s\e[K" "$count"
    sleep 0.05
    printf "\r\e[2K\e[?25h"
  else
    _dsearch_index_paint_status "$count"
    sleep 0.05
    printf "\r\e[2K"
  fi
  _DSEARCH_INDEX_PID=0
  [[ -n $_DSEARCH_INDEX_COUNT_FILE ]] && rm -f -- "$_DSEARCH_INDEX_COUNT_FILE" 2>/dev/null
  [[ -n $_DSEARCH_INDEX_PID_FILE ]] && rm -f -- "$_DSEARCH_INDEX_PID_FILE" 2>/dev/null
  _DSEARCH_INDEX_COUNT_FILE=""
  _DSEARCH_INDEX_PID_FILE=""
  _DSEARCH_INDEX_TMP=""
}

# Wait for a running index. Leaves the cursor line clean. 0 even with an empty fallback.
_dsearch_index_wait_ui() {
  local idx
  idx="$(_dsearch_index_path)"

  _dsearch_index_start_bg

  if ! _dsearch_index_running && [[ -f $idx && -s $idx ]]; then
    _DSEARCH_INDEX_STATE=done
    return 0
  fi

  _dsearch_index_finish_wait tui

  if [[ -f $idx && -s $idx ]]; then
    _DSEARCH_INDEX_STATE=done
    return 0
  fi

  # Fallback so search still opens (empty results better than kick-out)
  mkdir -p "${idx:h}" 2>/dev/null
  if [[ ! -f $idx ]]; then
    : > "$idx"
  fi
  _DSEARCH_INDEX_STATE=failed
  return 0
}

# Start/wait for the index. Always 0 so search can open. Honors index_auto / index_when.
# Walks only when dindexer is installed. index_file is imported (no find).
_dsearch_ensure_index() {
  local idx
  idx="$(_dsearch_index_path)"

  if _dsearch_index_file_resolved >/dev/null; then
    _dsearch_index_apply_file
    _dsearch_ensure_hot
    return 0
  fi

  if ! _dsearch_index_stale "$idx" && ! _dsearch_index_running; then
    _dsearch_ensure_hot
    return 0
  fi

  if ! _dsearch_index_wanted search; then
    _dsearch_ensure_hot
    return 0
  fi

  if ! _dsearch_load_dindexer; then
    _dsearch_ensure_hot
    return 0
  fi

  _dsearch_index_wait_ui
  _dsearch_ensure_hot
  return 0
}

# Rebuild dirs.idx (ignores index_auto / TTL).
_dsearch_reindex() {
  emulate -L zsh
  local idx n src
  case ${1:-} in
    -h|--help)
      print -r -- "Usage: dnav --reindex [--from FILE]"
      print -r -- "Rebuild the directory search index and exit. Does not open the TUI."
      print -r -- ""
      print -r -- "  --from FILE   install FILE (or - for stdin) as the index; no walk"
      print -r -- "Without --from, walks search_roots if dindexer is installed."
      print -r -- "If index_file is set in config, that list is imported instead of walking."
      return 0
      ;;
    --from)
      src="${2:-}"
      [[ -n $src ]] || {
        print -u2 -- "dnav: --from needs a file path (or - for stdin)"
        return 1
      }
      n="$(_dsearch_import_index "$src")" || {
        print -u2 -- "dnav: could not import index from $src"
        return 1
      }
      print -r -- "dnav: indexed ${n:-0} directories  $(_dsearch_index_path)"
      _DSEARCH_INDEX_STATE=done
      return 0
      ;;
  esac

  idx="$(_dsearch_index_path)"
  if _dsearch_index_file_resolved >/dev/null; then
    _dsearch_index_apply_file 1 || {
      print -u2 -- "dnav: could not import index_file"
      return 1
    }
    n=$(wc -l < "$idx" 2>/dev/null | tr -cd '0-9')
    print -r -- "dnav: indexed ${n:-0} directories  $idx"
    _DSEARCH_INDEX_STATE=done
    return 0
  fi
  if ! _dsearch_load_dindexer; then
    print -u2 -- "dnav: no crawler (dindexer not installed); use --from FILE"
    return 1
  fi
  export DNAV_INDEX_FULL=1
  _dsearch_index_start_bg 1 || {
    print -u2 -- "dnav: could not start indexing"
    return 1
  }

  _dsearch_index_finish_wait cli

  if [[ -f $idx && -s $idx ]]; then
    n=$(wc -l < "$idx" 2>/dev/null | tr -cd '0-9')
    print -r -- "dnav: indexed ${n:-0} directories  $idx"
    _DSEARCH_INDEX_STATE=done
    return 0
  fi
  print -u2 -- "dnav: index rebuild failed  $idx"
  _DSEARCH_INDEX_STATE=failed
  return 1
}

