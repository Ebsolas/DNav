#!/usr/bin/env zsh
# dsearch-index — dirs.idx cache (~/.cache/dnav)
# $HOME by default; extra trees via search_roots / DNAV_SEARCH_ROOTS

# Background worker + PID file (avoids "done" job lines on iSH / busybox).
typeset -gi _DSEARCH_INDEX_PID=0
typeset -gi _DSEARCH_INDEX_HAS_SID=0
typeset -g  _DSEARCH_INDEX_COUNT_FILE=""
typeset -g  _DSEARCH_INDEX_PID_FILE=""
typeset -g  _DSEARCH_INDEX_TMP=""
typeset -g  _DSEARCH_INDEX_STATE=idle   # idle|running|done|failed|cancelled

# Index path
_dsearch_index_path() {
  print -r -- "${XDG_CACHE_HOME:-$HOME/.cache}/dnav/dirs.idx"
}

_dsearch_hot_path() {
  print -r -- "${XDG_CACHE_HOME:-$HOME/.cache}/dnav/dirs.hot"
}

_dsearch_index_dir() {
  print -r -- "${XDG_CACHE_HOME:-$HOME/.cache}/dnav"
}

# Shallow subset of $1 (home depth ≤ 2, other paths depth ≤ 2). Writes dirs.hot.
_dsearch_write_hot() {
  emulate -L zsh
  local idx="$1" hot tmp home_p
  [[ -n $idx ]] || idx="$(_dsearch_index_path)"
  hot="$(_dsearch_hot_path)"
  mkdir -p "${hot:h}" 2>/dev/null || return 1
  tmp="${hot}.$$"
  if [[ ! -f $idx || ! -s $idx ]]; then
    : > "$hot"
    return 0
  fi
  home_p="${HOME%/}"
  awk -v home="$home_p" '
    function ncomp(path,   n, segs, i, d) {
      n = split(path, segs, "/")
      d = 0
      for (i = 1; i <= n; i++) if (segs[i] != "") d++
      return d
    }
    {
      if (home != "" && ($0 == home || index($0, home "/") == 1)) {
        if ($0 == home) { print; next }
        if (ncomp(substr($0, length(home) + 2)) <= 2) print
      } else if (ncomp($0) <= 2) print
    }
  ' "$idx" > "$tmp" || { rm -f -- "$tmp"; return 1; }
  mv -f "$tmp" "$hot" 2>/dev/null || { rm -f -- "$tmp"; return 1; }
  return 0
}

# Rebuild dirs.hot when missing or older than dirs.idx.
_dsearch_ensure_hot() {
  emulate -L zsh
  local idx hot im hm
  idx="$(_dsearch_index_path)"
  hot="$(_dsearch_hot_path)"
  [[ -f $idx && -s $idx ]] || return 0
  if [[ -f $hot && -s $hot ]]; then
    im="$(_dsearch_file_mtime "$idx")" || im=0
    hm="$(_dsearch_file_mtime "$hot")" || hm=0
    (( hm >= im && im > 0 )) && return 0
  fi
  _dsearch_write_hot "$idx"
}

# mtime: GNU stat, BSD stat, or python.
_dsearch_file_mtime() {
  local f="$1" m
  m=$(stat -c %Y -- "$f" 2>/dev/null) && { print -rn -- "$m"; return 0; }
  m=$(stat -f %m -- "$f" 2>/dev/null) && { print -rn -- "$m"; return 0; }
  m=$(python3 -c 'import os,sys; print(int(os.path.getmtime(sys.argv[1])))' "$f" 2>/dev/null) && {
    print -rn -- "$m"; return 0
  }
  return 1
}

# Seconds until dirs.idx is stale. 0 = never (missing/empty still stale).
_dsearch_index_ttl_sec() {
  local h="${DNAV_CFG_INDEX_TTL_HOURS:-24}"
  [[ $h == <-> ]] || h=24
  print -rn -- $(( h * 3600 ))
}

# 0 if auto-index should run here (open | search).
_dsearch_index_wanted() {
  local ctx="${1:-open}"
  (( ${DNAV_CFG_INDEX_AUTO:-1} )) || return 1
  local when="${(L)DNAV_CFG_INDEX_WHEN:-open}"
  case $when in
    search|s)
      [[ $ctx == search ]]
      ;;
    *)
      return 0
      ;;
  esac
}

_dsearch_index_stale() {
  local idx="$1" now mtime age ttl
  [[ ! -f $idx || ! -s $idx ]] && return 0
  ttl="$(_dsearch_index_ttl_sec)"
  (( ttl <= 0 )) && return 1
  now=$(date +%s 2>/dev/null) || return 0
  mtime="$(_dsearch_file_mtime "$idx")" || return 0
  age=$(( now - mtime ))
  (( age > ttl ))
}

_dsearch_index_count() {
  local n=0 f="$_DSEARCH_INDEX_COUNT_FILE"
  [[ -z $f || ! -f $f ]] && { print -rn -- 0; return; }
  n=$(tr -cd '0-9' <"$f" 2>/dev/null)
  [[ -n $n ]] || n=0
  print -rn -- "$n"
}

# iSH / similar: light index. A desktop busybox binary is not light mode.
_dsearch_constrained_env() {
  [[ -n ${DNAV_SEARCH_LIGHT:-} ]] && return 0
  [[ -d /var/ish || -d /ish || -e /proc/ish ]] && return 0
  uname -a 2>/dev/null | grep -Eiq 'ish|iphone|ipod|ipad' && return 0
  return 1
}

# 1 if a background index is still running (PID file; never wait).
_dsearch_index_running() {
  local pid=$_DSEARCH_INDEX_PID pf="$_DSEARCH_INDEX_PID_FILE"
  if (( pid <= 0 )) && [[ -n $pf && -f $pf ]]; then
    pid=$(tr -cd '0-9' <"$pf" 2>/dev/null)
    [[ -n $pid ]] && _DSEARCH_INDEX_PID=$pid
  fi
  (( _DSEARCH_INDEX_PID > 0 )) || return 1
  if kill -0 $_DSEARCH_INDEX_PID 2>/dev/null; then
    return 0
  fi
  # Process gone — clear without wait (avoids job-control "done" lines)
  _DSEARCH_INDEX_PID=0
  [[ -n $pf ]] && rm -f -- "$pf" 2>/dev/null
  return 1
}

# 1 if the path is virtual or not useful to navigate.
_dsearch_skip_root() {
  case $1 in
    /proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/run|/run/user/*|/run/systemd/*) return 0 ;;
    /boot|/boot/*|/tmp|/var/tmp|/var/log|/var/cache|/var/lib/docker/*) return 0 ;;
    /snap|/var/lib/snapd/snap) return 0 ;;
    *) return 1 ;;
  esac
}

# Roots to index.
_dsearch_collect_roots() {
  local -a roots
  local -A seen
  local r m

  _dsearch_add_root() {
    local p="$1"
    [[ -n $p && -d $p && -r $p ]] || return
    _dsearch_skip_root "$p" && return
    if (( $+functions[_dnav_logical_path] )); then
      p="$(_dnav_logical_path "$p")"
    else
      p="${p:a}"
    fi
    [[ -n ${seen[$p]:-} ]] && return
    seen[$p]=1
    roots+=("$p")
  }

  if [[ -n ${DNAV_SEARCH_ROOTS:-} ]]; then
    for r in ${=DNAV_SEARCH_ROOTS}; do
      _dsearch_add_root "$r"
    done
    print -l -- "${roots[@]}"
    return 0
  fi

  # Default: $HOME only. Add more with DNAV_SEARCH_ROOTS or search_roots=.
  _dsearch_add_root "$HOME"
  print -l -- "${roots[@]}"
}

# Dirs under $1, prune noisy trees. Extra find flags follow. No -readable.
_dsearch_find_dirs() {
  local root="$1"
  shift
  find "$root" "$@" \
    \( \
      -name .git -o -name node_modules -o -name target -o \
      -name __pycache__ -o -name .npm -o -name .cargo -o \
      -name .cache -o -path '*/.cache/*' -o \
      -path '*/.local/share/Trash' -o -path '*/.local/share/Trash/*' -o \
      -name Trash -o -name .Trash -o -name Caches -o \
      -name .gradle -o -name .m2 -o -name vendor -o \
      -name .tox -o -name .venv -o -name venv -o -name '.Trash-*' \
    \) -prune -o -type d -print 2>/dev/null
}

_dsearch_walk_tree() {
  local r="$1"
  if find "$r" -xdev -maxdepth 0 >/dev/null 2>&1; then
    _dsearch_find_dirs "$r" -xdev
  else
    _dsearch_find_dirs "$r"
  fi
}

_dsearch_meta_path() {
  print -r -- "$(_dsearch_index_dir)/dirs.idx.meta"
}

# Immediate subdirs of $1 as "mtime name", sorted.
_dsearch_top_children() {
  local root="$1" p m
  [[ -d $root ]] || return 0
  find "$root" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null | while IFS= read -r p; do
    [[ -n $p ]] || continue
    m="$(_dsearch_file_mtime "$p")" || m=0
    print -r -- "$m ${p##*/}"
  done | sort
}

_dsearch_meta_children_for() {
  local meta="$1" root="$2"
  [[ -f $meta ]] || return 0
  awk -v root="$root" '
    $1 == "r" {
      inroot = ($0 == "r " root)
      next
    }
    inroot && $1 == "c" { print substr($0, 3) }
  ' "$meta"
}

# Lines from $1 that are $2 or $2/*.
_dsearch_emit_under() {
  local src="$1" prefix="$2"
  [[ -f $src && -n $prefix ]] || return 0
  awk -v p="$prefix" '
    $0 == p || index($0, p "/") == 1 { print }
  ' "$src"
}

_dsearch_index_file_resolved() {
  local f="${DNAV_CFG_INDEX_FILE:-}" p
  [[ -n $f ]] || return 1
  if (( $+functions[_dnav_expand_path] )); then
    p="$(_dnav_expand_path "$f")"
  else
    p="$f"
    [[ $p == '~' ]] && p="$HOME"
    [[ $p == '~/'* ]] && p="$HOME/${p#~/}"
  fi
  print -r -- "$p"
}

# Install a path list as dirs.idx. $1 = file or -. Prints count kept.
_dsearch_import_index() {
  emulate -L zsh
  local src="$1" idx tmp line p n=0
  idx="$(_dsearch_index_path)"
  mkdir -p "${idx:h}" 2>/dev/null || return 1
  tmp="${idx}.import.$$"
  if [[ $src != - ]]; then
    [[ -f $src ]] || return 1
  fi
  {
    if [[ $src == - ]]; then
      cat
    else
      cat -- "$src"
    fi
  } | while IFS= read -r line || [[ -n $line ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z $line || $line == \#* ]] && continue
    if (( $+functions[_dnav_expand_path] )); then
      p="$(_dnav_expand_path "$line")"
    else
      p="$line"
      [[ $p == '~' ]] && p="$HOME"
      [[ $p == '~/'* ]] && p="$HOME/${p#~/}"
    fi
    [[ -d $p ]] || continue
    if (( $+functions[_dnav_logical_path] )); then
      p="$(_dnav_logical_path "$p")"
    fi
    print -r -- "$p"
  done | sort -u > "$tmp" || true
  n=$(wc -l < "$tmp" 2>/dev/null | tr -cd '0-9')
  mv -f "$tmp" "$idx" 2>/dev/null || { rm -f -- "$tmp"; return 1; }
  rm -f -- "$(_dsearch_meta_path)" 2>/dev/null
  _dsearch_write_hot "$idx"
  print -rn -- ${n:-0}
  return 0
}

# Walk into $idx. $2 = running count file. $3 = tmp (default $idx.building).
# DNAV_INDEX_FULL=1 ignores the sidecar and walks every root.
_dsearch_build_index_with_count() {
  local idx="$1" countfile="$2"
  local tmp="${3:-${idx}.building}"
  local meta old="" full=0
  local -a roots
  local r n=0 line first=1 sig oldsig name pause=0

  mkdir -p "${idx:h}" 2>/dev/null || return 1
  roots=("${(@f)$(_dsearch_collect_roots)}")
  (( $#roots )) || roots=("$HOME")
  (( ${DNAV_INDEX_FULL:-0} )) && full=1
  pause=0
  if (( $#roots > 1 )) && ! _dsearch_constrained_env; then
    pause=1
  fi

  print -rn -- 0 > "$countfile"
  : > "$tmp"
  meta="$(_dsearch_meta_path).building"
  print -r -- "v 1" > "$meta"
  [[ -f $idx && -s $idx && full -eq 0 ]] && old="$idx"

  {
    for r in "${roots[@]}"; do
      [[ -d $r ]] || continue
      if (( pause && ! first )); then
        sleep 0.25 2>/dev/null || true
      fi
      first=0
      print -r -- "r $r" >> "$meta"
      sig="$(_dsearch_top_children "$r")"
      typeset -A old_set sig_set
      old_set=()
      sig_set=()
      while IFS= read -r line; do
        [[ -z $line ]] && continue
        sig_set[$line]=1
        print -r -- "c $line" >> "$meta"
      done <<< "$sig"
      oldsig="$(_dsearch_meta_children_for "$(_dsearch_meta_path)" "$r")"
      if (( ! full )) && [[ -n $old && -n $sig && $sig == "$oldsig" ]]; then
        _dsearch_emit_under "$old" "$r"
        continue
      fi
      if (( full )) || [[ -z $old || -z $oldsig ]]; then
        _dsearch_walk_tree "$r"
        continue
      fi
      while IFS= read -r line; do
        [[ -n $line ]] && old_set[$line]=1
      done <<< "$oldsig"
      print -r -- "$r"
      for line in ${(k)old_set}; do
        [[ -n ${sig_set[$line]:-} ]] || continue
        name="${line#* }"
        [[ -n $name ]] || continue
        _dsearch_emit_under "$old" "$r/$name"
      done
      for line in ${(k)sig_set}; do
        [[ -n ${old_set[$line]:-} ]] && continue
        name="${line#* }"
        [[ -n $name && -d $r/$name ]] || continue
        _dsearch_walk_tree "$r/$name"
      done
    done
  } | {
    n=0
    while IFS= read -r line || [[ -n $line ]]; do
      [[ -z $line ]] && continue
      print -r -- "$line"
      (( n++ ))
      if (( n % 10 == 0 )); then
        print -rn -- $n > "$countfile"
      fi
    done
    print -rn -- $n > "$countfile"
  } >> "$tmp"

  if [[ -f $tmp ]]; then
    n=$(wc -l < "$tmp" 2>/dev/null | tr -cd '0-9')
    print -rn -- ${n:-0} > "$countfile"
  fi

  if command -v sort >/dev/null 2>&1; then
    sort -u "$tmp" -o "$tmp" 2>/dev/null || true
  fi

  mv -f "$tmp" "$idx" 2>/dev/null || return 1
  mv -f "$meta" "$(_dsearch_meta_path)" 2>/dev/null || true
  _dsearch_write_hot "$idx"
  return 0
}

# Start a detached reindex if stale. $1=1|--force ignores TTL.
_dsearch_index_lock_dir() {
  print -r -- "$(_dsearch_index_dir)/index.lock"
}

_dsearch_index_unlock() {
  rmdir -- "$(_dsearch_index_lock_dir)" 2>/dev/null || true
}

_dsearch_index_file_due() {
  local src idx sm im
  src="$(_dsearch_index_file_resolved)" || return 1
  [[ -f $src ]] || return 1
  idx="$(_dsearch_index_path)"
  [[ ! -f $idx || ! -s $idx ]] && return 0
  sm="$(_dsearch_file_mtime "$src")" || return 0
  im="$(_dsearch_file_mtime "$idx")" || return 0
  (( sm > im ))
}

_dsearch_index_start_bg() {
  local force=0 idx countfile pidfile lock tmp self="" src="" n
  case ${1:-} in
    1|--force) force=1 ;;
  esac
  idx="$(_dsearch_index_path)"

  if (( _DSEARCH_INDEX_PID > 0 )) && ! kill -0 $_DSEARCH_INDEX_PID 2>/dev/null; then
    _DSEARCH_INDEX_PID=0
  fi

  src="$(_dsearch_index_file_resolved)" || src=""
  if [[ -n $src ]]; then
    if [[ ! -f $src ]]; then
      (( force )) && print -u2 -- "dnav: index_file not found: $src"
      _DSEARCH_INDEX_STATE=done
      return 0
    fi
    if (( force )) || _dsearch_index_file_due || _dsearch_index_stale "$idx"; then
      n="$(_dsearch_import_index "$src")" || {
        _DSEARCH_INDEX_STATE=failed
        return 1
      }
    fi
    _DSEARCH_INDEX_STATE=done
    return 0
  fi

  if (( force )); then
    if _dsearch_index_running; then
      _dsearch_index_cancel
    fi
  else
    if ! _dsearch_index_stale "$idx"; then
      _DSEARCH_INDEX_STATE=done
      return 0
    fi
    if _dsearch_index_running; then
      return 0
    fi
  fi

  mkdir -p "$(_dsearch_index_dir)" 2>/dev/null || return 1
  lock="$(_dsearch_index_lock_dir)"
  if ! mkdir -- "$lock" 2>/dev/null; then
    if _dsearch_index_running; then
      return 0
    fi
    rmdir -- "$lock" 2>/dev/null || true
    mkdir -- "$lock" 2>/dev/null || return 0
  fi

  countfile="$(_dsearch_index_dir)/index.count"
  pidfile="$(_dsearch_index_dir)/index.pid"
  tmp="${idx}.building"
  _DSEARCH_INDEX_COUNT_FILE="$countfile"
  _DSEARCH_INDEX_PID_FILE="$pidfile"
  _DSEARCH_INDEX_TMP="$tmp"
  print -rn -- 0 > "$countfile"
  _DSEARCH_INDEX_STATE=running
  _DSEARCH_INDEX_HAS_SID=0

  if _dsearch_constrained_env; then
    export DNAV_SEARCH_LIGHT=1
  fi
  if (( force )); then
    export DNAV_INDEX_FULL=1
  else
    export DNAV_INDEX_FULL=0
  fi

  if [[ -n ${DNAV_DIR:-} && -f $DNAV_DIR/dsearch-index ]]; then
    self="$DNAV_DIR/dsearch-index"
  elif [[ -n ${(%):-%x} ]]; then
    self="${${(%):-%x}:A}"
  fi
  [[ -f $self ]] || self=""

  # Detached external zsh — not a job of the interactive shell.
  # setsid so cancel can kill that group only (never the interactive shell).
  # nice/ionice so a due rebuild yields to interactive work.
  if [[ -n $self ]]; then
    local body='
      command -v ionice >/dev/null 2>&1 && ionice -c3 -t -p $$ 2>/dev/null || true
      command -v renice >/dev/null 2>&1 && renice -n 19 $$ >/dev/null 2>&1 || true
      emulate -L zsh
      setopt nomonitor nonotify
      source "$1"
      _dsearch_build_index_with_count "$2" "$3" "$4"
      rm -f -- "$5"
      rmdir -- "${2:h}/index.lock" 2>/dev/null || true
    '
    if command -v setsid >/dev/null 2>&1; then
      nohup setsid zsh -fc "$body" dnav-index-worker "$self" "$idx" "$countfile" "$tmp" "$pidfile" \
        </dev/null >/dev/null 2>&1 &!
      _DSEARCH_INDEX_HAS_SID=1
    else
      nohup zsh -fc "$body" dnav-index-worker "$self" "$idx" "$countfile" "$tmp" "$pidfile" \
        </dev/null >/dev/null 2>&1 &!
    fi
    _DSEARCH_INDEX_PID=$!
  else
    setopt localoptions nomonitor nonotify
    (
      command -v ionice >/dev/null 2>&1 && ionice -c3 -t -p $$ 2>/dev/null || true
      command -v renice >/dev/null 2>&1 && renice -n 19 $$ >/dev/null 2>&1 || true
      _dsearch_build_index_with_count "$idx" "$countfile" "$tmp"
      rm -f -- "$pidfile"
      _dsearch_index_unlock
    ) </dev/null >/dev/null 2>&1 &!
    _DSEARCH_INDEX_PID=$!
  fi
  print -rn -- $_DSEARCH_INDEX_PID > "$pidfile"
  return 0
}

# Cancel a background index.
_dsearch_index_cancel() {
  local pid=$_DSEARCH_INDEX_PID pf="$_DSEARCH_INDEX_PID_FILE"
  if (( pid <= 0 )) && [[ -n $pf && -f $pf ]]; then
    pid=$(tr -cd '0-9' <"$pf" 2>/dev/null)
  fi
  if [[ $pid == <-> ]] && (( pid > 1 && pid != $$ )); then
    if (( _DSEARCH_INDEX_HAS_SID )); then
      kill -TERM -- -$pid 2>/dev/null || kill -TERM -- $pid 2>/dev/null || true
    else
      kill -TERM -- $pid 2>/dev/null || true
      pkill -TERM -P $pid 2>/dev/null || true
    fi
  fi
  _DSEARCH_INDEX_PID=0
  _DSEARCH_INDEX_HAS_SID=0
  _DSEARCH_INDEX_STATE=cancelled
  [[ -n $_DSEARCH_INDEX_TMP ]] && rm -f -- "$_DSEARCH_INDEX_TMP" 2>/dev/null
  [[ -n $_DSEARCH_INDEX_COUNT_FILE ]] && rm -f -- "$_DSEARCH_INDEX_COUNT_FILE" 2>/dev/null
  [[ -n $pf ]] && rm -f -- "$pf" 2>/dev/null
  _dsearch_index_unlock
  _DSEARCH_INDEX_COUNT_FILE=""
  _DSEARCH_INDEX_PID_FILE=""
  _DSEARCH_INDEX_TMP=""
}

# "Indexing... N" on one line; clear with CR/EL (no newlines).
_dsearch_index_paint_status() {
  local count="$1"
  local hl rst
  hl="$(_dnav_hl)"
  rst="$(_dnav_rst)"
  printf "\r${hl} Indexing...${rst} %s\e[K" "$count"
}

# Poll worker. $1=tui (chip) or cli (plain).
_dsearch_index_finish_wait() {
  local how="${1:-tui}" count
  _dsearch_index_running || return 0
  printf "\e[?25l"
  while _dsearch_index_running; do
    count="$(_dsearch_index_count)"
    if [[ $how == cli ]]; then
      printf "\rIndexing... %s\e[K" "$count"
    else
      _dsearch_index_paint_status "$count"
    fi
    sleep 0.15
  done
  count="$(_dsearch_index_count)"
  if [[ $how == cli ]]; then
    printf "\rIndexing... %s\e[K" "$count"
    sleep 0.05
    printf "\r\e[2K\e[?25h"
  else
    _dsearch_index_paint_status "$count"
    sleep 0.05
    printf "\r\e[2K"
  fi
  _DSEARCH_INDEX_PID=0
  [[ -n $_DSEARCH_INDEX_COUNT_FILE ]] && rm -f -- "$_DSEARCH_INDEX_COUNT_FILE" 2>/dev/null
  [[ -n $_DSEARCH_INDEX_PID_FILE ]] && rm -f -- "$_DSEARCH_INDEX_PID_FILE" 2>/dev/null
  _DSEARCH_INDEX_COUNT_FILE=""
  _DSEARCH_INDEX_PID_FILE=""
  _DSEARCH_INDEX_TMP=""
}

# Wait for a running index. Leaves the cursor line clean. 0 even with an empty fallback.
_dsearch_index_wait_ui() {
  local idx
  idx="$(_dsearch_index_path)"

  _dsearch_index_start_bg

  if ! _dsearch_index_running && [[ -f $idx && -s $idx ]]; then
    _DSEARCH_INDEX_STATE=done
    return 0
  fi

  _dsearch_index_finish_wait tui

  if [[ -f $idx && -s $idx ]]; then
    _DSEARCH_INDEX_STATE=done
    return 0
  fi

  # Fallback so search still opens (empty results better than kick-out)
  mkdir -p "${idx:h}" 2>/dev/null
  if [[ ! -f $idx ]]; then
    : > "$idx"
  fi
  _DSEARCH_INDEX_STATE=failed
  return 0
}

# Start/wait for the index. Always 0 so search can open. Honors index_auto / index_when.
_dsearch_ensure_index() {
  local idx
  idx="$(_dsearch_index_path)"

  if ! _dsearch_index_stale "$idx" && ! _dsearch_index_running; then
    _dsearch_ensure_hot
    return 0
  fi

  if ! _dsearch_index_wanted search; then
    _dsearch_ensure_hot
    return 0
  fi

  _dsearch_index_wait_ui
  _dsearch_ensure_hot
  return 0
}

# Rebuild dirs.idx (ignores index_auto / TTL).
_dsearch_reindex() {
  emulate -L zsh
  local idx n src
  case ${1:-} in
    -h|--help)
      print -r -- "Usage: dnav --reindex [--from FILE]"
      print -r -- "Rebuild the directory search index and exit. Does not open the TUI."
      print -r -- ""
      print -r -- "  --from FILE   install FILE (or - for stdin) as the index; no walk"
      print -r -- "Without --from, walks search_roots (default: \$HOME) at idle I/O."
      print -r -- "If index_file is set in config, that list is imported instead of walking."
      return 0
      ;;
    --from)
      src="${2:-}"
      [[ -n $src ]] || {
        print -u2 -- "dnav: --from needs a file path (or - for stdin)"
        return 1
      }
      n="$(_dsearch_import_index "$src")" || {
        print -u2 -- "dnav: could not import index from $src"
        return 1
      }
      print -r -- "dnav: indexed ${n:-0} directories  $(_dsearch_index_path)"
      _DSEARCH_INDEX_STATE=done
      return 0
      ;;
  esac

  idx="$(_dsearch_index_path)"
  export DNAV_INDEX_FULL=1
  _dsearch_index_start_bg 1 || {
    print -u2 -- "dnav: could not start indexing"
    return 1
  }

  _dsearch_index_finish_wait cli

  if [[ -f $idx && -s $idx ]]; then
    n=$(wc -l < "$idx" 2>/dev/null | tr -cd '0-9')
    print -r -- "dnav: indexed ${n:-0} directories  $idx"
    _DSEARCH_INDEX_STATE=done
    return 0
  fi
  print -u2 -- "dnav: index rebuild failed  $idx"
  _DSEARCH_INDEX_STATE=failed
  return 1
}

