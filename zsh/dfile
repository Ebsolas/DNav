#!/usr/bin/env zsh
# dfile — mini file explorer for dnav
#
# Layout (browse):
#   [ DNav Files:] [cwd] sib …         ← brand + parent strip (cwd chip fixed, not focusable)
#   [Jump to: cwd] child1 …            ← stay-here chip + dirs (focusable)
#   - Show Hidden ○ -- Dir: Alpha -- File: Ext ---- [perm]
#   (<47 cols: - SH ○ - D: A - F: DE ----)
#   file1 file2 …                      ← files in cwd (focusable)
#
# Keys: hjkl / arrows, Tab/f dirs↔files, . hidden, o/O dir/file order,
#       Enter exit/open, Esc, d Jump, s|/ Search

_dfile_available() { return 0 }

typeset -gi _DFILE_OPEN=0
typeset -ga _dfile_vis
typeset -g  _DFILE_LIST_DENY=""

_dfile_is_open() { (( _DFILE_OPEN )) }

_dfile_hl() { print -rn -- "${DNAV_HIGHLIGHT:-${HIGHLIGHT:-\e[30;46m}}" }
_dfile_rst() { print -rn -- "${DNAV_RESET:-${RESET:-\e[0m}}" }
_dfile_term_cols() {
  local w r c
  if (( $+functions[_dnav_term_cols] )); then
    w="$(_dnav_term_cols)"
  elif read -r r c <<< "$(stty size 2>/dev/null)"; then
    w=$c
  else
    w=${COLUMNS:-80}
  fi
  [[ $w == <-> ]] || w=80
  (( w < 8 )) && w=80
  print -rn -- "$w"
}

_dfile_cols() {
  if (( $+functions[_dnav_usable_cols] )); then
    _dnav_usable_cols
    return
  fi
  local w="$(_dfile_term_cols)"
  (( w > 2 )) && (( w -= 2 ))
  (( w < 8 )) && w=8
  print -rn -- "$w"
}

# 1 when the terminal is narrower than 47 columns (compact status).
_dfile_status_compact() {
  local w="${1:-}"
  [[ $w == <-> ]] || w="$(_dfile_term_cols)"
  (( w < 47 ))
}

# Current-folder name for the Jump to: chip. Keeps the start; cuts the end
# once longer than DNAV_CFG_DFILE_JUMP_NAME_MAX (default 20). $2 overrides max.
_dfile_jump_name() {
  local cwd="${1:-}" name max
  name="${cwd:t}"
  [[ $cwd == / || -z $name ]] && name="/"
  max="${2:-${DNAV_CFG_DFILE_JUMP_NAME_MAX:-20}}"
  [[ $max == <-> ]] || max=20
  (( max < 1 )) && max=1
  emulate -L zsh
  setopt localoptions multibyte
  if (( ${(m)#name} > max )); then
    while (( ${(m)#name} > max && ${#name} > 0 )); do
      name="${name[1,-2]}"
    done
  fi
  print -rn -- "$name"
}

_dfile_jump_label() {
  print -rn -- " Jump to: $(_dfile_jump_name "$1" ${2:-}) "
}

# Short status-bar labels for dfile_sort_dirs / dfile_sort_files.
_dfile_sort_dir_label() {
  case ${1:-${_DFILE_SORT_DIRS:-${DNAV_CFG_DFILE_SORT_DIRS:-alpha}}} in
    hidden_first|hidden|dot_first) print -rn -- Dot ;;
    *) print -rn -- Alpha ;;
  esac
}

_dfile_sort_file_label() {
  case ${1:-${_DFILE_SORT_FILES:-${DNAV_CFG_DFILE_SORT_FILES:-alpha}}} in
    ext|extension) print -rn -- Ext ;;
    dot_first|hidden_first|dot) print -rn -- Dot ;;
    dot_ext|dot_extension|hidden_ext) print -rn -- Dot/Ext ;;
    *) print -rn -- Alpha ;;
  esac
}

# Compact status tokens: D: A|D   F: A|D|E|DE
_dfile_sort_dir_short() {
  case ${1:-${_DFILE_SORT_DIRS:-${DNAV_CFG_DFILE_SORT_DIRS:-alpha}}} in
    hidden_first|hidden|dot_first) print -rn -- D ;;
    *) print -rn -- A ;;
  esac
}

_dfile_sort_file_short() {
  case ${1:-${_DFILE_SORT_FILES:-${DNAV_CFG_DFILE_SORT_FILES:-alpha}}} in
    ext|extension) print -rn -- E ;;
    dot_first|hidden_first|dot) print -rn -- D ;;
    dot_ext|dot_extension|hidden_ext) print -rn -- DE ;;
    *) print -rn -- A ;;
  esac
}

_dfile_cycle_dir_sort() {
  case ${_DFILE_SORT_DIRS:-${DNAV_CFG_DFILE_SORT_DIRS:-alpha}} in
    alpha) _DFILE_SORT_DIRS=hidden_first ;;
    *)     _DFILE_SORT_DIRS=alpha ;;
  esac
}

_dfile_cycle_file_sort() {
  case ${_DFILE_SORT_FILES:-${DNAV_CFG_DFILE_SORT_FILES:-alpha}} in
    alpha)     _DFILE_SORT_FILES=ext ;;
    ext)       _DFILE_SORT_FILES=dot_first ;;
    dot_first) _DFILE_SORT_FILES=dot_ext ;;
    *)         _DFILE_SORT_FILES=alpha ;;
  esac
}

# Cell width / window / strip live in the dnav engine.
_dfile_cell_w() { _dnav_cell_w "$@"; }

# 1 if path is a dir we cannot enter/list (need r+x).
_dfile_dir_locked() {
  local d="$1"
  [[ -d $d ]] || return 0
  [[ -r $d && -x $d ]] && return 1
  return 0
}

# List basenames. kind=dirs|files. Returns 1 if unreadable; sets _DFILE_LIST_DENY.
# For dirs, also sets _DFILE_LIST_LOCKS (parallel 0/1 array).
typeset -ga _DFILE_LIST_LOCKS
_dfile_list() {
  local dir="$1" kind="$2" show_hidden="$3"
  local -a raw names locks
  local e b
  names=()
  locks=()
  _DFILE_LIST_DENY=""
  _DFILE_LIST_LOCKS=()
  if [[ ! -d $dir ]]; then
    return 1
  fi
  if [[ ! -r $dir ]]; then
    _DFILE_LIST_DENY="$dir"
    return 1
  fi
  setopt localoptions nullglob

  if [[ $kind == dirs ]]; then
    if (( show_hidden )); then
      raw=("$dir"/*(-/) "$dir"/.*(-/))
    else
      raw=("$dir"/*(-/))
    fi
  else
    if (( show_hidden )); then
      raw=("$dir"/*(-.) "$dir"/.*(-.))
    else
      raw=("$dir"/*(-.))
    fi
  fi

  for e in "$raw[@]"; do
    b="${e:t}"
    [[ $b == . || $b == .. ]] && continue
    names+=("$b")
    if [[ $kind == dirs ]] && _dfile_dir_locked "$e"; then
      locks+=(1)
    else
      locks+=(0)
    fi
  done
  if (( $#names )); then
    local -a pairs sorted_names sorted_locks
    local i key ext dot rec
    local dmode="${_DFILE_SORT_DIRS:-${DNAV_CFG_DFILE_SORT_DIRS:-alpha}}"
    local fmode="${_DFILE_SORT_FILES:-${DNAV_CFG_DFILE_SORT_FILES:-alpha}}"
    local sep=$'\x1e'
    pairs=()
    for (( i=1; i <= $#names; i++ )); do
      b="${names[i]}"
      [[ $b == .* ]] && dot=0 || dot=1
      ext="${(L)b:e}"
      if [[ $kind == dirs ]]; then
        case $dmode in
          hidden_first) key="${dot}${sep}${(L)b}" ;;
          *)            key="${(L)b}" ;;
        esac
      else
        case $fmode in
          ext)       key="${ext}${sep}${(L)b}" ;;
          dot_first) key="${dot}${sep}${(L)b}" ;;
          dot_ext)   key="${dot}${sep}${ext}${sep}${(L)b}" ;;
          *)         key="${(L)b}" ;;
        esac
      fi
      pairs+=("${key}${sep}${sep}${b}${sep}${locks[i]}")
    done
    pairs=("${(@o)pairs}")
    sorted_names=(); sorted_locks=()
    for rec in "${pairs[@]}"; do
      sorted_locks+=("${rec##*${sep}}")
      rec="${rec%${sep}*}"
      sorted_names+=("${rec##*${sep}${sep}}")
    done
    names=("${sorted_names[@]}")
    if [[ $kind == dirs ]]; then
      locks=("${sorted_locks[@]}")
    else
      locks=()
    fi
  fi
  _DFILE_LIST_LOCKS=("${locks[@]}")
  print -l -- "${names[@]}"
  return 0
}

_dfile_window() { _dnav_window "$@"; }
_dfile_paint_strip() { _dnav_paint_strip "$@"; }

typeset -gi _DFILE_SHOW_HIDDEN=0
typeset -g  _DFILE_SORT_DIRS=alpha
typeset -g  _DFILE_SORT_FILES=alpha
typeset -g  _DFILE_FOCUS=children
typeset -g  _DFILE_MODE=browse
typeset -g  _DFILE_JUMP_BUF=""
typeset -ga _DFILE_SIBLINGS _DFILE_CHILDREN _DFILE_FILES _DFILE_CHILD_ROW
typeset -ga _DFILE_SIBLINGS_LOCK _DFILE_CHILDREN_LOCK _DFILE_CHILD_ROW_LOCK
typeset -gi _DFILE_SEL_S=0 _DFILE_SEL_C=0 _DFILE_SEL_F=0
typeset -gi _DFILE_WIN_S=0 _DFILE_WIN_C=0 _DFILE_WIN_F=0
typeset -gi _DFILE_BODY=0
typeset -g  _DFILE_CWD="" _DFILE_PARENT=""
typeset -g  _DFILE_PERM_DENIED=""
typeset -g  _DFILE_ORIGIN=""

_dfile_session_reset() {
  local start="${1:-}"
  _DFILE_SHOW_HIDDEN=${DNAV_CFG_SHOW_HIDDEN:-0}
  (( _DFILE_SHOW_HIDDEN = _DFILE_SHOW_HIDDEN ? 1 : 0 ))
  _DFILE_SORT_DIRS="${DNAV_CFG_DFILE_SORT_DIRS:-alpha}"
  _DFILE_SORT_FILES="${DNAV_CFG_DFILE_SORT_FILES:-alpha}"
  _DFILE_FOCUS=children
  _DFILE_MODE=browse
  _DFILE_JUMP_BUF=""
  _DFILE_SIBLINGS=()
  _DFILE_CHILDREN=()
  _DFILE_FILES=()
  _DFILE_CHILD_ROW=()
  _DFILE_SIBLINGS_LOCK=()
  _DFILE_CHILDREN_LOCK=()
  _DFILE_CHILD_ROW_LOCK=()
  _DFILE_SEL_S=0
  _DFILE_SEL_C=0
  _DFILE_SEL_F=0
  _DFILE_WIN_S=0
  _DFILE_WIN_C=0
  _DFILE_WIN_F=0
  _DFILE_BODY=0
  _DFILE_PERM_DENIED=""
  _DFILE_OPEN=1
  if [[ -n $start && -d $start ]]; then
    cd -- "$start" 2>/dev/null || true
  fi
  _DFILE_ORIGIN="${PWD:a}"
}

_dfile_cancel_restore() {
  [[ -n ${_DFILE_ORIGIN:-} && -d $_DFILE_ORIGIN ]] && cd -- "$_DFILE_ORIGIN" 2>/dev/null || true
  _DFILE_OPEN=0
}

_dfile_refresh() {
  local out rc
  _DFILE_CWD="${PWD:a}"
  _DFILE_PARENT="${_DFILE_CWD:h}"
  [[ -z $_DFILE_PARENT ]] && _DFILE_PARENT="/"
  _DFILE_PERM_DENIED=""

  _DFILE_SIBLINGS=()
  _DFILE_CHILDREN=()
  _DFILE_FILES=()
  _DFILE_SIBLINGS_LOCK=()
  _DFILE_CHILDREN_LOCK=()

  # At filesystem root there is no _DFILE_PARENT strip of _DFILE_SIBLINGS — only show "/"
  if [[ $_DFILE_CWD == / ]]; then
    _DFILE_SIBLINGS=("/")
    _DFILE_SIBLINGS_LOCK=(0)
    _DFILE_SEL_S=0
    _DFILE_WIN_S=0
    _DFILE_PARENT="/"
  else
    out="$(_dfile_list "$_DFILE_PARENT" dirs $_DFILE_SHOW_HIDDEN 2>/dev/null)"
    rc=$?
    if (( rc != 0 )); then
      [[ -n $_DFILE_LIST_DENY ]] && _DFILE_PERM_DENIED="$_DFILE_LIST_DENY"
      _DFILE_SIBLINGS=()
      _DFILE_SIBLINGS_LOCK=()
    else
      [[ -n $out ]] && _DFILE_SIBLINGS=("${(@f)out}") || _DFILE_SIBLINGS=()
      _DFILE_SIBLINGS_LOCK=("${_DFILE_LIST_LOCKS[@]}")
    fi
    # Highlight current directory name among _DFILE_SIBLINGS
    local base="${_DFILE_CWD:t}" i
    _DFILE_SEL_S=0
    for (( i=1; i <= $#_DFILE_SIBLINGS; i++ )); do
      if [[ ${_DFILE_SIBLINGS[i]} == $base ]]; then
        _DFILE_SEL_S=$(( i - 1 ))
        break
      fi
    done
  fi

  out="$(_dfile_list "$_DFILE_CWD" dirs $_DFILE_SHOW_HIDDEN 2>/dev/null)"
  rc=$?
  if (( rc != 0 )); then
    [[ -n $_DFILE_LIST_DENY ]] && _DFILE_PERM_DENIED="$_DFILE_LIST_DENY"
    _DFILE_CHILDREN=()
    _DFILE_CHILDREN_LOCK=()
  else
    [[ -n $out ]] && _DFILE_CHILDREN=("${(@f)out}") || _DFILE_CHILDREN=()
    _DFILE_CHILDREN_LOCK=("${_DFILE_LIST_LOCKS[@]}")
  fi

  out="$(_dfile_list "$_DFILE_CWD" files $_DFILE_SHOW_HIDDEN 2>/dev/null)"
  rc=$?
  if (( rc != 0 )); then
    [[ -n $_DFILE_LIST_DENY ]] && _DFILE_PERM_DENIED="$_DFILE_LIST_DENY"
    _DFILE_FILES=()
  else
    [[ -n $out ]] && _DFILE_FILES=("${(@f)out}") || _DFILE_FILES=()
  fi

  (( _DFILE_SEL_C < 0 )) && _DFILE_SEL_C=0
  (( $#_DFILE_FILES == 0 )) && _DFILE_SEL_F=0
  # _DFILE_SEL_C 0 = Jump to: chip; 1..$#_DFILE_CHILDREN = _DFILE_CHILDREN[_DFILE_SEL_C]
  (( _DFILE_SEL_C > $#_DFILE_CHILDREN )) && _DFILE_SEL_C=$#_DFILE_CHILDREN
  (( _DFILE_SEL_F >= $#_DFILE_FILES && $#_DFILE_FILES > 0 )) && _DFILE_SEL_F=$(( $#_DFILE_FILES - 1 ))
  _DFILE_CHILD_ROW=("Jump to: $(_dfile_jump_name "$_DFILE_CWD")")
  _DFILE_CHILD_ROW_LOCK=(0)
  if (( $#_DFILE_CHILDREN )); then
    _DFILE_CHILD_ROW+=("${_DFILE_CHILDREN[@]}")
    _DFILE_CHILD_ROW_LOCK+=("${_DFILE_CHILDREN_LOCK[@]}")
  fi
  _dfile_fix_focus
}

# Focus rules:
# - Stay on _DFILE_CHILDREN even when empty (shows "Jump to: name" if _DFILE_FILES-only dir)
# - Only bounce _DFILE_FILES → _DFILE_CHILDREN when _DFILE_FILES row is empty
_dfile_fix_focus() {
  if [[ $_DFILE_FOCUS == files ]]; then
    if (( $#_DFILE_FILES == 0 )); then
      _DFILE_FOCUS=children
    fi
  elif [[ $_DFILE_FOCUS != children ]]; then
    _DFILE_FOCUS=children
  fi
}

_dfile_paint_status() {
  local w="$1" hid_mark left right fill vis
  local dir_lbl file_lbl raw
  if (( _DFILE_SHOW_HIDDEN )); then hid_mark="●"; else hid_mark="○"; fi
  raw="$(_dfile_term_cols)"
  if _dfile_status_compact $raw; then
    dir_lbl="$(_dfile_sort_dir_short)"
    file_lbl="$(_dfile_sort_file_short)"
    left="- SH ${hid_mark} - D: ${dir_lbl} - F: ${file_lbl} "
  else
    dir_lbl="$(_dfile_sort_dir_label)"
    file_lbl="$(_dfile_sort_file_label)"
    left="- Show Hidden ${hid_mark} -- Dir: ${dir_lbl} -- File: ${file_lbl} "
  fi
  vis=${#left}
  printf "\r%s" "$left"
  if [[ -n $_DFILE_PERM_DENIED ]]; then
    right=" Permission Denied: ${_DFILE_PERM_DENIED} "
    if (( vis + ${#right} > w )); then
      local room=$(( w - vis - 5 ))
      (( room < 8 )) && room=8
      right=" …${right:$(( ${#right} - room ))} "
    fi
  else
    right=""
  fi
  fill=$(( w - vis - ${#right} ))
  (( fill < 0 )) && fill=0
  printf '%*s' $fill '' | tr ' ' '-'
  printf "%s\e[K" "$right"
}

# Paint one browse strip at the current cursor line (no leading NL).
# which: _DFILE_SIBLINGS | _DFILE_CHILDREN | _DFILE_FILES | status
_dfile_paint_line() {
  local which="$1"
  local maxw brand brand_w rest_w active=0 hl rst
  maxw="$(_dfile_cols)"
  hl="$(_dfile_hl)"
  rst="$(_dfile_rst)"
  case $which in
    siblings)
      # Brand chip always cyan; current dir among _DFILE_PARENT _DFILE_SIBLINGS (or "/" at root).
      brand=" DNav Files:"
      printf "\r${hl}%s${rst} " "$brand"
      brand_w=$(( ${#brand} + 1 ))
      rest_w=$(( maxw - brand_w ))
      (( rest_w < 8 )) && rest_w=8
      if (( $#_DFILE_SIBLINGS == 0 )); then
        # No _DFILE_PARENT context — leave the rest of the top row blank
        printf "\e[K"
        _DFILE_WIN_S=0
      else
        # active=1 always: highlight _DFILE_SEL_S (_DFILE_CWD chip, or "/" at root)
        _dfile_paint_strip _DFILE_SIBLINGS $_DFILE_SEL_S $_DFILE_WIN_S 1 $rest_w _DFILE_SIBLINGS_LOCK
        _DFILE_WIN_S=$reply[1]
      fi
      ;;
    children)
      # Jump to: is _DFILE_CHILD_ROW[1] — same strip/window as the folders.
      printf "\r"
      [[ $_DFILE_FOCUS == children ]] && active=1
      _dfile_paint_strip _DFILE_CHILD_ROW $_DFILE_SEL_C $_DFILE_WIN_C $active $maxw _DFILE_CHILD_ROW_LOCK 1
      _DFILE_WIN_C=$reply[1]
      ;;
    status)
      _dfile_paint_status $maxw
      ;;
    files)
      [[ $_DFILE_FOCUS == files ]] && active=1
      printf "\r"
      _dfile_paint_strip _DFILE_FILES $_DFILE_SEL_F $_DFILE_WIN_F $active $maxw
      _DFILE_WIN_F=$reply[1]
      ;;
  esac
}

# Row index below top for a browse strip (_DFILE_SIBLINGS=0 … _DFILE_FILES=3).
_dfile_row_of() {
  case $1 in
    siblings) print -rn -- 0 ;;
    children) print -rn -- 1 ;;
    status)   print -rn -- 2 ;;
    files)    print -rn -- 3 ;;
    *)        print -rn -- 0 ;;
  esac
}

# Repaint one browse row in place (no full wipe — avoids selection flicker).
# Cursor starts and ends on top row. Only valid when browse layout is up (_DFILE_BODY==3).
_dfile_repaint_row() {
  local which="$1" row
  [[ $_DFILE_MODE == browse && $_DFILE_BODY -eq 3 ]] || { _dfile_draw; return }
  row="$(_dfile_row_of "$which")"
  printf "\e[?25l"
  if (( row > 0 )); then
    printf "\e[%dB" $row
  fi
  _dfile_paint_line "$which"
  if (( row > 0 )); then
    printf "\e[%dA" $row
  fi
  printf "\r"
}

# Full redraw. Paint over existing cells (no \e[2K wipe-first — that flickers).
# Cursor starts and ends on top row (_DFILE_BODY invariant).
_dfile_draw() {
  local old_body=$_DFILE_BODY leftover i n maxw hl rst
  maxw="$(_dfile_cols)"
  hl="$(_dfile_hl)"
  rst="$(_dfile_rst)"
  printf "\e[?25l"

  if [[ $_DFILE_MODE == jump ]]; then
    # Chip is only the label; query sits outside highlight: [ DNav Jump:] dfoo
    printf "\r${hl} DNav Jump:${rst} %s\e[K" "$_DFILE_JUMP_BUF"
    local -a hits
    local k
    hits=()
    n=0
    if _djump_available 2>/dev/null; then
      hits=("${(@f)$(_djump_match_query "$_DFILE_JUMP_BUF")}")
    fi
    for k in "${hits[@]:0:6}"; do
      printf "\n\r\e[2m  d%s → %s${rst}\e[K" "$k" \
        "$(_djump_resolve "$k" 2>/dev/null || true)"
      (( n++ ))
    done
    leftover=$(( old_body - n ))
    if (( !_DNAV_RESIZING )); then
      for (( i=0; i < leftover; i++ )); do
        printf "\n\r\e[2K"
      done
      if (( leftover > 0 )); then
        printf "\e[%dA" $leftover
      fi
    fi
    _DFILE_BODY=$n
    printf "\e[J"
    if (( _DFILE_BODY > 0 )); then
      printf "\e[%dA" $_DFILE_BODY
    fi
    printf "\r"
    return
  fi

  # ── Browse: overwrite 4 lines in place ────────────────────────────
  _dfile_paint_line siblings
  printf "\n"
  _dfile_paint_line children
  printf "\n"
  _dfile_paint_line status
  printf "\n"
  _dfile_paint_line files

  # Blank leftover lines when shrinking from jump (or taller) layout
  leftover=$(( old_body - 3 ))
  if (( !_DNAV_RESIZING )); then
    for (( i=0; i < leftover; i++ )); do
      printf "\n\r\e[2K"
    done
    if (( leftover > 0 )); then
      printf "\e[%dA" $leftover
    fi
  fi

  _DFILE_BODY=3
  printf "\e[J"
  # Park cursor on top row for the next draw/erase/partial paint.
  printf "\e[3A\r"
}

# Wipe the explorer UI. Cursor starts on top row (_DFILE_BODY invariant).
_dfile_erase() {
  local i
  printf "\r\e[2K"
  for (( i=0; i < _DFILE_BODY; i++ )); do
    printf "\n\r\e[2K"
  done
  (( _DFILE_BODY > 0 )) && printf "\e[%dA" $_DFILE_BODY
  printf "\r\e[2K"
  _DFILE_BODY=0
}

_dfile_go() {
  local dest="$1"
  if [[ ! -d $dest ]]; then
    return 1
  fi
  if ! cd -- "$dest" 2>/dev/null; then
    _DFILE_PERM_DENIED="$dest"
    _dfile_draw
    return 1
  fi
  _dfile_refresh
  _DFILE_WIN_C=0; _DFILE_WIN_F=0; _DFILE_SEL_C=0; _DFILE_SEL_F=0
  # Land on the first real child so j/↓ can keep drilling; h selects Jump to:.
  (( $#_DFILE_CHILDREN > 0 )) && _DFILE_SEL_C=1
  _dfile_draw
}

# Resolve selected directory under _DFILE_CHILDREN _DFILE_FOCUS.
# Sets reply=(dest). Returns 1 if nothing selected / not on dirs row.
# _DFILE_SEL_C == 0 is the Jump to: chip — dest is _DFILE_CWD itself.
_dfile_sel_dir_path() {
  local name dest
  [[ $_DFILE_FOCUS == children ]] || return 1
  if (( _DFILE_SEL_C == 0 )); then
    reply=("$_DFILE_CWD")
    return 0
  fi
  name="${_DFILE_CHILDREN[_DFILE_SEL_C]}"
  dest="$_DFILE_CWD/$name"
  reply=("$dest")
}

# Tab / f: toggle _DFILE_FOCUS between directories (_DFILE_CHILDREN) and _DFILE_FILES.
# Children row always available (Jump to: when no subdirs). Files only if non-empty.
_dfile_toggle_focus() {
  local prev=$_DFILE_FOCUS
  if [[ $_DFILE_FOCUS == files ]]; then
    _DFILE_FOCUS=children
  else
    (( $#_DFILE_FILES > 0 )) || return
    _DFILE_FOCUS=files
  fi
  [[ $_DFILE_FOCUS == $prev ]] && return
  _dfile_repaint_row "$prev"
  _dfile_repaint_row "$_DFILE_FOCUS"
}

# Drill into a directory inside the explorer (j / ↓). Stays in dfile.
# On Jump to: chip, j does nothing (use Enter to leave at this folder).
_dfile_enter_sel_dir() {
  [[ $_DFILE_FOCUS == children ]] || return 1
  (( _DFILE_SEL_C == 0 )) && return 1
  _dfile_sel_dir_path || return 1
  # Don't drill into locked dirs — surface permission line
  local dest="$reply[1]"
  if _dfile_dir_locked "$dest"; then
    _DFILE_PERM_DENIED="$dest"
    _dfile_draw
    return 1
  fi
  _dfile_go "$dest"
}

# Leave dfile: cd to dest, show location bar, restore tty (optional ls).
_dfile_exit_to() {
  local dest="$1"
  _dfile_erase
  _DFILE_OPEN=0
  if [[ ! -d $dest ]] || ! cd -- "$dest" 2>/dev/null; then
    printf "Could not change to %s\n" "$dest"
    if (( $+functions[_dnav_cleanup] )); then
      _dnav_cleanup
    else
      printf "\e[?25h"
    fi
    return 0
  fi
  if (( $+functions[_dnav_finish] )); then
    _dnav_finish "${dest:a}" dnav
  else
    print -r -- "${dest:a}"
    printf "\e[?25h"
  fi
  return 0
}

# Enter on a directory row: leave explorer at that folder + location bar.
# Jump to: chip (_DFILE_SEL_C == 0) leaves at the current folder.
_dfile_exit_sel_dir() {
  if [[ $_DFILE_FOCUS == children && _DFILE_SEL_C -eq 0 ]]; then
    _dfile_exit_to "$_DFILE_CWD"
    return $?
  fi
  _dfile_sel_dir_path || return 1
  local dest="$reply[1]"
  if _dfile_dir_locked "$dest"; then
    _DFILE_PERM_DENIED="$dest"
    _dfile_draw
    return 1
  fi
  _dfile_exit_to "$dest"
}

# Open selected file: location bar, restore tty, then editor/xdg-open.
_dfile_open_file() {
  (( $#_DFILE_FILES )) || return 1
  local fpath="$_DFILE_CWD/${_DFILE_FILES[_DFILE_SEL_F+1]}"
  [[ -e $fpath ]] || return 1
  _dfile_erase
  _DFILE_OPEN=0
  if (( $+functions[_dnav_finish] )); then
    _dnav_finish "${fpath:a}" dnav
  else
    print -r -- "${fpath:a}"
    printf "\e[?25h"
  fi
  if [[ -n ${EDITOR:-} ]]; then
    ${=EDITOR} -- "$fpath"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$fpath" >/dev/null 2>&1 &
  else
    printf "No EDITOR/xdg-open for %s\n" "$fpath"
  fi
  return 0
}

_dfile_scroll_to_sel() {
  local aname="$1" sel="$2" win="$3" dir="$4"
  local n maxw="${5:-$(_dfile_cols)}" sticky="${6:-0}" vc
  local -a all
  all=("${(@P)aname}")
  n=$#all
  (( n == 0 )) && { reply=(0); return }
  # Match paint_strip: room for optional < > overflow markers
  (( maxw > 12 )) && (( maxw -= 4 ))
  if (( sticky )); then
    _dfile_window "$aname" $sel 0 $maxw "" 1
    if (( sel < $#_dfile_vis )); then
      reply=(0)
      return
    fi
  fi
  _dfile_window "$aname" $sel $win $maxw "" $sticky
  win=$reply[1]
  vc=$#_dfile_vis
  if (( dir > 0 && sel < n - 1 && vc >= 2 )); then
    win=$(( sel - (vc - 2) ))
    (( win < 0 )) && win=0
  elif (( dir < 0 && sel > 0 && vc >= 2 )); then
    if (( sel - win == 0 )); then
      win=$(( sel - 1 ))
      (( win < 0 )) && win=0
    fi
  fi
  _dfile_window "$aname" $sel $win $maxw "" $sticky
  reply=($reply[1])
}

_dfile_move_h() {
  local dir="$1" n
  # Parent strip is not interactive — only _DFILE_CHILDREN / _DFILE_FILES.
  case $_DFILE_FOCUS in
    children)
      n=$#_DFILE_CHILD_ROW; (( n == 0 )) && return
      (( _DFILE_SEL_C += dir ))
      (( _DFILE_SEL_C < 0 )) && _DFILE_SEL_C=0
      (( _DFILE_SEL_C >= n )) && _DFILE_SEL_C=$(( n - 1 ))
      _dfile_scroll_to_sel _DFILE_CHILD_ROW $_DFILE_SEL_C $_DFILE_WIN_C $dir "" 1
      _DFILE_WIN_C=$reply[1]
      ;;
    files)
      n=$#_DFILE_FILES; (( n == 0 )) && return
      (( _DFILE_SEL_F += dir ))
      (( _DFILE_SEL_F < 0 )) && _DFILE_SEL_F=0
      (( _DFILE_SEL_F >= n )) && _DFILE_SEL_F=$(( n - 1 ))
      _dfile_scroll_to_sel _DFILE_FILES $_DFILE_SEL_F $_DFILE_WIN_F $dir
      _DFILE_WIN_F=$reply[1]
      ;;
    *) return ;;
  esac
  # Only the focused strip changes — no full-frame wipe
  _dfile_repaint_row "$_DFILE_FOCUS"
}

_dfile_enter() {
  local key dest
  _dfile_session_reset "${1:-}"

  if (( $+functions[_dsearch_index_running] )) && _dsearch_index_running; then
    printf "\r\e[2K\e[?25l"
    (( $+functions[_dsearch_ensure_index] )) && _dsearch_ensure_index
    printf "\r\e[2K"
  fi

  _dfile_refresh
  (( $#_DFILE_CHILDREN > 0 )) && _DFILE_SEL_C=1
  _DFILE_BODY=0
  _dfile_draw

  while true; do
    if (( $+functions[_dnav_aborted] )) && _dnav_aborted; then
      _dfile_cancel_restore
      return 130
    fi
    if (( $+functions[_dnav_read_token] )); then
      _dnav_read_token || true
      key="$REPLY"
    else
      read -k 1 key || true
    fi
    if (( $+functions[_dnav_aborted] )) && _dnav_aborted; then
      _dfile_cancel_restore
      return 130
    fi
    if [[ $key == ctrl-c || $key == $'\x03' ]]; then
      _dfile_cancel_restore
      if (( $+functions[_dnav_abort] )); then
        _dnav_abort
      else
        _dfile_erase
        DNAV_ABORT=1
      fi
      return 130
    fi

    if [[ $_DFILE_MODE == jump ]]; then
      case $key in
        esc)
          _DFILE_MODE=browse
          _DFILE_JUMP_BUF=""
          _dfile_draw
          ;;
        enter)
          if _djump_available 2>/dev/null; then
            dest="$(_djump_resolve "$_DFILE_JUMP_BUF" 2>/dev/null)" || dest=""
            if [[ -z $dest && $_DFILE_JUMP_BUF != d* ]]; then
              dest="$(_djump_resolve "d$_DFILE_JUMP_BUF" 2>/dev/null)" || dest=""
            fi
            if [[ -n $dest ]]; then
              _DFILE_MODE=browse
              _DFILE_JUMP_BUF=""
              if [[ -d $dest ]]; then
                _dfile_go "$dest"
              else
                _DFILE_PERM_DENIED="$dest"
                _dfile_draw
              fi
            fi
          fi
          ;;
        backspace)
          (( ${#_DFILE_JUMP_BUF} > 0 )) && _DFILE_JUMP_BUF="${_DFILE_JUMP_BUF[1,-2]}"
          _dfile_draw
          ;;
        [[:print:]])
          _DFILE_JUMP_BUF+="$key"
          _dfile_draw
          ;;
      esac
      continue
    fi

    case $key in
      esc)
        _dfile_cancel_restore
        _dfile_erase
        return 1
        ;;
      up) [[ $_DFILE_CWD != / ]] && _dfile_go "${_DFILE_CWD:h}" ;;
      down) _dfile_enter_sel_dir ;;
      left|h) _dfile_move_h -1 ;;
      right|l) _dfile_move_h 1 ;;
      k) [[ $_DFILE_CWD != / ]] && _dfile_go "${_DFILE_CWD:h}" ;;
      j) _dfile_enter_sel_dir ;;
      f|F|tab)
        _dfile_toggle_focus
        ;;
      .)
        _DFILE_SHOW_HIDDEN=$(( 1 - _DFILE_SHOW_HIDDEN ))
        _dfile_refresh
        _dfile_draw
        ;;
      o)
        _dfile_cycle_dir_sort
        _dfile_refresh
        _dfile_draw
        ;;
      O)
        _dfile_cycle_file_sort
        _dfile_refresh
        _dfile_draw
        ;;
      d)
        if _djump_available 2>/dev/null; then
          _DFILE_MODE=jump
          _DFILE_JUMP_BUF="d"
          _dfile_draw
        fi
        ;;
      s|/)
        if _dsearch_available 2>/dev/null; then
          _dfile_erase
          _DFILE_BODY=0
          local spath
          if _dsearch_start_for_dfile; then
            spath="${DNAV_SEARCH_RESULT:-}"
            if [[ -n $spath && -d $spath ]]; then
              cd -- "$spath" 2>/dev/null || true
              _dfile_refresh
            fi
          fi
          if (( $+functions[_dnav_aborted] )) && _dnav_aborted; then
            _DFILE_OPEN=0
            return 130
          fi
          _DFILE_BODY=0
          _dfile_draw
        fi
        ;;
      enter)
        if [[ $_DFILE_FOCUS == files ]]; then
          if _dfile_open_file; then
            return 0
          fi
        else
          if _dfile_exit_sel_dir; then
            return 0
          fi
        fi
        ;;
    esac
  done
}

