#!/usr/bin/env zsh
# dfile — mini file explorer for dnav
#
# Layout (browse):
#   [ DNav Files:] [cwd] sib …         ← brand + parent strip (cwd chip fixed, not focusable)
#   [Jump to: cwd] child1 …            ← stay-here chip + dirs (focusable)
#   - Show Hidden ○ ----…---- [perm]   ← status / permission line
#   file1 file2 …                      ← files in cwd (focusable)
#
# Keys: hjkl / arrows, Tab/f toggle dirs↔files, . hidden, Enter exit/open, Esc, d Jump, s|/ Search

_dfile_available() { return 0 }

typeset -gi _DFILE_OPEN=0
typeset -ga _dfile_vis
typeset -g  _DFILE_LIST_DENY=""

_dfile_is_open() { (( _DFILE_OPEN )) }

_dfile_hl() { print -rn -- "${DNAV_HIGHLIGHT:-${HIGHLIGHT:-\e[30;46m}}" }
_dfile_rst() { print -rn -- "${DNAV_RESET:-${RESET:-\e[0m}}" }
_dfile_cols() {
  local w=${COLUMNS:-80}
  [[ $w == <-> ]] || w=80
  (( w < 8 )) && w=80
  # Never write the last column — that wraps and each dfile move adds a line.
  (( w > 1 )) && (( w-- ))
  print -rn -- "$w"
}

# Current-folder name for the Jump to: chip. Keeps the start; cuts the end
# once longer than DNAV_CFG_DFILE_JUMP_NAME_MAX (default 20). $2 overrides max.
_dfile_jump_name() {
  local cwd="${1:-}" name max
  name="${cwd:t}"
  [[ $cwd == / || -z $name ]] && name="/"
  max="${2:-${DNAV_CFG_DFILE_JUMP_NAME_MAX:-20}}"
  [[ $max == <-> ]] || max=20
  (( max < 1 )) && max=1
  if (( ${#name} > max )); then
    name="${name[1,max]}"
  fi
  print -rn -- "$name"
}

_dfile_jump_label() {
  print -rn -- " Jump to: $(_dfile_jump_name "$1" ${2:-}) "
}

# Cell width for a strip label (extra for 🔒 when locked).
_dfile_cell_w() {
  local label="$1" locked="${2:-0}"
  if (( locked )); then
    print -rn -- $(( ${#label} + 5 ))   # "🔒 " + " name "
  else
    print -rn -- $(( ${#label} + 3 ))
  fi
}

# 1 if path is a dir we cannot enter/list (need r+x).
_dfile_dir_locked() {
  local d="$1"
  [[ -d $d ]] || return 0
  [[ -r $d && -x $d ]] && return 1
  return 0
}

# List basenames. kind=dirs|files. Returns 1 if unreadable; sets _DFILE_LIST_DENY.
# For dirs, also sets _DFILE_LIST_LOCKS (parallel 0/1 array).
typeset -ga _DFILE_LIST_LOCKS
_dfile_list() {
  local dir="$1" kind="$2" show_hidden="$3"
  local -a raw names locks
  local e b
  names=()
  locks=()
  _DFILE_LIST_DENY=""
  _DFILE_LIST_LOCKS=()
  if [[ ! -d $dir ]]; then
    return 1
  fi
  if [[ ! -r $dir ]]; then
    _DFILE_LIST_DENY="$dir"
    return 1
  fi
  setopt localoptions nullglob

  if [[ $kind == dirs ]]; then
    if (( show_hidden )); then
      raw=("$dir"/*(/) "$dir"/.*(/))
    else
      raw=("$dir"/*(/))
    fi
  else
    if (( show_hidden )); then
      raw=("$dir"/*(.) "$dir"/.*(.))
    else
      raw=("$dir"/*(.))
    fi
  fi

  for e in "$raw[@]"; do
    b="${e:t}"
    [[ $b == . || $b == .. ]] && continue
    names+=("$b")
    if [[ $kind == dirs ]] && _dfile_dir_locked "$e"; then
      locks+=(1)
    else
      locks+=(0)
    fi
  done
  if (( $#names )); then
    local -a pairs sorted_names sorted_locks
    local i key ext dot rec
    local dmode="${DNAV_CFG_DFILE_SORT_DIRS:-alpha}"
    local fmode="${DNAV_CFG_DFILE_SORT_FILES:-alpha}"
    local sep=$'\x1e'
    pairs=()
    for (( i=1; i <= $#names; i++ )); do
      b="${names[i]}"
      [[ $b == .* ]] && dot=0 || dot=1
      ext="${(L)b:e}"
      if [[ $kind == dirs ]]; then
        case $dmode in
          hidden_first) key="${dot}${sep}${(L)b}" ;;
          *)            key="${(L)b}" ;;
        esac
      else
        case $fmode in
          ext)       key="${ext}${sep}${(L)b}" ;;
          dot_first) key="${dot}${sep}${(L)b}" ;;
          dot_ext)   key="${dot}${sep}${ext}${sep}${(L)b}" ;;
          *)         key="${(L)b}" ;;
        esac
      fi
      pairs+=("${key}${sep}${sep}${b}${sep}${locks[i]}")
    done
    pairs=("${(@o)pairs}")
    sorted_names=(); sorted_locks=()
    for rec in "${pairs[@]}"; do
      sorted_locks+=("${rec##*${sep}}")
      rec="${rec%${sep}*}"
      sorted_names+=("${rec##*${sep}${sep}}")
    done
    names=("${sorted_names[@]}")
    if [[ $kind == dirs ]]; then
      locks=("${sorted_locks[@]}")
    else
      locks=()
    fi
  fi
  _DFILE_LIST_LOCKS=("${locks[@]}")
  print -l -- "${names[@]}"
  return 0
}

# Windowing: reply=(win_start), _dfile_vis=(labels)
# Optional $5 = lock array name (parallel 0/1 flags).
# Optional $6 = sticky: keep index 0 on-screen while sel still fits at win=0.
_dfile_window() {
  local aname="$1" sel="$2" win="$3" maxw="$4" lockname="${5:-}" sticky="${6:-0}"
  local -a all locks
  all=("${(@P)aname}")
  locks=()
  [[ -n $lockname ]] && locks=("${(@P)lockname}")
  local n=$#all
  (( n == 0 )) && { reply=(0); _dfile_vis=(); return 0 }

  (( sel < 0 )) && sel=0
  (( sel >= n )) && sel=$(( n - 1 ))
  (( win < 0 )) && win=0
  (( win > sel )) && win=$sel

  local -a vis
  local i w used label vcount sel_slot changed=1 guard=0 locked

  while (( changed && guard < 40 )); do
    (( guard++ ))
    changed=0
    vis=()
    used=0
    for (( i=win; i < n; i++ )); do
      label="${all[i+1]}"
      locked=${locks[i+1]:-0}
      w="$(_dfile_cell_w "$label" $locked)"
      if (( $#vis > 0 && used + w > maxw )); then
        break
      fi
      if (( $#vis == 0 && w > maxw )); then
        vis+=("$label")
        break
      fi
      vis+=("$label")
      (( used += w ))
    done
    vcount=$#vis
    (( vcount == 0 )) && break
    sel_slot=$(( sel - win ))
    if (( sel_slot >= vcount )); then
      if (( vcount >= 2 )); then
        win=$(( sel - (vcount - 2) ))
      else
        win=$sel
      fi
      (( win < 0 )) && win=0
      changed=1
      continue
    fi
    if (( sel_slot == vcount - 1 && sel < n - 1 && vcount >= 2 )); then
      # Sticky prefix: do not scroll Jump to: off just to peek the next folder.
      if (( sticky && win == 0 )); then
        :
      else
        local nwin=$(( sel - (vcount - 2) ))
        (( nwin < 0 )) && nwin=0
        if (( nwin != win )); then
          win=$nwin
          changed=1
        fi
      fi
    fi
  done

  _dfile_vis=("${vis[@]}")
  reply=($win)
}

# Paint a horizontal strip at the current cursor line.
# Does not emit leading newline. Clears to EOL.
# Shows < / > when more items are scrolled off to the left / right.
# Optional $6 = lock array name. Sets reply=(new_win)
_dfile_paint_strip() {
  local aname="$1"
  local sel="$2"
  local win="$3"
  local active="$4"
  local maxw="$5"
  local lockname="${6:-}"
  local sticky="${7:-0}"
  local hl rst
  local -a items locks
  items=("${(@P)aname}")
  locks=()
  [[ -n $lockname ]] && locks=("${(@P)lockname}")
  hl="$(_dfile_hl)"
  rst="$(_dfile_rst)"

  local n=$#items
  local more_l=0 more_r=0 ind_l=0 ind_r=0 content_w=$maxw
  local i label used=0 cell_w locked

  # Pass 1: window at full width to see if overflow markers are needed
  _dfile_window "$aname" "$sel" "$win" "$content_w" "$lockname" "$sticky"
  win=$reply[1]
  (( win > 0 )) && more_l=1
  (( n > 0 && win + $#_dfile_vis < n )) && more_r=1

  # Reserve 2 cols each ("<" + space, space + ">") so chips never wrap
  (( more_l )) && ind_l=2
  (( more_r )) && ind_r=2
  if (( ind_l + ind_r > 0 )); then
    content_w=$(( maxw - ind_l - ind_r ))
    (( content_w < 1 )) && content_w=1
    _dfile_window "$aname" "$sel" "$win" "$content_w" "$lockname" "$sticky"
    win=$reply[1]
    more_l=0
    more_r=0
    (( win > 0 )) && more_l=1
    (( n > 0 && win + $#_dfile_vis < n )) && more_r=1
    ind_l=0
    ind_r=0
    (( more_l )) && ind_l=2
    (( more_r )) && ind_r=2
    content_w=$(( maxw - ind_l - ind_r ))
    (( content_w < 1 )) && content_w=1
    _dfile_window "$aname" "$sel" "$win" "$content_w" "$lockname" "$sticky"
    win=$reply[1]
    more_l=0
    more_r=0
    (( win > 0 )) && more_l=1
    (( n > 0 && win + $#_dfile_vis < n )) && more_r=1
  fi

  local printed=0 remain
  (( more_l )) && { printf "\e[2m<\e[22m "; printed=2 }

  used=0
  for (( i=win; i < n; i++ )); do
    label="${items[i+1]}"
    locked=${locks[i+1]:-0}
    cell_w="$(_dfile_cell_w "$label" $locked)"
    remain=$(( maxw - printed - (more_r ? 2 : 0) ))
    (( remain < 0 )) && remain=0
    if (( cell_w > remain )); then
      if (( used == 0 && remain > 0 )); then
        local pad=3
        (( locked )) && pad=5
        local room=$(( remain - pad ))
        (( room < 1 )) && room=1
        if (( ${#label} > room )); then
          if (( room >= 2 )); then
            label="${label[1,room-1]}…"
          else
            label="${label[1,room]}"
          fi
        fi
        cell_w=$(( ${#label} + pad ))
        (( cell_w > remain )) && cell_w=$remain
      else
        more_r=1
        break
      fi
    fi
    if (( locked )); then
      # Red + lock for inaccessible dirs
      if (( active && i == sel )); then
        printf "\e[41;37m 🔒 %s \e[0m " "$label"
      else
        printf "\e[31m 🔒 %s \e[0m " "$label"
      fi
    elif (( active && i == sel )); then
      printf "${hl} %s ${rst} " "$label"
    else
      printf " %s  " "$label"
    fi
    (( used += cell_w ))
    (( printed += cell_w ))
  done

  if (( more_r && printed + 2 <= maxw )); then
    printf " \e[2m>\e[22m"
  fi
  printf "\e[K"
  reply=($win)
}

_dfile_enter() {
  local start="${1:-}"
  local hl rst maxw
  local key key2 key3
  # Default from ~/.config/dnav/config show_hidden (toggle with .)
  local show_hidden=${DNAV_CFG_SHOW_HIDDEN:-0}
  (( show_hidden = show_hidden ? 1 : 0 ))
  # Focus only toggles dirs (children) ↔ files. Parent strip is display-only.
  local focus=children   # children | files
  local mode=browse      # browse | jump
  local jump_buf=""
  local -a siblings children files child_row
  local -a siblings_lock children_lock child_row_lock   # 1 = inaccessible (red + lock)
  local sel_s=0 sel_c=0 sel_f=0
  local win_s=0 win_c=0 win_f=0
  # body = lines below the top row (always 3 in browse: children, status, files).
  # Invariant: after _dfile_draw / between keystrokes, cursor rests on the TOP row.
  # Do not CUU(body) before redraw/erase — that would climb into prior shell output.
  local body=0
  local cwd parent
  local perm_denied=""   # path string if unreadable

  _DFILE_OPEN=1
  hl="$(_dfile_hl)"
  rst="$(_dfile_rst)"

  if [[ -n $start && -d $start ]]; then
    cd -- "$start" 2>/dev/null || true
  fi

  # If bg index still running, show Indexing... N then clear before explorer draws
  if (( $+functions[_dsearch_index_running] )) && _dsearch_index_running; then
    printf "\r\e[2K\e[?25l"
    (( $+functions[_dsearch_ensure_index] )) && _dsearch_ensure_index
    printf "\r\e[2K"
  fi

  _dfile_refresh() {
    local out rc
    cwd="${PWD:A}"
    parent="${cwd:h}"
    [[ -z $parent ]] && parent="/"
    perm_denied=""

    siblings=()
    children=()
    files=()
    siblings_lock=()
    children_lock=()

    # At filesystem root there is no parent strip of siblings — only show "/"
    if [[ $cwd == / ]]; then
      siblings=("/")
      siblings_lock=(0)
      sel_s=0
      win_s=0
      parent="/"
    else
      out="$(_dfile_list "$parent" dirs $show_hidden 2>/dev/null)"
      rc=$?
      if (( rc != 0 )); then
        [[ -n $_DFILE_LIST_DENY ]] && perm_denied="$_DFILE_LIST_DENY"
        siblings=()
        siblings_lock=()
      else
        [[ -n $out ]] && siblings=("${(@f)out}") || siblings=()
        siblings_lock=("${_DFILE_LIST_LOCKS[@]}")
      fi
      # Highlight current directory name among siblings
      local base="${cwd:t}" i
      sel_s=0
      for (( i=1; i <= $#siblings; i++ )); do
        if [[ ${siblings[i]} == $base ]]; then
          sel_s=$(( i - 1 ))
          break
        fi
      done
    fi

    out="$(_dfile_list "$cwd" dirs $show_hidden 2>/dev/null)"
    rc=$?
    if (( rc != 0 )); then
      [[ -n $_DFILE_LIST_DENY ]] && perm_denied="$_DFILE_LIST_DENY"
      children=()
      children_lock=()
    else
      [[ -n $out ]] && children=("${(@f)out}") || children=()
      children_lock=("${_DFILE_LIST_LOCKS[@]}")
    fi

    out="$(_dfile_list "$cwd" files $show_hidden 2>/dev/null)"
    rc=$?
    if (( rc != 0 )); then
      [[ -n $_DFILE_LIST_DENY ]] && perm_denied="$_DFILE_LIST_DENY"
      files=()
    else
      [[ -n $out ]] && files=("${(@f)out}") || files=()
    fi

    (( sel_c < 0 )) && sel_c=0
    (( $#files == 0 )) && sel_f=0
    # sel_c 0 = Jump to: chip; 1..$#children = children[sel_c]
    (( sel_c > $#children )) && sel_c=$#children
    (( sel_f >= $#files && $#files > 0 )) && sel_f=$(( $#files - 1 ))
    child_row=("Jump to: $(_dfile_jump_name "$cwd")")
    child_row_lock=(0)
    if (( $#children )); then
      child_row+=("${children[@]}")
      child_row_lock+=("${children_lock[@]}")
    fi
    _dfile_fix_focus
  }

  # Focus rules:
  # - Stay on children even when empty (shows "Jump to: name" if files-only dir)
  # - Only bounce files → children when files row is empty
  _dfile_fix_focus() {
    if [[ $focus == files ]]; then
      if (( $#files == 0 )); then
        focus=children
      fi
    elif [[ $focus != children ]]; then
      focus=children
    fi
  }

  _dfile_paint_status() {
    local w="$1" hid_mark left right fill
    if (( show_hidden )); then hid_mark="●"; else hid_mark="○"; fi
    left="- Show Hidden ${hid_mark} "
    if [[ -n $perm_denied ]]; then
      right=" Permission Denied: ${perm_denied} "
      # truncate right if needed
      if (( ${#left} + ${#right} > w )); then
        local room=$(( w - ${#left} - 5 ))
        (( room < 8 )) && room=8
        right=" …${right:$(( ${#right} - room ))} "
      fi
    else
      right=""
    fi
    fill=$(( w - ${#left} - ${#right} ))
    (( fill < 0 )) && fill=0
    printf "\r%s" "$left"
    printf '%*s' $fill '' | tr ' ' '-'
    printf "%s\e[K" "$right"
  }

  # Paint one browse strip at the current cursor line (no leading NL).
  # which: siblings | children | files | status
  _dfile_paint_line() {
    local which="$1"
    local maxw brand brand_w rest_w active=0
    maxw="$(_dfile_cols)"
    hl="$(_dfile_hl)"
    rst="$(_dfile_rst)"
    case $which in
      siblings)
        # Brand chip always cyan; current dir among parent siblings (or "/" at root).
        brand=" DNav Files:"
        printf "\r${hl}%s${rst} " "$brand"
        brand_w=$(( ${#brand} + 1 ))
        rest_w=$(( maxw - brand_w ))
        (( rest_w < 8 )) && rest_w=8
        if (( $#siblings == 0 )); then
          # No parent context — leave the rest of the top row blank
          printf "\e[K"
          win_s=0
        else
          # active=1 always: highlight sel_s (cwd chip, or "/" at root)
          _dfile_paint_strip siblings $sel_s $win_s 1 $rest_w siblings_lock
          win_s=$reply[1]
        fi
        ;;
      children)
        # Jump to: is child_row[1] — same strip/window as the folders.
        printf "\r"
        [[ $focus == children ]] && active=1
        _dfile_paint_strip child_row $sel_c $win_c $active $maxw child_row_lock 1
        win_c=$reply[1]
        ;;
      status)
        _dfile_paint_status $maxw
        ;;
      files)
        [[ $focus == files ]] && active=1
        printf "\r"
        _dfile_paint_strip files $sel_f $win_f $active $maxw
        win_f=$reply[1]
        ;;
    esac
  }

  # Row index below top for a browse strip (siblings=0 … files=3).
  _dfile_row_of() {
    case $1 in
      siblings) print -rn -- 0 ;;
      children) print -rn -- 1 ;;
      status)   print -rn -- 2 ;;
      files)    print -rn -- 3 ;;
      *)        print -rn -- 0 ;;
    esac
  }

  # Repaint one browse row in place (no full wipe — avoids selection flicker).
  # Cursor starts and ends on top row. Only valid when browse layout is up (body==3).
  _dfile_repaint_row() {
    local which="$1" row
    [[ $mode == browse && $body -eq 3 ]] || { _dfile_draw; return }
    row="$(_dfile_row_of "$which")"
    printf "\e[?25l"
    if (( row > 0 )); then
      printf "\e[%dB" $row
    fi
    _dfile_paint_line "$which"
    if (( row > 0 )); then
      printf "\e[%dA" $row
    fi
    printf "\r"
  }

  # Full redraw. Paint over existing cells (no \e[2K wipe-first — that flickers).
  # Cursor starts and ends on top row (body invariant).
  _dfile_draw() {
    local old_body=$body leftover i n
    maxw="$(_dfile_cols)"
    hl="$(_dfile_hl)"
    rst="$(_dfile_rst)"
    printf "\e[?25l"

    if [[ $mode == jump ]]; then
      # Chip is only the label; query sits outside highlight: [ DNav Jump:] dfoo
      printf "\r${hl} DNav Jump:${rst} %s\e[K" "$jump_buf"
      local -a hits
      local k
      hits=()
      n=0
      if _djump_available 2>/dev/null; then
        hits=("${(@f)$(_djump_match_query "$jump_buf")}")
      fi
      for k in "${hits[@]:0:6}"; do
        printf "\n\r\e[2m  d%s → %s${rst}\e[K" "$k" \
          "$(_djump_resolve "$k" 2>/dev/null || true)"
        (( n++ ))
      done
      leftover=$(( old_body - n ))
      for (( i=0; i < leftover; i++ )); do
        printf "\n\r\e[2K"
      done
      if (( leftover > 0 )); then
        printf "\e[%dA" $leftover
      fi
      body=$n
      if (( body > 0 )); then
        printf "\e[%dA" $body
      fi
      printf "\r"
      return
    fi

    # ── Browse: overwrite 4 lines in place ────────────────────────────
    _dfile_paint_line siblings
    printf "\n"
    _dfile_paint_line children
    printf "\n"
    _dfile_paint_line status
    printf "\n"
    _dfile_paint_line files

    # Blank leftover lines when shrinking from jump (or taller) layout
    leftover=$(( old_body - 3 ))
    for (( i=0; i < leftover; i++ )); do
      printf "\n\r\e[2K"
    done
    if (( leftover > 0 )); then
      printf "\e[%dA" $leftover
    fi

    body=3
    # Park cursor on top row for the next draw/erase/partial paint.
    printf "\e[3A\r"
  }

  # Wipe the explorer UI. Cursor starts on top row (body invariant).
  _dfile_erase() {
    local i
    printf "\r\e[2K"
    for (( i=0; i < body; i++ )); do
      printf "\n\r\e[2K"
    done
    (( body > 0 )) && printf "\e[%dA" $body
    printf "\r\e[2K"
    body=0
  }

  _dfile_go() {
    local dest="$1"
    if [[ ! -d $dest ]]; then
      return 1
    fi
    if ! cd -- "$dest" 2>/dev/null; then
      perm_denied="$dest"
      _dfile_draw
      return 1
    fi
    _dfile_refresh
    win_c=0; win_f=0; sel_c=0; sel_f=0
    # Land on the first real child so j/↓ can keep drilling; h selects Jump to:.
    (( $#children > 0 )) && sel_c=1
    _dfile_draw
  }

  # Resolve selected directory under children focus.
  # Sets reply=(dest). Returns 1 if nothing selected / not on dirs row.
  # sel_c == 0 is the Jump to: chip — dest is cwd itself.
  _dfile_sel_dir_path() {
    local name dest
    [[ $focus == children ]] || return 1
    if (( sel_c == 0 )); then
      reply=("$cwd")
      return 0
    fi
    name="${children[sel_c]}"
    dest="$cwd/$name"
    reply=("$dest")
  }

  # Tab / f: toggle focus between directories (children) and files.
  # Children row always available (Jump to: when no subdirs). Files only if non-empty.
  _dfile_toggle_focus() {
    local prev=$focus
    if [[ $focus == files ]]; then
      focus=children
    else
      (( $#files > 0 )) || return
      focus=files
    fi
    [[ $focus == $prev ]] && return
    _dfile_repaint_row "$prev"
    _dfile_repaint_row "$focus"
  }

  # Drill into a directory inside the explorer (j / ↓). Stays in dfile.
  # On Jump to: chip, j does nothing (use Enter to leave at this folder).
  _dfile_enter_sel_dir() {
    [[ $focus == children ]] || return 1
    (( sel_c == 0 )) && return 1
    _dfile_sel_dir_path || return 1
    # Don't drill into locked dirs — surface permission line
    local dest="$reply[1]"
    if _dfile_dir_locked "$dest"; then
      perm_denied="$dest"
      _dfile_draw
      return 1
    fi
    _dfile_go "$dest"
  }

  # Leave dfile: cd to dest, show location bar, restore tty (optional ls).
  _dfile_exit_to() {
    local dest="$1"
    _dfile_erase
    _DFILE_OPEN=0
    if [[ ! -d $dest ]] || ! cd -- "$dest" 2>/dev/null; then
      printf "Could not change to %s\n" "$dest"
      if (( $+functions[_dnav_cleanup] )); then
        _dnav_cleanup
      else
        printf "\e[?25h"
      fi
      return 0
    fi
    if (( $+functions[_dnav_success_bar] )); then
      _dnav_success_bar "${dest:A}" "" dnav
    else
      printf "%s\n" "${dest:A}"
    fi
    if (( $+functions[_dnav_cleanup] )); then
      _dnav_cleanup
    else
      printf "\e[?25h"
    fi
    (( $+functions[_dnav_maybe_ls] )) && _dnav_maybe_ls dnav
    return 0
  }

  # Enter on a directory row: leave explorer at that folder + location bar.
  # Jump to: chip (sel_c == 0) leaves at the current folder.
  _dfile_exit_sel_dir() {
    if [[ $focus == children && sel_c -eq 0 ]]; then
      _dfile_exit_to "$cwd"
      return $?
    fi
    _dfile_sel_dir_path || return 1
    local dest="$reply[1]"
    if _dfile_dir_locked "$dest"; then
      perm_denied="$dest"
      _dfile_draw
      return 1
    fi
    _dfile_exit_to "$dest"
  }

  # Open selected file: location bar, restore tty, then editor/xdg-open.
  _dfile_open_file() {
    (( $#files )) || return 1
    local fpath="$cwd/${files[sel_f+1]}"
    [[ -e $fpath ]] || return 1
    _dfile_erase
    _DFILE_OPEN=0
    if (( $+functions[_dnav_success_bar] )); then
      _dnav_success_bar "${fpath:A}" "" dnav
    else
      printf "%s\n" "${fpath:A}"
    fi
    if (( $+functions[_dnav_cleanup] )); then
      _dnav_cleanup
    else
      printf "\e[?25h"
    fi
    if [[ -n ${EDITOR:-} ]]; then
      ${=EDITOR} -- "$fpath"
    elif command -v xdg-open >/dev/null 2>&1; then
      xdg-open "$fpath" >/dev/null 2>&1 &
    else
      printf "No EDITOR/xdg-open for %s\n" "$fpath"
    fi
    return 0
  }

  _dfile_scroll_to_sel() {
    local aname="$1" sel="$2" win="$3" dir="$4"
    local n maxw="${5:-$(_dfile_cols)}" sticky="${6:-0}" vc
    local -a all
    all=("${(@P)aname}")
    n=$#all
    (( n == 0 )) && { reply=(0); return }
    # Match paint_strip: room for optional < > overflow markers
    (( maxw > 12 )) && (( maxw -= 4 ))
    if (( sticky )); then
      _dfile_window "$aname" $sel 0 $maxw "" 1
      if (( sel < $#_dfile_vis )); then
        reply=(0)
        return
      fi
    fi
    _dfile_window "$aname" $sel $win $maxw "" $sticky
    win=$reply[1]
    vc=$#_dfile_vis
    if (( dir > 0 && sel < n - 1 && vc >= 2 )); then
      win=$(( sel - (vc - 2) ))
      (( win < 0 )) && win=0
    elif (( dir < 0 && sel > 0 && vc >= 2 )); then
      if (( sel - win == 0 )); then
        win=$(( sel - 1 ))
        (( win < 0 )) && win=0
      fi
    fi
    _dfile_window "$aname" $sel $win $maxw "" $sticky
    reply=($reply[1])
  }

  _dfile_move_h() {
    local dir="$1" n
    # Parent strip is not interactive — only children / files.
    case $focus in
      children)
        n=$#child_row; (( n == 0 )) && return
        (( sel_c += dir ))
        (( sel_c < 0 )) && sel_c=0
        (( sel_c >= n )) && sel_c=$(( n - 1 ))
        _dfile_scroll_to_sel child_row $sel_c $win_c $dir "" 1
        win_c=$reply[1]
        ;;
      files)
        n=$#files; (( n == 0 )) && return
        (( sel_f += dir ))
        (( sel_f < 0 )) && sel_f=0
        (( sel_f >= n )) && sel_f=$(( n - 1 ))
        _dfile_scroll_to_sel files $sel_f $win_f $dir
        win_f=$reply[1]
        ;;
      *) return ;;
    esac
    # Only the focused strip changes — no full-frame wipe
    _dfile_repaint_row "$focus"
  }

  _dfile_refresh
  (( $#children > 0 )) && sel_c=1
  body=0
  _dfile_draw

  while true; do
    # Abort already tore down UI (via _dnav_abort); just leave the explorer
    (( ${DNAV_ABORT:-0} )) && { _DFILE_OPEN=0; return 130; }
    read -k 1 key || true
    (( ${DNAV_ABORT:-0} )) && { _DFILE_OPEN=0; return 130; }
    if [[ $key == $'\x03' ]]; then
      if (( $+functions[_dnav_abort] )); then
        _dnav_abort
      else
        _dfile_erase
        _DFILE_OPEN=0
        DNAV_ABORT=1
      fi
      return 130
    fi

    if [[ $mode == jump ]]; then
      case $key in
        $'\e')
          if read -t 0.05 -k 1 key2 2>/dev/null; then
            [[ $key2 == '[' ]] && read -k 1 key3
          else
            mode=browse
            jump_buf=""
            _dfile_draw
          fi
          ;;
        $'\n'|$'\r')
          if _djump_available 2>/dev/null; then
            local dest
            dest="$(_djump_resolve "$jump_buf" 2>/dev/null)" || dest=""
            if [[ -z $dest && $jump_buf != d* ]]; then
              dest="$(_djump_resolve "d$jump_buf" 2>/dev/null)" || dest=""
            fi
            if [[ -n $dest ]]; then
              mode=browse
              jump_buf=""
              if [[ -d $dest ]]; then
                _dfile_go "$dest"
              else
                perm_denied="$dest"
                _dfile_draw
              fi
            fi
          fi
          ;;
        $'\177'|$'\b')
          (( ${#jump_buf} > 0 )) && jump_buf="${jump_buf[1,-2]}"
          _dfile_draw
          ;;
        [[:print:]])
          jump_buf+="$key"
          _dfile_draw
          ;;
      esac
      continue
    fi

    case $key in
      $'\e')
        if read -t 0.05 -k 1 key2 2>/dev/null; then
          if [[ $key2 == '[' ]]; then
            read -k 1 key3
            case $key3 in
              A) [[ $cwd != / ]] && _dfile_go "${cwd:h}" ;;
              B) _dfile_enter_sel_dir ;;
              C) _dfile_move_h 1 ;;
              D) _dfile_move_h -1 ;;
            esac
          fi
        else
          _dfile_erase
          _DFILE_OPEN=0
          return 1
        fi
        ;;
      h) _dfile_move_h -1 ;;
      l) _dfile_move_h 1 ;;
      k) [[ $cwd != / ]] && _dfile_go "${cwd:h}" ;;
      j) _dfile_enter_sel_dir ;;  # drill down inside explorer
      f|F|$'\t')
        # Toggle focus: directories ↔ files (parent strip is not a focus target)
        _dfile_toggle_focus
        ;;
      .)
        show_hidden=$(( 1 - show_hidden ))
        _dfile_refresh
        _dfile_draw
        ;;
      d)
        if _djump_available 2>/dev/null; then
          mode=jump
          jump_buf="d"
          _dfile_draw
        fi
        ;;
      s|/)
        # s or / — fuzzy search (same as main dnav)
        if _dsearch_available 2>/dev/null; then
          # Leave a clean screen region for search overlay
          _dfile_erase
          body=0
          local spath
          if _dsearch_start_for_dfile; then
            spath="${DNAV_SEARCH_RESULT:-}"
            if [[ -n $spath && -d $spath ]]; then
              cd -- "$spath" 2>/dev/null || true
              _dfile_refresh
            fi
          fi
          # Ctrl+C during search: full abort already restored the shell tty
          (( ${DNAV_ABORT:-0} )) && { _DFILE_OPEN=0; return 130; }
          body=0
          _dfile_draw
        fi
        ;;
      $'\n'|$'\r')
        if [[ $focus == files ]]; then
          # Open file: location bar, then editor
          if _dfile_open_file; then
            return 0
          fi
        else
          # Leave explorer at selected folder + location bar
          if _dfile_exit_sel_dir; then
            return 0
          fi
        fi
        ;;
    esac
  done
}
