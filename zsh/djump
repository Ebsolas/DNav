#!/usr/bin/env zsh
# djump — editable directory jump table for dnav plugins
#
# Data file (first match wins):
#   $DNAV_JUMPS
#   $DNAV_CONFIG_DIR/jumps     (~/.config/dnav/jumps)
#   $DNAV_DIR/jumps            (package default)
#
# API:
#   _djump_available
#   _djump_load / _djump_save
#   _djump_resolve KEY     → prints absolute path, return 0/1
#   _djump_list_keys
#   _djump_match_query S   → keys matching s / ds (for typeahead / search pin)
#   _djump_goto KEY        → cd to jump (for shell cmds)
#   djump [-r|-l|KEY]      → reload / list / go
#   dfavorite add|edit|remove|list  → manage jump favorites
#
# When sourced (via dnav), each jump key is also installed as a shell command
# `dKEY` (e.g. key "home" → `dhome`) so you can jump without opening dnav.

_djump_available() { return 0 }

typeset -gA _DJUMP_MAP
typeset -ga _DJUMP_KEYS
typeset -ga _DJUMP_SHELL_CMDS
typeset -g  _DJUMP_LOADED=0

_djump_data_path() {
  local cfg="${DNAV_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/dnav}"
  if [[ -n ${DNAV_JUMPS:-} ]]; then
    print -r -- "$DNAV_JUMPS"
  elif [[ -f $cfg/jumps ]]; then
    print -r -- "$cfg/jumps"
  elif [[ -n ${DNAV_DIR:-} && -f $DNAV_DIR/jumps ]]; then
    print -r -- "$DNAV_DIR/jumps"
  else
    print -r -- "${0:A:h}/jumps"
  fi
}

# Path we write favorites to (always user config, not package tree).
_djump_user_path() {
  if [[ -n ${DNAV_JUMPS:-} ]]; then
    print -r -- "$DNAV_JUMPS"
    return
  fi
  local cfg="${DNAV_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/dnav}"
  mkdir -p -- "$cfg" 2>/dev/null || true
  print -r -- "$cfg/jumps"
}

# Compact path for storage (~ for $HOME). Never treats bare "~" as a relative name.
_djump_store_path() {
  local p="$1" store
  if [[ $p == '~' ]]; then
    store="$HOME"
  elif [[ $p == '~/'* ]]; then
    store="${p/#\~/$HOME}"
  elif [[ $p == /* ]]; then
    store="${p:A}"
  else
    store="$(cd -- "$PWD" && cd -- "$p" 2>/dev/null && pwd -P)" || store="${PWD:A}/$p"
  fi
  if [[ $store == "$HOME" ]]; then
    store="~"
  elif [[ $store == "$HOME/"* ]]; then
    store="~${store#$HOME}"
  fi
  print -r -- "$store"
}

# Persist current map to the user jumps file and reinstall dKEY commands.
_djump_save() {
  local f k path
  f="$(_djump_user_path)"
  {
    print -r -- "# djump table — key becomes dKEY (home → dhome)"
    print -r -- "# Format:  key   path"
    print -r -- "# Managed by dfavorite / dnav Settings / hand-edit"
    print -r -- "#"
    for k in "${_DJUMP_KEYS[@]}"; do
      path="${_DJUMP_MAP[$k]}"
      [[ -n $path ]] || continue
      print -r -- "$k  $(_djump_store_path "$path")"
    done
  } > "$f"
  # Future loads should read the user file
  _DJUMP_LOADED=0
  _djump_load 2>/dev/null || {
    # load may fail only if empty; still install what we have
    _DJUMP_LOADED=1
    _djump_install_cmds
  }
  return 0
}

# Validate jump label (must form a valid dKEY function name body).
_djump_valid_label() {
  local key="${1#d}"
  [[ $key =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]]
}

# Remove previously installed dKEY shell functions.
_djump_uninstall_cmds() {
  local cmd
  for cmd in "${_DJUMP_SHELL_CMDS[@]}"; do
    (( $+functions[$cmd] )) && unfunction "$cmd"
  done
  _DJUMP_SHELL_CMDS=()
}

# Install one shell function per jump: dhome, dproj, …
# Only safe identifier keys (letters/digits/_) become commands.
_djump_install_cmds() {
  local key cmd
  _djump_uninstall_cmds
  for key in "${_DJUMP_KEYS[@]}"; do
    # Require a valid shell function name body (no extendedglob needed)
    [[ $key =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]] || continue
    cmd="d${key}"
    # Capture key by value so each function keeps its own target.
    eval "${cmd}() { _djump_goto ${(q)key}; }"
    _DJUMP_SHELL_CMDS+=("$cmd")
  done
}

_djump_load() {
  local f line key path
  f="$(_djump_data_path)"
  _DJUMP_MAP=()
  _DJUMP_KEYS=()
  _DJUMP_LOADED=0
  if [[ ! -f $f ]]; then
    _djump_uninstall_cmds
    return 1
  fi
  while IFS= read -r line || [[ -n $line ]]; do
    line="${line%%#*}"
    line="${line%"${line##*[![:space:]]}"}"
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z $line ]] && continue
    key="${line%%[[:space:]]*}"
    path="${line#"$key"}"
    path="${path#"${path%%[![:space:]]*}"}"
    [[ -z $key || -z $path ]] && continue
    _DJUMP_MAP[$key]="$path"
    _DJUMP_KEYS+=("$key")
  done < "$f"
  _DJUMP_LOADED=1
  _djump_install_cmds
  return 0
}

_djump_ensure() {
  (( _DJUMP_LOADED )) || _djump_load
}

# Expand path: ~ and relatives against $PWD; print absolute if possible.
_djump_expand() {
  local p="$1" out
  if [[ $p == '~' || $p == '~/'* ]]; then
    p="${p/#\~/$HOME}"
  fi
  if [[ $p == /* ]]; then
    print -r -- "${p:a}"
    return 0
  fi
  out="$(cd -- "$PWD" && cd -- "$p" 2>/dev/null && pwd -P)" || out=""
  if [[ -n $out ]]; then
    print -r -- "$out"
  else
    print -r -- "${PWD:a}/$p"
  fi
}

# Resolve jump key (without leading d). Also accepts dKEY → KEY.
_djump_resolve() {
  local raw="$1" key path
  _djump_ensure || return 1
  key="${raw#d}"
  # if user passed "dhome", key becomes "home"; if "home", stays
  if [[ $raw == d* && -n ${_DJUMP_MAP[$key]:-} ]]; then
    :
  elif [[ -n ${_DJUMP_MAP[$raw]:-} ]]; then
    key="$raw"
  elif [[ -n ${_DJUMP_MAP[$key]:-} ]]; then
    :
  else
    return 1
  fi
  path="${_DJUMP_MAP[$key]}"
  _djump_expand "$path"
}

# cd to a jump target (used by dKEY shell commands and `djump KEY`).
# Uses the same cyan success bar as dnav when available.
_djump_goto() {
  local key="$1" dest
  [[ -n $key ]] || return 1
  dest="$(_djump_resolve "$key")" || {
    print -u2 -- "djump: unknown key: $key"
    return 1
  }
  if [[ ! -d $dest ]]; then
    print -u2 -- "djump: not a directory: $dest"
    return 1
  fi
  cd -- "$dest" || {
    print -u2 -- "djump: could not cd to $dest"
    return 1
  }
  dest="${dest:A}"
  if (( $+functions[_dnav_success_bar] )); then
    _dnav_success_bar "$dest" "" djump
  elif [[ -o interactive ]]; then
    print -r -- "$dest"
  fi
  if (( $+functions[_dnav_maybe_ls] )); then
    _dnav_maybe_ls djump
  else
    case ${DNAV_CFG_LS_DJUMP:--1} in
      1) command ls -a --color=auto ;;
      0) ;;
      *)
        case ${DNAV_CFG_LS:-0} in
          1|true|yes|on|TRUE|YES|ON) command ls -a --color=auto ;;
        esac
        ;;
    esac
  fi
  return 0
}

_djump_list_keys() {
  _djump_ensure || return 1
  print -l -- "${_DJUMP_KEYS[@]}"
}

# Print matching keys for query (case-insensitive). Query may be "dhome", "home", "ho".
_djump_match_query() {
  local q="${(L)1}" k kl dkl
  local -a hits
  _djump_ensure || return 1
  [[ -z $q ]] && return 0
  for k in "${_DJUMP_KEYS[@]}"; do
    kl="${(L)k}"
    dkl="d${kl}"
    if [[ $kl == ${q}* || $dkl == ${q}* || $q == $kl || $q == $dkl ]]; then
      hits+=("$k")
    fi
  done
  (( $#hits )) && print -l -- "${hits[@]}"
}

# User-facing helper: list, reload, or jump.
#   djump            list keys as dKEY → path
#   djump -l         same
#   djump -r         reload jumps file + reinstall dKEY cmds
#   djump home       cd to key "home" (same as dhome)
djump() {
  case ${1:-} in
    -r|--reload)
      _DJUMP_LOADED=0
      if _djump_load; then
        print -r -- "djump: loaded ${#_DJUMP_KEYS} jumps (${#_DJUMP_SHELL_CMDS} commands)"
        return 0
      fi
      print -u2 -- "djump: failed to load $(_djump_data_path)"
      return 1
      ;;
    -l|--list|'')
      _djump_ensure || {
        print -u2 -- "djump: no jumps file at $(_djump_data_path)"
        return 1
      }
      local k
      for k in "${_DJUMP_KEYS[@]}"; do
        print -r -- "d${k}	${_DJUMP_MAP[$k]}"
      done
      return 0
      ;;
    -h|--help)
      print -r -- "usage: djump [-r|-l|KEY]"
      print -r -- "  -r, --reload   reload jumps file and dKEY commands"
      print -r -- "  -l, --list     list dKEY → path"
      print -r -- "  KEY            cd to jump (also: dKEY e.g. dhome)"
      print -r -- "favorites: dfavorite add|edit|remove|list"
      return 0
      ;;
    *)
      _djump_goto "$1"
      ;;
  esac
}

# ── dfavorite — manage jump favorites from the shell ─────────────────────
#   dfavorite add   LABEL [PATH]   add (PATH defaults to $PWD)
#   dfavorite edit  LABEL [PATH]   change path (PATH defaults to $PWD)
#   dfavorite remove LABEL         remove favorite + dKEY command
#   dfavorite list                 list favorites
#   dfavorite                      show help
dfavorite() {
  local cmd="${1:-}" label path dest k
  local hl="${DNAV_HIGHLIGHT:-\e[30;46m}"
  local rst="${DNAV_RESET:-\e[0m}"

  _djump_ensure 2>/dev/null || {
    # Empty table is fine — start fresh in user config
    _DJUMP_MAP=()
    _DJUMP_KEYS=()
    _DJUMP_LOADED=1
  }

  case $cmd in
    ''|-h|--help|help)
      print -r -- "${hl} dfavorite ${rst}"
      print -r -- "  dfavorite add LABEL [PATH]     add jump (default path: \$PWD)"
      print -r -- "  dfavorite edit LABEL [PATH]    set path (default: \$PWD)"
      print -r -- "  dfavorite remove LABEL         remove jump + dLABEL command"
      print -r -- "  dfavorite list                 list favorites"
      print -r -- ""
      print -r -- "Examples:"
      print -r -- "  dfavorite add work             # dwork → current directory"
      print -r -- "  dfavorite add docs ~/Documents  # ddocs → ~/Documents"
      print -r -- "  dfavorite edit work /other/path"
      print -r -- "  dfavorite remove work"
      return 0
      ;;
    list|-l|--list)
      if (( $#_DJUMP_KEYS == 0 )); then
        print -r -- "dfavorite: no favorites yet (try: dfavorite add <label>)"
        return 0
      fi
      for k in "${_DJUMP_KEYS[@]}"; do
        print -r -- "d${(r:14:)k}  ${_DJUMP_MAP[$k]}"
      done
      return 0
      ;;
    add)
      # Label is stored without the dKEY prefix (add work → dwork). Do not strip
      # a leading "d" from words like "docs".
      label="$2"
      path="${3:-$PWD}"
      if [[ -z $label ]]; then
        print -u2 -- "usage: dfavorite add LABEL [PATH]"
        return 1
      fi
      if ! _djump_valid_label "$label"; then
        print -u2 -- "dfavorite: invalid label '$label' (use letters, digits, _)"
        return 1
      fi
      dest="$(_djump_expand "$path")"
      if [[ ! -d $dest ]]; then
        print -u2 -- "dfavorite: not a directory: $path"
        return 1
      fi
      if [[ -n ${_DJUMP_MAP[$label]:-} ]]; then
        print -u2 -- "dfavorite: '$label' exists (use: dfavorite edit $label …)"
        return 1
      fi
      _DJUMP_KEYS+=("$label")
      _DJUMP_MAP[$label]="$dest"
      _djump_save
      print -r -- "dfavorite: added d${label} → $(_djump_store_path "$dest")"
      return 0
      ;;
    edit)
      label="$2"
      path="${3:-$PWD}"
      if [[ -z $label ]]; then
        print -u2 -- "usage: dfavorite edit LABEL [PATH]"
        return 1
      fi
      # Allow dwork as well as work when editing/removing
      if [[ -z ${_DJUMP_MAP[$label]:-} && $label == d* && -n ${_DJUMP_MAP[${label#d}]:-} ]]; then
        label="${label#d}"
      fi
      if [[ -z ${_DJUMP_MAP[$label]:-} ]]; then
        print -u2 -- "dfavorite: unknown label '$label' (try: dfavorite list)"
        return 1
      fi
      dest="$(_djump_expand "$path")"
      if [[ ! -d $dest ]]; then
        print -u2 -- "dfavorite: not a directory: $path"
        return 1
      fi
      _DJUMP_MAP[$label]="$dest"
      _djump_save
      print -r -- "dfavorite: updated d${label} → $(_djump_store_path "$dest")"
      return 0
      ;;
    remove|rm|delete|del)
      label="$2"
      if [[ -z $label ]]; then
        print -u2 -- "usage: dfavorite remove LABEL"
        return 1
      fi
      if [[ -z ${_DJUMP_MAP[$label]:-} && $label == d* && -n ${_DJUMP_MAP[${label#d}]:-} ]]; then
        label="${label#d}"
      fi
      if [[ -z ${_DJUMP_MAP[$label]:-} ]]; then
        print -u2 -- "dfavorite: unknown label '$label'"
        return 1
      fi
      unset "_DJUMP_MAP[$label]"
      local -a nkeys
      nkeys=()
      for k in "${_DJUMP_KEYS[@]}"; do
        [[ $k == "$label" ]] && continue
        nkeys+=("$k")
      done
      _DJUMP_KEYS=("${nkeys[@]}")
      _djump_save
      print -r -- "dfavorite: removed d${label}"
      return 0
      ;;
    *)
      print -u2 -- "dfavorite: unknown command '$cmd' (try: dfavorite --help)"
      return 1
      ;;
  esac
}

# Load once when sourced (installs dKEY commands into the shell)
_djump_load 2>/dev/null || true
