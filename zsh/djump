#!/usr/bin/env zsh
# djump — standalone jump table (works with or without dnav)
#
# Data file (first match wins):
#   $DNAV_JUMPS
#   $DNAV_CONFIG_DIR/jumps     (~/.config/dnav/jumps)
#   $DNAV_DIR/jumps            (package default)
#
# API:
#   _djump_available
#   _djump_load / _djump_save
#   _djump_add / _djump_edit / _djump_remove
#   _djump_resolve KEY     → prints absolute path, return 0/1
#   _djump_list_keys
#   _djump_match_query S   → keys matching s / ds (for typeahead / search pin)
#   _djump_goto KEY        → cd to jump (for shell cmds)
#   _djump_cmd_clash KEY   → 0 if dKEY is taken (REPLY = why)
#   djump [-r|-l|-c|add|edit|remove|KEY]
#   dhelp                      jump list only (not usage)
#   djump -h / --help          usage
#
# When sourced, each jump key is also installed as `dKEY` (home → dhome)
# unless that name is reserved or already taken on the system.

_djump_available() { return 0 }

typeset -gA _DJUMP_MAP
typeset -ga _DJUMP_KEYS
typeset -ga _DJUMP_SHELL_CMDS
typeset -ga _DJUMP_SKIPPED
typeset -g  _DJUMP_LOADED=0

_djump_data_path() {
  local cfg="${DNAV_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/dnav}"
  if [[ -n ${DNAV_JUMPS:-} ]]; then
    print -r -- "$DNAV_JUMPS"
  elif [[ -f $cfg/jumps ]]; then
    print -r -- "$cfg/jumps"
  elif [[ -n ${DNAV_DIR:-} && -f $DNAV_DIR/jumps ]]; then
    print -r -- "$DNAV_DIR/jumps"
  else
    print -r -- "${0:A:h}/jumps"
  fi
}

# Path we write favorites to (always user config, not package tree).
_djump_user_path() {
  if [[ -n ${DNAV_JUMPS:-} ]]; then
    print -r -- "$DNAV_JUMPS"
    return
  fi
  local cfg="${DNAV_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/dnav}"
  mkdir -p -- "$cfg" 2>/dev/null || true
  print -r -- "$cfg/jumps"
}

# Compact path for storage (~ for $HOME). Never treats bare "~" as a relative name.
_djump_store_path() {
  local p="$1" store
  if [[ $p == '~' ]]; then
    store="$HOME"
  elif [[ $p == '~/'* ]]; then
    store="${p/#\~/$HOME}"
  elif [[ $p == /* ]]; then
    store="${p:a}"
  else
    store="$(cd -- "$PWD" && cd -- "$p" 2>/dev/null && pwd)" || store="${PWD:a}/$p"
  fi
  if [[ $store == "$HOME" ]]; then
    store="~"
  elif [[ $store == "$HOME/"* ]]; then
    store="~${store#$HOME}"
  fi
  print -r -- "$store"
}

# Persist current map to the user jumps file (temp + mv) and reinstall dKEY commands.
_djump_save() {
  emulate -L zsh
  setopt localoptions no_multios clobber
  local f tmp k jpath
  f="$(_djump_user_path)"
  tmp="${f}.tmp.$$"
  {
    print -r -- "# djump table — key becomes dKEY (home → dhome)"
    print -r -- "# Format:  key   path"
    print -r -- "# Managed by djump add|edit|remove / dnav Settings / hand-edit"
    print -r -- "#"
    for k in "${_DJUMP_KEYS[@]}"; do
      jpath="${_DJUMP_MAP[$k]}"
      [[ -n $jpath ]] || continue
      print -r -- "$k  $(_djump_store_path "$jpath")"
    done
  } > "$tmp" || { /bin/rm -f -- "$tmp"; return 1 }
  /bin/mv -f -- "$tmp" "$f" || { /bin/rm -f -- "$tmp"; return 1 }
  _DJUMP_LOADED=0
  _djump_load 2>/dev/null || {
    _DJUMP_LOADED=1
    _djump_install_cmds
  }
  return 0
}

# Label as stored (do not strip a leading "d" — "docs" stays "docs").
_djump_valid_label() {
  [[ $1 =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]]
}

# True if dNAME is a jump function we installed (body still calls _djump_goto).
_djump_owned() {
  local jname="$1"
  (( $+functions[$jname] )) || return 1
  [[ ${functions[$jname]} == *_djump_goto* ]]
}

# 0 = clash (REPLY = reserved|alias|builtin|function|command). 1 = free or ours.
_djump_cmd_clash() {
  local key="$1"
  local jname="d${key}"
  local kind
  REPLY=""
  case $jname in
    dnav|djump|dconfig|dhelp)
      REPLY=reserved
      return 0
      ;;
  esac
  if _djump_owned "$jname"; then
    return 1
  fi
  kind="$(whence -w -- "$jname" 2>/dev/null)"
  kind="${kind#*: }"
  case $kind in
    none|'') return 1 ;;
    alias) REPLY=alias; return 0 ;;
    builtin) REPLY=builtin; return 0 ;;
    function) REPLY=function; return 0 ;;
    *) REPLY=command; return 0 ;;
  esac
}

# Remove previously installed dKEY functions we still own.
_djump_uninstall_cmds() {
  local cmd
  for cmd in "${_DJUMP_SHELL_CMDS[@]}"; do
    if _djump_owned "$cmd"; then
      unfunction "$cmd"
    fi
  done
  _DJUMP_SHELL_CMDS=()
}

# Install one shell function per jump: dhome, dproj, …
# Skip reserved / already-taken names; keep the table row.
_djump_install_cmds() {
  local key cmd why
  local -a skipped
  _djump_uninstall_cmds
  skipped=()
  for key in "${_DJUMP_KEYS[@]}"; do
    _djump_valid_label "$key" || continue
    cmd="d${key}"
    if _djump_cmd_clash "$key"; then
      why="$REPLY"
      skipped+=("${cmd}:${why}")
      continue
    fi
    eval "${cmd}() { _djump_goto ${(q)key}; }"
    _DJUMP_SHELL_CMDS+=("$cmd")
  done
  _DJUMP_SKIPPED=("${skipped[@]}")
}

# One-line skip summary (for djump -r). Empty if nothing skipped.
_djump_skip_summary() {
  local -a names
  local rec
  (( $#_DJUMP_SKIPPED )) || return 1
  names=()
  for rec in "${_DJUMP_SKIPPED[@]}"; do
    names+=("${rec%%:*}")
  done
  local plural=s
  (( $#_DJUMP_SKIPPED == 1 )) && plural=""
  print -r -- "djump: skipped ${#_DJUMP_SKIPPED} command${plural} that already exist (${(j:, :)names}). djump KEY still works."
}

# Same comment rule as _dnav_strip_comment. Prefer the engine when sourced via dnav.
_djump_strip_comment() {
  if (( $+functions[_dnav_strip_comment] )); then
    _dnav_strip_comment "$1"
    return
  fi
  emulate -L zsh
  setopt localoptions no_extended_glob
  local s="$1" t i ch prev=""
  t="${s#"${s%%[![:space:]]*}"}"
  if [[ -z $t || $t == \#* ]]; then
    print -r -- ""
    return
  fi
  for (( i=1; i <= ${#s}; i++ )); do
    ch="${s[i]}"
    if [[ $ch == '#' && $prev == [[:space:]] ]]; then
      print -r -- "${s[1,i-1]}"
      return
    fi
    prev="$ch"
  done
  print -r -- "$s"
}

_djump_trim() {
  if (( $+functions[_dnav_trim] )); then
    _dnav_trim "$1"
    return
  fi
  emulate -L zsh
  setopt localoptions no_extended_glob
  local s="$1"
  s="${s%"${s##*[![:space:]]}"}"
  s="${s#"${s%%[![:space:]]*}"}"
  print -r -- "$s"
}

_djump_load() {
  emulate -L zsh
  setopt localoptions no_extended_glob
  local f line key jpath
  f="$(_djump_data_path)"
  _DJUMP_MAP=()
  _DJUMP_KEYS=()
  _DJUMP_SKIPPED=()
  _DJUMP_LOADED=0
  if [[ ! -f $f ]]; then
    _djump_uninstall_cmds
    return 1
  fi
  while IFS= read -r line || [[ -n $line ]]; do
    line="$(_djump_trim "$(_djump_strip_comment "$line")")"
    [[ -z $line ]] && continue
    key="${line%%[[:space:]]*}"
    jpath="${line#"$key"}"
    jpath="${jpath#"${jpath%%[![:space:]]*}"}"
    [[ -z $key || -z $jpath ]] && continue
    _DJUMP_MAP[$key]="$jpath"
    _DJUMP_KEYS+=("$key")
  done < "$f"
  _DJUMP_LOADED=1
  _djump_install_cmds
  return 0
}

_djump_ensure() {
  (( _DJUMP_LOADED )) || _djump_load
}

# Empty table is a valid starting point for add (no jumps file yet).
_djump_ensure_table() {
  _djump_ensure 2>/dev/null || {
    _DJUMP_MAP=()
    _DJUMP_KEYS=()
    _DJUMP_SKIPPED=()
    _DJUMP_LOADED=1
  }
}

# Expand path: ~ and relatives against $PWD; print absolute if possible.
_djump_expand() {
  local p="$1" out
  if [[ $p == '~' || $p == '~/'* ]]; then
    p="${p/#\~/$HOME}"
  fi
  if [[ $p == /* ]]; then
    print -r -- "${p:a}"
    return 0
  fi
  out="$(cd -- "$PWD" && cd -- "$p" 2>/dev/null && pwd -P)" || out=""
  if [[ -n $out ]]; then
    print -r -- "$out"
  else
    print -r -- "${PWD:a}/$p"
  fi
}

# Resolve jump key. Exact map key wins; only then try stripping a leading d.
_djump_resolve() {
  local raw="$1" key jpath
  _djump_ensure || return 1
  if [[ -n ${_DJUMP_MAP[$raw]:-} ]]; then
    key="$raw"
  elif [[ $raw == d* && -n ${_DJUMP_MAP[${raw#d}]:-} ]]; then
    key="${raw#d}"
  else
    return 1
  fi
  jpath="${_DJUMP_MAP[$key]}"
  _djump_expand "$jpath"
}

# Map "dwork" → "work" only when "dwork" is not itself a key.
_djump_existing_label() {
  local label="$1"
  if [[ -n ${_DJUMP_MAP[$label]:-} ]]; then
    print -r -- "$label"
    return 0
  fi
  if [[ $label == d* && -n ${_DJUMP_MAP[${label#d}]:-} ]]; then
    print -r -- "${label#d}"
    return 0
  fi
  return 1
}

# cd to a jump target (used by dKEY shell commands and `djump KEY`).
# Uses the same cyan success bar as dnav when available.
_djump_goto() {
  local key="$1" dest
  [[ -n $key ]] || return 1
  dest="$(_djump_resolve "$key")" || {
    print -u2 -- "djump: unknown key: $key"
    return 1
  }
  if [[ ! -d $dest ]]; then
    print -u2 -- "djump: not a directory: $dest"
    return 1
  fi
  cd -- "$dest" || {
    print -u2 -- "djump: could not cd to $dest"
    return 1
  }
  dest="${dest:a}"
  # Same bar as dnav/dfile/dsearch (_dnav_finish also restores TUI tty, skip here).
  if (( $+functions[_dnav_success_bar] )); then
    _dnav_success_bar "$dest" "" djump
  elif [[ -o interactive ]]; then
    print -r -- "$dest"
  fi
  if (( $+functions[_dnav_maybe_ls] )); then
    _dnav_maybe_ls djump
  else
    case ${DNAV_CFG_LS_DJUMP:--1} in
      1) command ls -a --color=auto ;;
      0) ;;
      *)
        case ${DNAV_CFG_LS:-0} in
          1|true|yes|on|TRUE|YES|ON) command ls -a --color=auto ;;
        esac
        ;;
    esac
  fi
  return 0
}

_djump_list_keys() {
  _djump_ensure || return 1
  print -l -- "${_DJUMP_KEYS[@]}"
}

# Print matching keys for query (case-insensitive). Query may be "dhome", "home", "ho".
_djump_match_query() {
  local q="${(L)1}" k kl dkl
  local -a hits
  _djump_ensure || return 1
  [[ -z $q ]] && return 0
  for k in "${_DJUMP_KEYS[@]}"; do
    kl="${(L)k}"
    dkl="d${kl}"
    if [[ $kl == ${q}* || $dkl == ${q}* || $q == $kl || $q == $dkl ]]; then
      hits+=("$k")
    fi
  done
  (( $#hits )) && print -l -- "${hits[@]}"
}

# Mutators used by `djump` and by dnav Settings. On failure REPLY is the error.
# On success REPLY is a one-line confirmation.
_djump_add() {
  local label="$1" jpath="${2:-$PWD}" dest why
  REPLY=""
  _djump_ensure_table
  if [[ -z $label ]]; then
    REPLY="usage: djump add LABEL [PATH]"
    return 1
  fi
  if ! _djump_valid_label "$label"; then
    REPLY="djump: invalid label '$label' (use letters, digits, _)"
    return 1
  fi
  if _djump_cmd_clash "$label"; then
    why="$REPLY"
    REPLY="djump: '$label' would shadow d${label} ($why)"
    return 1
  fi
  dest="$(_djump_expand "$jpath")"
  if [[ ! -d $dest ]]; then
    REPLY="djump: not a directory: $jpath"
    return 1
  fi
  if [[ -n ${_DJUMP_MAP[$label]:-} ]]; then
    REPLY="djump: '$label' exists (use: djump edit $label …)"
    return 1
  fi
  _DJUMP_KEYS+=("$label")
  _DJUMP_MAP[$label]="$dest"
  _djump_save || {
    REPLY="djump: failed to save jumps"
    return 1
  }
  REPLY="djump: added d${label} → $(_djump_store_path "$dest")"
  return 0
}

_djump_edit() {
  local label="$1" jpath="${2:-$PWD}" dest
  REPLY=""
  _djump_ensure_table
  if [[ -z $label ]]; then
    REPLY="usage: djump edit LABEL [PATH]"
    return 1
  fi
  label="$(_djump_existing_label "$label")" || {
    REPLY="djump: unknown label '$1' (try: djump -l)"
    return 1
  }
  dest="$(_djump_expand "$jpath")"
  if [[ ! -d $dest ]]; then
    REPLY="djump: not a directory: $jpath"
    return 1
  fi
  _DJUMP_MAP[$label]="$dest"
  _djump_save || {
    REPLY="djump: failed to save jumps"
    return 1
  }
  REPLY="djump: updated d${label} → $(_djump_store_path "$dest")"
  return 0
}

_djump_remove() {
  local label="$1" k
  local -a nkeys
  REPLY=""
  _djump_ensure_table
  if [[ -z $label ]]; then
    REPLY="usage: djump remove LABEL"
    return 1
  fi
  label="$(_djump_existing_label "$label")" || {
    REPLY="djump: unknown label '$1'"
    return 1
  }
  unset "_DJUMP_MAP[$label]"
  nkeys=()
  for k in "${_DJUMP_KEYS[@]}"; do
    [[ $k == "$label" ]] && continue
    nkeys+=("$k")
  done
  _DJUMP_KEYS=("${nkeys[@]}")
  _djump_save || {
    REPLY="djump: failed to save jumps"
    return 1
  }
  REPLY="djump: removed d${label}"
  return 0
}

_djump_print_list() {
  local k
  _djump_ensure || {
    print -u2 -- "djump: no jumps file at $(_djump_data_path)"
    return 1
  }
  if (( $#_DJUMP_KEYS == 0 )); then
    print -r -- "djump: no jumps yet (try: djump add <label>)"
    return 0
  fi
  for k in "${_DJUMP_KEYS[@]}"; do
    print -r -- "d${k}	${_DJUMP_MAP[$k]}"
  done
}

# Jump list only (plain text, pipe-friendly). Not usage. Warnings go to stderr.
dhelp() {
  _djump_print_list || return 1
  _djump_warn_stolen
}

_djump_print_help() {
  print -r -- "Usage: djump [OPTION]... [COMMAND] [ARG]..."
  print -r -- "       djump KEY"
  print -r -- "Jump to a saved folder, or manage the jump table."
  print -r -- ""
  print -r -- "With no operands, list jumps. KEY is the same as running dKEY"
  print -r -- "(for example, djump home and dhome both go to that folder)."
  print -r -- ""
  print -r -- "Commands:"
  print -r -- "  add LABEL [PATH]     add a jump (PATH defaults to the current directory)"
  print -r -- "  edit LABEL [PATH]    change the path for LABEL"
  print -r -- "  remove LABEL         remove LABEL and the dLABEL command"
  print -r -- ""
  print -r -- "Options:"
  print -r -- "  -l, --list           list jumps as dKEY and path"
  print -r -- "  -r, --reload         reload the jumps file and reinstall dKEY commands"
  print -r -- "  -c, --check          report dKEY names that clash with existing commands"
  print -r -- "  -h, --help           display this help and exit"
  print -r -- ""
  print -r -- "The jump table is ~/.config/dnav/jumps."
  print -r -- "dhelp prints the same list as djump --list."
}

# Warn about dKEY names that exist but are no longer our function (alias, etc.).
_djump_warn_stolen() {
  local k cmd
  _djump_ensure 2>/dev/null || return 0
  for k in "${_DJUMP_KEYS[@]}"; do
    cmd="d${k}"
    if (( $+aliases[$cmd] )); then
      print -u2 -- "djump: ${cmd} is no longer a DNav jump (now an alias). Use: djump $k"
      continue
    fi
    if (( $+functions[$cmd] )) && ! _djump_owned "$cmd"; then
      print -u2 -- "djump: ${cmd} is no longer a DNav jump (now a function). Use: djump $k"
    fi
  done
}

_djump_check() {
  local k cmd rec why
  local -a installed skipped stolen
  _djump_ensure_table
  installed=()
  skipped=("${_DJUMP_SKIPPED[@]}")
  stolen=()
  for k in "${_DJUMP_KEYS[@]}"; do
    cmd="d${k}"
    if (( $+aliases[$cmd] )); then
      stolen+=("${cmd}:alias")
      continue
    fi
    if _djump_owned "$cmd"; then
      installed+=("$cmd")
      continue
    fi
    if (( $+functions[$cmd] )); then
      stolen+=("${cmd}:function")
    fi
  done
  print -r -- "djump: ${#_DJUMP_KEYS} table entries, ${#installed} commands installed"
  if (( $#installed )); then
    print -r -- "  installed  ${(j: :)installed}"
  fi
  if (( $#skipped )); then
    print -r -- "  skipped    ${(j: :)skipped}"
  fi
  if (( $#stolen )); then
    print -r -- "  stolen     ${(j: :)stolen}"
  fi
  (( $#stolen + $#skipped )) && return 1
  return 0
}

# User-facing: list, reload, manage, or jump.
#   djump                 list keys as dKEY → path
#   djump -l              same
#   djump -r              reload jumps file + reinstall dKEY cmds
#   djump -c / --check    clash report
#   djump add LABEL [PATH]
#   djump edit LABEL [PATH]
#   djump remove LABEL
#   djump home            cd to key "home" (same as dhome)
djump() {
  local msg
  case ${1:-} in
    -r|--reload)
      _DJUMP_LOADED=0
      if _djump_load; then
        print -r -- "djump: loaded ${#_DJUMP_KEYS} jumps (${#_DJUMP_SHELL_CMDS} commands)"
        msg="$(_djump_skip_summary)" && print -r -- "$msg"
        _djump_warn_stolen
        return 0
      fi
      print -u2 -- "djump: failed to load $(_djump_data_path)"
      return 1
      ;;
    -l|--list|list|'')
      _djump_print_list || return 1
      _djump_warn_stolen
      return 0
      ;;
    -c|--check)
      _djump_check
      return $?
      ;;
    -h|--help)
      _djump_print_help
      return 0
      ;;
    add)
      if _djump_add "$2" "${3:-$PWD}"; then
        print -r -- "$REPLY"
        return 0
      fi
      print -u2 -- "$REPLY"
      return 1
      ;;
    edit)
      if _djump_edit "$2" "${3:-$PWD}"; then
        print -r -- "$REPLY"
        return 0
      fi
      print -u2 -- "$REPLY"
      return 1
      ;;
    remove|rm|delete|del)
      if _djump_remove "$2"; then
        print -r -- "$REPLY"
        return 0
      fi
      print -u2 -- "$REPLY"
      return 1
      ;;
    -*)
      print -u2 -- "djump: unknown option: $1"
      print -u2 -- "Try 'djump --help' for more information."
      return 1
      ;;
    *)
      _djump_goto "$1"
      ;;
  esac
}

# Load once when sourced (installs dKEY commands into the shell).
# Skipped clashes stay quiet here — use djump -r / djump --check to see them.
_djump_load 2>/dev/null || true
if [[ -n ${DNAV_JUMP_WARN:-} && ${DNAV_JUMP_WARN} != 0 ]]; then
  _djump_skip_summary && true
fi
