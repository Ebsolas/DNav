#!/usr/bin/env zsh
# dfile — mini file explorer for dnav
#
# Layout (browse):
#   [ DNav Files:] [sib] sib sib …     ← brand + parent siblings
#   child1 child2 …                    ← dirs in cwd
#   - Show Hidden ○ ----…---- [perm]   ← status / permission line
#   file1 file2 …                      ← files in cwd
#
# Keys: hjkl / arrows, Tab, . hidden, Enter, Esc, d Jump, s Search

_dfile_available() { return 0 }

typeset -gi _DFILE_OPEN=0
typeset -ga _dfile_vis
typeset -g  _DFILE_LIST_DENY=""

_dfile_is_open() { (( _DFILE_OPEN )) }

_dfile_hl() { print -rn -- "${DNAV_HIGHLIGHT:-${HIGHLIGHT:-\e[30;46m}}" }
_dfile_rst() { print -rn -- "${DNAV_RESET:-${RESET:-\e[0m}}" }
_dfile_cols() {
  local w=${cols:-${COLUMNS:-80}}
  (( w < 20 )) && w=80
  print -rn -- "$w"
}

# List basenames. kind=dirs|files. Returns 1 if unreadable; sets _DFILE_LIST_DENY.
_dfile_list() {
  local dir="$1" kind="$2" show_hidden="$3"
  local -a raw names
  local e b
  names=()
  _DFILE_LIST_DENY=""
  if [[ ! -d $dir ]]; then
    return 1
  fi
  if [[ ! -r $dir ]]; then
    _DFILE_LIST_DENY="$dir"
    return 1
  fi
  setopt localoptions nullglob

  if [[ $kind == dirs ]]; then
    if (( show_hidden )); then
      raw=("$dir"/*(/) "$dir"/.*(/))
    else
      raw=("$dir"/*(/))
    fi
  else
    if (( show_hidden )); then
      raw=("$dir"/*(.) "$dir"/.*(.))
    else
      raw=("$dir"/*(.))
    fi
  fi

  for e in "$raw[@]"; do
    b="${e:t}"
    [[ $b == . || $b == .. ]] && continue
    names+=("$b")
  done
  (( $#names )) && names=("${(@o)names}")
  print -l -- "${names[@]}"
  return 0
}

# Windowing: reply=(win_start), _dfile_vis=(labels)
_dfile_window() {
  local aname="$1" sel="$2" win="$3" maxw="$4"
  local -a all
  all=("${(@P)aname}")
  local n=$#all
  (( n == 0 )) && { reply=(0); _dfile_vis=(); return 0 }

  (( sel < 0 )) && sel=0
  (( sel >= n )) && sel=$(( n - 1 ))
  (( win < 0 )) && win=0
  (( win > sel )) && win=$sel

  local -a vis
  local i w used label vcount sel_slot changed=1 guard=0

  while (( changed && guard < 40 )); do
    (( guard++ ))
    changed=0
    vis=()
    used=0
    for (( i=win; i < n; i++ )); do
      label="${all[i+1]}"
      w=$(( ${#label} + 3 ))
      if (( $#vis > 0 && used + w > maxw )); then
        break
      fi
      if (( $#vis == 0 && w > maxw )); then
        vis+=("$label")
        break
      fi
      vis+=("$label")
      (( used += w ))
    done
    vcount=$#vis
    (( vcount == 0 )) && break
    sel_slot=$(( sel - win ))
    if (( sel_slot >= vcount )); then
      if (( vcount >= 2 )); then
        win=$(( sel - (vcount - 2) ))
      else
        win=$sel
      fi
      (( win < 0 )) && win=0
      changed=1
      continue
    fi
    if (( sel_slot == vcount - 1 && sel < n - 1 && vcount >= 2 )); then
      local nwin=$(( sel - (vcount - 2) ))
      (( nwin < 0 )) && nwin=0
      if (( nwin != win )); then
        win=$nwin
        changed=1
      fi
    fi
  done

  _dfile_vis=("${vis[@]}")
  reply=($win)
}

# Paint a horizontal strip at the current cursor line.
# Does not emit leading newline. Clears to EOL.
# Sets reply=(new_win)
_dfile_paint_strip() {
  local aname="$1"
  local sel="$2"
  local win="$3"
  local active="$4"
  local maxw="$5"
  local hl rst
  local -a items
  items=("${(@P)aname}")
  hl="$(_dfile_hl)"
  rst="$(_dfile_rst)"

  _dfile_window "$aname" "$sel" "$win" "$maxw"
  win=$reply[1]

  local i label used=0 n=$#items cell_w
  for (( i=win; i < n; i++ )); do
    label="${items[i+1]}"
    cell_w=$(( ${#label} + 3 ))
    if (( used > 0 && used + cell_w > maxw )); then
      break
    fi
    if (( used == 0 && cell_w > maxw )); then
      label="${label[1,maxw-2]}…"
      cell_w=$maxw
    fi
    if (( active && i == sel )); then
      printf "${hl} %s ${rst} " "$label"
    else
      printf " %s  " "$label"
    fi
    (( used += cell_w ))
  done
  printf "\e[K"
  reply=($win)
}

_dfile_enter() {
  local start="${1:-}"
  local hl rst maxw
  local key key2 key3
  local show_hidden=0
  local focus=siblings   # siblings | children | files
  local mode=browse      # browse | jump
  local jump_buf=""
  local -a siblings children files
  local sel_s=0 sel_c=0 sel_f=0
  local win_s=0 win_c=0 win_f=0
  # body = lines below the top row (always 3 in browse: children, status, files)
  local body=0
  local cwd parent
  local perm_denied=""   # path string if unreadable

  _DFILE_OPEN=1
  hl="$(_dfile_hl)"
  rst="$(_dfile_rst)"

  if [[ -n $start && -d $start ]]; then
    cd -- "$start" 2>/dev/null || true
  fi

  # Move cursor to top row of our UI (row 0), if we have body lines below.
  _dfile_to_top() {
    if (( body > 0 )); then
      printf "\e[%dA" $body
    fi
  }

  # Clear body lines below top, leave cursor on top row.
  _dfile_clear_body() {
    local i w
    w="$(_dfile_cols)"
    if (( body <= 0 )); then
      printf "\r\e[2K"
      return
    fi
    local i
    for (( i=0; i < body; i++ )); do
      printf "\n\r\e[2K"
    done
    printf "\e[%dA" $body
    printf "\r\e[2K"
  }

  _dfile_refresh() {
    local out rc
    cwd="${PWD:A}"
    parent="${cwd:h}"
    [[ -z $parent ]] && parent="/"
    perm_denied=""

    siblings=()
    children=()
    files=()

    out="$(_dfile_list "$parent" dirs $show_hidden 2>/dev/null)"
    rc=$?
    if (( rc != 0 )); then
      [[ -n $_DFILE_LIST_DENY ]] && perm_denied="$_DFILE_LIST_DENY"
      siblings=()
    else
      [[ -n $out ]] && siblings=("${(@f)out}") || siblings=()
    fi

    out="$(_dfile_list "$cwd" dirs $show_hidden 2>/dev/null)"
    rc=$?
    if (( rc != 0 )); then
      [[ -n $_DFILE_LIST_DENY ]] && perm_denied="$_DFILE_LIST_DENY"
      children=()
    else
      [[ -n $out ]] && children=("${(@f)out}") || children=()
    fi

    out="$(_dfile_list "$cwd" files $show_hidden 2>/dev/null)"
    rc=$?
    if (( rc != 0 )); then
      [[ -n $_DFILE_LIST_DENY ]] && perm_denied="$_DFILE_LIST_DENY"
      files=()
    else
      [[ -n $out ]] && files=("${(@f)out}") || files=()
    fi

    # Highlight current directory name among siblings
    local base="${cwd:t}" i
    sel_s=0
    for (( i=1; i <= $#siblings; i++ )); do
      if [[ ${siblings[i]} == $base ]]; then
        sel_s=$(( i - 1 ))
        break
      fi
    done
    (( $#children == 0 )) && sel_c=0
    (( $#files == 0 )) && sel_f=0
    (( sel_c >= $#children && $#children > 0 )) && sel_c=$(( $#children - 1 ))
    (( sel_f >= $#files && $#files > 0 )) && sel_f=$(( $#files - 1 ))
  }

  _dfile_paint_status() {
    local w="$1" hid_mark left right fill
    if (( show_hidden )); then hid_mark="●"; else hid_mark="○"; fi
    left="- Show Hidden ${hid_mark} "
    if [[ -n $perm_denied ]]; then
      right=" Permission Denied: ${perm_denied} "
      # truncate right if needed
      if (( ${#left} + ${#right} > w )); then
        local room=$(( w - ${#left} - 5 ))
        (( room < 8 )) && room=8
        right=" …${right:$(( ${#right} - room ))} "
      fi
    else
      right=""
    fi
    fill=$(( w - ${#left} - ${#right} ))
    (( fill < 0 )) && fill=0
    printf "\r%s" "$left"
    printf '%*s' $fill '' | tr ' ' '-'
    printf "%s\e[K" "$right"
  }

  # Full redraw. Cursor ends on top row.
  _dfile_draw() {
    local brand_w rest_w hid_mark
    maxw="$(_dfile_cols)"
    hl="$(_dfile_hl)"
    rst="$(_dfile_rst)"
    printf "\e[?25l"

    # Go to top of existing UI and clear previous body
    _dfile_to_top
    _dfile_clear_body

    if [[ $mode == jump ]]; then
      printf "\r${hl} DNav Jump: ${rst} %s\e[K" "$jump_buf"
      local -a hits
      local k n=0 i
      hits=()
      if _djump_available 2>/dev/null; then
        hits=("${(@f)$(_djump_match_query "$jump_buf")}")
      fi
      for k in "${hits[@]:0:6}"; do
        printf "\n\r\e[2m  d%s → %s${rst}\e[K" "$k" \
          "$(_djump_resolve "$k" 2>/dev/null || true)"
        (( n++ ))
      done
      body=$n
      if (( body > 0 )); then
        printf "\e[%dA" $body
      fi
      printf "\r"
      return
    fi

    # ── Line 0: brand + siblings ──────────────────────────────────────
    local brand=" DNav Files: "
    printf "\r${hl}%s${rst}" "$brand"
    brand_w=${#brand}
    rest_w=$(( maxw - brand_w ))
    (( rest_w < 8 )) && rest_w=8
    _dfile_paint_strip siblings $sel_s $win_s \
      $([[ $focus == siblings ]] && print 1 || print 0) $rest_w
    win_s=$reply[1]

    # ── Line 1: children ──────────────────────────────────────────────
    printf "\n"
    _dfile_paint_strip children $sel_c $win_c \
      $([[ $focus == children ]] && print 1 || print 0) $maxw
    win_c=$reply[1]

    # ── Line 2: status rule ───────────────────────────────────────────
    printf "\n"
    _dfile_paint_status $maxw

    # ── Line 3: files ─────────────────────────────────────────────────
    printf "\n"
    _dfile_paint_strip files $sel_f $win_f \
      $([[ $focus == files ]] && print 1 || print 0) $maxw
    win_f=$reply[1]

    body=3
    printf "\e[3A\r"
  }

  _dfile_erase() {
    local i w
    w="$(_dfile_cols)"
    _dfile_to_top
    printf "\r\e[2K"
    for (( i=0; i < body; i++ )); do
      printf "\n\r\e[2K"
    done
    (( body > 0 )) && printf "\e[%dA" $body
    printf "\r\e[2K"
    body=0
  }

  _dfile_go() {
    local dest="$1"
    if [[ ! -d $dest ]]; then
      return 1
    fi
    if ! cd -- "$dest" 2>/dev/null; then
      perm_denied="$dest"
      _dfile_draw
      return 1
    fi
    _dfile_refresh
    win_c=0; win_f=0; sel_c=0; sel_f=0
    _dfile_draw
  }

  _dfile_enter_sel_dir() {
    local name dest
    case $focus in
      siblings)
        (( $#siblings )) || return 1
        name="${siblings[sel_s+1]}"
        if [[ $parent == / ]]; then dest="/$name"; else dest="$parent/$name"; fi
        ;;
      children)
        (( $#children )) || return 1
        name="${children[sel_c+1]}"
        dest="$cwd/$name"
        ;;
      *) return 1 ;;
    esac
    _dfile_go "$dest"
  }

  _dfile_open_file() {
    (( $#files )) || return 1
    local fpath="$cwd/${files[sel_f+1]}"
    [[ -e $fpath ]] || return 1
    _dfile_erase
    _DFILE_OPEN=0
    if (( $+functions[_dnav_cleanup] )); then
      _dnav_cleanup
    else
      printf "\e[?25h"
    fi
    if [[ -n ${EDITOR:-} ]]; then
      ${=EDITOR} -- "$fpath"
    elif command -v xdg-open >/dev/null 2>&1; then
      xdg-open "$fpath" >/dev/null 2>&1 &
    else
      printf "No EDITOR/xdg-open for %s\n" "$fpath"
    fi
    return 0
  }

  _dfile_scroll_to_sel() {
    local aname="$1" sel="$2" win="$3" dir="$4"
    local n maxw="$(_dfile_cols)" vc
    local -a all
    all=("${(@P)aname}")
    n=$#all
    (( n == 0 )) && { reply=(0); return }
    _dfile_window "$aname" $sel $win $maxw
    win=$reply[1]
    vc=$#_dfile_vis
    if (( dir > 0 && sel < n - 1 && vc >= 2 )); then
      win=$(( sel - (vc - 2) ))
      (( win < 0 )) && win=0
    elif (( dir < 0 && sel > 0 && vc >= 2 )); then
      if (( sel - win == 0 )); then
        win=$(( sel - 1 ))
        (( win < 0 )) && win=0
      fi
    fi
    _dfile_window "$aname" $sel $win $maxw
    reply=($reply[1])
  }

  _dfile_move_h() {
    local dir="$1" n
    case $focus in
      siblings)
        n=$#siblings; (( n == 0 )) && return
        (( sel_s += dir ))
        (( sel_s < 0 )) && sel_s=0
        (( sel_s >= n )) && sel_s=$(( n - 1 ))
        _dfile_scroll_to_sel siblings $sel_s $win_s $dir
        win_s=$reply[1]
        ;;
      children)
        n=$#children; (( n == 0 )) && return
        (( sel_c += dir ))
        (( sel_c < 0 )) && sel_c=0
        (( sel_c >= n )) && sel_c=$(( n - 1 ))
        _dfile_scroll_to_sel children $sel_c $win_c $dir
        win_c=$reply[1]
        ;;
      files)
        n=$#files; (( n == 0 )) && return
        (( sel_f += dir ))
        (( sel_f < 0 )) && sel_f=0
        (( sel_f >= n )) && sel_f=$(( n - 1 ))
        _dfile_scroll_to_sel files $sel_f $win_f $dir
        win_f=$reply[1]
        ;;
    esac
    _dfile_draw
  }

  _dfile_refresh
  body=0
  _dfile_draw

  while true; do
    read -k 1 key

    if [[ $mode == jump ]]; then
      case $key in
        $'\e')
          if read -t 0.05 -k 1 key2 2>/dev/null; then
            [[ $key2 == '[' ]] && read -k 1 key3
          else
            mode=browse
            jump_buf=""
            _dfile_draw
          fi
          ;;
        $'\n'|$'\r')
          if _djump_available 2>/dev/null; then
            local dest
            dest="$(_djump_resolve "$jump_buf" 2>/dev/null)" || dest=""
            if [[ -z $dest && $jump_buf != d* ]]; then
              dest="$(_djump_resolve "d$jump_buf" 2>/dev/null)" || dest=""
            fi
            if [[ -n $dest ]]; then
              mode=browse
              jump_buf=""
              if [[ -d $dest ]]; then
                _dfile_go "$dest"
              else
                perm_denied="$dest"
                _dfile_draw
              fi
            fi
          fi
          ;;
        $'\177'|$'\b')
          (( ${#jump_buf} > 0 )) && jump_buf="${jump_buf[1,-2]}"
          _dfile_draw
          ;;
        [[:print:]])
          jump_buf+="$key"
          _dfile_draw
          ;;
      esac
      continue
    fi

    case $key in
      $'\e')
        if read -t 0.05 -k 1 key2 2>/dev/null; then
          if [[ $key2 == '[' ]]; then
            read -k 1 key3
            case $key3 in
              A) [[ $cwd != / ]] && _dfile_go "${cwd:h}" ;;
              B) _dfile_enter_sel_dir ;;
              C) _dfile_move_h 1 ;;
              D) _dfile_move_h -1 ;;
            esac
          fi
        else
          _dfile_erase
          _DFILE_OPEN=0
          return 1
        fi
        ;;
      h) _dfile_move_h -1 ;;
      l) _dfile_move_h 1 ;;
      k) [[ $cwd != / ]] && _dfile_go "${cwd:h}" ;;
      j) _dfile_enter_sel_dir ;;
      $'\t')
        case $focus in
          siblings) focus=children ;;
          children) focus=files ;;
          files) focus=siblings ;;
        esac
        _dfile_draw
        ;;
      .)
        show_hidden=$(( 1 - show_hidden ))
        _dfile_refresh
        _dfile_draw
        ;;
      d)
        if _djump_available 2>/dev/null; then
          mode=jump
          jump_buf="d"
          _dfile_draw
        fi
        ;;
      s)
        if _dsearch_available 2>/dev/null; then
          # Leave a clean screen region for search overlay
          _dfile_erase
          body=0
          local spath
          if _dsearch_start_for_dfile; then
            spath="${DNAV_SEARCH_RESULT:-}"
            if [[ -n $spath && -d $spath ]]; then
              cd -- "$spath" 2>/dev/null || true
              _dfile_refresh
            fi
          fi
          body=0
          _dfile_draw
        fi
        ;;
      $'\n'|$'\r')
        if [[ $focus == files ]]; then
          if _dfile_open_file; then
            return 0
          fi
        else
          _dfile_enter_sel_dir
        fi
        ;;
    esac
  done
}
