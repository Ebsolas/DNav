#!/usr/bin/env zsh
# dsearch - fuzzy directory search plugin for dnav
#
# Provides:
#   _dsearch_available    – always true when this file is sourced
#   _dsearch_start        – search overlay (return 0 = navigated/done, 1 = cancel → main)
#   _dsearch_in_dfile     – stub: jump inside dfile explorer (later)
#   _dsearch_ensure_index – ensure on-disk directory path cache is fresh
#
# Strategy: load-once path list, incremental filter-out, awk scorer (not pure zsh).
# Index: ${XDG_CACHE_HOME:-$HOME/.cache}/dnav/dirs.idx  (dirs only, rebuilt after 24h)
# Scope: $HOME + common roots; prunes noisy trees. Override roots with DNAV_SEARCH_ROOTS.

_dsearch_available() { return 0 }

# ── dfile hook (stub) ─────────────────────────────────────────────────────
_dsearch_in_dfile() {
  return 1
}

# ── Spinner ───────────────────────────────────────────────────────────────
# Braille “dots marching” — no status text
typeset -ga _DSEARCH_SPINNER_FRAMES
_DSEARCH_SPINNER_FRAMES=(⠄⠄⠄ ⠂⠄⠄ ⠁⠂⠄ ⠂⠁⠂ ⠄⠂⠁ ⠄⠄⠂)

# Run command while animating spinner on the current line. No text labels.
_dsearch_run_with_spinner() {
  local i=1 pid ret
  local hl rst w frame
  hl="${DNAV_HIGHLIGHT:-${HIGHLIGHT:-\e[30;46m}}"
  rst="${DNAV_RESET:-${RESET:-\e[0m}}"
  w=${cols:-${COLUMNS:-80}}
  (( w < 8 )) && w=80
  (
    "$@"
  ) &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    frame="${_DSEARCH_SPINNER_FRAMES[i]}"
    printf "\r${hl} %s%*s${rst}" "$frame" $(( w - ${#frame} - 1 )) ""
    (( i = i % $#_DSEARCH_SPINNER_FRAMES + 1 ))
    sleep 0.1
  done
  wait "$pid"
  ret=$?
  printf "\r%*s\r" $w ""
  return $ret
}

# ── Index ─────────────────────────────────────────────────────────────────
_dsearch_index_path() {
  print -r -- "${XDG_CACHE_HOME:-$HOME/.cache}/dnav/dirs.idx"
}

_dsearch_index_stale() {
  local idx="$1"
  [[ ! -f $idx || ! -s $idx ]] && return 0
  local now mtime age
  now=$(date +%s)
  mtime=$(stat -c %Y -- "$idx" 2>/dev/null) || return 0
  age=$(( now - mtime ))
  (( age > 86400 ))
}

_dsearch_collect_roots() {
  local -a roots
  local r
  if [[ -n ${DNAV_SEARCH_ROOTS:-} ]]; then
    roots=(${=DNAV_SEARCH_ROOTS})
  else
    roots=("$HOME")
    for r in /opt /usr/local /mnt /media /var/www; do
      [[ -d $r ]] && roots+=("$r")
    done
  fi
  print -r -- "${roots[@]}"
}

_dsearch_build_index() {
  local idx="$1"
  local tmp="${idx}.tmp.$$"
  local -a roots
  local r

  mkdir -p "${idx:h}" 2>/dev/null || return 1
  roots=($(_dsearch_collect_roots))

  : > "$tmp"
  for r in $roots; do
    [[ -d $r ]] || continue
    find "$r" \
      \( \
        -name .git -o \
        -name node_modules -o \
        -name target -o \
        -name __pycache__ -o \
        -name .npm -o \
        -name .cargo -o \
        -name .cache -o \
        -name Trash -o \
        -name .Trash \
      \) -prune -o \
      -type d -print 2>/dev/null
  done >> "$tmp"

  if command -v sort >/dev/null 2>&1; then
    sort -u "$tmp" -o "$tmp" 2>/dev/null || true
  fi

  mv -f "$tmp" "$idx"
}

# Ensure on-disk index exists and is fresh. Does not load into a zsh array.
# Uses braille spinner while rebuilding (no text).
_dsearch_ensure_index() {
  local idx
  idx="$(_dsearch_index_path)"

  if ! _dsearch_index_stale "$idx"; then
    return 0
  fi

  if ! _dsearch_run_with_spinner _dsearch_build_index "$idx"; then
    return 1
  fi
  [[ -f $idx && -s $idx ]]
}

# ── Session state (search UI) ─────────────────────────────────────────────
typeset -ga _dsearch_matches
typeset -gi _dsearch_sel=0
typeset -gi _dsearch_extra_lines=0
typeset -g  _dsearch_tmpdir=""
typeset -g  _dsearch_prev_query=""
# Sparse map: length -> candidate file of ALL survivors for that query
typeset -gA _dsearch_cand_stack

_dsearch_session_cleanup() {
  if [[ -n $_dsearch_tmpdir && -d $_dsearch_tmpdir ]]; then
    rm -rf -- "$_dsearch_tmpdir" 2>/dev/null
  fi
  _dsearch_tmpdir=""
  _dsearch_prev_query=""
  _dsearch_q=""
  _dsearch_cand_stack=()
  _dsearch_focus=list
  _dsearch_view=search
}

# ── awk filter (hot path) ─────────────────────────────────────────────────
# Args: query, mode (prefix1|fuzzy), maxn, src_file, survivors_out
# Prints top maxn paths (one per line) to stdout.
# Writes ALL matching paths to survivors_out.
_dsearch_awk_filter() {
  local query="$1" mode="$2" maxn="$3" src="$4" survivors="$5"

  awk -v query="$query" -v mode="$mode" -v maxn="$maxn" -v surv="$survivors" '
  function consider(sc, path,   i) {
    # top-N insert (desc)
    if (maxn > 0) {
      if (tn == maxn && sc <= tsc[tn]) {
        # still a survivor overall; just skip top list
      } else {
        if (tn < maxn) tn++
        i = tn
        while (i > 1 && sc > tsc[i-1]) {
          tsc[i] = tsc[i-1]
          tpath[i] = tpath[i-1]
          i--
        }
        tsc[i] = sc
        tpath[i] = path
      }
    }
  }

  function fuzzy_score(path, q,   lp, qlen, plen, score, run, last, pi, qi, ch, pc, prev, found) {
    lp = tolower(path)
    q = tolower(q)
    qlen = length(q)
    plen = length(lp)
    if (qlen == 0) return -1
    score = 0; run = 0; last = -2; pi = 1
    for (qi = 1; qi <= qlen; qi++) {
      ch = substr(q, qi, 1)
      found = 0
      for (; pi <= plen; pi++) {
        pc = substr(lp, pi, 1)
        if (pc == ch) {
          found = 1
          if (pi == last + 1) { run++; score += 8 + run }
          else { run = 0; score += 2 }
          prev = (pi == 1) ? "" : substr(lp, pi - 1, 1)
          if (pi == 1 || prev == "/") score += 12
          if (prev == "-" || prev == "_" || prev == ".") score += 4
          last = pi
          pi++
          break
        }
      }
      if (!found) return -1
    }
    score += 40 - (plen < 40 ? plen : 40)
    return score
  }

  # Component-prefix: any path segment starts with the (single) query char
  function prefix1_score(path, q,   lp, ch, n, i, seg, best, sc, plen) {
    lp = tolower(path)
    ch = tolower(substr(q, 1, 1))
    if (ch == "") return -1
    n = split(lp, seg, "/")
    best = -1
    for (i = 1; i <= n; i++) {
      if (seg[i] == "") continue
      if (substr(seg[i], 1, 1) == ch) {
        sc = 50
        # Prefer shorter segment / shorter full path
        sc += 20 - (length(seg[i]) < 20 ? length(seg[i]) : 20)
        plen = length(lp)
        sc += 30 - (plen < 30 ? plen : 30)
        # Prefer last component match
        if (i == n) sc += 15
        if (sc > best) best = sc
      }
    }
    return best
  }

  BEGIN { tn = 0 }
  {
    path = $0
    if (path == "") next
    if (mode == "prefix1") sc = prefix1_score(path, query)
    else sc = fuzzy_score(path, query)
    if (sc < 0) next
    print path >> surv
    consider(sc, path)
  }
  END {
    for (i = 1; i <= tn; i++) print tpath[i]
  }
  ' "$src"
}

# Apply filter for $query using incremental candidate stack when possible.
# Sets _dsearch_matches (top 10). Updates stack for this query length.
_dsearch_apply_filter() {
  local query="$1"
  local maxn="${2:-10}"
  local qlen=${#query}
  local idx src mode survivors
  local -a top

  _dsearch_matches=()
  idx="$(_dsearch_index_path)"

  if (( qlen == 0 )); then
    _dsearch_prev_query=""
    return 0
  fi

  survivors="$_dsearch_tmpdir/c.${qlen}"
  : > "$survivors"

  local prev_len=${#_dsearch_prev_query}
  local i partial

  # Choose source + mode
  if (( qlen == 1 )); then
    src="$idx"
    mode="prefix1"
  elif (( qlen < prev_len )) && [[ -n ${_dsearch_cand_stack[$qlen]:-} && -s ${_dsearch_cand_stack[$qlen]} ]]; then
    # Backspace: re-rank existing survivors for this length
    src="${_dsearch_cand_stack[$qlen]}"
    mode="fuzzy"
    (( qlen == 1 )) && mode="prefix1"
    top=("${(@f)$(_dsearch_awk_filter "$query" "$mode" "$maxn" "$src" "$survivors")}")
    _dsearch_matches=("${top[@]}")
    _dsearch_cand_stack[$qlen]="$survivors"
    _dsearch_prev_query="$query"
    return 0
  elif [[ -n $_dsearch_prev_query && $query == "$_dsearch_prev_query"* ]] && (( qlen > prev_len )); then
    # Query grew (1+ chars) — filter previous survivors only (incremental)
    if [[ -n ${_dsearch_cand_stack[$prev_len]:-} && -s ${_dsearch_cand_stack[$prev_len]} ]]; then
      src="${_dsearch_cand_stack[$prev_len]}"
    else
      src="$idx"
    fi
    mode="fuzzy"
  elif (( qlen > 1 )) && [[ -z ${_dsearch_cand_stack[1]:-} || ! -s ${_dsearch_cand_stack[1]} ]]; then
    # Cold multi-char query (e.g. coalesced "proj"): progressive 1..qlen once
    for (( i=1; i <= qlen; i++ )); do
      partial="${query[1,i]}"
      survivors="$_dsearch_tmpdir/c.${i}"
      : > "$survivors"
      if (( i == 1 )); then
        src="$idx"
        mode="prefix1"
      else
        src="${_dsearch_cand_stack[$((i - 1))]}"
        mode="fuzzy"
        [[ -s $src ]] || src="$idx"
      fi
      if (( i == qlen )); then
        top=("${(@f)$(_dsearch_awk_filter "$partial" "$mode" "$maxn" "$src" "$survivors")}")
      else
        _dsearch_awk_filter "$partial" "$mode" 0 "$src" "$survivors" >/dev/null
      fi
      _dsearch_cand_stack[$i]="$survivors"
    done
    _dsearch_matches=("${top[@]}")
    _dsearch_prev_query="$query"
    return 0
  else
    src="$idx"
    mode="fuzzy"
    (( qlen == 1 )) && mode="prefix1"
  fi

  top=("${(@f)$(_dsearch_awk_filter "$query" "$mode" "$maxn" "$src" "$survivors")}")
  _dsearch_matches=("${top[@]}")
  _dsearch_cand_stack[$qlen]="$survivors"
  _dsearch_prev_query="$query"
}

# ── UI ────────────────────────────────────────────────────────────────────
# Matches dnav: black-on-cyan full-width bars (same DNAV_HIGHLIGHT / success bar).

_dsearch_hl() {
  print -rn -- "${DNAV_HIGHLIGHT:-${HIGHLIGHT:-\e[30;46m}}"
}
_dsearch_rst() {
  print -rn -- "${DNAV_RESET:-${RESET:-\e[0m}}"
}

_dsearch_cols() {
  local w=${cols:-${COLUMNS:-80}}
  (( w < 8 )) && w=80
  print -rn -- "$w"
}

# Shorten path for display (~ for $HOME); optional max length.
_dsearch_display_path() {
  local p="$1" maxw="${2:-0}"
  local home="$HOME"
  if [[ $p == $home || $p == $home/* ]]; then
    p="~${p#$home}"
  fi
  if (( maxw > 0 && ${#p} > maxw )); then
    p="…${p:$(( ${#p} - maxw + 1 ))}"
  fi
  print -r -- "$p"
}

# Truncate/pad a string to exactly w columns (byte length; fine for paths).
_dsearch_fit() {
  local s="$1" w="$2"
  if (( ${#s} > w )); then
    if (( w <= 1 )); then
      s="${s[1,w]}"
    else
      s="…${s:$(( ${#s} - w + 1 ))}"
    fi
  fi
  printf "%-${w}s" "$s"
}

# Focus: list (result rows) | help (Help chip on the bar)
typeset -g _dsearch_focus=list
# View: search (normal) | help (help overlay inside dsearch)
typeset -g _dsearch_view=search

# Help body lines (shown under the bar when Help is opened)
_dsearch_help_lines() {
  print -r -- "Type to fuzzy-find directories"
  print -r -- "↑/↓  or  Ctrl+N / Ctrl+P    move selection"
  print -r -- "Enter                       open selected folder"
  print -r -- "→                           focus Help button"
  print -r -- "←                           leave Help button"
  print -r -- "Enter on Help               show this help"
  print -r -- "Esc                         close help / leave search"
  print -r -- "Ctrl+U                      clear query"
  print -r -- "Backspace                   delete character"
}

# Paint one full-width row at the current line (no prior clear → less flicker).
# $1 = mode: bar | sel | row | blank | help_row
# $2 = text (ignored for blank)
_dsearch_paint_row() {
  local mode="$1" text="${2:-}"
  local hl rst maxw inner
  maxw="$(_dsearch_cols)"
  hl="$(_dsearch_hl)"
  rst="$(_dsearch_rst)"

  case $mode in
    bar)
      # Full-width cyan: query left, optional count, Help chip on the right
      local left count helpchip gap avail mid
      left="/${text}"
      helpchip=" Help "
      if (( $#_dsearch_matches > 0 )) && [[ ${_dsearch_focus:-list} == list ]]; then
        count=" $(( _dsearch_sel + 1 ))/$#_dsearch_matches "
      else
        count=""
      fi
      avail=$(( maxw - ${#count} - ${#helpchip} ))
      (( avail < 1 )) && avail=1
      if (( ${#left} > avail )); then
        if (( avail <= 1 )); then
          left="${left[1,avail]}"
        else
          left="${left[1,avail-1]}…"
        fi
      fi
      gap=$(( maxw - ${#left} - ${#count} - ${#helpchip} ))
      (( gap < 0 )) && gap=0
      if [[ ${_dsearch_focus:-list} == help ]]; then
        # Query+count in cyan; Help chip reverse so it reads as the focused button
        printf "\r${hl}%s%*s%s${rst}\e[7m%s${rst}" \
          "$left" $gap "" "$count" "$helpchip"
      else
        printf "\r${hl}%s%*s%s%s${rst}" \
          "$left" $gap "" "$count" "$helpchip"
      fi
      ;;
    sel)
      # Selected match: full-width cyan + pointer
      inner=$(( maxw - 2 ))
      (( inner < 1 )) && inner=1
      printf "\r${hl}▶ %s${rst}" "$(_dsearch_fit "$text" $inner)"
      ;;
    row)
      # Unselected: faint, full-width pad so old cyan is fully overwritten
      inner=$(( maxw - 2 ))
      (( inner < 1 )) && inner=1
      printf "\r\e[2m  %s${rst}" "$(_dsearch_fit "$text" $inner)"
      ;;
    help_row)
      # Help overlay body line
      printf "\r${hl}%-${maxw}s${rst}" "$(_dsearch_fit " $text" $maxw)"
      ;;
    blank)
      printf "\r%*s" $maxw ""
      ;;
  esac
}

# Full redraw of prompt + dropdown (or help overlay). Cursor stays hidden.
_dsearch_draw() {
  local query="$1"
  local n p disp i leftover
  local -a hlines

  printf "\e[?25l"

  _dsearch_paint_row bar "$query"

  n=0
  if [[ ${_dsearch_view:-search} == help ]]; then
    hlines=("${(@f)$(_dsearch_help_lines)}")
    for p in "${hlines[@]}"; do
      printf "\n"
      _dsearch_paint_row help_row "$p"
      (( n++ ))
    done
  else
    for p in "${_dsearch_matches[@]}"; do
      disp="$(_dsearch_display_path "$p")"
      printf "\n"
      # When Help chip is focused, no list row looks selected
      if [[ ${_dsearch_focus:-list} == list ]] && (( n == _dsearch_sel )); then
        _dsearch_paint_row sel "$disp"
      else
        _dsearch_paint_row row "$disp"
      fi
      (( n++ ))
    done
  fi

  leftover=$(( _dsearch_extra_lines - n ))
  for (( i=0; i < leftover; i++ )); do
    printf "\n"
    _dsearch_paint_row blank
  done
  if (( leftover > 0 )); then
    printf "\e[%dA" $leftover
  fi

  _dsearch_extra_lines=$n

  if (( n > 0 )); then
    printf "\e[%dA" $n
  fi
  printf "\r"
}

# Selection moved only — repaint two rows + bar (minimal flicker).
_dsearch_draw_sel() {
  local query="$1"
  local old="$2"   # previous index
  local n=$#_dsearch_matches
  local disp

  [[ ${_dsearch_view:-search} == search ]] || return 0
  (( n == 0 )) && return 0
  printf "\e[?25l"

  _dsearch_paint_row bar "$query"

  if (( old >= 0 && old < n )); then
    printf "\e[%dB" $(( old + 1 ))
    disp="$(_dsearch_display_path "${_dsearch_matches[old+1]}")"
    _dsearch_paint_row row "$disp"
    printf "\e[%dA" $(( old + 1 ))
  fi

  if [[ ${_dsearch_focus:-list} == list ]]; then
    printf "\e[%dB" $(( _dsearch_sel + 1 ))
    disp="$(_dsearch_display_path "${_dsearch_matches[_dsearch_sel+1]}")"
    _dsearch_paint_row sel "$disp"
    printf "\e[%dA" $(( _dsearch_sel + 1 ))
  fi
  printf "\r"
}

_dsearch_erase_ui() {
  local i maxw
  maxw="$(_dsearch_cols)"
  printf "\e[?25l"
  printf "\r%*s" $maxw ""
  for (( i=0; i < _dsearch_extra_lines; i++ )); do
    printf "\n"
    _dsearch_paint_row blank
  done
  if (( _dsearch_extra_lines > 0 )); then
    printf "\e[%dA" $_dsearch_extra_lines
  fi
  printf "\r%*s\r" $maxw ""
  _dsearch_extra_lines=0
}

_dsearch_focus_help() {
  _dsearch_focus=help
  _dsearch_draw "$_dsearch_q"
}

_dsearch_focus_list() {
  _dsearch_focus=list
  _dsearch_draw "$_dsearch_q"
}

_dsearch_open_help() {
  _dsearch_view=help
  _dsearch_focus=help
  _dsearch_draw "$_dsearch_q"
}

_dsearch_close_help() {
  _dsearch_view=search
  _dsearch_focus=list
  _dsearch_draw "$_dsearch_q"
}

# Coalesce further keystrokes into $_dsearch_q, then filter once + draw.
# Main loop keeps query in $_dsearch_q for the session.
_dsearch_refresh_query() {
  local maxn=10
  local k
  local -i coalescing=1

  # Debounce / drain buffered input so fast typing = one filter
  while (( coalescing )); do
    if ! read -t 0.05 -k 1 k 2>/dev/null; then
      coalescing=0
      break
    fi
    case $k in
      $'\177'|$'\b')
        if (( ${#_dsearch_q} > 0 )); then
          _dsearch_q="${_dsearch_q[1,-2]}"
        fi
        ;;
      $'\x15')
        _dsearch_q=""
        ;;
      $'\e'|$'\n'|$'\r')
        _DSEARCH_PUSHBACK="$k"
        coalescing=0
        ;;
      $'\x0e'|$'\x10')  # Ctrl+N / Ctrl+P — selection, not query text
        _DSEARCH_PUSHBACK="$k"
        coalescing=0
        ;;
      [[:print:]])
        _dsearch_q+="$k"
        ;;
      *)
        ;;
    esac
  done

  _dsearch_sel=0
  _dsearch_focus=list
  # Stay in search view while typing (don't clobber open help mid-key — typing leaves help)
  if [[ ${_dsearch_view:-search} == help ]]; then
    _dsearch_view=search
  fi
  _dsearch_apply_filter "$_dsearch_q" $maxn
  _dsearch_draw "$_dsearch_q"
}

# Move highlight in the dropdown (arrows / Ctrl+N / Ctrl+P — not j/k, those type)
_dsearch_sel_up() {
  [[ ${_dsearch_view:-search} == search ]] || return 1
  if [[ ${_dsearch_focus:-list} == help ]]; then
    # Leave Help chip, keep current list index
    _dsearch_focus_list
    return 0
  fi
  (( $#_dsearch_matches && _dsearch_sel > 0 )) || return 1
  local old=$_dsearch_sel
  (( _dsearch_sel-- ))
  _dsearch_draw_sel "$_dsearch_q" $old
}

_dsearch_sel_down() {
  [[ ${_dsearch_view:-search} == search ]] || return 1
  if [[ ${_dsearch_focus:-list} == help ]]; then
    _dsearch_focus_list
    return 0
  fi
  (( $#_dsearch_matches && _dsearch_sel < $#_dsearch_matches - 1 )) || return 1
  local old=$_dsearch_sel
  (( _dsearch_sel++ ))
  _dsearch_draw_sel "$_dsearch_q" $old
}

# ── Main entry ────────────────────────────────────────────────────────────
# Return 0 → dnav should exit (navigated or finished with cleanup)
# Return 1 → cancelled; dnav redraws main bar
_dsearch_start() {
  if _dfile_available && (( $+functions[_dfile_is_open] )) && _dfile_is_open; then
    _dsearch_in_dfile
    return $?
  fi

  local key key2 key3
  local target
  local maxn=10
  typeset -g _DSEARCH_PUSHBACK=""
  typeset -g _dsearch_q=""

  _dsearch_q=""
  _dsearch_matches=()
  _dsearch_sel=0
  _dsearch_extra_lines=0
  _dsearch_prev_query=""
  _dsearch_cand_stack=()
  _dsearch_focus=list
  _dsearch_view=search

  _dsearch_tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/dnav-dsearch.XXXXXX") || {
    printf "\r\e[2K"
    printf "\e[?25l"
    return 1
  }

  # Keep cursor hidden in search mode (bar shows query; avoids blink on redraw)
  printf "\e[?25l"

  # Ensure index (braille spinner while rebuilding)
  if ! _dsearch_ensure_index; then
    _dsearch_session_cleanup
    printf "\r\e[2K"
    printf "\e[?25l"
    return 1
  fi

  _dsearch_draw "$_dsearch_q"

  while true; do
    if [[ -n $_DSEARCH_PUSHBACK ]]; then
      key="$_DSEARCH_PUSHBACK"
      _DSEARCH_PUSHBACK=""
    else
      read -k 1 key
    fi

    case $key in
      $'\e')  # Esc or arrows
        if read -t 0.05 -k 1 key2 2>/dev/null; then
          if [[ $key2 == '[' ]]; then
            read -k 1 key3
            case $key3 in
              A) _dsearch_sel_up ;;
              B) _dsearch_sel_down ;;
              C)  # Right → focus Help button (search view only)
                if [[ ${_dsearch_view:-search} == search ]]; then
                  _dsearch_focus_help
                fi
                ;;
              D)  # Left → leave Help button
                if [[ ${_dsearch_view:-search} == search && ${_dsearch_focus:-list} == help ]]; then
                  _dsearch_focus_list
                fi
                ;;
            esac
          fi
        else
          # Plain Esc
          if [[ ${_dsearch_view:-search} == help ]]; then
            # Return to search (keep query + results)
            _dsearch_close_help
          else
            _dsearch_erase_ui
            _dsearch_session_cleanup
            printf "\e[?25l"
            return 1
          fi
        fi
        ;;
      $'\n'|$'\r')
        if [[ ${_dsearch_view:-search} == help ]]; then
          # Enter in help overlay does nothing (Esc closes)
          continue
        fi
        if [[ ${_dsearch_focus:-list} == help ]]; then
          _dsearch_open_help
          continue
        fi
        if (( $#_dsearch_matches == 0 )); then
          continue
        fi
        target="${_dsearch_matches[_dsearch_sel+1]}"
        _dsearch_erase_ui
        _dsearch_session_cleanup
        printf "\e[?25l"
        if [[ -d $target ]]; then
          cd -- "$target" || {
            printf "Could not change to %s\n" "$target"
            (( $+functions[_dnav_cleanup] )) && _dnav_cleanup
            return 0
          }
          if (( $+functions[_dnav_success_bar] )); then
            _dnav_success_bar "${target:A}"
          else
            printf "%s\n" "${target:A}"
          fi
          (( $+functions[_dnav_cleanup] )) && _dnav_cleanup
          return 0
        else
          printf "Folder not found: %s\n" "$target"
          (( $+functions[_dnav_cleanup] )) && _dnav_cleanup
          return 0
        fi
        ;;
      $'\177'|$'\b')
        if [[ ${_dsearch_view:-search} == help ]]; then
          continue
        fi
        if (( ${#_dsearch_q} > 0 )); then
          _dsearch_q="${_dsearch_q[1,-2]}"
          _dsearch_refresh_query
        fi
        ;;
      $'\x15')
        if [[ ${_dsearch_view:-search} == help ]]; then
          continue
        fi
        _dsearch_q=""
        _dsearch_sel=0
        _dsearch_matches=()
        _dsearch_prev_query=""
        _dsearch_focus=list
        _dsearch_draw "$_dsearch_q"
        ;;
      $'\x10')  # Ctrl+P — previous match
        _dsearch_sel_up
        ;;
      $'\x0e')  # Ctrl+N — next match
        _dsearch_sel_down
        ;;
      [[:print:]])
        # Typing returns to search/list and appends to query
        if [[ ${_dsearch_view:-search} == help ]]; then
          _dsearch_view=search
        fi
        _dsearch_focus=list
        _dsearch_q+="$key"
        _dsearch_refresh_query
        ;;
    esac
  done
}
