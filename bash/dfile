#!/usr/bin/env bash
# dfile - mini file explorer for dnav (bash port)
#
# Keys: hjkl/arrows, Tab/f toggle dirs/files, . hidden, Enter exit/open, Esc, d Jump, s|/ Search

_dfile_available() { return 0; }

declare -gi _DFILE_OPEN=0
declare -ga _dfile_vis=()
declare -g  _DFILE_LIST_DENY=""
declare -g  _dfile_win_out=0
declare -g  _dfile_sel_path=""

_dfile_is_open() { (( _DFILE_OPEN )); }
_dfile_hl() { printf '%s' "${DNAV_HIGHLIGHT:-${HIGHLIGHT:-$'\e[30;46m'}}"; }
_dfile_rst() { printf '%s' "${DNAV_RESET:-${RESET:-$'\e[0m'}}"; }
_dfile_cols() {
  local w=${cols:-${COLUMNS:-80}}; (( w < 20 )) && w=80; printf '%s' "$w"
}

_dfile_list() {
  local dir="$1" kind="$2" show_hidden="$3"
  local -a names=(); local e b
  _DFILE_LIST_DENY=""
  [[ -d $dir ]] || return 1
  if [[ ! -r $dir ]]; then _DFILE_LIST_DENY="$dir"; return 1; fi
  shopt -s nullglob
  if [[ $kind == dirs ]]; then
    if (( show_hidden )); then
      for e in "$dir"/*/ "$dir"/.[!.]*/ "$dir"/..?*/; do
        [[ -d $e ]] || continue
        b="$(basename -- "$e")"; [[ $b == . || $b == .. ]] && continue
        names+=("$b")
      done
    else
      for e in "$dir"/*/; do
        [[ -d $e ]] || continue
        names+=("$(basename -- "$e")")
      done
    fi
  else
    if (( show_hidden )); then
      for e in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
        [[ -e $e && ! -d $e ]] || continue
        b="$(basename -- "$e")"; [[ $b == . || $b == .. ]] && continue
        names+=("$b")
      done
    else
      for e in "$dir"/*; do
        [[ -e $e && ! -d $e ]] || continue
        names+=("$(basename -- "$e")")
      done
    fi
  fi
  shopt -u nullglob
  if (( ${#names[@]} )); then
    local IFS=$'\n'; names=($(printf '%s\n' "${names[@]}" | sort)); unset IFS
  fi
  printf '%s\n' "${names[@]}"
  return 0
}

_dfile_window() {
  local -n _all="$1"
  local sel="$2" win="$3" maxw="$4"
  local n=${#_all[@]}
  _dfile_vis=()
  if (( n == 0 )); then _dfile_win_out=0; return 0; fi
  (( sel < 0 )) && sel=0; (( sel >= n )) && sel=$(( n - 1 ))
  (( win < 0 )) && win=0; (( win > sel )) && win=$sel
  local -a vis=()
  local i w used label vcount sel_slot changed=1 guard=0
  while (( changed && guard < 40 )); do
    (( guard++ )); changed=0; vis=(); used=0
    for (( i=win; i < n; i++ )); do
      label="${_all[i]}"; w=$(( ${#label} + 3 ))
      if (( ${#vis[@]} > 0 && used + w > maxw )); then break; fi
      if (( ${#vis[@]} == 0 && w > maxw )); then vis+=("$label"); break; fi
      vis+=("$label"); (( used += w ))
    done
    vcount=${#vis[@]}; (( vcount == 0 )) && break
    sel_slot=$(( sel - win ))
    if (( sel_slot >= vcount )); then
      if (( vcount >= 2 )); then win=$(( sel - (vcount - 2) )); else win=$sel; fi
      (( win < 0 )) && win=0; changed=1; continue
    fi
    if (( sel_slot == vcount - 1 && sel < n - 1 && vcount >= 2 )); then
      local nwin=$(( sel - (vcount - 2) )); (( nwin < 0 )) && nwin=0
      if (( nwin != win )); then win=$nwin; changed=1; fi
    fi
  done
  _dfile_vis=("${vis[@]}"); _dfile_win_out=$win
}

_dfile_paint_strip() {
  local -n items="$1"
  local sel="$2" win="$3" active="$4" maxw="$5"
  local hl rst; hl="$(_dfile_hl)"; rst="$(_dfile_rst)"
  local n=${#items[@]} more_l=0 more_r=0 ind_l=0 ind_r=0 content_w=$maxw
  local i label used=0 cell_w
  _dfile_window items "$sel" "$win" "$content_w"; win=$_dfile_win_out
  (( win > 0 )) && more_l=1
  (( n > 0 && win + ${#_dfile_vis[@]} < n )) && more_r=1
  (( more_l )) && ind_l=2; (( more_r )) && ind_r=2
  if (( ind_l + ind_r > 0 )); then
    content_w=$(( maxw - ind_l - ind_r )); (( content_w < 4 )) && content_w=4
    _dfile_window items "$sel" "$win" "$content_w"; win=$_dfile_win_out
    more_l=0; more_r=0
    (( win > 0 )) && more_l=1
    (( n > 0 && win + ${#_dfile_vis[@]} < n )) && more_r=1
  fi
  (( more_l )) && printf '\e[2m<\e[22m '
  used=0
  for (( i=win; i < n; i++ )); do
    label="${items[i]}"; cell_w=$(( ${#label} + 3 ))
    if (( used > 0 && used + cell_w > content_w )); then break; fi
    if (( used == 0 && cell_w > content_w )); then
      label="${label:0:$((content_w-2))}…"; cell_w=$content_w
    fi
    if (( active && i == sel )); then printf "${hl} %s ${rst} " "$label"
    else printf ' %s  ' "$label"; fi
    (( used += cell_w ))
  done
  (( more_r )) && printf ' \e[2m>\e[22m'
  printf '\e[K'; _dfile_win_out=$win
}

_dfile_enter() {
  local start="${1:-}" hl rst maxw key key2 key3
  local show_hidden=${DNAV_CFG_SHOW_HIDDEN:-0}
  (( show_hidden = show_hidden ? 1 : 0 ))
  local focus=children mode=browse jump_buf=""
  local -a siblings=() children=() files=()
  local sel_s=0 sel_c=0 sel_f=0 win_s=0 win_c=0 win_f=0 body=0
  local cwd parent perm_denied=""
  _DFILE_OPEN=1; hl="$(_dfile_hl)"; rst="$(_dfile_rst)"
  [[ -n $start && -d $start ]] && cd -- "$start" 2>/dev/null || true

  if declare -f _dsearch_index_running >/dev/null 2>&1 && _dsearch_index_running; then
    printf '\r\e[2K\e[?25l'
    declare -f _dsearch_ensure_index >/dev/null 2>&1 && _dsearch_ensure_index
    printf '\r\e[2K'
  fi

  _dfile_refresh() {
    local out rc
    cwd="$(pwd -P 2>/dev/null || pwd)"
    parent="$(dirname -- "$cwd")"; [[ -z $parent ]] && parent="/"
    perm_denied=""; siblings=(); children=(); files=()
    # At filesystem root: no parent siblings — show only "/"
    if [[ $cwd == / ]]; then
      siblings=("/")
      sel_s=0
      win_s=0
      parent="/"
    else
      out="$(_dfile_list "$parent" dirs $show_hidden 2>/dev/null)"; rc=$?
      if (( rc != 0 )); then [[ -n $_DFILE_LIST_DENY ]] && perm_denied="$_DFILE_LIST_DENY"; siblings=()
      else [[ -n $out ]] && mapfile -t siblings <<< "$out" || siblings=(); fi
      local base i; base="$(basename -- "$cwd")"; sel_s=0
      for (( i=0; i < ${#siblings[@]}; i++ )); do
        [[ ${siblings[i]} == "$base" ]] && { sel_s=$i; break; }
      done
    fi
    out="$(_dfile_list "$cwd" dirs $show_hidden 2>/dev/null)"; rc=$?
    if (( rc != 0 )); then [[ -n $_DFILE_LIST_DENY ]] && perm_denied="$_DFILE_LIST_DENY"; children=()
    else [[ -n $out ]] && mapfile -t children <<< "$out" || children=(); fi
    out="$(_dfile_list "$cwd" files $show_hidden 2>/dev/null)"; rc=$?
    if (( rc != 0 )); then [[ -n $_DFILE_LIST_DENY ]] && perm_denied="$_DFILE_LIST_DENY"; files=()
    else [[ -n $out ]] && mapfile -t files <<< "$out" || files=(); fi
    (( ${#children[@]} == 0 )) && sel_c=0
    (( ${#files[@]} == 0 )) && sel_f=0
    (( sel_c >= ${#children[@]} && ${#children[@]} > 0 )) && sel_c=$(( ${#children[@]} - 1 ))
    (( sel_f >= ${#files[@]} && ${#files[@]} > 0 )) && sel_f=$(( ${#files[@]} - 1 ))
    _dfile_fix_focus
  }

  _dfile_fix_focus() {
    if [[ $focus == children ]]; then
      (( ${#children[@]} == 0 && ${#files[@]} > 0 )) && focus=files
    elif [[ $focus == files ]]; then
      (( ${#files[@]} == 0 && ${#children[@]} > 0 )) && focus=children
    else
      if (( ${#children[@]} > 0 )); then focus=children
      elif (( ${#files[@]} > 0 )); then focus=files
      else focus=children; fi
    fi
  }

  _dfile_paint_status() {
    local w="$1" hid_mark left right fill
    (( show_hidden )) && hid_mark="●" || hid_mark="○"
    local dir_lbl file_lbl
    case ${DNAV_CFG_DFILE_SORT_DIRS:-alpha} in
      hidden_first|hidden|dot_first) dir_lbl=Dot ;;
      *) dir_lbl=Alpha ;;
    esac
    case ${DNAV_CFG_DFILE_SORT_FILES:-alpha} in
      ext|extension) file_lbl=Ext ;;
      dot_first|hidden_first|dot) file_lbl=Dot ;;
      dot_ext|dot_extension|hidden_ext) file_lbl=Dot/Ext ;;
      *) file_lbl=Alpha ;;
    esac
    left="- Show Hidden ${hid_mark} -- Dir: ${dir_lbl} -- File: ${file_lbl} "
    if (( ${#left} > w )); then
      left="- Hidden ${hid_mark} -- Dir: ${dir_lbl} -- File: ${file_lbl} "
    fi
    if (( ${#left} > w )); then
      left="- ${hid_mark} -- D:${dir_lbl} -- F:${file_lbl} "
    fi
    if [[ -n $perm_denied ]]; then
      right=" Permission Denied: ${perm_denied} "
      if (( ${#left} + ${#right} > w )); then
        local room=$(( w - ${#left} - 5 )); (( room < 8 )) && room=8
        right=" …${right: -room} "
      fi
    else right=""; fi
    fill=$(( w - ${#left} - ${#right} )); (( fill < 0 )) && fill=0
    printf '\r%s' "$left"
    printf '%*s' $fill '' | tr ' ' '-'
    printf '%s\e[K' "$right"
  }

  _dfile_paint_line() {
    local which="$1" maxw brand brand_w rest_w active=0
    maxw="$(_dfile_cols)"; hl="$(_dfile_hl)"; rst="$(_dfile_rst)"
    case $which in
      siblings)
        brand=" DNav Files:"; printf "\r${hl}%s${rst} " "$brand"
        brand_w=$(( ${#brand} + 1 )); rest_w=$(( maxw - brand_w )); (( rest_w < 8 )) && rest_w=8
        if (( ${#siblings[@]} == 0 )); then
          printf '\e[K'; win_s=0
        else
          _dfile_paint_strip siblings $sel_s $win_s 1 $rest_w; win_s=$_dfile_win_out
        fi ;;
      children)
        [[ $focus == children ]] && active=1; printf '\r'
        _dfile_paint_strip children $sel_c $win_c $active $maxw; win_c=$_dfile_win_out ;;
      status) _dfile_paint_status $maxw ;;
      files)
        [[ $focus == files ]] && active=1; printf '\r'
        _dfile_paint_strip files $sel_f $win_f $active $maxw; win_f=$_dfile_win_out ;;
    esac
  }

  _dfile_draw() {
    local old_body=$body leftover i n
    maxw="$(_dfile_cols)"; hl="$(_dfile_hl)"; rst="$(_dfile_rst)"
    printf '\e[?25l'
    if [[ $mode == jump ]]; then
      printf "\r${hl} DNav Jump:${rst} %s\e[K" "$jump_buf"
      local -a hits=(); local k; n=0
      if _djump_available 2>/dev/null; then mapfile -t hits < <(_djump_match_query "$jump_buf"); fi
      for k in "${hits[@]:0:6}"; do
        printf "\n\r\e[2m  d%s → %s${rst}\e[K" "$k" "$(_djump_resolve "$k" 2>/dev/null || true)"
        (( n++ ))
      done
      leftover=$(( old_body - n ))
      for (( i=0; i < leftover; i++ )); do printf '\n\r\e[2K'; done
      (( leftover > 0 )) && printf "\e[%dA" $leftover
      body=$n; (( body > 0 )) && printf "\e[%dA" $body; printf '\r'; return
    fi
    _dfile_paint_line siblings; printf '\n'
    _dfile_paint_line children; printf '\n'
    _dfile_paint_line status; printf '\n'
    _dfile_paint_line files
    leftover=$(( old_body - 3 ))
    for (( i=0; i < leftover; i++ )); do printf '\n\r\e[2K'; done
    (( leftover > 0 )) && printf "\e[%dA" $leftover
    body=3; printf '\e[3A\r'
  }

  _dfile_erase() {
    local i; printf '\r\e[2K'
    for (( i=0; i < body; i++ )); do printf '\n\r\e[2K'; done
    (( body > 0 )) && printf "\e[%dA" $body
    printf '\r\e[2K'; body=0
  }

  _dfile_go() {
    local dest="$1"
    [[ -d $dest ]] || return 1
    if ! cd -- "$dest" 2>/dev/null; then perm_denied="$dest"; _dfile_draw; return 1; fi
    _dfile_refresh; win_c=0; win_f=0; sel_c=0; sel_f=0; _dfile_draw
  }

  _dfile_sel_dir_path() {
    [[ $focus == children ]] || return 1
    (( ${#children[@]} )) || return 1
    _dfile_sel_path="$cwd/${children[sel_c]}"
  }

  _dfile_toggle_focus() {
    local prev=$focus
    [[ $focus == files ]] && focus=children || focus=files
    _dfile_fix_focus
    [[ $focus == "$prev" ]] && return
    _dfile_draw
  }

  _dfile_enter_sel_dir() { _dfile_sel_dir_path || return 1; _dfile_go "$_dfile_sel_path"; }

  _dfile_exit_to() {
    local dest="$1"; _dfile_erase; _DFILE_OPEN=0
    if [[ ! -d $dest ]] || ! cd -- "$dest" 2>/dev/null; then
      printf 'Could not change to %s\n' "$dest"
      declare -f _dnav_cleanup >/dev/null 2>&1 && _dnav_cleanup || printf '\e[?25h'
      return 0
    fi
    if declare -f _dnav_success_bar >/dev/null 2>&1; then _dnav_success_bar "$(pwd -P 2>/dev/null || pwd)"
    else printf '%s\n' "$(pwd -P 2>/dev/null || pwd)"; fi
    declare -f _dnav_cleanup >/dev/null 2>&1 && _dnav_cleanup || printf '\e[?25h'
    declare -f _dnav_maybe_ls >/dev/null 2>&1 && _dnav_maybe_ls
    return 0
  }

  _dfile_exit_sel_dir() { _dfile_sel_dir_path || return 1; _dfile_exit_to "$_dfile_sel_path"; }

  _dfile_open_file() {
    (( ${#files[@]} )) || return 1
    local fpath="$cwd/${files[sel_f]}"; [[ -e $fpath ]] || return 1
    _dfile_erase; _DFILE_OPEN=0
    declare -f _dnav_success_bar >/dev/null 2>&1 && _dnav_success_bar "$fpath" || printf '%s\n' "$fpath"
    declare -f _dnav_cleanup >/dev/null 2>&1 && _dnav_cleanup || printf '\e[?25h'
    if [[ -n ${EDITOR:-} ]]; then $EDITOR -- "$fpath"
    elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$fpath" >/dev/null 2>&1 &
    else printf 'No EDITOR/xdg-open for %s\n' "$fpath"; fi
    return 0
  }

  _dfile_move_h() {
    local dir="$1" n
    case $focus in
      children)
        n=${#children[@]}; (( n == 0 )) && return
        (( sel_c += dir )); (( sel_c < 0 )) && sel_c=0; (( sel_c >= n )) && sel_c=$(( n - 1 )) ;;
      files)
        n=${#files[@]}; (( n == 0 )) && return
        (( sel_f += dir )); (( sel_f < 0 )) && sel_f=0; (( sel_f >= n )) && sel_f=$(( n - 1 )) ;;
      *) return ;;
    esac
    _dfile_draw
  }

  _dfile_refresh; body=0; _dfile_draw

  while true; do
    (( ${DNAV_ABORT:-0} )) && { _DFILE_OPEN=0; return 130; }
    IFS= read -r -n 1 -s key || true
    (( ${DNAV_ABORT:-0} )) && { _DFILE_OPEN=0; return 130; }
    if [[ $key == $'\x03' ]]; then
      if declare -f _dnav_abort >/dev/null 2>&1; then _dnav_abort
      else _dfile_erase; _DFILE_OPEN=0; DNAV_ABORT=1; fi
      return 130
    fi
    if [[ $mode == jump ]]; then
      case $key in
        $'\e')
          if IFS= read -r -n 1 -s -t 0.05 key2 2>/dev/null; then
            [[ $key2 == '[' ]] && IFS= read -r -n 1 -s key3
          else mode=browse; jump_buf=""; _dfile_draw; fi ;;
        $'\n'|$'\r'|'')
          if _djump_available 2>/dev/null; then
            local dest; dest="$(_djump_resolve "$jump_buf" 2>/dev/null)" || dest=""
            if [[ -z $dest && $jump_buf != d* ]]; then dest="$(_djump_resolve "d$jump_buf" 2>/dev/null)" || dest=""; fi
            if [[ -n $dest ]]; then
              mode=browse; jump_buf=""
              if [[ -d $dest ]]; then _dfile_go "$dest"; else perm_denied="$dest"; _dfile_draw; fi
            fi
          fi ;;
        $'\177'|$'\b') (( ${#jump_buf} > 0 )) && jump_buf="${jump_buf:0:$((${#jump_buf}-1))}"; _dfile_draw ;;
        [[:print:]]) jump_buf+="$key"; _dfile_draw ;;
      esac
      continue
    fi
    case $key in
      $'\e')
        if IFS= read -r -n 1 -s -t 0.05 key2 2>/dev/null; then
          if [[ $key2 == '[' ]]; then
            IFS= read -r -n 1 -s key3
            case $key3 in
              A) [[ $cwd != / ]] && _dfile_go "$(dirname -- "$cwd")" ;;
              B) _dfile_enter_sel_dir ;;
              C) _dfile_move_h 1 ;;
              D) _dfile_move_h -1 ;;
            esac
          fi
        else _dfile_erase; _DFILE_OPEN=0; return 1; fi ;;
      h) _dfile_move_h -1 ;;
      l) _dfile_move_h 1 ;;
      k) [[ $cwd != / ]] && _dfile_go "$(dirname -- "$cwd")" ;;
      j) _dfile_enter_sel_dir ;;
      f|F|$'\t') _dfile_toggle_focus ;;
      .) show_hidden=$(( 1 - show_hidden )); _dfile_refresh; _dfile_draw ;;
      d) if _djump_available 2>/dev/null; then mode=jump; jump_buf="d"; _dfile_draw; fi ;;
      s|/)
        if _dsearch_available 2>/dev/null; then
          _dfile_erase; body=0; local spath
          if declare -f _dsearch_start_for_dfile >/dev/null 2>&1 && _dsearch_start_for_dfile; then
            spath="${DNAV_SEARCH_RESULT:-}"
            if [[ -n $spath && -d $spath ]]; then cd -- "$spath" 2>/dev/null || true; _dfile_refresh; fi
          fi
          (( ${DNAV_ABORT:-0} )) && { _DFILE_OPEN=0; return 130; }
          body=0; _dfile_draw
        fi ;;
      $'\n'|$'\r'|'')
        if [[ $focus == files ]]; then _dfile_open_file && return 0
        else _dfile_exit_sel_dir && return 0; fi ;;
    esac
  done
}
